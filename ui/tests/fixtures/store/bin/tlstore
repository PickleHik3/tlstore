#!/bin/sh
# Stub tlstore for tlstore-ui tests: answers from the fixture files next to it and logs
# every call to calls.log. Speaks the Revision 5 TSV contract, the snapshot and prefetch
# streams, and the progress stream.
d=$(cd "$(dirname "$0")/.." && pwd)
printf '%s\n' "$*" >> "$d/calls.log"
TAB=$(printf '\t')
cmd=$1; shift
case "$cmd" in
    list) cat "$d/list.tsv"; exit 0 ;;
    snapshot)
        # list.tsv as `item` lines, each item's info/<name>.tsv as `field` lines,
        # updates.tsv as `update` lines; nothing is ever reported cached.
        # hold-snapshot: the answer waits while the file is there (a phone's slow rebuild).
        [ "$1" = --tsv ] || exit 2
        while [ -f "$d/hold-snapshot" ]; do sleep 0.05; done
        printf '# tlstore snapshot\tkey=fixture\n'
        while IFS="$TAB" read -r n rest; do
            [ -n "$n" ] || continue
            printf 'item\t%s\t%s\n' "$n" "$rest"
            [ -f "$d/info/$n.tsv" ] && sed "s/^/field${TAB}${n}${TAB}/" "$d/info/$n.tsv"
        done < "$d/list.tsv"
        sed "s/^/update${TAB}/" "$d/updates.tsv"
        exit 0
        ;;
    prefetch)
        # Nothing is prefetched unless a test asks for it (prefetch-lines): then every
        # picture, demo and readme the fixtures hold is reported ready, the way the real
        # engine answers from its cache.
        [ -f "$d/prefetch-lines" ] || exit 0
        while IFS="$TAB" read -r n rest; do
            [ -n "$n" ] || continue
            if [ -f "$d/pics/$n.png" ]; then
                printf 'ready\t%s\tpicture\t%s\n' "$n" "$d/pics/$n.png"
                printf 'ready\t%s\tdemo\t%s\n' "$n" "$d/pics/$n.png"
            elif [ -f "$d/pics/$n.jpg" ]; then
                printf 'ready\t%s\tpicture\t%s\n' "$n" "$d/pics/$n.jpg"
            else
                printf 'failed\t%s\tpicture\tnot fetched or not verified\n' "$n"
            fi
            [ -f "$d/readme/$n.md" ] && printf 'ready\t%s\treadme\t%s\n' "$n" "$d/readme/$n.md"
        done < "$d/list.tsv"
        exit 0
        ;;
    update)
        case " $* " in
            *" --check "*) cat "$d/updates.tsv"; exit 0 ;;
        esac
        ;;
    self-update)
        # A newer store is offered only when a test drops the file `self-update` in;
        # the --progress stream then plays the engine's self-update for the item tlstore
        # (hold: sleeps mid-download like any job; fail-tlstore: a refused program).
        case " $* " in
            *" --check "*)
                if [ -f "$d/self-update" ]; then
                    printf 'self\t0.6\t0.7\t1\n'
                else
                    printf 'self\t0.6\t0.6\t0\n'
                fi
                exit 0
                ;;
            *" --progress "*)
                printf 'step\ttlstore\t2\tfetched\n'
                printf 'step\ttlstore\t8\tfetched\n'
                printf 'step\ttlstore\t44\tfetched\n'
                [ -f "$d/hold" ] && sleep 30
                printf 'step\ttlstore\t80\tfetched\n'
                if [ -f "$d/fail-tlstore" ]; then
                    printf 'done\ttlstore\tfailed\tthe store program that was offered does not match what tlstore 0.7 expects\n'
                    exit 1
                fi
                printf 'step\ttlstore\t85\tsignature checked\n'
                printf 'step\ttlstore\t92\tputting files in place\n'
                printf 'step\ttlstore\t100\tready\n'
                printf 'done\ttlstore\tok\tupdated to 0.7\n'
                rm -f "$d/self-update"
                exit 0
                ;;
        esac
        exit 2
        ;;
    info)
        [ "$1" = --tsv ] && shift
        [ -f "$d/info/$1.tsv" ] || exit 1
        cat "$d/info/$1.tsv"
        exit 0
        ;;
    picture)
        # `picture <name> demo` is the hero clip (a test's APNG, pics/<name>.png); the plain
        # form is the still, the .jpg first.
        [ -f "$d/nopics" ] && exit 2
        if [ "$2" = demo ]; then
            [ -f "$d/pics/$1.png" ] || exit 1
            echo "$d/pics/$1.png"
            exit 0
        fi
        for p in "$d/pics/$1.jpg" "$d/pics/$1.png"; do
            [ -f "$p" ] || continue
            echo "$p"
            exit 0
        done
        exit 1
        ;;
    readme)
        # Exit 2: no upstream (a setup). Exit 1: nothing fetched and nothing cached.
        [ -f "$d/info/$1.tsv" ] || exit 1
        grep -q "^Setup	1" "$d/info/$1.tsv" && exit 2
        [ -f "$d/noreadme" ] && exit 1
        p="$d/readme/$1.md"
        [ -f "$p" ] || exit 1
        echo "$p"
        exit 0
        ;;
    readme-asset)
        # Every asset is answered with the item's own picture; nothing is downloaded.
        [ -f "$d/nopics" ] && exit 1
        case "$2" in
            *.gif|*.svg) exit 1 ;;
        esac
        p="$d/pics/$1.jpg"
        [ -f "$p" ] || exit 1
        echo "$p"
        exit 0
        ;;
esac
case "$cmd" in
    install|upgrade|remove) ;;
    *) exit 2 ;;
esac
[ "$1" = --progress ] || exit 2
shift
# The plan first, one `row` line per row (Revision 17). part-<name> holds the name of a
# part that item needs: announced auto before it and run through before it.
action=install
[ "$cmd" = remove ] && action=remove
for n in "$@"; do
    [ -f "$d/part-$n" ] && printf 'row\t%s\tinstall\tpkg\t-\tauto\tneeded by %s\n' "$(cat "$d/part-$n")" "$n"
    printf 'row\t%s\t%s\tbinary\t-\trequested\t-\n' "$n" "$action"
done
failed=0
for n in "$@"; do
    if [ -f "$d/part-$n" ]; then
        p=$(cat "$d/part-$n")
        printf 'step\t%s\t10\tfetched\n' "$p"
        printf 'step\t%s\t60\tsignature checked\n' "$p"
        printf 'step\t%s\t90\tputting files in place\n' "$p"
        printf 'step\t%s\t100\tready\n' "$p"
        printf 'done\t%s\tok\tinstalled\n' "$p"
    fi
    # error-<name>: its lines arrive as job-level `error` lines before the item's first step.
    if [ -f "$d/error-$n" ]; then
        while IFS= read -r line; do
            printf 'error\t%s\n' "$line"
        done < "$d/error-$n"
    fi
    printf 'step\t%s\t10\tfetched\n' "$n"
    if [ -f "$d/hold" ]; then
        printf 'step\t%s\t60\tsignature checked\n' "$n"
        sleep 30
    fi
    if [ "$n" = broken ] || [ -f "$d/fail-$n" ]; then
        printf 'done\t%s\tfailed\tcould not %s %s\n' "$n" "$cmd" "$n"
        failed=1
        continue
    fi
    printf 'step\t%s\t60\tsignature checked\n' "$n"
    printf 'step\t%s\t90\tputting files in place\n' "$n"
    printf 'step\t%s\t100\tready\n' "$n"
    msg=installed
    [ "$cmd" = remove ] && msg=removed
    [ "$cmd" = upgrade ] && msg=updated
    [ -f "$d/kept" ] && msg="kept your config.fish"
    printf 'done\t%s\tok\t%s\n' "$n" "$msg"
    case "$cmd" in
        install) sed -i "s/^$n${TAB}available${TAB}\([^$TAB]*\)${TAB}${TAB}/$n${TAB}installed${TAB}\1${TAB}\1${TAB}/" "$d/list.tsv" ;;
        remove)
            sed -i "s/^$n${TAB}installed${TAB}\([^$TAB]*\)${TAB}[^$TAB]*${TAB}/$n${TAB}available${TAB}\1${TAB}${TAB}/" "$d/list.tsv"
            sed -i "/^$n$TAB/d" "$d/updates.tsv"
            ;;
        upgrade) sed -i "/^$n$TAB/d" "$d/updates.tsv" ;;
    esac
done
exit $failed

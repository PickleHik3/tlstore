+/// Termux: libxcb looks for X sockets only under its build-time `$PREFIX/tmp`,
+/// but an X server started from a shell listens under that shell's `$TMPDIR`,
+/// and another Termux app id has another prefix. For a local display (`:N`,
+/// `unix:N`), connect to the socket under `$TMPDIR` or `$PREFIX/tmp` ourselves
+/// and hand the fd to libxcb. `None` falls back to the normal connect.
+#[cfg(target_os = "android")]
+fn termux_x11_connect(display: &str) -> Option<(XCBConnection, usize)> {
+    use std::os::fd::IntoRawFd;
+    unsafe extern "C" {
+        fn xcb_connect_to_fd(fd: std::ffi::c_int, auth: *mut std::ffi::c_void) -> *mut std::ffi::c_void;
+        fn xcb_connection_has_error(c: *mut std::ffi::c_void) -> std::ffi::c_int;
+        fn xcb_disconnect(c: *mut std::ffi::c_void);
+    }
+    let (host, rest) = display.rsplit_once(':')?;
+    if !matches!(host, "" | "unix") {
+        return None;
+    }
+    let (number, screen) = match rest.split_once('.') {
+        Some((n, s)) => (n, s.parse::<usize>().ok()?),
+        None => (rest, 0),
+    };
+    let number: u32 = number.parse().ok()?;
+    let dirs = [
+        std::env::var("TMPDIR").ok(),
+        std::env::var("PREFIX").ok().map(|p| format!("{p}/tmp")),
+    ];
+    let stream = dirs
+        .into_iter()
+        .flatten()
+        .filter(|d| !d.is_empty())
+        .find_map(|d| std::os::unix::net::UnixStream::connect(format!("{d}/.X11-unix/X{number}")).ok())?;
+    let fd = stream.into_raw_fd();
+    unsafe {
+        let raw = xcb_connect_to_fd(fd, std::ptr::null_mut());
+        if raw.is_null() {
+            return None;
+        }
+        if xcb_connection_has_error(raw) != 0 {
+            xcb_disconnect(raw);
+            return None;
+        }
+        let connection = XCBConnection::from_raw_xcb_connection(raw, true).ok()?;
+        Some((connection, screen))

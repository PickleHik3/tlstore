+/// The X11/cursorfont.h glyph (XC_*) for a cursor style; the mask is the next glyph.
+fn cursor_style_to_font_glyph(style: CursorStyle) -> u16 {
+    match style {
+        CursorStyle::Arrow => 68,                  // XC_left_ptr
+        CursorStyle::IBeam => 152,                 // XC_xterm
+        CursorStyle::IBeamCursorForVerticalLayout => 152, // XC_xterm
+        CursorStyle::Crosshair => 34,              // XC_crosshair
+        CursorStyle::ClosedHand => 58,             // XC_hand1
+        CursorStyle::OpenHand => 58,               // XC_hand1
+        CursorStyle::PointingHand => 60,           // XC_hand2
+        CursorStyle::ResizeLeft => 70,             // XC_left_side
+        CursorStyle::ResizeRight => 96,            // XC_right_side
+        CursorStyle::ResizeLeftRight => 108,       // XC_sb_h_double_arrow
+        CursorStyle::ResizeColumn => 108,          // XC_sb_h_double_arrow
+        CursorStyle::ResizeUp => 138,              // XC_top_side
+        CursorStyle::ResizeDown => 16,             // XC_bottom_side
+        CursorStyle::ResizeUpDown => 116,          // XC_sb_v_double_arrow
+        CursorStyle::ResizeRow => 116,             // XC_sb_v_double_arrow
+        CursorStyle::ResizeUpLeftDownRight => 134, // XC_top_left_corner
+        CursorStyle::ResizeUpRightDownLeft => 136, // XC_top_right_corner
+        CursorStyle::OperationNotAllowed => 0,     // XC_X_cursor
+        _ => 68,                                   // XC_left_ptr
+    }
+}
+
+fn create_font_glyph_cursor(
+    connection: &XCBConnection,
+    style: CursorStyle,
+) -> Option<xproto::Cursor> {
+    let glyph = cursor_style_to_font_glyph(style);
+    let font = connection.generate_id().ok()?;
+    connection.open_font(font, b"cursor").ok()?.check().ok()?;
+    let cursor = connection.generate_id().ok()?;
+    let created = connection
+        .create_glyph_cursor(
+            cursor, font, font, glyph, glyph + 1, 0, 0, 0, 0xffff, 0xffff, 0xffff,
+        )
+        .ok()
+        .and_then(|cookie| cookie.check().ok());
+    connection.close_font(font).ok();
+    created.map(|_| cursor)
+}

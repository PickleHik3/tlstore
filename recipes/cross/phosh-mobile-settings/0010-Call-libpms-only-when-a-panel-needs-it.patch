From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@example.invalid>
Date: Mon, 26 Oct 2026 13:00:00 +0000
Subject: [PATCH] Call libpms only when a panel needs it

libpms is the library the language, OSK and OS update panels share. When all three are off it
is not built, and main () does not initialise it.

diff --git a/src/main.c b/src/main.c
index 5aac79e..28679c0 100644
--- a/src/main.c
+++ b/src/main.c
@@ -12,7 +12,9 @@
 #include "ms-application.h"
 #include "ms-main.h"
 
+#if MOBILE_SETTINGS_HAVE_LIBPMS
 #include "libpms.h"
+#endif
 
 #include <glib-unix.h>
 
@@ -34,8 +36,10 @@ main (int argc, char *argv[])
   g_autoptr (GError) err = NULL;
   int ret;
 
+#if MOBILE_SETTINGS_HAVE_LIBPMS
   /* Init libpms */
   ms_init ();
+#endif
   /* Init the private lib */
   ms_internal_init ();
 

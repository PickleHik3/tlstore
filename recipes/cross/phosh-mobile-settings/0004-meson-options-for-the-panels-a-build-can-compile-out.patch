@@ -0,0 +1,12 @@
+# GtkBuilder files that name objects of panels the tl patch set can compile out are passed through
+# tools/tl-ui-filter, which drops the blocks of the panels that are off. The result is in this
+# directory of the build tree, where mobile-settings.gresource.xml finds it before the source's own.
+tl_filtered_uis = []
+foreach ui : ['ms-window.ui']
+  tl_filtered_uis += custom_target(
+    'filtered-' + ui,
+    input: ui,
+    output: ui,
+    command: [tl_ui_filter, '@INPUT@', '@OUTPUT@', tl_ui_off],
+  )
+endforeach
--- a/tools/tl-ui-filter
+++ b/tools/tl-ui-filter
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+#
+# Copyright (C) 2026 Termux Launcher
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# Takes the objects of features that are compiled out of a GtkBuilder file, so that the template
+# does not name a type that the build does not have.
+#
+# Usage: tl-ui-filter INPUT OUTPUT [FEATURE...]
+#
+# FEATUREs are the features that are *off*. A block starts with a line holding only
+#
+#   <!-- tl-if FEATURE -->
+#
+# and ends with a line holding only
+#
+#   <!-- tl-endif -->
+#
+# The block is kept when FEATURE is not listed and dropped when it is. The marker lines are not
+# copied. Blocks do not nest.
+
+import re
+import sys
+
+if len(sys.argv) < 3:
+    sys.exit(__doc__)
+
+src, dst = sys.argv[1:3]
+off = set(sys.argv[3:])
+
+start = re.compile(r"^\s*<!--\s*tl-if\s+([a-z0-9_-]+)\s*-->\s*$")
+end = re.compile(r"^\s*<!--\s*tl-endif\s*-->\s*$")
+
+out = []
+skipping = False
+inside = False
+
+with open(src, encoding="utf-8") as f:
+    for number, line in enumerate(f, 1):
+        m = start.match(line)
+        if m:
+            if inside:
+                sys.exit(f"{src}:{number}: tl-if inside tl-if")
+            inside = True
+            skipping = m.group(1) in off
+            continue
+        if end.match(line):
+            if not inside:
+                sys.exit(f"{src}:{number}: tl-endif without tl-if")
+            inside = False
+            skipping = False
+            continue
+        if not skipping:
+            out.append(line)
+
+if inside:
+    sys.exit(f"{src}: tl-if without tl-endif")
+
+with open(dst, "w", encoding="utf-8") as f:
+    f.writelines(out)

++// Termux Launcher: sets up a render buffer for a host (shm) wlr_buffer: an
++// internal device-local image to render into, and a host-visible buffer the
++// render command buffer copies each finished frame into (see pass.c).
++static bool init_shm_render_buffer(struct wlr_vk_render_buffer *buffer,
++		const struct wlr_shm_attributes *shm) {
++	struct wlr_vk_renderer *renderer = buffer->renderer;
++	VkDevice dev = renderer->dev->dev;
++	VkResult res;
++
++	if (!renderer->dev->shm_present) {
++		wlr_log(WLR_ERROR, "Cannot render into a shm buffer: "
++			"the device is not set up for it");
++		return false;
++	}
++
++	const struct wlr_vk_format_props *fmt = vulkan_format_props_from_drm(
++		renderer->dev, shm->format);
++	const struct wlr_pixel_format_info *info = drm_get_pixel_format_info(shm->format);
++	if (fmt == NULL || info == NULL || info->bytes_per_block == 0 ||
++			info->block_width != 1 || info->block_height != 1 ||
++			!wlr_drm_format_set_has(&renderer->dev->shm_render_formats,
++				shm->format, DRM_FORMAT_MOD_INVALID)) {
++		wlr_log(WLR_ERROR, "Unsupported shm render format 0x%"PRIX32, shm->format);
++		return false;
++	}
++
++	uint32_t width = buffer->wlr_buffer->width;
++	uint32_t height = buffer->wlr_buffer->height;
++
++	VkImageCreateInfo img_info = {
++		.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
++		.imageType = VK_IMAGE_TYPE_2D,
++		.format = fmt->format.vk,
++		.mipLevels = 1,
++		.arrayLayers = 1,
++		.samples = VK_SAMPLE_COUNT_1_BIT,
++		.tiling = VK_IMAGE_TILING_OPTIMAL,
++		.initialLayout = VK_IMAGE_LAYOUT_PREINITIALIZED,
++		.extent = (VkExtent3D){ width, height, 1 },
++		.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
++			VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
++		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
++	};
++	res = vkCreateImage(dev, &img_info, NULL, &buffer->image);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkCreateImage (shm render buffer)", res);
++		return false;
++	}
++
++	VkMemoryRequirements mem_reqs;
++	vkGetImageMemoryRequirements(dev, buffer->image, &mem_reqs);
++	int mem_type = vulkan_find_mem_type(renderer->dev,
++		VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, mem_reqs.memoryTypeBits);
++	if (mem_type < 0) {
++		wlr_log(WLR_ERROR, "No device-local memory type for the shm render buffer");
++		return false;
++	}
++	VkMemoryAllocateInfo mem_info = {
++		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
++		.allocationSize = mem_reqs.size,
++		.memoryTypeIndex = mem_type,
++	};
++	res = vkAllocateMemory(dev, &mem_info, NULL, &buffer->memories[0]);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkAllocateMemory (shm render buffer)", res);
++		return false;
++	}
++	buffer->mem_count = 1;
++	res = vkBindImageMemory(dev, buffer->image, buffer->memories[0], 0);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkBindImageMemory (shm render buffer)", res);
++		return false;
++	}
++
++	// The staging buffer holds one tightly packed frame; the copy into the
++	// wlr_buffer honours its stride.
++	buffer->shm_stage_size = (VkDeviceSize)width * height * info->bytes_per_block;
++	VkBufferCreateInfo buf_info = {
++		.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
++		.size = buffer->shm_stage_size,
++		.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
++		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
++	};
++	res = vkCreateBuffer(dev, &buf_info, NULL, &buffer->shm_stage_buffer);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkCreateBuffer (shm staging)", res);
++		return false;
++	}
++	vkGetBufferMemoryRequirements(dev, buffer->shm_stage_buffer, &mem_reqs);
++	// Cached memory first: the CPU reads this buffer back every frame, and
++	// reading write-combined memory is very slow.
++	mem_type = vulkan_find_mem_type(renderer->dev,
++		VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
++		VK_MEMORY_PROPERTY_HOST_CACHED_BIT, mem_reqs.memoryTypeBits);
++	if (mem_type < 0) {
++		mem_type = vulkan_find_mem_type(renderer->dev,
++			VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
++			mem_reqs.memoryTypeBits);
++	}
++	if (mem_type < 0) {
++		wlr_log(WLR_ERROR, "No host-visible memory type for the shm staging buffer");
++		return false;
++	}
++	mem_info = (VkMemoryAllocateInfo){
++		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
++		.allocationSize = mem_reqs.size,
++		.memoryTypeIndex = mem_type,
++	};
++	res = vkAllocateMemory(dev, &mem_info, NULL, &buffer->shm_stage_memory);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkAllocateMemory (shm staging)", res);
++		return false;
++	}
++	res = vkBindBufferMemory(dev, buffer->shm_stage_buffer,
++		buffer->shm_stage_memory, 0);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkBindBufferMemory (shm staging)", res);
++		return false;
++	}
++	res = vkMapMemory(dev, buffer->shm_stage_memory, 0, VK_WHOLE_SIZE, 0,
++		&buffer->shm_stage_data);
++	if (res != VK_SUCCESS) {
++		wlr_vk_error("vkMapMemory (shm staging)", res);
++		buffer->shm_stage_data = NULL;
++		return false;
++	}
++
++	buffer->shm = true;
++	buffer->shm_format = shm->format;
++	buffer->shm_bytes_per_pixel = info->bytes_per_block;
++	return true;
++}
++
++bool vulkan_render_buffer_get_attribs(struct wlr_vk_render_buffer *buffer,
++		struct wlr_dmabuf_attributes *attribs) {
++	if (buffer->shm) {
++		*attribs = (struct wlr_dmabuf_attributes){
++			.width = buffer->wlr_buffer->width,
++			.height = buffer->wlr_buffer->height,
++			.format = buffer->shm_format,
++		};
++		return true;
++	}
++	return wlr_buffer_get_dmabuf(buffer->wlr_buffer, attribs);
++}
++
++bool vulkan_render_buffer_shm_readback(struct wlr_vk_render_buffer *buffer) {
++	assert(buffer->shm);
++
++	void *data;
++	uint32_t format;
++	size_t stride;
++	if (!wlr_buffer_begin_data_ptr_access(buffer->wlr_buffer,
++			WLR_BUFFER_DATA_PTR_ACCESS_WRITE, &data, &format, &stride)) {
++		wlr_log(WLR_ERROR, "Cannot write the shm render buffer");
++		return false;
++	}
++
++	size_t row = (size_t)buffer->wlr_buffer->width * buffer->shm_bytes_per_pixel;
++	const uint8_t *src = buffer->shm_stage_data;
++	uint8_t *dst = data;
++	if (stride == row) {
++		memcpy(dst, src, row * buffer->wlr_buffer->height);
++	} else {
++		for (int y = 0; y < buffer->wlr_buffer->height; y++) {
++			memcpy(dst + y * stride, src + y * row, row);
++		}
++	}
++
++	wlr_buffer_end_data_ptr_access(buffer->wlr_buffer);
++	return true;
++}
++

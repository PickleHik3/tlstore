From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@users.noreply.github.com>
Date: Mon, 26 Oct 2026 11:13:49 +0300
Subject: [PATCH 1/2] Build for Termux: no libinput, libudev or libintl, no
 examples or tools

phoc's X11 backend gets keyboard, pointer and touch as X11 events, so no input device is a
libinput device. Termux has neither libinput nor libudev (nor libintl, which glib's gi18n.h
includes), and wlroots is built without its DRM, libinput and session code. src/compat/ declares
and defines what phoc still names: the libinput_device_* and udev calls (never reached, because
wlr_input_device_is_libinput() is false), the wlroots DRM and session entry points, and
no-translation gettext. pidfd_open is a function Bionic declares only from API 31, so the pidfd
code is compiled in only where it is declared. The examples and tools are not built.
---
 meson.build                |  9 ++---
 src/compat/libinput-stub.c | 48 ++++++++++++++++++++++
 src/compat/libinput.h      | 82 ++++++++++++++++++++++++++++++++++++++
 src/compat/libintl.h       | 23 +++++++++++
 src/meson.build            |  3 +-
 5 files changed, 157 insertions(+), 8 deletions(-)
 create mode 100644 src/compat/libinput-stub.c
 create mode 100644 src/compat/libinput.h
 create mode 100644 src/compat/libintl.h

diff --git a/meson.build b/meson.build
index 380bad8..dde6134 100644
--- a/meson.build
+++ b/meson.build
@@ -8,7 +8,7 @@ project(
 )
 
 add_project_arguments(
-  ['-DWLR_USE_UNSTABLE', '-DGMOBILE_USE_UNSTABLE_API', '-I' + meson.project_build_root()],
+  ['-DWLR_USE_UNSTABLE', '-DGMOBILE_USE_UNSTABLE_API', '-I' + meson.project_build_root(), '-I' + meson.project_source_root() / 'src/compat'],
   language: 'c',
 )
 
@@ -35,8 +35,7 @@ gobject = dependency('gobject-2.0', version: glib_ver_cmp)
 glesv2 = dependency('glesv2')
 gnome_desktop = dependency('gnome-desktop-3.0', version: '>=3.26')
 gsettings_desktop_schemas_dep = dependency('gsettings-desktop-schemas')
-input = dependency('libinput', version: '>= 1.27.0')
-udev = dependency('libudev')
+# Termux has neither libinput nor libudev, and the X11 backend uses neither: src/compat/ stands in.
 drm = dependency('libdrm')
 pixman = dependency('pixman-1', version: '>= 0.43.4')
 wayland_client = dependency('wayland-client', version: '>= 1.23.1')
@@ -166,7 +165,7 @@ config_h.set('PHOC_USE_DTRACE', use_dtrace, description: 'Whether tracing via dt
 config_h.set('PHOC_USE_SYSPROF', use_sysprof, description: 'Whether tracing via sysprof is enabled')
 config_h.set(
   'PHOC_HAVE_PIDFD',
-  cc.has_header('sys/pidfd.h'),
+  cc.has_function('pidfd_open', prefix: '#include <sys/pidfd.h>'),
   description: 'Whether pidfd support is available',
 )
 
@@ -177,9 +176,7 @@ subdir('protocols')
 subdir('data')
 subdir('src')
 subdir('tests')
-subdir('tools')
 subdir('doc')
-subdir('examples')
 
 run_data = configuration_data()
 run_data.set('ABS_BUILDDIR', meson.current_build_dir())
diff --git a/src/compat/libinput-stub.c b/src/compat/libinput-stub.c
new file mode 100644
index 0000000..f382768
--- /dev/null
+++ b/src/compat/libinput-stub.c
@@ -0,0 +1,48 @@
+/* Termux Launcher: definitions for compat/libinput.h and for the wlroots libinput, DRM and
+ * session entry points that phoc names but this wlroots (X11 backend only) does not build.
+ * Nothing here is reached with the X11 backend: wlr_input_device_is_libinput() is false for
+ * every device, and phoc checks it before it touches a libinput handle. */
+
+#include <wlr/backend/drm.h>
+#include <wlr/backend/libinput.h>
+#include <wlr/backend/session.h>
+
+#include <stddef.h>
+
+bool wlr_input_device_is_libinput (struct wlr_input_device *device) { return false; }
+bool wlr_backend_is_libinput (struct wlr_backend *backend) { return false; }
+struct libinput_device *wlr_libinput_get_device_handle (struct wlr_input_device *dev) { return NULL; }
+
+int libinput_device_config_accel_set_speed (struct libinput_device *d, double s) { return 0; }
+int libinput_device_config_dwt_set_enabled (struct libinput_device *d, enum libinput_config_dwt_state e) { return 0; }
+int libinput_device_config_left_handed_is_available (struct libinput_device *d) { return 0; }
+int libinput_device_config_left_handed_set (struct libinput_device *d, int v) { return 0; }
+int libinput_device_config_middle_emulation_is_available (struct libinput_device *d) { return 0; }
+int libinput_device_config_middle_emulation_set_enabled (struct libinput_device *d, int e) { return 0; }
+enum libinput_config_scroll_method libinput_device_config_scroll_get_method (struct libinput_device *d) { return LIBINPUT_CONFIG_SCROLL_NO_SCROLL; }
+int libinput_device_config_scroll_has_natural_scroll (struct libinput_device *d) { return 0; }
+int libinput_device_config_scroll_set_method (struct libinput_device *d, enum libinput_config_scroll_method m) { return 0; }
+int libinput_device_config_scroll_set_natural_scroll_enabled (struct libinput_device *d, int e) { return 0; }
+int libinput_device_config_tap_get_finger_count (struct libinput_device *d) { return 0; }
+int libinput_device_config_tap_set_drag_enabled (struct libinput_device *d, enum libinput_config_drag_state e) { return 0; }
+int libinput_device_config_tap_set_drag_lock_enabled (struct libinput_device *d, enum libinput_config_drag_lock_state e) { return 0; }
+int libinput_device_config_tap_set_enabled (struct libinput_device *d, enum libinput_config_tap_state e) { return 0; }
+struct libinput_device_group *libinput_device_get_device_group (struct libinput_device *d) { return NULL; }
+unsigned int libinput_device_get_id_product (struct libinput_device *d) { return 0; }
+unsigned int libinput_device_get_id_vendor (struct libinput_device *d) { return 0; }
+const char *libinput_device_get_name (struct libinput_device *d) { return ""; }
+struct udev_device *libinput_device_get_udev_device (struct libinput_device *d) { return NULL; }
+int libinput_device_keyboard_has_key (struct libinput_device *d, uint32_t c) { return 0; }
+int libinput_device_switch_has_switch (struct libinput_device *d, enum libinput_switch s) { return 0; }
+
+struct udev_device *udev_device_unref (struct udev_device *d) { return NULL; }
+const char *udev_device_get_property_value (struct udev_device *d, const char *k) { return NULL; }
+struct udev_list_entry *udev_device_get_properties_list_entry (struct udev_device *d) { return NULL; }
+struct udev_list_entry *udev_list_entry_get_next (struct udev_list_entry *e) { return NULL; }
+const char *udev_list_entry_get_name (struct udev_list_entry *e) { return NULL; }
+const char *udev_list_entry_get_value (struct udev_list_entry *e) { return NULL; }
+
+bool wlr_output_is_drm (struct wlr_output *output) { return false; }
+enum wl_output_transform wlr_drm_connector_get_panel_orientation (struct wlr_output *output) { return WL_OUTPUT_TRANSFORM_NORMAL; }
+struct wlr_output_mode *wlr_drm_connector_add_mode (struct wlr_output *output, const drmModeModeInfo *mode) { return NULL; }
+bool wlr_session_change_vt (struct wlr_session *session, unsigned vt) { return false; }
diff --git a/src/compat/libinput.h b/src/compat/libinput.h
new file mode 100644
index 0000000..0b5ef46
--- /dev/null
+++ b/src/compat/libinput.h
@@ -0,0 +1,82 @@
+/*
+ * Termux Launcher: stand-in for <libinput.h>.
+ *
+ * The X11 backend delivers keyboard, pointer and touch as X11 events, so no input device phoc
+ * sees is a libinput device. Termux has no libinput (nor libudev), and phoc's code only reaches
+ * these calls for devices that wlr_input_device_is_libinput() accepts, which under this build is
+ * none. This header declares just the types and calls phoc names; libinput-stub.c defines them.
+ */
+#pragma once
+
+#include <stdint.h>
+
+struct libinput_device;
+struct libinput_device_group;
+struct libinput_tablet_tool;
+struct udev_device;
+struct udev_list_entry;
+
+enum libinput_config_scroll_method {
+  LIBINPUT_CONFIG_SCROLL_NO_SCROLL = 0,
+  LIBINPUT_CONFIG_SCROLL_2FG = (1 << 0),
+  LIBINPUT_CONFIG_SCROLL_EDGE = (1 << 1),
+  LIBINPUT_CONFIG_SCROLL_ON_BUTTON_DOWN = (1 << 2),
+};
+
+enum libinput_config_tap_state {
+  LIBINPUT_CONFIG_TAP_DISABLED,
+  LIBINPUT_CONFIG_TAP_ENABLED,
+};
+
+enum libinput_config_drag_state {
+  LIBINPUT_CONFIG_DRAG_DISABLED,
+  LIBINPUT_CONFIG_DRAG_ENABLED,
+};
+
+enum libinput_config_drag_lock_state {
+  LIBINPUT_CONFIG_DRAG_LOCK_DISABLED,
+  LIBINPUT_CONFIG_DRAG_LOCK_ENABLED_TIMEOUT,
+  LIBINPUT_CONFIG_DRAG_LOCK_ENABLED_STICKY,
+};
+
+enum libinput_config_dwt_state {
+  LIBINPUT_CONFIG_DWT_DISABLED,
+  LIBINPUT_CONFIG_DWT_ENABLED,
+};
+
+enum libinput_switch {
+  LIBINPUT_SWITCH_LID = 1,
+  LIBINPUT_SWITCH_TABLET_MODE,
+};
+
+int libinput_device_config_accel_set_speed (struct libinput_device *device, double speed);
+int libinput_device_config_dwt_set_enabled (struct libinput_device *device, enum libinput_config_dwt_state enable);
+int libinput_device_config_left_handed_is_available (struct libinput_device *device);
+int libinput_device_config_left_handed_set (struct libinput_device *device, int left_handed);
+int libinput_device_config_middle_emulation_is_available (struct libinput_device *device);
+int libinput_device_config_middle_emulation_set_enabled (struct libinput_device *device, int enable);
+enum libinput_config_scroll_method libinput_device_config_scroll_get_method (struct libinput_device *device);
+int libinput_device_config_scroll_has_natural_scroll (struct libinput_device *device);
+int libinput_device_config_scroll_set_method (struct libinput_device *device, enum libinput_config_scroll_method method);
+int libinput_device_config_scroll_set_natural_scroll_enabled (struct libinput_device *device, int enable);
+int libinput_device_config_tap_get_finger_count (struct libinput_device *device);
+int libinput_device_config_tap_set_drag_enabled (struct libinput_device *device, enum libinput_config_drag_state enable);
+int libinput_device_config_tap_set_drag_lock_enabled (struct libinput_device *device, enum libinput_config_drag_lock_state enable);
+int libinput_device_config_tap_set_enabled (struct libinput_device *device, enum libinput_config_tap_state enable);
+struct libinput_device_group *libinput_device_get_device_group (struct libinput_device *device);
+unsigned int libinput_device_get_id_product (struct libinput_device *device);
+unsigned int libinput_device_get_id_vendor (struct libinput_device *device);
+const char *libinput_device_get_name (struct libinput_device *device);
+struct udev_device *libinput_device_get_udev_device (struct libinput_device *device);
+int libinput_device_keyboard_has_key (struct libinput_device *device, uint32_t code);
+int libinput_device_switch_has_switch (struct libinput_device *device, enum libinput_switch sw);
+
+struct udev_device *udev_device_unref (struct udev_device *udev_device);
+const char *udev_device_get_property_value (struct udev_device *udev_device, const char *key);
+struct udev_list_entry *udev_device_get_properties_list_entry (struct udev_device *udev_device);
+struct udev_list_entry *udev_list_entry_get_next (struct udev_list_entry *list_entry);
+const char *udev_list_entry_get_name (struct udev_list_entry *list_entry);
+const char *udev_list_entry_get_value (struct udev_list_entry *list_entry);
+
+#define udev_list_entry_foreach(list_entry, first_entry) \
+  for (list_entry = first_entry; list_entry; list_entry = udev_list_entry_get_next (list_entry))
diff --git a/src/compat/libintl.h b/src/compat/libintl.h
new file mode 100644
index 0000000..5327411
--- /dev/null
+++ b/src/compat/libintl.h
@@ -0,0 +1,23 @@
+/*
+ * Termux Launcher: stand-in for <libintl.h>.
+ *
+ * Bionic has no gettext, and Termux's glib (built with its own stubs) does not link a libintl
+ * either, so no message catalog is ever read on the device. These are the calls <glib/gi18n.h>
+ * and phoc's main() name, answering with the untranslated text.
+ */
+#pragma once
+
+#include <stddef.h>
+
+static inline char *gettext (const char *msgid) { return (char *) msgid; }
+static inline char *dgettext (const char *domain, const char *msgid) { return (char *) msgid; }
+static inline char *dcgettext (const char *domain, const char *msgid, int category) { return (char *) msgid; }
+static inline char *ngettext (const char *msgid, const char *msgid_plural, unsigned long n) {
+  return (char *) (n == 1 ? msgid : msgid_plural);
+}
+static inline char *dngettext (const char *domain, const char *msgid, const char *msgid_plural, unsigned long n) {
+  return (char *) (n == 1 ? msgid : msgid_plural);
+}
+static inline char *textdomain (const char *domain) { return (char *) domain; }
+static inline char *bindtextdomain (const char *domain, const char *dir) { return (char *) dir; }
+static inline char *bind_textdomain_codeset (const char *domain, const char *codeset) { return (char *) codeset; }

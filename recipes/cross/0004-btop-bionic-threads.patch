+#ifdef __ANDROID__
+//* Bionic has no pthread_timedjoin_np: join from a helper thread and give up on the helper when the
+//* time runs out. Only used on the way out, where an abandoned blocked thread costs nothing.
+static int timed_join(pthread_t thread, int timeout_ms) {
+	static std::atomic<bool> done{false};   //? static: the helper may outlive the call
+	std::thread([thread] { pthread_join(thread, nullptr); done.store(true); }).detach();
+	for (int waited = 0; waited < timeout_ms and not done.load(); waited += 10) sleep_ms(10);
+	return done.load() ? 0 : -1;
+}
+#endif

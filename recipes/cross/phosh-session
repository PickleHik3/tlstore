#!/bin/sh
# phosh-session — runs phosh on the launcher's display: phoc nested on it as an X11 client, phosh
# as phoc's shell. The archive's exe= (docs/PHOSH.md, "Session"); the store's wrapper
# ~/.local/bin/phosh-session execs it, and the launcher's Desktops entry runs it too.
#
#   phosh-session          run the session on the launcher's display (phoc runs as a child)
#   phosh-session stop     end it: phoc, phosh and tl-feedbackd go (nothing else of the launcher's)
#
# The display is the launcher's: its Desktops entry opens the Display window and starts the server
# before it runs this, and nothing from a shell can open that window. Run from a terminal with no
# Display window open, phoc cannot connect and this says so.
#
# PHOSH_SCALE, if set, overrides the output scale (phoc reads it); the settings app's display-scale
# supplies it when it is not set.
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
tmp="${TERMUX_TMP_PREFIX:-$PREFIX/tmp}"

if [ "${1:-}" = stop ]; then
    # phosh's own processes only. The session that runs this script ends by itself once phoc is
    # gone; the launcher's display and its other desktops are left alone.
    pids=$(pgrep -x 'phoc|phosh|tl-feedbackd' 2>/dev/null || true)
    [ -n "$pids" ] || exit 0
    # shellcheck disable=SC2086 # one word per pid
    kill -TERM $pids 2>/dev/null || true
    sleep 1
    for pid in $pids; do
        # Only one that is still there a second after its TERM.
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done
    exit 0
fi

# This archive's root: <root>/bin/phosh-session, found through any symlinks (the store exposes the
# exe as ~/.local/bin/phosh-session). A readlink loop, as POSIX sh has no readlink -f.
self=$0
case "$self" in
    */*) ;;
    *) self=$(command -v "$self" 2>/dev/null || echo "$self") ;;
esac
n=0
while [ -L "$self" ] && [ "$n" -lt 20 ]; do
    n=$((n + 1))
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self="${self%/*}/$link" ;;
    esac
done
app=$(cd "${self%/*}/.." 2>/dev/null && pwd) || app=
[ -n "$app" ] && [ -d "$app/share/glib-2.0/schemas" ] || app="$HOME/.local/lib/phosh"

runtime="${XDG_RUNTIME_DIR:-$tmp}"
sockets="$tmp/.X11-unix"

# A crashed phoc leaves wayland-0 and its lock behind, and the next one then refuses to start.
# They are stale unless a phoc is running.
if ! pgrep -x phoc >/dev/null 2>&1; then
    rm -f "$runtime/wayland-0" "$runtime/wayland-0.lock"
fi

# The launcher's session bus, shared with the launcher and the rest of its desktop, unless the
# launcher already gave this session one (its dbus-launch wrap).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$sockets/termux-launcher-bus" ]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=$sockets/termux-launcher-bus"
    export DBUS_SESSION_BUS_ADDRESS
fi

# The archive's schemas with its overrides, compiled here together with the system's
# org.gnome.desktop.* schemas: the overrides (90_tl's screensaver lock and screen keyboard, phosh's
# own desktop defaults) name those, and glib-compile-schemas drops an override of a schema it does
# not have. The archive's directory may not be writable to the session, so this is a directory of
# ours, compiled at every start; it comes first in the schema path, so its copies of the desktop
# schemas, with the overrides, are the ones read. If it does not compile, the archive's own
# compiled set (its schemas and overrides only) is used.
schemas="${XDG_STATE_HOME:-$HOME/.local/state}/phosh/schemas"
mkdir -p "$schemas"
rm -f "$schemas"/*.xml "$schemas"/*.override "$schemas/gschemas.compiled"
cp "$PREFIX"/share/glib-2.0/schemas/org.gnome.desktop*.xml "$schemas/" 2>/dev/null || true
cp "$app"/share/glib-2.0/schemas/*.xml "$app"/share/glib-2.0/schemas/*.override "$schemas/" 2>/dev/null || true
if glib-compile-schemas "$schemas" 2>/dev/null; then
    GSETTINGS_SCHEMA_DIR="$schemas"
else
    GSETTINGS_SCHEMA_DIR="$app/share/glib-2.0/schemas"
fi

DISPLAY="${DISPLAY:-:0}"
XDG_RUNTIME_DIR="$runtime"
XDG_DATA_DIRS="$app/share:$PREFIX/share"
XDG_CURRENT_DESKTOP=Phosh
GSK_RENDERER=cairo
PATH="$app/bin:$PATH"
WLR_BACKEND=x11
WLR_X11_OUTPUTS=1
WLR_NO_HARDWARE_CURSORS=1
export DISPLAY XDG_RUNTIME_DIR XDG_DATA_DIRS GSETTINGS_SCHEMA_DIR XDG_CURRENT_DESKTOP \
    GSK_RENDERER PATH WLR_BACKEND WLR_X11_OUTPUTS WLR_NO_HARDWARE_CURSORS

# Output scale: PHOSH_SCALE from the environment wins; else phosh-mobile-settings' display-scale
# (a double, 0.0 = automatic, which phoc works out itself).
if [ -z "${PHOSH_SCALE:-}" ]; then
    scale=$(gsettings get mobi.phosh.MobileSettings display-scale 2>/dev/null || true)
    case "$scale" in
        ''|0|0.0|0.00) ;;
        *[!0-9.]*) ;;
        *) PHOSH_SCALE="$scale" ;;
    esac
fi
[ -z "${PHOSH_SCALE:-}" ] || export PHOSH_SCALE

# A TERM (the launcher's stop), INT or HUP is passed on to phoc. The trap is set before anything
# is started, so a signal that comes early ends the session instead of orphaning tl-feedbackd.
pid=
fbd=
stopping=
# shellcheck disable=SC2329 # run by the trap
on_signal() {
    stopping=1
    [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
}
trap on_signal TERM INT HUP

# tl-feedbackd (#13): answers org.sigxcpu.Feedback on the session bus, so phosh's and the apps'
# feedback events (libfeedback) become launcherctl vibrate calls. Started before phoc; if one is
# already on the bus it loses the name and exits. Its D-Bus activation file is in the archive's
# share/dbus-1/services/, found through XDG_DATA_DIRS, for a libfeedback that asks before this runs.
if [ -x "$app/bin/tl-feedbackd" ]; then
    "$app/bin/tl-feedbackd" 2>>"${XDG_STATE_HOME:-$HOME/.local/state}/phosh/tl-feedbackd.log" &
    fbd=$!
fi

if [ -n "$stopping" ]; then
    [ -z "$fbd" ] || kill "$fbd" 2>/dev/null || true
    exit 143
fi

# phoc runs as a child so that a connection failure can be told apart and explained.
log="${XDG_STATE_HOME:-$HOME/.local/state}/phosh/phoc.log"
phoc -E phosh 2>"$log" &
pid=$!
# A signal that came between the start and the line above had no pid to pass on.
[ -z "$stopping" ] || kill "$pid" 2>/dev/null || true
rc=0
wait "$pid" || rc=$?
# A signal interrupts the first wait; wait again for the child to be gone.
while kill -0 "$pid" 2>/dev/null; do wait "$pid" || rc=$?; done
[ -z "$fbd" ] || kill "$fbd" 2>/dev/null || true
cat "$log" >&2
if [ "$rc" -ne 0 ] && grep -q 'xcb connection' "$log" 2>/dev/null; then
    echo "phosh-session: open Display in the launcher first, or tap Phosh under Desktops" >&2
fi
exit "$rc"

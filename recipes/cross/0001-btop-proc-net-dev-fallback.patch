+	//* Read the received and transmitted byte counters of every interface from /proc/net/dev
+	//? The same counters as /sys/class/net/<iface>/statistics/{rx,tx}_bytes, for kernels or
+	//? security policies (Android's shell uid, for one) that refuse the sysfs files but not procfs.
+	static auto proc_net_dev() -> std::unordered_map<string, array<uint64_t, 2>> {
+		std::unordered_map<string, array<uint64_t, 2>> counters;
+		ifstream devread(Shared::procPath / "net/dev");
+		for (string line; getline(devread, line);) {
+			//? "  wlan0: <rx bytes> <packets> <errs> <drop> <fifo> <frame> <compressed> <multicast> <tx bytes> ..."
+			const auto colon = line.find(':');
+			if (colon == string::npos) continue;
+			string iface = line.substr(0, colon);
+			iface.erase(0, iface.find_first_not_of(' '));
+			std::istringstream fields(line.substr(colon + 1));
+			uint64_t rx{}, tx{}, skip{};
+			if (fields >> rx >> skip >> skip >> skip >> skip >> skip >> skip >> skip >> tx)
+				counters[iface] = {rx, tx};
+		}
+		return counters;
+	}

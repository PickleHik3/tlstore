+    const LINKER: &str = "/apex/com.android.runtime/bin/linker64";
+
+    #[test]
+    fn the_linker_is_replaced_by_termux_execs_real_path() {
+        let real = std::env::current_exe().unwrap();
+        assert_eq!(own_exe_from(PathBuf::from(LINKER), Some(real.as_os_str())), real);
+        assert_eq!(own_exe_from(PathBuf::from("/system/bin/linker"), Some(real.as_os_str())), real);
+    }
+
+    #[test]
+    fn the_linker_stays_without_a_usable_real_path() {
+        let linker = PathBuf::from(LINKER);
+        assert_eq!(own_exe_from(linker.clone(), None), linker);
+        assert_eq!(own_exe_from(linker.clone(), Some(OsStr::new("serve"))), linker);
+        assert_eq!(own_exe_from(linker.clone(), Some(OsStr::new("/no/such/hc"))), linker);
+    }
+
+    #[test]
+    fn a_normal_path_is_unchanged() {
+        let real = std::env::current_exe().unwrap();
+        let hc = PathBuf::from("/data/data/com.termux/files/home/.local/lib/herdr-core/libexec/hc");
+        assert_eq!(own_exe_from(hc.clone(), Some(real.as_os_str())), hc);
+    }

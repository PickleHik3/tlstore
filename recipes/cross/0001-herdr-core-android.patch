+/// Why `hc update` must not download a release here, if it must not. On
+/// Android (Termux) hc is built for Bionic by the launcher's store, and
+/// upstream's Linux release would replace it with one that cannot run there.
+pub fn self_update_refused() -> Option<&'static str> {
+    if cfg!(target_os = "android") { Some("this hc was installed by tlstore, which keeps it up to date") } else { None }
+}
+
+/// This hc's own executable. On Android, termux-exec starts every program as
+/// `linker64 <path> args`, so `current_exe()` is the linker and
+/// `TERMUX_EXEC__PROC_SELF_EXE` holds the real path.
+pub fn own_exe() -> std::io::Result<std::path::PathBuf> {
+    let exe = std::env::current_exe()?;
+    if cfg!(target_os = "android") {
+        return Ok(own_exe_from(exe, std::env::var_os("TERMUX_EXEC__PROC_SELF_EXE").as_deref()));
+    }
+    Ok(exe)
+}
+
+/// The decision behind `own_exe`: a linker's path is replaced by `real` when
+/// that is an absolute path to an existing file.
+fn own_exe_from(exe: std::path::PathBuf, real: Option<&std::ffi::OsStr>) -> std::path::PathBuf {
+    let is_linker = matches!(exe.file_name().and_then(|n| n.to_str()), Some("linker" | "linker64"));
+    match real.map(std::path::Path::new) {
+        Some(real) if is_linker && real.is_absolute() && real.is_file() => real.to_path_buf(),
+        _ => exe,
+    }
+}
+
+#[cfg(test)]
+mod own_exe_tests {
+    use super::own_exe_from;
+    use std::ffi::OsStr;

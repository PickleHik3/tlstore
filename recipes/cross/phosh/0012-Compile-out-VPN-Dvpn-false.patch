From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@example.invalid>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH 12/16] Compile out VPN: -Dvpn=false

No VPN manager, tile or status icon (NetworkManager's).
---
 src/quick-settings.c     | 4 ++++
 src/shell.c              | 4 ++++
 src/ui/quick-settings.ui | 8 ++++++++
 src/ui/top-panel.ui      | 2 ++
 4 files changed, 18 insertions(+)

diff --git a/src/quick-settings.c b/src/quick-settings.c
index 3b7b2dd..73e7ac4 100644
--- a/src/quick-settings.c
+++ b/src/quick-settings.c
@@ -206,6 +206,7 @@ on_docked_clicked (PhoshQuickSettings *self, PhoshQuickSetting *child)
 }
 
 
+#if PHOSH_HAVE_VPN
 static void
 on_vpn_clicked (PhoshQuickSettings *self, PhoshQuickSetting *child)
 {
@@ -217,6 +218,7 @@ on_vpn_clicked (PhoshQuickSettings *self, PhoshQuickSetting *child)
 
   phosh_vpn_manager_toggle_last_connection (vpn_manager);
 }
+#endif
 
 
 static void
@@ -304,7 +306,9 @@ phosh_quick_settings_class_init (PhoshQuickSettingsClass *klass)
   gtk_widget_class_bind_template_callback (widget_class, on_feedback_clicked);
   gtk_widget_class_bind_template_callback (widget_class, on_torch_clicked);
   gtk_widget_class_bind_template_callback (widget_class, on_docked_clicked);
+#if PHOSH_HAVE_VPN
   gtk_widget_class_bind_template_callback (widget_class, on_vpn_clicked);
+#endif
 }
 
 
diff --git a/src/shell.c b/src/shell.c
index e3fd6e9..477487b 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -989,7 +989,9 @@ type_setup (void)
   g_type_ensure (PHOSH_TYPE_SYSTEM_MODAL);
   g_type_ensure (PHOSH_TYPE_SYSTEM_MODAL_DIALOG);
   g_type_ensure (PHOSH_TYPE_TORCH_INFO);
+#if PHOSH_HAVE_VPN
   g_type_ensure (PHOSH_TYPE_VPN_INFO);
+#endif
   g_type_ensure (PHOSH_TYPE_WIFI_INFO);
   g_type_ensure (PHOSH_TYPE_WWAN_INFO);
 }
@@ -2317,6 +2319,7 @@ phosh_shell_get_torch_manager (PhoshShell *self)
   return priv->torch_manager;
 }
 
+#if PHOSH_HAVE_VPN
 /**
  * phosh_shell_get_vpn_manager:
  * @self: The shell singleton
@@ -2339,6 +2342,7 @@ phosh_shell_get_vpn_manager (PhoshShell *self)
   g_return_val_if_fail (PHOSH_IS_VPN_MANAGER (priv->vpn_manager), NULL);
   return priv->vpn_manager;
 }
+#endif
 
 /**
  * phosh_shell_get_wwan:
diff --git a/src/ui/quick-settings.ui b/src/ui/quick-settings.ui
index 91f697c..4e1d64b 100644
--- a/src/ui/quick-settings.ui
+++ b/src/ui/quick-settings.ui
@@ -88,6 +88,7 @@
             <signal name="clicked" handler="on_docked_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
         </child>
+        <!-- tl-if vpn -->
         <child>
           <object class="PhoshQuickSetting">
             <property name="visible" bind-source="vpninfo" bind-property="present" bind-flags="sync-create"/>
@@ -97,6 +98,7 @@
             <signal name="clicked" handler="on_vpn_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
         </child>
+        <!-- tl-endif -->
       </object>
     </child>
   </template>
@@ -134,16 +136,22 @@
     <property name="visible">1</property>
     <property name="pixel-size">16</property>
   </object>
+  <!-- tl-if vpn -->
   <object class="PhoshVpnInfo" id="vpninfo">
     <property name="visible">1</property>
     <property name="pixel-size">16</property>
   </object>
+  <!-- tl-endif -->
+  <!-- tl-if networkmanager -->
   <object class="PhoshWifiStatusPage" id="wifi_status_page">
     <property name="visible">1</property>
   </object>
+  <!-- tl-endif -->
+  <!-- tl-if bluetooth -->
   <object class="PhoshBtStatusPage" id="bt_status_page">
     <property name="visible">1</property>
   </object>
+  <!-- tl-endif -->
   <object class="PhoshFeedbackStatusPage" id="feedback_status_page">
     <property name="visible">1</property>
   </object>
diff --git a/src/ui/top-panel.ui b/src/ui/top-panel.ui
index 9b4cea5..72175e9 100644
--- a/src/ui/top-panel.ui
+++ b/src/ui/top-panel.ui
@@ -254,6 +254,8 @@
                             <property name="child">vpn_info</property>
                           </object>
                         </child>
+                        <!-- tl-endif -->
+                        <!-- tl-if networkmanager -->
                         <child>
                           <object class="PhoshRevealer">
                             <property name="visible">1</property>

diff --git a/src/wifi-manager-none.c b/src/wifi-manager-none.c
new file mode 100644
index 0000000..b54a20c
--- /dev/null
+++ b/src/wifi-manager-none.c
@@ -0,0 +1,179 @@
+/*
+ * Copyright (C) 2019 Purism SPC
+ *               2025 Termux Launcher
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Author: Guido Günther <agx@sigxcpu.org>
+ */
+#define G_LOG_DOMAIN "phosh-wifi-manager"
+
+#include "phosh-config.h"
+
+#include "wifi-manager.h"
+
+/**
+ * PhoshWifiManager:
+ *
+ * Tracks the Wi-Fi status, without a backend
+ *
+ * This is the Wi-Fi manager of a build without NetworkManager (`-Dnetworkmanager=false`, the
+ * build that has no libnm). It has the properties of the NetworkManager one and answers as that
+ * one does when the daemon is not on the bus: no Wi-Fi hardware, so the Wi-Fi status icon and
+ * the Wi-Fi tile stay hidden. A backend that fills them in replaces this file.
+ */
+
+enum {
+  PROP_0,
+  PROP_ICON_NAME,
+  PROP_SSID,
+  PROP_ENABLED,
+  PROP_PRESENT,
+  PROP_IS_HOTSPOT_MASTER,
+  PROP_LAST_PROP
+};
+
+struct _PhoshWifiManager {
+  GObject parent;
+};
+G_DEFINE_TYPE (PhoshWifiManager, phosh_wifi_manager, G_TYPE_OBJECT);
+
+
+static void
+phosh_wifi_manager_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  switch (property_id) {
+  case PROP_ICON_NAME:
+    g_value_set_string (value, "network-wireless-disabled-symbolic");
+    break;
+  case PROP_SSID:
+    g_value_set_string (value, NULL);
+    break;
+  case PROP_ENABLED:
+  case PROP_PRESENT:
+  case PROP_IS_HOTSPOT_MASTER:
+    g_value_set_boolean (value, FALSE);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_wifi_manager_class_init (PhoshWifiManagerClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->get_property = phosh_wifi_manager_get_property;
+
+  g_object_class_install_property (
+    object_class, PROP_ICON_NAME,
+    g_param_spec_string ("icon-name", "", "", NULL,
+                         G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+  g_object_class_install_property (
+    object_class, PROP_SSID,
+    g_param_spec_string ("ssid", "", "", NULL,
+                         G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+  g_object_class_install_property (
+    object_class, PROP_ENABLED,
+    g_param_spec_boolean ("enabled", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+  g_object_class_install_property (
+    object_class, PROP_PRESENT,
+    g_param_spec_boolean ("present", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+  g_object_class_install_property (
+    object_class, PROP_IS_HOTSPOT_MASTER,
+    g_param_spec_boolean ("is-hotspot-master", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS));
+}
+
+
+static void
+phosh_wifi_manager_init (PhoshWifiManager *self)
+{
+}
+
+
+PhoshWifiManager *
+phosh_wifi_manager_new (void)
+{
+  return g_object_new (PHOSH_TYPE_WIFI_MANAGER, NULL);
+}
+
+
+guint8
+phosh_wifi_manager_get_strength (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), 0);
+
+  return 0;
+}
+
+
+const char *
+phosh_wifi_manager_get_icon_name (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), NULL);
+
+  return "network-wireless-disabled-symbolic";
+}
+
+
+const char *
+phosh_wifi_manager_get_ssid (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), NULL);
+
+  return NULL;
+}
+
+
+gboolean
+phosh_wifi_manager_get_enabled (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return FALSE;
+}
+
+
+void
+phosh_wifi_manager_set_enabled (PhoshWifiManager *self, gboolean enabled)
+{
+  g_return_if_fail (PHOSH_IS_WIFI_MANAGER (self));
+
+  g_debug ("No Wi-Fi backend, not switching Wi-Fi %s", enabled ? "on" : "off");
+}
+
+
+gboolean
+phosh_wifi_manager_get_present (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return FALSE;
+}
+
+
+gboolean
+phosh_wifi_manager_is_hotspot_master (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return FALSE;
+}
+
+
+void
+phosh_wifi_manager_set_hotspot_master (PhoshWifiManager *self, gboolean is_hotspot_master)
+{
+  g_return_if_fail (PHOSH_IS_WIFI_MANAGER (self));
+
+  g_debug ("No Wi-Fi backend, not %s a hotspot", is_hotspot_master ? "starting" : "stopping");
+}

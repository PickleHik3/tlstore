diff --git a/src/wifi-manager-tl.c b/src/wifi-manager-tl.c
new file mode 100644
index 0000000..ca221d8
--- /dev/null
+++ b/src/wifi-manager-tl.c
@@ -0,0 +1,299 @@
+/*
+ * Copyright (C) 2019 Purism SPC
+ *               2025 Termux Launcher
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Author: Guido Günther <agx@sigxcpu.org>
+ */
+#define G_LOG_DOMAIN "phosh-wifi-manager"
+
+#include "phosh-config.h"
+
+#include "wifi-manager.h"
+
+#include "tl-launcherctl.h"
+#include "util.h"
+
+/**
+ * PhoshWifiManager:
+ *
+ * Tracks the Wi-Fi status, from the launcher
+ *
+ * This is the Wi-Fi manager of a build with `-Dlauncherctl`. It shows what the `network`
+ * events of the launcher's watch stream say about Wi-Fi (on or off, connected, the SSID, the
+ * signal level 0 to 4) and only shows it: it cannot switch Wi-Fi, scan or connect. The Wi-Fi
+ * quick setting's long-press opens Android's Wi-Fi settings (see [class@PhoshTopPanel]).
+ * Without a launcher there is no Wi-Fi hardware to show, as with the manager of a build
+ * without a backend.
+ */
+
+enum {
+  PROP_0,
+  PROP_ICON_NAME,
+  PROP_SSID,
+  PROP_ENABLED,
+  PROP_PRESENT,
+  PROP_IS_HOTSPOT_MASTER,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+struct _PhoshWifiManager {
+  GObject        parent;
+
+  TlLauncherctl *client;
+
+  const char    *icon_name;
+  char          *ssid;
+  gboolean       enabled;
+  gboolean       present;
+  guint8         strength;
+};
+G_DEFINE_TYPE (PhoshWifiManager, phosh_wifi_manager, G_TYPE_OBJECT);
+
+
+static void
+update (PhoshWifiManager *self)
+{
+  JsonObject *network = NULL;
+  JsonObject *wifi = NULL;
+  gboolean present, enabled, connected;
+  const char *icon_name;
+  const char *ssid = NULL;
+  int level = 0;
+
+  if (tl_launcherctl_get_available (self->client))
+    network = tl_launcherctl_get_last (self->client, "network");
+  wifi = tl_json_get_object (network, "wifi");
+
+  present = wifi != NULL;
+  enabled = present && json_object_get_boolean_member_with_default (wifi, "enabled", FALSE);
+  connected = enabled && json_object_get_boolean_member_with_default (wifi, "connected", FALSE);
+  if (connected) {
+    ssid = json_object_get_string_member_with_default (wifi, "ssid", NULL);
+    level = CLAMP (json_object_get_int_member_with_default (wifi, "signal_level", 0), 0, 4);
+  }
+
+  if (!enabled)
+    icon_name = "network-wireless-disabled-symbolic";
+  else if (!connected)
+    icon_name = "network-wireless-offline-symbolic";
+  else
+    icon_name = phosh_util_get_icon_by_wifi_strength (level * 25, FALSE);
+
+  g_object_freeze_notify (G_OBJECT (self));
+
+  self->strength = connected ? level * 25 : 0;
+
+  if (self->icon_name != icon_name) {
+    self->icon_name = icon_name;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_ICON_NAME]);
+  }
+
+  if (g_strcmp0 (self->ssid, ssid)) {
+    g_free (self->ssid);
+    self->ssid = g_strdup (ssid);
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_SSID]);
+  }
+
+  if (self->enabled != enabled) {
+    self->enabled = enabled;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_ENABLED]);
+  }
+
+  if (self->present != present) {
+    self->present = present;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PRESENT]);
+  }
+
+  g_object_thaw_notify (G_OBJECT (self));
+}
+
+
+static void
+on_network_event (PhoshWifiManager *self, JsonObject *data, TlLauncherctl *client)
+{
+  update (self);
+}
+
+
+static void
+on_available_changed (PhoshWifiManager *self, GParamSpec *pspec, TlLauncherctl *client)
+{
+  update (self);
+}
+
+
+static void
+phosh_wifi_manager_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  PhoshWifiManager *self = PHOSH_WIFI_MANAGER (object);
+
+  switch (property_id) {
+  case PROP_ICON_NAME:
+    g_value_set_string (value, self->icon_name);
+    break;
+  case PROP_SSID:
+    g_value_set_string (value, self->ssid);
+    break;
+  case PROP_ENABLED:
+    g_value_set_boolean (value, self->enabled);
+    break;
+  case PROP_PRESENT:
+    g_value_set_boolean (value, self->present);
+    break;
+  case PROP_IS_HOTSPOT_MASTER:
+    g_value_set_boolean (value, FALSE);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_wifi_manager_constructed (GObject *object)
+{
+  PhoshWifiManager *self = PHOSH_WIFI_MANAGER (object);
+
+  G_OBJECT_CLASS (phosh_wifi_manager_parent_class)->constructed (object);
+
+  self->client = g_object_ref (tl_launcherctl_get_default ());
+  g_signal_connect_object (self->client, "event::network",
+                           G_CALLBACK (on_network_event), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (self->client, "notify::available",
+                           G_CALLBACK (on_available_changed), self, G_CONNECT_SWAPPED);
+  update (self);
+}
+
+
+static void
+phosh_wifi_manager_dispose (GObject *object)
+{
+  PhoshWifiManager *self = PHOSH_WIFI_MANAGER (object);
+
+  g_clear_object (&self->client);
+  g_clear_pointer (&self->ssid, g_free);
+
+  G_OBJECT_CLASS (phosh_wifi_manager_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_wifi_manager_class_init (PhoshWifiManagerClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->constructed = phosh_wifi_manager_constructed;
+  object_class->dispose = phosh_wifi_manager_dispose;
+  object_class->get_property = phosh_wifi_manager_get_property;
+
+  props[PROP_ICON_NAME] =
+    g_param_spec_string ("icon-name", "", "", NULL,
+                         G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+  props[PROP_SSID] =
+    g_param_spec_string ("ssid", "", "", NULL,
+                         G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+  props[PROP_ENABLED] =
+    g_param_spec_boolean ("enabled", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+  props[PROP_PRESENT] =
+    g_param_spec_boolean ("present", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+  props[PROP_IS_HOTSPOT_MASTER] =
+    g_param_spec_boolean ("is-hotspot-master", "", "", FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+}
+
+
+static void
+phosh_wifi_manager_init (PhoshWifiManager *self)
+{
+  self->icon_name = "network-wireless-disabled-symbolic";
+}
+
+
+PhoshWifiManager *
+phosh_wifi_manager_new (void)
+{
+  return g_object_new (PHOSH_TYPE_WIFI_MANAGER, NULL);
+}
+
+
+guint8
+phosh_wifi_manager_get_strength (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), 0);
+
+  return self->strength;
+}
+
+
+const char *
+phosh_wifi_manager_get_icon_name (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), NULL);
+
+  return self->icon_name;
+}
+
+
+const char *
+phosh_wifi_manager_get_ssid (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), NULL);
+
+  return self->ssid;
+}
+
+
+gboolean
+phosh_wifi_manager_get_enabled (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return self->enabled;
+}
+
+
+void
+phosh_wifi_manager_set_enabled (PhoshWifiManager *self, gboolean enabled)
+{
+  g_return_if_fail (PHOSH_IS_WIFI_MANAGER (self));
+
+  g_debug ("Wi-Fi is read-only here, not switching it %s", enabled ? "on" : "off");
+}
+
+
+gboolean
+phosh_wifi_manager_get_present (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return self->present;
+}
+
+
+gboolean
+phosh_wifi_manager_is_hotspot_master (PhoshWifiManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_WIFI_MANAGER (self), FALSE);
+
+  return FALSE;
+}
+
+
+void
+phosh_wifi_manager_set_hotspot_master (PhoshWifiManager *self, gboolean is_hotspot_master)
+{
+  g_return_if_fail (PHOSH_IS_WIFI_MANAGER (self));
+
+  g_debug ("No hotspot, not %s one", is_hotspot_master ? "starting" : "stopping");
+}

diff --git a/src/wwan/phosh-wwan-tl.c b/src/wwan/phosh-wwan-tl.c
new file mode 100644
index 0000000..5dd934d
--- /dev/null
+++ b/src/wwan/phosh-wwan-tl.c
@@ -0,0 +1,306 @@
+/*
+ * Copyright (C) 2025 Termux Launcher
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-wwan-tl"
+
+#include "phosh-config.h"
+
+#include "phosh-wwan-iface.h"
+#include "phosh-wwan-tl.h"
+#include "tl-launcherctl.h"
+
+/**
+ * PhoshWWanTl:
+ *
+ * Implementation of the [iface@Phosh.WWan] interface for the launcher
+ *
+ * It shows what the `network` events of the launcher's watch stream say about the cellular
+ * connection (present, signal level 0 to 4, network type, mobile data on or off) and only shows
+ * it: the radio and the mobile data cannot be switched from here. The mobile quick setting's
+ * long-press opens Android's mobile-network settings.
+ */
+
+enum {
+  PROP_0,
+  PROP_SIGNAL_QUALITY,
+  PROP_ACCESS_TEC,
+  PROP_UNLOCKED,
+  PROP_SIM,
+  PROP_PRESENT,
+  PROP_ENABLED,
+  PROP_OPERATOR,
+  PROP_DATA_ENABLED,
+  PROP_HAS_DATA,
+  PROP_LAST_PROP,
+};
+
+struct _PhoshWWanTl {
+  PhoshWWanManager parent;
+
+  TlLauncherctl   *client;
+
+  guint            signal_quality;
+  const char      *access_tec;
+  gboolean         present;
+  gboolean         data_enabled;
+};
+
+static void phosh_wwan_tl_interface_init (PhoshWWanInterface *iface);
+G_DEFINE_TYPE_WITH_CODE (PhoshWWanTl, phosh_wwan_tl, PHOSH_TYPE_WWAN_MANAGER,
+                         G_IMPLEMENT_INTERFACE (PHOSH_TYPE_WWAN,
+                                                phosh_wwan_tl_interface_init))
+
+
+/* The launcher says what Android says (LTE, NR, HSPA, ...); phosh shows 2G to 5G. */
+static const char *
+access_tec_from_network_type (const char *type)
+{
+  static const struct {
+    const char *type;
+    const char *tec;
+  } map[] = {
+    { "NR", "5G" },
+    { "LTE", "4G" },
+    { "LTE_CA", "4G" },
+    { "UMTS", "3G" },
+    { "HSDPA", "3G" },
+    { "HSUPA", "3G" },
+    { "HSPA", "3G" },
+    { "HSPAP", "3G" },
+    { "TD_SCDMA", "3G" },
+    { "EVDO_0", "3G" },
+    { "EVDO_A", "3G" },
+    { "EVDO_B", "3G" },
+    { "GPRS", "2G" },
+    { "EDGE", "2G" },
+    { "GSM", "2G" },
+    { "CDMA", "2G" },
+    { "1XRTT", "2G" },
+    { "IDEN", "2G" },
+  };
+
+  if (!type)
+    return NULL;
+
+  for (guint i = 0; i < G_N_ELEMENTS (map); i++) {
+    if (!g_ascii_strcasecmp (type, map[i].type))
+      return map[i].tec;
+  }
+
+  return NULL;
+}
+
+
+static void
+update (PhoshWWanTl *self)
+{
+  JsonObject *network = NULL;
+  JsonObject *cellular = NULL;
+  gboolean present, data_enabled;
+  guint quality = 0;
+  const char *tec = NULL;
+
+  if (tl_launcherctl_get_available (self->client))
+    network = tl_launcherctl_get_last (self->client, "network");
+  cellular = tl_json_get_object (network, "cellular");
+
+  present = cellular && json_object_get_boolean_member_with_default (cellular, "present", FALSE);
+  data_enabled = present && json_object_get_boolean_member_with_default (cellular, "data_enabled",
+                                                                          FALSE);
+  if (present) {
+    quality = CLAMP (json_object_get_int_member_with_default (cellular, "signal_level", 0),
+                     0, 4) * 25;
+    tec = access_tec_from_network_type (
+      json_object_get_string_member_with_default (cellular, "network_type", NULL));
+  }
+
+  g_object_freeze_notify (G_OBJECT (self));
+
+  if (self->signal_quality != quality) {
+    self->signal_quality = quality;
+    g_object_notify (G_OBJECT (self), "signal-quality");
+  }
+  if (self->access_tec != tec) {
+    self->access_tec = tec;
+    g_object_notify (G_OBJECT (self), "access-tec");
+  }
+  if (self->data_enabled != data_enabled) {
+    self->data_enabled = data_enabled;
+    g_object_notify (G_OBJECT (self), "data-enabled");
+    g_object_notify (G_OBJECT (self), "has-data");
+  }
+  if (self->present != present) {
+    self->present = present;
+    /* A modem with a SIM that is unlocked, and the radio on: that is all Android lets us see */
+    g_object_notify (G_OBJECT (self), "present");
+    g_object_notify (G_OBJECT (self), "sim");
+    g_object_notify (G_OBJECT (self), "unlocked");
+    g_object_notify (G_OBJECT (self), "enabled");
+  }
+
+  g_object_thaw_notify (G_OBJECT (self));
+}
+
+
+static void
+on_network_event (PhoshWWanTl *self, JsonObject *data, TlLauncherctl *client)
+{
+  update (self);
+}
+
+
+static void
+on_available_changed (PhoshWWanTl *self, GParamSpec *pspec, TlLauncherctl *client)
+{
+  update (self);
+}
+
+
+static void
+phosh_wwan_tl_get_property (GObject    *object,
+                            guint       property_id,
+                            GValue     *value,
+                            GParamSpec *pspec)
+{
+  PhoshWWanTl *self = PHOSH_WWAN_TL (object);
+
+  switch (property_id) {
+  case PROP_SIGNAL_QUALITY:
+    g_value_set_int (value, self->signal_quality);
+    break;
+  case PROP_ACCESS_TEC:
+    g_value_set_string (value, self->access_tec);
+    break;
+  case PROP_UNLOCKED:
+  case PROP_SIM:
+  case PROP_PRESENT:
+  case PROP_ENABLED:
+    g_value_set_boolean (value, self->present);
+    break;
+  case PROP_OPERATOR:
+    g_value_set_string (value, NULL);
+    break;
+  case PROP_DATA_ENABLED:
+  case PROP_HAS_DATA:
+    g_value_set_boolean (value, self->data_enabled);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_wwan_tl_constructed (GObject *object)
+{
+  PhoshWWanTl *self = PHOSH_WWAN_TL (object);
+
+  G_OBJECT_CLASS (phosh_wwan_tl_parent_class)->constructed (object);
+
+  self->client = g_object_ref (tl_launcherctl_get_default ());
+  g_signal_connect_object (self->client, "event::network",
+                           G_CALLBACK (on_network_event), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (self->client, "notify::available",
+                           G_CALLBACK (on_available_changed), self, G_CONNECT_SWAPPED);
+  update (self);
+}
+
+
+static void
+phosh_wwan_tl_dispose (GObject *object)
+{
+  PhoshWWanTl *self = PHOSH_WWAN_TL (object);
+
+  g_clear_object (&self->client);
+
+  G_OBJECT_CLASS (phosh_wwan_tl_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_wwan_tl_class_init (PhoshWWanTlClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->constructed = phosh_wwan_tl_constructed;
+  object_class->dispose = phosh_wwan_tl_dispose;
+  object_class->get_property = phosh_wwan_tl_get_property;
+
+  g_object_class_override_property (object_class, PROP_SIGNAL_QUALITY, "signal-quality");
+  g_object_class_override_property (object_class, PROP_ACCESS_TEC, "access-tec");
+  g_object_class_override_property (object_class, PROP_UNLOCKED, "unlocked");
+  g_object_class_override_property (object_class, PROP_SIM, "sim");
+  g_object_class_override_property (object_class, PROP_PRESENT, "present");
+  g_object_class_override_property (object_class, PROP_ENABLED, "enabled");
+  g_object_class_override_property (object_class, PROP_OPERATOR, "operator");
+  /* The base class has no data connection of its own to ask: it asks the object */
+  g_object_class_override_property (object_class, PROP_DATA_ENABLED, "data-enabled");
+  g_object_class_override_property (object_class, PROP_HAS_DATA, "has-data");
+}
+
+
+static void
+phosh_wwan_tl_init (PhoshWWanTl *self)
+{
+}
+
+
+static guint
+phosh_wwan_tl_get_signal_quality (PhoshWWan *wwan)
+{
+  g_return_val_if_fail (PHOSH_IS_WWAN_TL (wwan), 0);
+
+  return PHOSH_WWAN_TL (wwan)->signal_quality;
+}
+
+
+static const char *
+phosh_wwan_tl_get_access_tec (PhoshWWan *wwan)
+{
+  g_return_val_if_fail (PHOSH_IS_WWAN_TL (wwan), NULL);
+
+  return PHOSH_WWAN_TL (wwan)->access_tec;
+}
+
+
+static gboolean
+phosh_wwan_tl_is_present (PhoshWWan *wwan)
+{
+  g_return_val_if_fail (PHOSH_IS_WWAN_TL (wwan), FALSE);
+
+  return PHOSH_WWAN_TL (wwan)->present;
+}
+
+
+static const char *
+phosh_wwan_tl_get_operator (PhoshWWan *wwan)
+{
+  g_return_val_if_fail (PHOSH_IS_WWAN_TL (wwan), NULL);
+
+  return NULL;
+}
+
+
+static void
+phosh_wwan_tl_interface_init (PhoshWWanInterface *iface)
+{
+  iface->get_signal_quality = phosh_wwan_tl_get_signal_quality;
+  iface->get_access_tec = phosh_wwan_tl_get_access_tec;
+  /* The SIM is there, unlocked and the radio on whenever the modem is */
+  iface->is_unlocked = phosh_wwan_tl_is_present;
+  iface->has_sim = phosh_wwan_tl_is_present;
+  iface->is_present = phosh_wwan_tl_is_present;
+  iface->is_enabled = phosh_wwan_tl_is_present;
+  iface->get_operator = phosh_wwan_tl_get_operator;
+}
+
+
+PhoshWWanTl *
+phosh_wwan_tl_new (void)
+{
+  return g_object_new (PHOSH_TYPE_WWAN_TL, NULL);
+}

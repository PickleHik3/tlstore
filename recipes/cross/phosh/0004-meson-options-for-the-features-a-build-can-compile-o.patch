+       type: 'boolean', value: true,
+       description: 'Build the polkit authentication agent')
+
+option('logind',
+       type: 'boolean', value: true,
+       description: 'Build the logind session, inhibit and idle/suspend integration (libsystemd or libelogind)')
+
+option('osk',
+       type: 'boolean', value: true,
+       description: 'Build the on-screen keyboard manager (the sm.puri.OSK0 service)')
+
+option('eds',
+       type: 'boolean', value: true,
+       description: 'Build the evolution-data-server calendar server and the calendar plugins')
+
+option('calls',
+       type: 'boolean', value: true,
+       description: 'Build phone calls: callaudiod-style call handling, libcall-ui widgets, emergency calls, cell broadcasts')
+
+option('bluetooth',
+       type: 'boolean', value: true,
+       description: 'Build the Bluetooth manager and status page (gnome-bluetooth)')
+
+option('location',
+       type: 'boolean', value: true,
+       description: 'Build the location (GeoClue) manager and its quick setting')
+
+option('vpn',
+       type: 'boolean', value: true,
+       description: 'Build the VPN manager')
+
+option('hotspot',
+       type: 'boolean', value: true,
+       description: 'Build the Wi-Fi hotspot quick setting')
+
+option('networkmanager',
+       type: 'boolean', value: true,
+       description: 'Build against libnm: Wi-Fi, connectivity, network authentication agent. Without it the Wi-Fi manager reports no Wi-Fi')
+
+option('modemmanager',
+       type: 'boolean', value: true,

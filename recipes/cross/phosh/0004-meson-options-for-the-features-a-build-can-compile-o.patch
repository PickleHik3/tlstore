diff --git a/src/ui/meson.build b/src/ui/meson.build
new file mode 100644
index 0000000..6461130
--- /dev/null
+++ b/src/ui/meson.build
@@ -0,0 +1,28 @@
+# GtkBuilder files that name objects of features the tl patch set can compile out are passed
+# through tools/tl-ui-filter, which drops the blocks of the features that are off. The result is in
+# this directory of the build tree, where phosh.gresources.xml finds it before the source's own.
+tl_ui_off = []
+foreach feature, enabled : {
+  'bluetooth': have_bluetooth,
+  'calls': have_calls,
+  'location': have_location,
+  'lockscreen': have_lockscreen,
+  'networkmanager': have_networkmanager,
+  'vpn': have_vpn,
+}
+  if not enabled
+    tl_ui_off += feature
+  endif
+endforeach
+
+tl_ui_filter = find_program(meson.project_source_root() / 'tools' / 'tl-ui-filter')
+
+tl_filtered_uis = []
+foreach ui : ['power-menu.ui', 'quick-settings.ui', 'top-panel.ui']
+  tl_filtered_uis += custom_target(
+    'filtered-' + ui,
+    input: ui,
+    output: ui,
+    command: [tl_ui_filter, '@INPUT@', '@OUTPUT@', tl_ui_off],
+  )
+endforeach

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@example.invalid>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH] Compile out the lock screen: -Dlockscreen=false

No lock screen, shields, keypad, PIN entry, authentication (PAM) or lock-screen plugins. The
lockscreen manager stays as the object the rest of phosh asks, and never locks: phosh starts
unlocked and stays so. The lock buttons of the top panel and the power menu are gone.

diff --git a/src/lockscreen-manager.c b/src/lockscreen-manager.c
index 0ee3fa6..b4cfc08 100644
--- a/src/lockscreen-manager.c
+++ b/src/lockscreen-manager.c
@@ -9,11 +9,15 @@
 
 #define G_LOG_DOMAIN "phosh-lockscreen-manager"
 
+#include "phosh-config.h"
+
 #include "background-cache.h"
 #include "background-image.h"
 #include "lockscreen-manager-priv.h"
-#include "lockscreen-priv.h"
-#include "lockshield.h"
+#if PHOSH_HAVE_LOCKSCREEN
+# include "lockscreen-priv.h"
+# include "lockshield.h"
+#endif
 #include "monitor-manager.h"
 #include "monitor/monitor.h"
 #include "phosh-wayland.h"
@@ -80,6 +84,7 @@ struct _PhoshLockscreenManager {
 G_DEFINE_TYPE (PhoshLockscreenManager, phosh_lockscreen_manager, G_TYPE_OBJECT)
 
 
+#if PHOSH_HAVE_LOCKSCREEN
 static void
 on_background_cache_fetch_ready (GObject *source_object, GAsyncResult *res, gpointer data)
 {
@@ -415,6 +420,19 @@ lockscreen_lock (PhoshLockscreenManager *self)
 }
 
 
+#else
+/*
+ * Built without a lock screen (-Dlockscreen=false): there is nothing to put on the outputs, so the
+ * shell stays unlocked. Asking for a lock is not an error, it just does not happen.
+ */
+static void
+lockscreen_lock (PhoshLockscreenManager *self)
+{
+  g_message ("Locking is not built in, staying unlocked");
+}
+
+#endif
+
 static void
 phosh_lockscreen_manager_set_property (GObject      *object,
                                        guint         property_id,
@@ -562,6 +580,7 @@ phosh_lockscreen_manager_class_init (PhoshLockscreenManagerClass *klass)
 static void
 phosh_lockscreen_manager_init (PhoshLockscreenManager *self)
 {
+#if PHOSH_HAVE_LOCKSCREEN
   self->bg_settings = g_settings_new (SCREENSAVER_SETTINGS);
 
   g_object_connect (self->bg_settings,
@@ -573,9 +592,11 @@ phosh_lockscreen_manager_init (PhoshLockscreenManager *self)
                     self,
                     NULL);
   on_picture_params_changed (self);
+#endif
 }
 
 
+#if PHOSH_HAVE_CALLS
 PhoshLockscreenManager *
 phosh_lockscreen_manager_new (PhoshCallsManager *calls_manager)
 {
@@ -607,8 +628,10 @@ phosh_lockscreen_manager_set_locked (PhoshLockscreenManager *self, gboolean lock
 
   if (lock)
     lockscreen_lock (self);
+#if PHOSH_HAVE_LOCKSCREEN
   else
     on_lockscreen_unlock (self, PHOSH_LOCKSCREEN (self->lockscreen));
+#endif
 }
 
 
@@ -631,7 +654,11 @@ phosh_lockscreen_manager_get_page (PhoshLockscreenManager *self)
 {
   g_return_val_if_fail (PHOSH_IS_LOCKSCREEN_MANAGER (self), FALSE);
 
+#if PHOSH_HAVE_LOCKSCREEN
   return phosh_lockscreen_get_page (self->lockscreen);
+#else
+  return PHOSH_LOCKSCREEN_PAGE_INFO;
+#endif
 }
 
 
@@ -653,10 +680,14 @@ phosh_lockscreen_manager_set_page  (PhoshLockscreenManager *self,
   if (!self->lockscreen)
     return FALSE;
 
+#if PHOSH_HAVE_LOCKSCREEN
   g_return_val_if_fail (PHOSH_IS_LOCKSCREEN (self->lockscreen), FALSE);
 
   phosh_lockscreen_set_page (self->lockscreen, page);
   return TRUE;
+#else
+  return FALSE;
+#endif
 }
 
 
@@ -676,7 +707,11 @@ phosh_lockscreen_manager_get_lockscreen (PhoshLockscreenManager *self)
   if (!self->lockscreen)
     return NULL;
 
+#if PHOSH_HAVE_LOCKSCREEN
   g_return_val_if_fail (PHOSH_IS_LOCKSCREEN (self->lockscreen), FALSE);
 
   return self->lockscreen;
+#else
+  return NULL;
+#endif
 }
diff --git a/src/shell.c b/src/shell.c
index 0cf2956..31afe52 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -1325,11 +1325,13 @@ phosh_shell_action_map_iface_init (GActionMapInterface *iface)
 }
 
 
+#if PHOSH_HAVE_LOCKSCREEN
 static GType
 get_lockscreen_type (PhoshShell *self)
 {
   return PHOSH_TYPE_LOCKSCREEN;
 }
+#endif
 
 /* }}} */
 /* {{{ GObject init */
@@ -1346,7 +1348,9 @@ phosh_shell_class_init (PhoshShellClass *klass)
   object_class->set_property = phosh_shell_set_property;
   object_class->get_property = phosh_shell_get_property;
 
+#if PHOSH_HAVE_LOCKSCREEN
   klass->get_lockscreen_type = get_lockscreen_type;
+#endif
 
   type_setup ();
 
diff --git a/src/top-panel.c b/src/top-panel.c
index 290e260..f690379 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -80,7 +80,9 @@ typedef struct _PhoshTopPanel {
   GtkWidget *btn_power;
   GtkWidget *menu_system;
   GtkWidget *box_clock;
+#if PHOSH_HAVE_LOCKSCREEN
   GtkWidget *btn_lock;
+#endif
   GtkWidget *lbl_clock2;
   GtkWidget *lbl_date;
 
@@ -941,7 +943,9 @@ phosh_top_panel_class_init (PhoshTopPanelClass *klass)
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, box);
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, box_clock);
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, box_top_bar);
+#if PHOSH_HAVE_LOCKSCREEN
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, btn_lock);
+#endif
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, btn_power);
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, click_gesture);
   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, launch_settings_revealer);
diff --git a/src/ui/power-menu.ui b/src/ui/power-menu.ui
index 635ba76..1e802a0 100644
--- a/src/ui/power-menu.ui
+++ b/src/ui/power-menu.ui
@@ -128,6 +128,7 @@
                 <property name="top-attach">0</property>
               </packing>
             </child>
+            <!-- tl-if lockscreen -->
             <child>
               <object class="GtkButton" id="btn_lock">
                 <property name="visible">1</property>
@@ -169,6 +170,7 @@
                 <property name="top-attach">0</property>
               </packing>
             </child>
+            <!-- tl-endif -->
             <child>
               <object class="GtkButton" id="btn_screenshot">
                 <property name="visible">1</property>
diff --git a/src/ui/top-panel.ui b/src/ui/top-panel.ui
index 2b45e03..34a5bc7 100644
--- a/src/ui/top-panel.ui
+++ b/src/ui/top-panel.ui
@@ -135,6 +135,7 @@
             <style>
               <class name="phosh-clock-box"/>
             </style>
+            <!-- tl-if lockscreen -->
             <child>
               <object class="GtkButton" id="btn_lock">
                 <property name="visible" bind-source="PhoshTopPanel" bind-property="on-lockscreen" bind-flags="sync-create|invert-boolean"/>
@@ -150,6 +151,7 @@
                 </child>
               </object>
             </child>
+            <!-- tl-endif -->
             <child type="center">
               <object class="GtkBox">
                 <property name="visible">1</property>

+/**
+ * tl_json_get_object:
+ * @object: (nullable): a JSON object
+ * @member: the member to look up
+ *
+ * Returns: (transfer none) (nullable): the member when it is an object, else %NULL. Unlike
+ * json_object_get_object_member() it logs nothing for a member that is missing or another type.
+ */
+static inline JsonObject *
+tl_json_get_object (JsonObject *object, const char *member)
+{
+  JsonNode *node = object ? json_object_get_member (object, member) : NULL;
+
+  return (node && JSON_NODE_HOLDS_OBJECT (node)) ? json_node_get_object (node) : NULL;
+}

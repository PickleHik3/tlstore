From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@example.invalid>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH] Long-press of the Wi-Fi, mobile and battery quick settings:
 Android's Settings

With -Dlauncherctl the panels those quick settings name (wifi and wwan of launch-mobile-panel,
power of launch-panel) are Android's Settings pages: open_settings_panel POSTs
/v1/settings/open {"page":"wifi"|"mobile"|"battery"} and folds the top panel when the launcher
has answered. Other panels open as before. The torch quick setting's long-press also names the
power panel, so it opens Android's battery page.

diff --git a/src/top-panel.c b/src/top-panel.c
index f690379..8307f28 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -23,6 +23,9 @@
 #include "session-manager.h"
 #include "settings.h"
 #include "status-icons-box.h"
+#if PHOSH_HAVE_LAUNCHERCTL
+# include "tl-launcherctl.h"
+#endif
 #include "top-panel.h"
 #include "top-panel-bg.h"
 #include "arrow.h"
@@ -320,12 +323,65 @@ on_open_panel_ready (GObject *source_object, GAsyncResult *res, gpointer user_da
 }
 
 
+#if PHOSH_HAVE_LAUNCHERCTL
+static void
+on_android_settings_opened (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  PhoshTopPanel *self = PHOSH_TOP_PANEL (user_data);
+  g_autoptr (GError) err = NULL;
+  g_autoptr (JsonObject) reply = NULL;
+
+  reply = tl_launcherctl_post_finish (TL_LAUNCHERCTL (source_object), res, &err);
+  if (!reply) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to open Android's settings: %s", err->message);
+    return;
+  }
+
+  phosh_top_panel_fold (self);
+}
+
+
+/*
+ * The panels the long-press of the Wi-Fi, mobile and battery quick settings name are Android's
+ * Settings pages here: POST /v1/settings/open with wifi, mobile or battery. Returns %FALSE for
+ * the other panels, which open as usual.
+ */
+static gboolean
+open_android_settings (PhoshTopPanel *self, gboolean mobile, const char *panel)
+{
+  g_autofree char *body = NULL;
+  const char *page = NULL;
+
+  if (mobile && !g_strcmp0 (panel, "wifi"))
+    page = "wifi";
+  else if (mobile && !g_strcmp0 (panel, "wwan"))
+    page = "mobile";
+  else if (!mobile && !g_strcmp0 (panel, "power"))
+    page = "battery";
+
+  if (!page)
+    return FALSE;
+
+  body = g_strdup_printf ("{\"page\":\"%s\"}", page);
+  tl_launcherctl_post_async (tl_launcherctl_get_default (), "/v1/settings/open", body,
+                             self->cancel, on_android_settings_opened, self);
+  return TRUE;
+}
+#endif
+
+
 static void
 open_settings_panel (PhoshTopPanel *self, gboolean mobile, const char *panel, GVariant *params)
 {
   if (self->on_lockscreen)
     return;
 
+#if PHOSH_HAVE_LAUNCHERCTL
+  if (open_android_settings (self, mobile, panel))
+    return;
+#endif
+
   phosh_util_open_settings_panel (panel,
                                   params,
                                   mobile,

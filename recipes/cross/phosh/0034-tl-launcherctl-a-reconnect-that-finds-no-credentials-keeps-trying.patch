From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PickleHik3 <noreply@example.invalid>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH 34/34] tl-launcherctl: a reconnect that finds no credentials keeps
 trying

start_stream() gave up for good whenever ~/.launcherctl/endpoint or token was missing, and it
also runs for every reconnect. A launcher restart rewrites those files while phosh reconnects, so
a reconnect in that window left phosh offline for the rest of the session, against the client's
own doc ("the files are read again at every attempt"). Now only the first start gives up (a phosh
with no launcher around: no connection attempt, no timer); a reconnect that finds the files
missing, or an endpoint it cannot use, schedules the next attempt with the usual backoff.
---
diff --git a/src/tl-launcherctl.c b/src/tl-launcherctl.c
--- a/src/tl-launcherctl.c
+++ b/src/tl-launcherctl.c
@@ -30,10 +30,12 @@
  * of each at the time, and sends one more whenever it changes, so nothing is polled and no GET
  * of those routes is made.
  *
- * Without an endpoint or token file the client is unavailable and does nothing else: no
- * connection attempt, no timer. When the stream breaks it is opened again after 2 s, then 4 s,
+ * Without an endpoint or token file at the first start the client is unavailable and does
+ * nothing else: no connection attempt, no timer (a phosh with no launcher around). Once it has
+ * started, it never gives up: when the stream breaks it is opened again after 2 s, then 4 s,
  * 8 s and so on up to 60 s, until an event arrives (which starts the backoff over). The files
- * are read again at every attempt.
+ * are read again at every attempt, and a reconnect that finds them missing or unusable (a
+ * launcher restart rewrites them) keeps the backoff going instead of stopping.
  *
  * Public API:
  *
@@ -74,7 +76,7 @@
   guint            watchdog_id;
   guint            reconnect_id;
   guint            backoff;
-  gboolean         warned;
+  gboolean         started;        /* start_stream() has run once */
 
   /* The event being read */
   char            *event;
@@ -362,23 +364,34 @@
 {
   g_autofree char *endpoint = NULL;
   g_autofree char *token = NULL;
+  gboolean first = !self->started;
 
+  self->started = TRUE;
   teardown_stream (self);
 
   if (!read_credentials (&endpoint, &token)) {
-    /* No launcher to talk to. Nothing is retried: this is a phosh without a launcher around. */
-    if (!self->warned)
+    if (first) {
+      /* No launcher to talk to. Nothing is retried: this is a phosh without a launcher around. */
       g_message ("No launcherctl endpoint or token in ~/.launcherctl, no battery, network, "
                  "rotation or torch");
-    self->warned = TRUE;
-    set_available (self, FALSE);
+      set_available (self, FALSE);
+      return;
+    }
+    /* There was a launcher; its files are gone for now (it is restarting). Try again later. */
+    g_debug ("No launcherctl endpoint or token in ~/.launcherctl yet");
+    schedule_reconnect (self);
     return;
   }
 
   self->watch_msg = new_message (SOUP_METHOD_GET, endpoint, token, WATCH_PATH);
   if (!self->watch_msg) {
     g_message ("'%s' is not a usable launcherctl endpoint", endpoint);
-    set_available (self, FALSE);
+    if (first) {
+      set_available (self, FALSE);
+      return;
+    }
+    /* Read while the launcher was writing it, perhaps: the next attempt reads it again. */
+    schedule_reconnect (self);
     return;
   }
   soup_message_headers_replace (soup_message_get_request_headers (self->watch_msg),

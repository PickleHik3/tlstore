diff --git a/src/format-duration.h b/src/format-duration.h
new file mode 100644
index 0000000..f01e516
--- /dev/null
+++ b/src/format-duration.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright (C) 2020 Purism SPC
+ *               2025 Termux Launcher
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * phosh_format_duration() is libcall-ui's cui_call_format_duration(). The media player and the
+ * timer plugins use nothing else from libcall-ui, so with -Dcalls=false the library is not built.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+/**
+ * phosh_format_duration:
+ * @duration: Duration in seconds
+ *
+ * Formats a duration as `MM:SS`, or `H:MM:SS` for an hour or more.
+ *
+ * Returns: (transfer full): The duration as text
+ */
+static inline char *
+phosh_format_duration (double duration)
+{
+#define PHOSH_MINUTE 60
+#define PHOSH_HOUR   (60 * PHOSH_MINUTE)
+  guint seconds, minutes;
+  GString *str = g_string_new ("");
+
+  if (duration > PHOSH_HOUR) {
+    int hours = (int) (duration / PHOSH_HOUR);
+
+    g_string_append_printf (str, "%u:", hours);
+    duration -= (hours * PHOSH_HOUR);
+  }
+
+  minutes = (int) (duration / PHOSH_MINUTE);
+  seconds = duration - (minutes * PHOSH_MINUTE);
+  g_string_append_printf (str, "%02u:%02u", minutes, seconds);
+
+  return g_string_free (str, FALSE);
+#undef PHOSH_HOUR
+#undef PHOSH_MINUTE
+}

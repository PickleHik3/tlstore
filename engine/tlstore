#!/system/bin/sh
# written by termux-launcher
# tlstore — the launcher's tool store. Installs, lists, updates and removes the
# tools and configs the launcher shows off but does not ship.
#
# The shebang is /system/bin/sh on purpose: the prefix differs per edition and
# this file is written into it by the app, so it cannot name $PREFIX/bin/sh.
# POSIX sh only (Termux's sh is dash): no locals, no arrays, no [[ ]].
# Functions therefore share one variable namespace — every helper prefixes its
# variables (dl_, bk_, it_, …) so callers and callees cannot clobber each other.
#
# Item definitions come from the catalog: the one shipped in the APK, or a newer
# one refreshed from the repository and verified with minisign.
#
# Env:
#   TLSTORE_PREFIX      install prefix (default $PREFIX) — tests point it at a fake tree
#   TLSTORE_CATALOG_URL where refresh reads the catalog (file:// works)
#   TLSTORE_ASSUME_YES  1 = same as -y
#   TLSTORE_NPM_REGISTRY npm registry base (default https://registry.npmjs.org)
#   TLSTORE_ARCH        override uname -m (tests exercise aarch64 items on a host)
#   TLSTORE_PATCHELF    the patchelf command (tests pass a no-op)
#   TLSTORE_ASSUME_TTY  1 = answer questions from stdin even when it is not a
#                       terminal (the test suite pipes them in)
#   TLSTORE_HOST        launcher|termux — which app the store is running in,
#                       when the detection below should not have the last word
#   TLSTORE_UI          the tlstore-ui binary bare `tlstore` execs inside the
#                       launcher (default $PREFIX/libexec/termux-launcher/
#                       tlstore/tlstore-ui; tests point it at a fake one, or
#                       one that is not there, to take the other path)
#   TLSTORE_GITHUB      where GitHub is, for an item's README and the pictures
#                       in it: a prefix put in front of the host and path of
#                       every https://…github… address (default none, the real
#                       hosts; tests point it at a file:// tree laid out
#                       <host>/<path>)
#   TLSTORE_RELEASE_BASE  where the newest store release is: tlstore,
#                       tlstore.minisig, catalog.tsv, catalog.tsv.minisig and
#                       tlstore-ui-<abi> sit right under it (default this
#                       repository's releases/latest/download; tests point it
#                       at a file:// directory)
#   TLSTORE_BINARIES_RELEASES  where a bare `binaries:<asset>@<tag>` source
#                       is: <base>/<tag>/<asset>-aarch64 (default this
#                       repository's releases/download; tests use file://)
#   TLSTORE_BINARIES_RAW  where a `binaries:<path/with/slash>@<tag>` source
#                       is: <base>/<tag>/<path>, a file in this repository at
#                       that tag (default the raw GitHub URL; tests use file://)

set -u

TLSTORE_VERSION=0.7

# The store program that pairs with this script, one digest per processor.
# Empty in the source tree: scripts/release.sh --prepare fills them in from
# dist/tlstore-ui-<abi> before the file is signed, so a self-update can check
# the program it downloads against a digest the signature covers (see
# self_update, which reads them out of the downloaded copy, not this one).
# Keep these two lines exactly in this shape.
# shellcheck disable=SC2034
TLSTORE_UI_SHA256_arm64_v8a=
# shellcheck disable=SC2034
TLSTORE_UI_SHA256_x86_64=

PREFIX="${TLSTORE_PREFIX:-${PREFIX:-${HOME%/files/home}/files/usr}}"
HOME="${HOME:?tlstore needs HOME}"

# /data/data/<app package>/files/usr — the edition this prefix belongs to.
APP_PACKAGE=""
case "$PREFIX" in
    */files/usr)
        APP_PACKAGE="${PREFIX%/files/usr}"
        APP_PACKAGE="${APP_PACKAGE##*/}"
        ;;
esac

BIN_DIR="$HOME/.local/bin"
LIB_DIR="$HOME/.local/lib"
# Where a priv=shizuku binary itself lives: off PATH, since what the user runs
# is the wrapper in BIN_DIR that hands it to the launcher's privileged lane.
PRIV_DIR="$LIB_DIR/tlstore/priv"
DATA_DIR="$HOME/.local/share/tlstore"
CACHE_DIR="$HOME/.cache/tlstore"
STORE_DIR="$PREFIX/libexec/termux-launcher/tlstore"
BASE_CATALOG="$STORE_DIR/catalog.tsv"
USER_CATALOG="$DATA_DIR/catalog.tsv"
PUBKEY="$STORE_DIR/trusted.pub"
STATE="$DATA_DIR/installed.tsv"

# The app writes this when it puts tlstore down (a hand install writes
# .standalone instead, with the address it came from inside it; nothing here
# reads that one — tlstore keeps itself current the same way in both cases).
INSTALLED_MARK="$STORE_DIR/.installed"

# Which app the store is running in. The launcher names itself in the
# environment; over ssh nothing does, and then the app's own marker answers.
HOST="${TLSTORE_HOST:-}"
case "$HOST" in
    launcher|termux) ;;
    *)
        if [ "${TERM_PROGRAM:-}" = termux-launcher ]; then
            HOST=launcher
        elif [ -n "${TERM_PROGRAM:-}" ]; then
            HOST=termux
        elif [ -f "$INSTALLED_MARK" ]; then
            HOST=launcher
        else
            HOST=termux
        fi
        ;;
esac

# The launcher's own version, for items that need a recent one. Only the
# launcher sets it, and an item asking for it passes anywhere else.
LAUNCHER_VERSION="${TERM_PROGRAM_VERSION:-}"
[ "$HOST" = launcher ] || LAUNCHER_VERSION=""

# The newest store release: the signed script, the signed catalog and the
# store program, as GitHub Release assets. The catalog and tlstore itself are
# refreshed from here, whoever installed tlstore (see refresh_catalog and
# self_update).
RELEASE_BASE="${TLSTORE_RELEASE_BASE:-https://github.com/PickleHik3/tlstore/releases/latest/download}"
CATALOG_URL="${TLSTORE_CATALOG_URL:-$RELEASE_BASE/catalog.tsv}"
NPM_REGISTRY="${TLSTORE_NPM_REGISTRY:-https://registry.npmjs.org}"
PATCHELF="${TLSTORE_PATCHELF:-patchelf}"
TLSTORE_UI_BIN="${TLSTORE_UI:-$STORE_DIR/tlstore-ui}"

LAUNCHER_RAW="https://raw.githubusercontent.com/PickleHik3/termux-launcher"
# A bare `binaries:<asset>@<tag>` is a GitHub Release asset of this repository
# (a bins-… prerelease built by .github/workflows/build.yml); a path with a
# slash is a small file kept in git, read raw at that tag.
BINARIES_RELEASES="${TLSTORE_BINARIES_RELEASES:-https://github.com/PickleHik3/tlstore/releases/download}"
BINARIES_RAW="${TLSTORE_BINARIES_RAW:-https://raw.githubusercontent.com/PickleHik3/tlstore}"

# Where an item's own README and its pictures are read from (see cmd_readme).
GITHUB_RAW="https://raw.githubusercontent.com"
GITHUB_MIRROR="${TLSTORE_GITHUB:-}"

ASSUME_YES="${TLSTORE_ASSUME_YES:-0}"
[ "$ASSUME_YES" = 1 ] || ASSUME_YES=0

ASSUME_TTY="${TLSTORE_ASSUME_TTY:-0}"
[ "$ASSUME_TTY" = 1 ] || ASSUME_TTY=0

# -y never answers "replace my config file?"; --configs does, and only that.
REPLACE_CONFIGS=0

# --progress: a machine stream on stdout for install/update/remove, for
# tlstore-ui. It implies -y, and a config file question is always answered by
# keeping the user's file (never replacing it) rather than asking.
PROGRESS=0
PROGRESS_NOTE=""

# Packages this run installed only so something else could be built.
BUILD_ADDED=""

ARCH="${TLSTORE_ARCH:-$(uname -m 2>/dev/null || echo unknown)}"
case "$ARCH" in
    aarch64|arm64) ARCH_OK=1 ;;
    *) ARCH_OK=0 ;;
esac

CATALOG=""
CATALOG_SERIAL=""
CATALOG_FROM=""
FAILED=0

TAB=$(printf '\t')

# What a cancel (SIGTERM to the whole process group — tlstore-ui sends it when
# the person backs out of a running --progress job) has to clean up: the temp
# file the current download is writing (download() keeps this current),
# anywhere else an install leaves a half-built scratch copy before it moves it
# into place (npm-musl's unpack directory), and which item was in flight, so
# the UI still gets a done line for it instead of waiting forever.
CANCEL_TMP=""
CANCEL_EXTRA=""
CANCEL_ITEM=""

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

say() {
    if [ "$PROGRESS" = 1 ]; then
        printf '%s\n' "$*" >&2
    else
        printf '%s\n' "$*"
    fi
}
err() { printf 'tlstore: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

# progress_line <step> <name> <pct> <words> — one line of the --progress
# stream. Always stdout, whether or not PROGRESS is set, since these lines are
# the machine output itself, not incidental narration.
progress_line() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }
progress_done() { printf 'done\t%s\t%s\t%s\n' "$1" "$2" "$3"; }

# progress_stage <pct> <words> — the job's item reached a step. Only moves
# forward, so a step the work already reported (the download's own count, or
# its checksum) is not reported again, and one it never reached (a pkg item
# has no download of ours) still shows before "ready".
PROGRESS_AT=0
progress_stage() {
    [ "$PROGRESS" = 1 ] && [ -n "$CANCEL_ITEM" ] || return 0
    [ "$1" -gt "$PROGRESS_AT" ] || return 0
    PROGRESS_AT=$1
    progress_line step "$CANCEL_ITEM" "$1" "$2"
}

# The share of the bar a download fills: from the "fetched" step up to where
# the checksum step starts.
PROGRESS_FETCH_END=55

# curl_to <url> <file> — download to a file. Inside a --progress job, for the
# job's own item, curl's progress bar is turned into step lines as the bytes
# arrive (one per whole percent of the bar, flushed), so the count and the line
# move with the download instead of jumping from the first step to the last.
curl_to() {
    if [ "$PROGRESS" != 1 ] || [ -z "$CANCEL_ITEM" ]; then
        curl -fsSL --connect-timeout 5 --speed-limit 1 --speed-time 30 -o "$2" "$1"
        return
    fi
    ct_rc="$2.rc"
    # curl's own exit status cannot come back through the pipe, so it goes
    # through a file; -# draws "####   42.0%" frames separated by carriage
    # returns on stderr, whatever stderr is.
    { curl -fL -# --connect-timeout 5 --speed-limit 1 --speed-time 30 -o "$2" "$1" 2>&1
      echo "$?" > "$ct_rc"; } |
        tr '\r' '\n' |
        awk -v name="$CANCEL_ITEM" -v from="$PROGRESS_AT" -v to="$PROGRESS_FETCH_END" '
            match($0, /[0-9]+(\.[0-9]+)?%/) {
                p = substr($0, RSTART, RLENGTH - 1) + 0
                v = int(from + (to - from) * p / 100)
                if (v > last) { last = v; printf "step\t%s\t%d\tfetched\n", name, v; fflush() }
            }'
    ct_status=$(cat "$ct_rc" 2>/dev/null || echo 1)
    rm -f "$ct_rc"
    [ "$ct_status" = 0 ] || return 1
    PROGRESS_AT=$PROGRESS_FETCH_END
    return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# Runs on SIGTERM (a plain kill or the whole process group tlstore-ui signals
# to cancel a running --progress job): drop whatever the current download had
# not finished writing, drop any other scratch copy an install had not yet
# moved into place, tell the UI the item in flight failed rather than leaving
# it to wait for a line that is never coming, and stop. Nothing already
# recorded in STATE is touched, so an item that finished earlier in this same
# run stays installed.
on_cancel() {
    [ -z "$CANCEL_TMP" ] || rm -f "$CANCEL_TMP"
    for oc_p in $CANCEL_EXTRA; do
        rm -rf "$oc_p"
    done
    if [ "$PROGRESS" = 1 ] && [ -n "$CANCEL_ITEM" ]; then
        progress_done "$CANCEL_ITEM" failed "Cancelled."
    fi
    exit 143
}
trap on_cancel TERM

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

serial_of() {
    [ -f "$1" ] || return 1
    sed -n 's/^#.*serial=\([0-9][0-9]*\).*$/\1/p' "$1" | head -1
}

# Picks the newer of the refreshed catalog and the one shipped in the app.
pick_catalog() {
    pc_base=$(serial_of "$BASE_CATALOG" 2>/dev/null || true)
    pc_user=$(serial_of "$USER_CATALOG" 2>/dev/null || true)
    CATALOG=""
    if [ -f "$USER_CATALOG" ] && [ -n "$pc_user" ]; then
        if [ -z "$pc_base" ] || [ "$pc_user" -gt "$pc_base" ] 2>/dev/null; then
            CATALOG="$USER_CATALOG"
            CATALOG_SERIAL="$pc_user"
            CATALOG_FROM=refreshed
        fi
    fi
    if [ -z "$CATALOG" ] && [ -f "$BASE_CATALOG" ]; then
        CATALOG="$BASE_CATALOG"
        CATALOG_SERIAL="$pc_base"
        CATALOG_FROM=app
    fi
    [ -n "$CATALOG" ]
}

need_catalog() {
    pick_catalog || die "the list of items is missing — reopen the app to put it back"
}

# Every row that applies here: this edition's prefix, this processor, this app,
# a new enough launcher; first row per name wins.
rows() {
    awk -F "$TAB" -v pkgname="$APP_PACKAGE" -v archok="$ARCH_OK" \
        -v host="$HOST" -v lver="$LAUNCHER_VERSION" '
        function prefix_ok(list,   n, i, parts) {
            if (list == "*" || list == "") return 1
            n = split(list, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == pkgname) return 1
            return 0
        }
        function arch_ok(kind) {
            if (archok == "1") return 1
            return (kind != "binary" && kind != "npm-musl")
        }
        function optval(list, key,   n, i, parts) {
            n = split(list, parts, ";")
            for (i = 1; i <= n; i++)
                if (index(parts[i], key "=") == 1)
                    return substr(parts[i], length(key) + 2)
            return ""
        }
        function host_ok(list,   want, n, i, parts) {
            want = optval(list, "host")
            if (want == "") return 1
            n = split(want, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == host) return 1
            return 0
        }
        function vercmp(a, b,   na, nb, pa, pb, i, n, x, y) {
            na = split(a, pa, /[._-]/)
            nb = split(b, pb, /[._-]/)
            n = (na > nb) ? na : nb
            for (i = 1; i <= n; i++) {
                x = (i <= na) ? pa[i] + 0 : 0
                y = (i <= nb) ? pb[i] + 0 : 0
                if (x > y) return 1
                if (x < y) return -1
            }
            return 0
        }
        function launcher_ok(list,   want) {
            want = optval(list, "min-launcher")
            if (want == "") return 1
            if (lver == "") return 1
            return vercmp(lver, want) >= 0
        }
        /^[ \t]*#/ { next }
        /^[ \t]*$/ { next }
        NF < 10 { next }
        !prefix_ok($4) { next }
        !arch_ok($2) { next }
        !host_ok($9) { next }
        !launcher_ok($9) { next }
        seen[$1]++ { next }
        { print }
    ' "$CATALOG"
}

# The rows a user picks from. The rest are plumbing: parts other items pull in,
# never listed and never installed by name.
visible_rows() {
    rows | awk -F "$TAB" '$9 !~ /(^|;)hidden=1(;|$)/'
}

hidden_item() {
    hi_row=$(row "$1")
    [ -n "$hi_row" ] || return 1
    [ "$(opt "$(field "$hi_row" 9)" hidden)" = 1 ]
}

# row <name> — the row for one item, empty when it has none here.
row() {
    rows | awk -F "$TAB" -v want="$1" '$1 == want { print; exit }'
}

# Loads a row into it_* for the rest of the run. The row is split with
# parameter expansion alone (no cut per field): a field beyond the row's end
# reads as "", the way `cut -f` reports it, and an empty field stays empty.
load_item() {
    it_row=$(row "$1")
    [ -n "$it_row" ] || return 1
    it_name=""; it_kind=""; it_version=""; it_prefixes=""; it_source=""
    it_digest=""; it_target=""; it_requires=""; it_options=""; it_summary=""
    it_category=""; it_upstream=""; it_setup=""; it_standfirst=""
    it_does1=""; it_does2=""; it_does3=""; it_try=""; it_notes=""
    it_author=""; it_licence=""; it_size=""; it_picture=""
    it_picture_digest=""; it_demo=""; it_featured=""; it_readme_skip=""
    it_readme=""; it_readme_digest=""; it_demo_digest=""
    # A trailing tab so the last field ends the way every other one does.
    li_rest="$it_row$TAB"
    li_i=1
    while [ -n "$li_rest" ] && [ "$li_i" -le 30 ]; do
        li_f="${li_rest%%"$TAB"*}"
        li_rest="${li_rest#*"$TAB"}"
        # shellcheck disable=SC2034  # it_prefixes is loaded for completeness; rows() did the matching
        case "$li_i" in
            1) it_name="$li_f" ;;
            2) it_kind="$li_f" ;;
            3) it_version="$li_f" ;;
            4) it_prefixes="$li_f" ;;
            5) it_source="$li_f" ;;
            6) it_digest="$li_f" ;;
            7) it_target="$li_f" ;;
            8) it_requires="$li_f" ;;
            9) it_options="$li_f" ;;
            10) it_summary="$li_f" ;;
            # The Revision 5 fields, read out by cmd_info and cmd_snapshot.
            11) it_category="$li_f" ;;
            12) it_upstream="$li_f" ;;
            13) it_setup="$li_f" ;;
            14) it_standfirst="$li_f" ;;
            15) it_does1="$li_f" ;;
            16) it_does2="$li_f" ;;
            17) it_does3="$li_f" ;;
            18) it_try="$li_f" ;;
            19) it_notes="$li_f" ;;
            20) it_author="$li_f" ;;
            21) it_licence="$li_f" ;;
            22) it_size="$li_f" ;;
            23) it_picture="$li_f" ;;
            24) it_picture_digest="$li_f" ;;
            25) it_demo="$li_f" ;;
            26) it_featured="$li_f" ;;
            27) it_readme_skip="$li_f" ;;
            28) it_readme="$li_f" ;;
            29) it_readme_digest="$li_f" ;;
            30) it_demo_digest="$li_f" ;;
        esac
        li_i=$((li_i + 1))
    done
    # Revision 6: the README sections tlstore-ui leaves out, |-separated. A
    # catalog from before the column has no field 27 at all, which reads as
    # "none" the same way "-" does.
    [ -n "$it_readme_skip" ] || it_readme_skip="-"
    # Pinned content (Revision 6 addendum): a launcher:/binaries: source for a
    # pinned README (instead of fetching upstream) and its digest, plus the
    # demo picture's own digest. A catalog from before these columns has none
    # of the three, which reads as "-" the same way an explicit "-" does.
    [ -n "$it_readme" ] || it_readme="-"
    [ -n "$it_readme_digest" ] || it_readme_digest="-"
    [ -n "$it_demo_digest" ] || it_demo_digest="-"
    return 0
}

field() {
    printf '%s\n' "$1" | cut -d "$TAB" -f "$2"
}

# The value of one ;-separated option, empty when unset.
opt() {
    printf '%s' "$1" | tr ';' '\n' | sed -n "s/^$2=//p" | head -1
}

commas() { printf '%s' "$1" | tr ',' ' '; }

# " a  b " → "a, b", for reading out a list of names.
words_list() { printf '%s' "$1" | sed 's/^ *//; s/ *$//; s/  */, /g'; }

# A leading ~ in a target is this user's home, not a shell expansion.
# shellcheck disable=SC2088
expand_path() {
    case "$1" in
        '~'|'~/'*) printf '%s' "$HOME${1#\~}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The URL a source field points at.
source_url() {
    case "$1" in
        launcher:*)
            su_rest="${1#launcher:}"
            su_path="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            printf '%s/%s/%s' "$LAUNCHER_RAW" "$su_tag" "$su_path"
            ;;
        binaries:*)
            su_rest="${1#binaries:}"
            su_asset="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            case "$su_asset" in
                # A path (a readme or a hero picture kept in the repository)
                # resolves straight to that file at the tag; a bare asset name
                # is the per-processor binary, published as a release asset
                # under the tag.
                */*) printf '%s/%s/%s' "$BINARIES_RAW" "$su_tag" "$su_asset" ;;
                *) printf '%s/%s/%s-aarch64' "$BINARIES_RELEASES" "$su_tag" "$su_asset" ;;
            esac
            ;;
        *) printf '%s' "$1" ;;
    esac
}

# item_targets <name> <kind> <target> [source] [options] — where an item's
# payload lands, space separated; empty for pkg and bundles. An npm-musl item
# lands twice: the directory, then the wrapper, which is named after the
# executable inside the package (claude-code installs the command `claude`). A
# package that keeps its executable in a subdirectory (npm:x#bin/y) still gets
# the bare name. A binary with priv=shizuku lands twice as well: the program
# under PRIV_DIR, off PATH, then the wrapper on PATH that runs it through
# tl-priv.
item_targets() {
    case "$2" in
        binary|file|file-once)
            if [ "$2" = binary ] && [ "$(opt "${5:-}" priv)" = shizuku ]; then
                if [ "$3" = "-" ] || [ -z "$3" ]; then
                    printf '%s %s' "$PRIV_DIR/$1" "$BIN_DIR/$1"
                else
                    printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$1"
                fi
            elif [ "$3" = "-" ] || [ -z "$3" ]; then
                [ "$2" = binary ] || return 0
                printf '%s' "$BIN_DIR/$1"
            else
                expand_path "$3"
            fi
            ;;
        npm-musl)
            it_exe="${4:-}"
            case "$it_exe" in
                *"#"*) it_exe="${it_exe##*#}" ;;
                *) it_exe="$1" ;;
            esac
            it_exe="${it_exe##*/}"
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                printf '%s %s' "$LIB_DIR/$1" "$BIN_DIR/$it_exe"
            else
                printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$it_exe"
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

state_row() {
    [ -f "$STATE" ] || return 1
    awk -F "$TAB" -v want="$1" '/^#/ { next } $1 == want { print; exit }' "$STATE"
}

is_installed() {
    [ -n "$(state_row "$1" 2>/dev/null)" ]
}

installed_version() {
    st_row=$(state_row "$1" 2>/dev/null) || return 1
    [ -n "$st_row" ] || return 1
    field "$st_row" 3
}

installed_names() {
    [ -f "$STATE" ] || return 0
    awk -F "$TAB" '/^#/ { next } NF > 0 { print $1 }' "$STATE"
}

# state_record <name> <kind> <version> <files…>
state_record() {
    sr_name="$1"
    sr_kind="$2"
    sr_version="$3"
    shift 3
    sr_files="$*"
    mkdir -p "$DATA_DIR"
    [ -f "$STATE" ] || printf '# tlstore installed\tname\tkind\tversion\twhen\tfiles\n' > "$STATE"
    sr_tmp="$STATE.new"
    awk -F "$TAB" -v want="$sr_name" '$1 != want' "$STATE" > "$sr_tmp" || return 1
    printf '%s\t%s\t%s\t%s\t%s\n' "$sr_name" "$sr_kind" "$sr_version" "$(timestamp)" "$sr_files" >> "$sr_tmp"
    mv "$sr_tmp" "$STATE"
}

state_forget() {
    [ -f "$STATE" ] || return 0
    sf_tmp="$STATE.new"
    awk -F "$TAB" -v want="$1" '$1 != want' "$STATE" > "$sf_tmp" || return 1
    mv "$sf_tmp" "$STATE"
}

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

file_digest() {
    if have sha256sum; then
        sha256sum "$1" | cut -d' ' -f1
    elif have openssl; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        printf ''
    fi
}

backup_existing() {
    bk_target="$1"
    if [ -e "$bk_target" ]; then
        bk_copy="$bk_target.bak-$(timestamp)"
        cp -a "$bk_target" "$bk_copy" || return 1
        say "  kept a copy of $(basename "$bk_target") beside it"
    fi
    return 0
}

# The newest .bak beside a file, put back in its place.
restore_backup() {
    rb_target="$1"
    rb_newest=""
    for rb_f in "$rb_target".bak-*; do
        [ -e "$rb_f" ] || continue
        rb_newest="$rb_f"
    done
    [ -n "$rb_newest" ] || return 1
    mv "$rb_newest" "$rb_target" || return 1
    return 0
}

# download <url> <destination> <sha256 or -> — CANCEL_TMP tracks the part
# file while it is being written, so on_cancel can drop it if a SIGTERM lands
# mid-download; nothing here is left behind once the function returns, either
# way, since every exit path clears it again. The part file carries this
# process's pid, so two tlstores fetching the same file at once (a prefetch
# lane and an item opened early) never write over each other: each verifies
# its own copy and the last mv wins, whole. A payload can be hundreds of
# megabytes on a slow link, so the timeout is on a stall (nothing for 30 s)
# rather than on the whole transfer.
download() {
    dl_url="$1"
    dl_dest="$2"
    dl_expect="$3"
    dl_dir=$(dirname "$dl_dest")
    mkdir -p "$dl_dir" || return 1
    dl_tmp="$dl_dir/.$(basename "$dl_dest").$$.part"
    CANCEL_TMP="$dl_tmp"
    if ! curl_to "$dl_url" "$dl_tmp"; then
        rm -f "$dl_tmp"
        CANCEL_TMP=""
        err "could not download $(basename "$dl_dest")"
        return 1
    fi
    if [ "$dl_expect" != "-" ] && [ -n "$dl_expect" ]; then
        progress_stage 60 "signature checked"
        dl_actual=$(file_digest "$dl_tmp")
        if [ -z "$dl_actual" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "cannot check what was downloaded — install coreutils and try again"
            return 1
        fi
        if [ "$dl_actual" != "$dl_expect" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "$(basename "$dl_dest") does not match what the list expects — nothing was installed"
            return 1
        fi
    fi
    progress_stage 90 "putting files in place"
    mv "$dl_tmp" "$dl_dest" || { CANCEL_TMP=""; return 1; }
    CANCEL_TMP=""
    return 0
}

# Is someone there to answer a question?
interactive() {
    [ "$ASSUME_TTY" = 1 ] && return 0
    [ -t 0 ]
}

# A full-screen view needs a real terminal at both ends, whatever the knob says.
on_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

# How wide the terminal is; 80 when nothing here will say.
term_cols() {
    tc_n="${COLUMNS:-}"
    case "$tc_n" in
        ''|*[!0-9]*) tc_n="" ;;
    esac
    if [ -z "$tc_n" ] && have tput; then
        tc_n=$(tput cols 2>/dev/null || printf '')
        case "$tc_n" in
            ''|*[!0-9]*) tc_n="" ;;
        esac
    fi
    { [ -n "$tc_n" ] && [ "$tc_n" -gt 0 ]; } || tc_n=80
    printf '%s' "$tc_n"
}

yes_reply() {
    case "$1" in
        y|Y|yes|YES) return 0 ;;
    esac
    return 1
}

# A question that goes ahead unless you say no. -y answers it.
ask_yn() {
    [ "$ASSUME_YES" = 1 ] && return 0
    printf '%s [Y/n] ' "$1"
    read -r ay_answer || ay_answer=""
    [ -n "$ay_answer" ] || ay_answer=y
    yes_reply "$ay_answer"
}

# A question that does nothing unless you say yes. -y answers it; with nobody
# there to ask, the answer is no.
ask_ny() {
    [ "$ASSUME_YES" = 1 ] && return 0
    interactive || return 1
    printf '%s [y/N] ' "$1"
    read -r an_answer || an_answer=""
    yes_reply "$an_answer"
}

# Two files with the same contents.
same_file() {
    if have cmp; then
        cmp -s "$1" "$2"
        return $?
    fi
    sf_a=$(file_digest "$1")
    sf_b=$(file_digest "$2")
    [ -n "$sf_a" ] && [ "$sf_a" = "$sf_b" ]
}

# pm_run <command...> — run the package manager. Inside a --progress job, for
# the job's own item, what it prints is turned into step lines, since pkg, apt
# and pacman draw no progress bar a pipe can carry: each download line moves
# the bar a third of the way on towards the checksum step, the integrity check
# and the unpacking move it past that, and everything it says goes to stderr so
# stdout stays the machine stream.
pm_run() {
    if [ "$PROGRESS" != 1 ] || [ -z "$CANCEL_ITEM" ]; then
        "$@"
        return
    fi
    mkdir -p "$CACHE_DIR"
    pr_rc="$CACHE_DIR/pm.rc"
    # As in curl_to, the exit status comes back through a file; so does the
    # last percentage reported, so progress_stage never steps back behind it.
    { "$@" 2>&1; echo "$?" > "$pr_rc"; } |
        tr '\r' '\n' |
        awk -v name="$CANCEL_ITEM" -v from="$PROGRESS_AT" -v to="$PROGRESS_FETCH_END" -v atf="$pr_rc.at" '
            function step(v, w) {
                if (v > last) { last = v; printf "step\t%s\t%d\t%s\n", name, v, w; fflush() }
            }
            BEGIN { last = from; at = from }
            { print | "cat 1>&2" }
            /^(Get|Hit):[0-9]/ || /downloading/ || /^:: (Synchronizing|Retrieving)/ {
                at += (to - at) / 3; step(int(at), "fetched"); next
            }
            /^Fetched / || /checking (package integrity|keys)/ { step(60, "signature checked"); next }
            /^(Preparing to unpack|Unpacking) / || /^\([0-9]+\/[0-9]+\) (installing|upgrading) / {
                step(75, "putting files in place"); next
            }
            /^Setting up / || /^:: Running post-transaction/ { step(85, "putting files in place") }
            END { print last > atf }'
    pr_status=$(cat "$pr_rc" 2>/dev/null || echo 1)
    PROGRESS_AT=$(cat "$pr_rc.at" 2>/dev/null || echo "$PROGRESS_AT")
    rm -f "$pr_rc" "$pr_rc.at"
    [ "$pr_status" = 0 ]
}

install_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pm_run pacman -S --needed --noconfirm $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pm_run pkg install -y $@
    else
        err "no package manager here — cannot install $*"
        return 1
    fi
}

upgrade_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pm_run pacman -S --needed --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        pm_run apt-get install -y -qq --only-upgrade $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pm_run pkg install -y $@
    else
        err "no package manager here — cannot update $*"
        return 1
    fi
}

remove_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pacman -R --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        apt remove -y $@
    else
        return 1
    fi
}

pkg_present() {
    if have pacman; then
        pacman -Q "$1" >/dev/null 2>&1
    elif have dpkg; then
        dpkg -s "$1" >/dev/null 2>&1
    else
        have "$1"
    fi
}

# ---------------------------------------------------------------------------
# Lists of names (space separated; names are [a-z0-9-]+ so words are safe)
# ---------------------------------------------------------------------------

in_list() {
    case " $1 " in
        *" $2 "*) return 0 ;;
    esac
    return 1
}

# The item and everything it needs, in the order they have to be installed.
plan_for() {
    pf_closure=""
    pf_todo="$*"
    while [ -n "$pf_todo" ]; do
        pf_next=""
        for pf_n in $pf_todo; do
            in_list "$pf_closure" "$pf_n" && continue
            pf_closure="$pf_closure $pf_n"
            pf_deps=$(item_deps "$pf_n")
            pf_next="$pf_next $pf_deps"
        done
        pf_todo="$pf_next"
    done

    pf_plan=""
    pf_left="$pf_closure"
    while [ -n "$pf_left" ]; do
        pf_moved=0
        pf_rest=""
        for pf_n in $pf_left; do
            if deps_ready "$pf_n" "$pf_closure" "$pf_plan"; then
                pf_plan="$pf_plan $pf_n"
                pf_moved=1
            else
                pf_rest="$pf_rest $pf_n"
            fi
        done
        pf_left=$(printf '%s' "$pf_rest" | sed 's/^ *//')
        if [ "$pf_moved" = 0 ]; then
            pf_plan="$pf_plan $pf_left"
            break
        fi
    done
    printf '%s' "$pf_plan" | sed 's/^ *//'
}

# What a name needs installed before it.
item_deps() {
    id_row=$(row "$1")
    [ -n "$id_row" ] || return 0
    id_req=$(commas "$(field "$id_row" 8)")
    [ "$id_req" = "-" ] && id_req=""
    printf '%s' "$id_req"
}

deps_ready() {
    for dr_d in $(item_deps "$1"); do
        in_list "$2" "$dr_d" || continue
        in_list "$3" "$dr_d" || return 1
    done
    return 0
}

# ---------------------------------------------------------------------------
# Tools that are only needed while installing
# ---------------------------------------------------------------------------

# Is this item already here in the version the list offers?
already_here() {
    ah_row=$(row "$1")
    [ -n "$ah_row" ] || return 1
    is_installed "$1" || return 1
    case "$(field "$ah_row" 2)" in
        pkg|bundle|fisher) return 0 ;;
    esac
    [ "$(installed_version "$1")" = "$(field "$ah_row" 3)" ]
}

# build_tools_for <names> <force> — the build= packages the plan will really
# need, each named once. Nothing is fetched for an item that is already here.
build_tools_for() {
    bt_out=""
    for bt_n in $1; do
        bt_row=$(row "$bt_n")
        [ -n "$bt_row" ] || continue
        if [ "$2" = 0 ] && already_here "$bt_n"; then
            continue
        fi
        for bt_p in $(commas "$(opt "$(field "$bt_row" 9)" build)"); do
            [ "$bt_p" = "-" ] && continue
            in_list "$bt_out" "$bt_p" || bt_out="$bt_out $bt_p"
        done
    done
    printf '%s' "$bt_out" | sed 's/^ *//'
}

# Installs the ones that are not here already, remembering which those were so
# they can be offered back afterwards.
# add_build_tools <names> <force>
add_build_tools() {
    ab_missing=""
    for ab_p in $(build_tools_for "$1" "$2"); do
        pkg_present "$ab_p" || ab_missing="$ab_missing $ab_p"
    done
    [ -n "$(printf '%s' "$ab_missing" | tr -d ' ')" ] || return 0
    say "Installing what is needed to build:$ab_missing"
    # shellcheck disable=SC2086
    if ! install_pkg $ab_missing; then
        err "could not install what is needed to build:$ab_missing"
        return 1
    fi
    BUILD_ADDED="$BUILD_ADDED$ab_missing"
    return 0
}

drop_build_tools() {
    db_pkgs=$(printf '%s' "$BUILD_ADDED" | sed 's/^ *//')
    BUILD_ADDED=""
    [ -n "$db_pkgs" ] || return 0
    ask_ny "Remove the tools that were only needed for installing ($(words_list "$db_pkgs"))?" || return 0
    # shellcheck disable=SC2086
    remove_pkg $db_pkgs >/dev/null 2>&1 || true
    # What was downloaded to build: not the pictures and readmes tlstore-ui
    # keeps (see "The asset cache" below), which stay until an item moves on.
    for db_f in "${CACHE_DIR:?}"/*; do
        [ -e "$db_f" ] || continue
        case "${db_f##*/}" in
            pictures|readme|snapshot.tsv) ;;
            *) rm -rf "$db_f" 2>/dev/null || true ;;
        esac
    done
    say "Removed them, and cleared what was downloaded."
    return 0
}

# ---------------------------------------------------------------------------
# Installing
# ---------------------------------------------------------------------------

install_item() {
    ii_name="$1"
    ii_force="${2:-0}"
    # Something a bundle asks for that has no row here — another edition's
    # build, or an aarch64 tool on a different processor — is skipped, not an
    # error. A name typed on the command line is checked before we get here.
    load_item "$ii_name" || {
        say "$ii_name is not available on this device"
        PROGRESS_NOTE="$ii_name is not available on this device"
        return 0
    }
    ii_kind="$it_kind"
    ii_version="$it_version"
    ii_source="$it_source"
    ii_digest="$it_digest"
    ii_target="$it_target"
    ii_options="$it_options"

    if [ "$ii_force" = 0 ] && already_here "$ii_name"; then
        say "$ii_name is already installed"
        PROGRESS_NOTE="already installed"
        return 0
    fi

    case "$ii_kind" in
        pkg) do_pkg ;;
        binary) do_binary ;;
        file) do_file 0 ;;
        file-once) do_file 1 ;;
        fisher) do_fisher ;;
        npm-musl) do_npm_musl ;;
        bundle) do_bundle ;;
        *) err "$ii_name cannot be installed here"; return 1 ;;
    esac
}

do_pkg() {
    say "installing $ii_name"
    # shellcheck disable=SC2086  # the source column is a list of package names
    if ! install_pkg $ii_source; then
        err "could not install $ii_name"
        return 1
    fi
    state_record "$ii_name" pkg "$ii_version"
    return 0
}

do_binary() {
    db_targets=$(item_targets "$ii_name" binary "$ii_target" "$ii_source" "$ii_options")
    db_dest="${db_targets%% *}"
    db_mode=$(opt "$ii_options" mode)
    [ -n "$db_mode" ] || db_mode=755
    say "installing $ii_name"
    mkdir -p "$(dirname "$db_dest")"
    backup_existing "$db_dest"
    download "$(source_url "$ii_source")" "$db_dest" "$ii_digest" || return 1
    chmod "$db_mode" "$db_dest"
    if [ "$(opt "$ii_options" priv)" = shizuku ]; then
        # The program stays off PATH. What the user runs is a wrapper that hands
        # it to tl-priv, the client of the launcher's privileged lane, which
        # starts it as the Shizuku shell user. tl-priv is a hidden binary item
        # every such item requires, so it is in BIN_DIR by now.
        db_wrapper="${db_targets#* }"
        mkdir -p "$BIN_DIR"
        backup_existing "$db_wrapper"
        {
            printf '#!%s/bin/sh\n' "$PREFIX"
            printf '# written by termux-launcher\n'
            printf 'exec "%s/tl-priv" run "%s" "$@"\n' "$BIN_DIR" "$db_dest"
        } > "$db_wrapper"
        chmod 755 "$db_wrapper"
        state_record "$ii_name" binary "$ii_version" "$db_dest" "$db_wrapper"
        say "  $db_wrapper"
    else
        state_record "$ii_name" binary "$ii_version" "$db_dest"
        say "  $db_dest"
    fi
    return 0
}

# Shows what would change in a config file and asks. Only --configs answers this
# for you; -y deliberately does not, because a config is the user's own work.
# confirm_replace <name> <current> <new>
confirm_replace() {
    cf_name="$1"
    cf_cur="$2"
    cf_new="$3"
    # --progress never opens a prompt tlstore-ui cannot answer: the user's file
    # is always kept, whatever --configs says.
    [ "$PROGRESS" = 1 ] && return 1
    [ "$REPLACE_CONFIGS" = 1 ] && return 0
    interactive || return 1
    say "$cf_name"
    if have diff; then
        diff -u "$cf_cur" "$cf_new" || true
    else
        say "  before:"
        head -25 "$cf_cur" | sed 's/^/    /'
        say "  after:"
        head -25 "$cf_new" | sed 's/^/    /'
    fi
    printf 'Replace your %s? [y/N] ' "$(basename "$cf_cur")"
    read -r cf_answer || cf_answer=""
    yes_reply "$cf_answer"
}

# do_file <once>
do_file() {
    df_once="$1"
    df_dest=$(item_targets "$ii_name" file "$ii_target")
    if [ -z "$df_dest" ]; then
        err "$ii_name has nowhere to go"
        return 1
    fi
    df_mode=$(opt "$ii_options" mode)
    [ -n "$df_mode" ] || df_mode=644
    if [ "$df_once" = 1 ] && [ -e "$df_dest" ]; then
        say "kept your $(basename "$df_dest") — it is yours to edit"
        PROGRESS_NOTE="kept your $(basename "$df_dest")"
        is_installed "$ii_name" || state_record "$ii_name" file-once "$ii_version"
        return 0
    fi
    # A config file you already have is never replaced without being shown the
    # change first. It is recorded either way, so declining is not asked again
    # until the shipped file itself moves on.
    if [ "$df_once" = 0 ] && [ -e "$df_dest" ]; then
        mkdir -p "$CACHE_DIR"
        df_new="$CACHE_DIR/$ii_name.new"
        download "$(source_url "$ii_source")" "$df_new" "$ii_digest" || return 1
        if same_file "$df_dest" "$df_new"; then
            rm -f "$df_new"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        if ! confirm_replace "$ii_name" "$df_dest" "$df_new"; then
            rm -f "$df_new"
            say "kept your $(basename "$df_dest")"
            PROGRESS_NOTE="kept your $(basename "$df_dest")"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        backup_existing "$df_dest"
        cp "$df_new" "$df_dest" || return 1
        rm -f "$df_new"
        chmod "$df_mode" "$df_dest"
        state_record "$ii_name" file "$ii_version" "$df_dest"
        say "  $df_dest"
        return 0
    fi
    say "installing $ii_name"
    mkdir -p "$(dirname "$df_dest")"
    backup_existing "$df_dest"
    download "$(source_url "$ii_source")" "$df_dest" "$ii_digest" || return 1
    chmod "$df_mode" "$df_dest"
    if [ "$df_once" = 1 ]; then
        state_record "$ii_name" file-once "$ii_version" "$df_dest"
    else
        state_record "$ii_name" file "$ii_version" "$df_dest"
    fi
    say "  $df_dest"
    return 0
}

# Plugins fish's own plugin manager fetches. Keeping them current is fisher's
# job, not tlstore's, so update never touches them.
do_fisher() {
    if ! have fish; then
        err "$ii_name needs fish — install it first"
        return 1
    fi
    say "installing $ii_name"
    if ! fish -c "fisher install $ii_source" </dev/null; then
        err "could not install $ii_name"
        return 1
    fi
    state_record "$ii_name" fisher "$ii_version"
    return 0
}

do_bundle() {
    state_record "$ii_name" bundle "$ii_version"
    return 0
}

# Reads one string field out of a single-line npm registry document.
json_field() {
    tr -d '\n' | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1
}

# npm_latest_version <npm:package#exe> — the version the registry's latest
# dist-tag points at now, or nothing when it cannot be reached.
npm_latest_version() {
    nl_package="${1#npm:}"
    nl_package="${nl_package%#*}"
    curl -fsSL --connect-timeout 5 --max-time 60 "$NPM_REGISTRY/$nl_package/latest" 2>/dev/null | json_field version
}

do_npm_musl() {
    np_package="${ii_source#npm:}"
    np_exe="${np_package##*#}"
    np_package="${np_package%#*}"
    np_dir=$(item_targets "$ii_name" npm-musl "$ii_target" "$ii_source")
    np_wrapper="${np_dir##* }"
    np_dir="${np_dir%% *}"

    for np_tool in curl tar sha512sum base64 od; do
        have "$np_tool" || { err "$np_tool is missing — install coreutils and tar"; return 1; }
    done
    have "$PATCHELF" || { err "patchelf is missing — install it and try again"; return 1; }

    np_loader_row=$(row musl-loader)
    if [ -z "$np_loader_row" ]; then
        err "$ii_name has no loader for this device"
        return 1
    fi

    say "installing $ii_name"
    np_want="${ii_version:-latest}"
    np_meta=$(curl -fsSL --connect-timeout 5 --max-time 60 "$NPM_REGISTRY/$np_package/$np_want") || {
        err "could not reach the $ii_name download"
        return 1
    }
    np_version=$(printf '%s' "$np_meta" | json_field version)
    np_tarball=$(printf '%s' "$np_meta" | json_field tarball)
    np_integrity=$(printf '%s' "$np_meta" | json_field integrity)
    case "$np_integrity" in
        sha512-*) ;;
        *) err "$ii_name came without a checksum — nothing was installed"; return 1 ;;
    esac
    np_expect=$(printf '%s' "${np_integrity#sha512-}" | base64 -d | od -An -v -tx1 | tr -d ' \n')

    if [ -x "$np_dir/$np_exe" ] && [ "$(cat "$np_dir/version" 2>/dev/null)" = "$np_version" ]; then
        say "  $ii_name $np_version is already here"
    else
        say "  downloading $ii_name $np_version"
        mkdir -p "$(dirname "$np_dir")"
        np_tmp="$CACHE_DIR/$ii_name.tgz"
        mkdir -p "$CACHE_DIR"
        CANCEL_TMP="$np_tmp"
        curl_to "$np_tarball" "$np_tmp" || { rm -f "$np_tmp"; CANCEL_TMP=""; err "could not download $ii_name"; return 1; }
        np_actual=$(sha512sum "$np_tmp" | cut -d' ' -f1)
        if [ "$np_actual" != "$np_expect" ]; then
            rm -f "$np_tmp"
            CANCEL_TMP=""
            err "$ii_name does not match its checksum — nothing was installed"
            return 1
        fi
        CANCEL_TMP=""
        rm -rf "$np_dir.new"
        mkdir -p "$np_dir.new"
        CANCEL_EXTRA="$np_dir.new"
        if ! tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 "package/$np_exe"; then
            rm -f "$np_tmp"
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            err "the $ii_name download is not what was expected"
            return 1
        fi
        tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 package/LICENSE.md 2>/dev/null || true
        rm -f "$np_tmp"

        np_loader="$np_dir.new/ld-musl-aarch64.so.1"
        np_have_loader=$(item_targets musl-loader binary "$(field "$np_loader_row" 7)")
        if [ -f "$np_have_loader" ]; then
            cp -f "$np_have_loader" "$np_loader"
        elif ! download "$(source_url "$(field "$np_loader_row" 5)")" "$np_loader" "$(field "$np_loader_row" 6)"; then
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            return 1
        fi
        chmod 755 "$np_loader" "$np_dir.new/$np_exe"

        # Some of these binaries need more of the musl world than its libc —
        # opencode links libstdc++ and libgcc_s, and Termux's own are Bionic
        # ones the musl loader cannot use. They go in beside the loader,
        # because the rpath set below is this directory and nothing else.
        for np_lib in $(commas "$(opt "$ii_options" musl-libs)"); do
            np_lib_row=$(row "$np_lib")
            if [ -z "$np_lib_row" ]; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                err "$ii_name has no $np_lib for this device"
                return 1
            fi
            np_lib_have=$(item_targets "$np_lib" binary "$(field "$np_lib_row" 7)")
            np_lib_dest="$np_dir.new/${np_lib_have##*/}"
            if [ -f "$np_lib_have" ]; then
                cp -f "$np_lib_have" "$np_lib_dest"
            elif ! download "$(source_url "$(field "$np_lib_row" 5)")" "$np_lib_dest" "$(field "$np_lib_row" 6)"; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                return 1
            fi
            chmod 644 "$np_lib_dest"
        done

        if ! "$PATCHELF" --set-interpreter "$np_dir/ld-musl-aarch64.so.1" --set-rpath "$np_dir" "$np_dir.new/$np_exe"; then
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            err "could not prepare $ii_name for this device"
            return 1
        fi
        printf '%s\n' "$np_version" > "$np_dir.new/version"
        CANCEL_EXTRA=""
        rm -rf "$np_dir.old"
        [ ! -e "$np_dir" ] || mv "$np_dir" "$np_dir.old"
        mv "$np_dir.new" "$np_dir"
        rm -rf "$np_dir.old"
    fi

    mkdir -p "$BIN_DIR"
    backup_existing "$np_wrapper"
    np_envs=$(commas "$(opt "$ii_options" env)")
    {
        printf '#!%s/bin/sh\n' "$PREFIX"
        printf '# written by termux-launcher\n'
        for np_e in $np_envs; do
            printf 'export %s\n' "$np_e"
        done
        if [ "$(opt "$ii_options" tz)" = 1 ]; then
            # shellcheck disable=SC2016  # written into the wrapper, expanded there
            printf '%s\n' '[ -n "${TZ:-}" ] || TZ=$(getprop persist.sys.timezone 2>/dev/null) && export TZ'
        fi
        printf 'exec "%s" "$@"\n' "$np_dir/$np_exe"
    } > "$np_wrapper"
    chmod 755 "$np_wrapper"
    state_record "$ii_name" npm-musl "$np_version" "$np_dir" "$np_wrapper"
    say "  $np_wrapper"
    return 0
}

# ---------------------------------------------------------------------------
# Removing
# ---------------------------------------------------------------------------

remove_item() {
    ri_name="$1"
    ri_row=$(state_row "$ri_name" 2>/dev/null || true)
    if [ -z "$ri_row" ]; then
        say "$ri_name is not installed"
        return 0
    fi
    ri_kind=$(field "$ri_row" 2)
    ri_files=$(field "$ri_row" 5)
    if [ "$ri_kind" = fisher ]; then
        ri_item=$(row "$ri_name")
        if [ -n "$ri_item" ] && have fish; then
            fish -c "fisher remove $(field "$ri_item" 5)" </dev/null >/dev/null 2>&1 || true
        fi
    fi
    for ri_f in $ri_files; do
        if [ -d "$ri_f" ]; then
            rm -rf "$ri_f"
        else
            rm -f "$ri_f"
        fi
        restore_backup "$ri_f" && say "  put your own $(basename "$ri_f") back"
    done
    state_forget "$ri_name"
    case "$ri_kind" in
        pkg) say "$ri_name is no longer tracked; the package itself stays installed" ;;
        bundle) say "removed $ri_name" ;;
        *) say "removed $ri_name" ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Refresh
# ---------------------------------------------------------------------------

# refresh_catalog <quiet> — 0 took a newer list, 1 kept the one we had, 2 refused
# what was offered.
refresh_catalog() {
    rc_quiet="${1:-0}"
    if ! have minisign; then
        [ "$rc_quiet" = 1 ] && return 1
        if ask_yn "Updating the list of items needs minisign. Install it?"; then
            install_pkg minisign >/dev/null 2>&1 || true
        fi
        if ! have minisign; then
            say "Using the list that came with the app."
            return 1
        fi
    fi
    if [ ! -f "$PUBKEY" ]; then
        [ "$rc_quiet" = 1 ] || say "Using the list that came with the app."
        return 1
    fi
    mkdir -p "$CACHE_DIR"
    rc_new="$CACHE_DIR/catalog.tsv"
    rc_sig="$CACHE_DIR/catalog.tsv.minisig"
    if ! curl -fsL --connect-timeout 5 --max-time 60 -o "$rc_new" "$CATALOG_URL" 2>/dev/null ||
       ! curl -fsL --connect-timeout 5 --max-time 60 -o "$rc_sig" "$CATALOG_URL.minisig" 2>/dev/null; then
        rm -f "$rc_new" "$rc_sig"
        [ "$rc_quiet" = 1 ] || say "Could not reach the item list; using the one you have."
        return 1
    fi
    if ! minisign -Q -V -p "$PUBKEY" -x "$rc_sig" -m "$rc_new" >/dev/null 2>&1; then
        rm -f "$rc_new" "$rc_sig"
        err "the downloaded item list is not signed by the launcher — ignoring it"
        return 2
    fi
    rc_serial=$(serial_of "$rc_new" 2>/dev/null || true)
    case "$rc_serial" in
        ''|*[!0-9]*)
            rm -f "$rc_new" "$rc_sig"
            err "the downloaded item list is unreadable — ignoring it"
            return 2
            ;;
    esac
    if [ -n "$CATALOG_SERIAL" ] && [ "$rc_serial" -lt "$CATALOG_SERIAL" ]; then
        rm -f "$rc_new" "$rc_sig"
        err "the downloaded item list is older than the one you have — ignoring it"
        return 2
    fi
    if [ -n "$CATALOG_SERIAL" ] && [ "$rc_serial" -eq "$CATALOG_SERIAL" ]; then
        rm -f "$rc_new" "$rc_sig"
        [ "$rc_quiet" = 1 ] || say "The item list is already up to date."
        return 1
    fi
    mkdir -p "$DATA_DIR"
    mv "$rc_new" "$USER_CATALOG" || return 1
    rm -f "$rc_sig"
    pick_catalog
    say "Updated the list of items."
    return 0
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

# pick_items <candidates file: name TAB summary> <chosen file>
pick_items() {
    pi_list="$1"
    pi_out="$2"
    : > "$pi_out"
    [ -s "$pi_list" ] || return 0
    pi_count=$(awk 'END { print NR }' "$pi_list")
    pi_sel=""
    while :; do
        say ""
        awk -F "$TAB" -v sel=" $pi_sel " '
            { mark = (index(sel, " " NR " ") > 0) ? "x" : " "
              printf "  [%s] %2d  %-18s %s\n", mark, NR, $1, $2 }
        ' "$pi_list"
        say ""
        say "Type numbers to pick, a for all, n for none, Enter when you are done."
        printf '> '
        read -r pi_reply || pi_reply=""
        case "$pi_reply" in
            '') break ;;
            a|A)
                pi_sel=""
                pi_i=1
                while [ "$pi_i" -le "$pi_count" ]; do
                    pi_sel="$pi_sel $pi_i"
                    pi_i=$((pi_i + 1))
                done
                ;;
            n|N) pi_sel="" ;;
            q|Q) pi_sel=""; break ;;
            *)
                for pi_tok in $pi_reply; do
                    case "$pi_tok" in
                        ''|*[!0-9]*) say "  $pi_tok is not one of the numbers"; continue ;;
                    esac
                    if [ "$pi_tok" -lt 1 ] || [ "$pi_tok" -gt "$pi_count" ]; then
                        say "  $pi_tok is not one of the numbers"
                        continue
                    fi
                    if in_list "$pi_sel" "$pi_tok"; then
                        pi_sel=$(printf '%s' " $pi_sel " | sed "s/ $pi_tok / /")
                    else
                        pi_sel="$pi_sel $pi_tok"
                    fi
                done
                ;;
        esac
    done
    [ -n "$pi_sel" ] || return 0
    for pi_n in $pi_sel; do
        awk -F "$TAB" -v want="$pi_n" 'NR == want { print $1 }' "$pi_list" >> "$pi_out"
    done
    return 0
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
tlstore installs the tools and configs the launcher shows off.

  tlstore list [-i|-a]        everything, what you have (-i), what you do not (-a)
  tlstore search <term>       find an item by name or description
  tlstore info <name>         what an item is and where it goes
  tlstore install [name...]   install items; with no names, pick from a list
  tlstore remove <name...>    remove items tlstore installed
  tlstore update [name...]    bring what you have up to date
  tlstore refresh             update the list of items
  tlstore self-update         bring tlstore itself up to date (--check: only say)
  tlstore shell               install the fish shell setup
  tlstore display             set up graphics for Linux apps
  tlstore doctor              check that everything is in place
  tlstore version

  -y          say yes to everything except a config file of yours
  --configs   take the new version of every config file too
EOF
}

# emit_items <style list|search> <all|installed|available> <tsv 0|1> [term]
# The one place the item list is printed, for people and for programs. The
# machine-readable columns are name, state, version, installed, kind, summary,
# category, featured — the two tlstore-ui needs for the Apps screen's chips
# and cover picture without an `info` call per item.
emit_items() {
    ei_style="$1"
    ei_mode="$2"
    ei_tsv="$3"
    ei_term="${4:-}"
    visible_rows | awk -F "$TAB" -v term="$ei_term" '
        BEGIN { t = tolower(term) }
        t == "" || index(tolower($1), t) > 0 || index(tolower($10), t) > 0 {
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $9, $10, $11, $26
        }' |
    while IFS="$TAB" read -r ei_name ei_kind ei_version ei_options ei_summary ei_category ei_featured; do
        if is_installed "$ei_name"; then
            [ "$ei_mode" = available ] && continue
            ei_state=installed
            ei_have=$(installed_version "$ei_name")
            ei_mark="*"
        else
            [ "$ei_mode" = installed ] && continue
            ei_state=available
            ei_have=""
            ei_mark=" "
        fi
        if [ "$ei_tsv" = 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$ei_name" "$ei_state" "$ei_version" "$ei_have" "$ei_kind" "$ei_summary" \
                "$ei_category" "$ei_featured"
            continue
        fi
        if [ "$ei_style" = list ]; then
            printf '%s %-14s %s\n' "$ei_mark" "$ei_name" "$ei_summary"
            ei_build=$(opt "$ei_options" build)
            [ -z "$ei_build" ] || printf '    needs while installing: %s\n' "$ei_build"
        else
            printf '  %-14s %s\n' "$ei_name" "$ei_summary"
        fi
    done
    return 0
}

cmd_list() {
    cl_mode=all
    cl_tsv=0
    for cl_a in "$@"; do
        case "$cl_a" in
            -i) cl_mode=installed ;;
            -a) cl_mode=available ;;
            --tsv) cl_tsv=1 ;;
            *) err "unknown option: $cl_a"; return 2 ;;
        esac
    done
    need_catalog
    emit_items list "$cl_mode" "$cl_tsv"
}

cmd_search() {
    cs_tsv=0
    cs_term=""
    for cs_a in "$@"; do
        case "$cs_a" in
            --tsv) cs_tsv=1 ;;
            -*) err "unknown option: $cs_a"; return 2 ;;
            *)
                if [ -n "$cs_term" ]; then
                    err "search takes one thing to look for"
                    return 2
                fi
                cs_term="$cs_a"
                ;;
        esac
    done
    [ -n "$cs_term" ] || { err "search needs something to look for"; return 2; }
    need_catalog
    emit_items search all "$cs_tsv" "$cs_term"
}

cmd_info() {
    ci_tsv=0
    ci_want=""
    for ci_a in "$@"; do
        case "$ci_a" in
            --tsv) ci_tsv=1 ;;
            -*) err "unknown option: $ci_a"; return 2 ;;
            *)
                if [ -n "$ci_want" ]; then
                    err "info needs one name"
                    return 2
                fi
                ci_want="$ci_a"
                ;;
        esac
    done
    [ -n "$ci_want" ] || { err "info needs one name"; return 2; }
    need_catalog
    load_item "$ci_want" || { err "$ci_want is not in the list"; return 1; }
    ci_files=$(item_targets "$it_name" "$it_kind" "$it_target" "$it_source" "$it_options")
    ci_where="$ci_files"
    case "$it_kind" in
        pkg) ci_where="$it_source" ;;
        bundle) ci_where="-" ;;
    esac
    [ -n "$ci_where" ] || ci_where="-"
    ci_build=$(opt "$it_options" build)
    if [ "$ci_tsv" = 1 ]; then
        printf '%s\t%s\n' Kind "$it_kind"
        printf '%s\t%s\n' Version "$it_version"
        printf '%s\t%s\n' From "$it_source"
        printf '%s\t%s\n' Checksum "$it_digest"
        printf '%s\t%s\n' Needs "$it_requires"
        [ -z "$ci_build" ] || printf '%s\t%s\n' "Builds with" "$ci_build"
        printf '%s\t%s\n' Files "$ci_where"
        if is_installed "$it_name"; then
            printf '%s\t%s\n' Installed "$(installed_version "$it_name")"
        fi
        printf '%s\t%s\n' Summary "$it_summary"
        # The item spread, for tlstore-ui: everything item-spread-rules.md
        # needs to draw the item's own page, one key per line, an unknown
        # value ("-") dropping its row the same way "Builds with" does above.
        [ "$it_category" = - ] || printf '%s\t%s\n' Category "$it_category"
        [ "$it_upstream" = - ] || printf '%s\t%s\n' Upstream "$it_upstream"
        printf '%s\t%s\n' Setup "$it_setup"
        [ "$it_standfirst" = - ] || printf '%s\t%s\n' Standfirst "$it_standfirst"
        [ "$it_does1" = - ] || printf '%s\t%s\n' Does1 "$it_does1"
        [ "$it_does2" = - ] || printf '%s\t%s\n' Does2 "$it_does2"
        [ "$it_does3" = - ] || printf '%s\t%s\n' Does3 "$it_does3"
        [ "$it_try" = - ] || printf '%s\t%s\n' Try "$it_try"
        [ "$it_notes" = - ] || printf '%s\t%s\n' Notes "$it_notes"
        [ "$it_author" = - ] || printf '%s\t%s\n' Author "$it_author"
        [ "$it_licence" = - ] || printf '%s\t%s\n' Licence "$it_licence"
        [ "$it_size" = - ] || printf '%s\t%s\n' Size "$it_size"
        if [ "$it_picture" != - ]; then
            printf '%s\t%s\n' Picture "$it_picture"
            printf '%s\t%s\n' Picture-digest "$it_picture_digest"
        fi
        if [ "$it_demo" != - ]; then
            printf '%s\t%s\n' Demo "$it_demo"
            [ "$it_demo_digest" = - ] || printf '%s\t%s\n' Demo-digest "$it_demo_digest"
        fi
        printf '%s\t%s\n' Featured "$it_featured"
        [ "$it_readme_skip" = - ] || printf '%s\t%s\n' Readme-skip "$it_readme_skip"
        if [ "$it_readme" != - ]; then
            printf '%s\t%s\n' Readme "$it_readme"
            [ "$it_readme_digest" = - ] || printf '%s\t%s\n' Readme-digest "$it_readme_digest"
        fi
        return 0
    fi
    say "$it_name"
    say "  $it_summary"
    printf '  %-11s %s\n' Kind "$it_kind"
    printf '  %-11s %s\n' Version "$it_version"
    printf '  %-11s %s\n' From "$it_source"
    printf '  %-11s %s\n' Checksum "$it_digest"
    printf '  %-11s %s\n' Needs "$it_requires"
    [ -z "$ci_build" ] || printf '  %-11s %s\n' "Builds with" "$ci_build"
    printf '  %-11s %s\n' Files "$ci_where"
    if is_installed "$it_name"; then
        printf '  %-11s %s\n' Installed "$(installed_version "$it_name")"
    fi
    [ "$it_category" = - ] || printf '  %-11s %s\n' Category "$it_category"
    [ "$it_upstream" = - ] || printf '  %-11s %s\n' Upstream "$it_upstream"
    [ "$it_author" = - ] || printf '  %-11s %s\n' Author "$it_author"
    [ "$it_licence" = - ] || printf '  %-11s %s\n' Licence "$it_licence"
    [ "$it_size" = - ] || printf '  %-11s %s\n' Size "$it_size"
    return 0
}

# sha256 of a short string, for caching a fetch that carries no digest of its
# own (an old catalog's demo has none — a fresh one carries demo-digest).
string_digest() {
    sd_tmp="$CACHE_DIR/.picture-url.$$"
    mkdir -p "$CACHE_DIR"
    printf '%s' "$1" > "$sd_tmp"
    sd_out=$(file_digest "$sd_tmp")
    rm -f "$sd_tmp"
    printf '%s' "$sd_out"
}

# ---------------------------------------------------------------------------
# The asset cache — pictures, demos and readmes for tlstore-ui
# ---------------------------------------------------------------------------
#
# Everything tlstore-ui shows lives under CACHE_DIR ($HOME/.cache/tlstore —
# the Termux home, under the app's files directory, which Android leaves
# alone; it is not the app's cache directory the system may clear):
#
#   pictures/<digest>.<ext>            a picture or demo, keyed by the catalog's
#                                      digest (by the sha256 of its URL when an
#                                      old catalog carries none)
#   readme/pinned/<digest>.md          a pinned readme, keyed by its digest
#   readme/<name>-<version>.md, .ref   an upstream readme and the revision it
#                                      was read at, keyed by the item's version
#   readme/<name>/<ref>/<urldigest>.<ext>
#                                      a picture that readme refers to
#   snapshot.tsv                       the last `snapshot --tsv`, with its key
#   .changed                           touched whenever any of the above moves
#
# A digest-keyed file is final: it is fetched once and served for as long as
# the catalog names that digest. A version-keyed one is fetched once per
# version; `prefetch` revalidates it at most once a day (curl -z, in the
# background), and `readme` / `readme-asset` — the open path — always serve
# whatever copy is here, offline or not. `prefetch` also throws away what the
# active catalog no longer names.

# cache_stamp — something under CACHE_DIR changed (a fetch landed, an orphan
# went), so the next `snapshot` knows its cached copy is stale.
cache_stamp() {
    mkdir -p "$CACHE_DIR"
    touch "$CACHE_DIR/.changed"
}

# file_stamp <file> — its mtime and size, "-" when it is not there.
file_stamp() {
    [ -e "$1" ] || { printf '%s' -; return 0; }
    stat -c '%Y.%s' "$1" 2>/dev/null || stat -f '%m.%z' "$1" 2>/dev/null || printf '?'
}

# stale_day <file> — is the copy a day old or more?
stale_day() {
    [ -f "$1" ] || return 1
    [ -n "$(find "$1" -mtime +0 2>/dev/null)" ]
}

# A local, verified copy of <url> (checked against <digest> unless it is "-"),
# cached under CACHE_DIR/pictures keyed by the digest so a second call for the
# same picture never touches the network. Prints the path on success only.
# cache_fetch <url> <digest> <extension>
cache_fetch() {
    cf_url="$1"
    cf_digest="$2"
    cf_ext="$3"
    mkdir -p "$CACHE_DIR/pictures"
    if [ -n "$cf_digest" ] && [ "$cf_digest" != "-" ]; then
        cf_key="$cf_digest"
    else
        cf_key=$(string_digest "$cf_url")
    fi
    cf_dest="$CACHE_DIR/pictures/$cf_key.$cf_ext"
    if [ -f "$cf_dest" ]; then
        printf '%s\n' "$cf_dest"
        return 0
    fi
    download "$cf_url" "$cf_dest" "$cf_digest" || return 1
    cache_stamp
    printf '%s\n' "$cf_dest"
    return 0
}

# picture_fetch <source> <digest> — the cached, verified copy of a picture or
# demo source field (the path `tlstore picture` prints), fetched when missing.
picture_fetch() {
    pf_url=$(source_url "$1")
    pf_ext="${pf_url##*.}"
    case "$pf_ext" in
        ''|*[!a-zA-Z0-9]*) pf_ext=jpg ;;
    esac
    cache_fetch "$pf_url" "$2" "$pf_ext"
}

# tlstore picture <name> [demo] — for tlstore-ui: the local path of the item's
# cover picture, or its demo when "demo" is given, fetched and digest-checked
# the same way any other launcher: source is (see load_item / picture,
# picture-digest, demo, demo-digest). A catalog from before demo-digest
# carries "-" there, so it is only cached by its URL, not verified against
# one. Prints nothing and exits non-zero when the item has no such picture,
# the download fails, or the digest does not match.
cmd_picture() {
    cp_name=""
    cp_demo=0
    for cp_a in "$@"; do
        case "$cp_a" in
            demo) cp_demo=1 ;;
            -*) err "unknown option: $cp_a"; return 2 ;;
            *)
                if [ -n "$cp_name" ]; then
                    err "picture needs one name"
                    return 2
                fi
                cp_name="$cp_a"
                ;;
        esac
    done
    [ -n "$cp_name" ] || { err "picture needs a name"; return 2; }
    need_catalog
    load_item "$cp_name" || return 1
    if [ "$cp_demo" = 1 ]; then
        cp_source="$it_demo"
        cp_digest="$it_demo_digest"
    else
        cp_source="$it_picture"
        cp_digest="$it_picture_digest"
    fi
    [ "$cp_source" != "-" ] && [ -n "$cp_source" ] || return 1
    picture_fetch "$cp_source" "$cp_digest"
}

# ---------------------------------------------------------------------------
# The upstream README, for tlstore-ui's item page
# ---------------------------------------------------------------------------

# github_url <https address> — the address actually fetched: the real one, or
# the same host and path under the TLSTORE_GITHUB tree when it is set.
github_url() {
    if [ -n "$GITHUB_MIRROR" ]; then
        printf '%s/%s' "$GITHUB_MIRROR" "${1#https://}"
    else
        printf '%s' "$1"
    fi
}

# github_host_ok <address> — only https on GitHub's own hosts is fetched for a
# README's pictures; anything else is left where it is.
github_host_ok() {
    case "$1" in
        https://*) ;;
        *) return 1 ;;
    esac
    gh_host="${1#https://}"
    gh_host="${gh_host%%/*}"
    gh_host="${gh_host##*@}"
    gh_host="${gh_host%%:*}"
    case "$gh_host" in
        github.com|raw.githubusercontent.com|user-images.githubusercontent.com) return 0 ;;
        *.githubusercontent.com|github.io|*.github.io) return 0 ;;
    esac
    return 1
}

# quiet_fetch <https address> <destination> <cap in bytes, 0 for none>
# [<copy to revalidate>] — a silent download, written beside its destination
# first (under this process's pid, so a prefetch lane and an item opened early
# never share a part file) so a failure leaves nothing behind. A missing file,
# a network error and a file over the cap all fail the same way; the caller
# says what that means. With a fourth argument the request is conditional on
# that copy's age (curl -z): when the server has nothing newer, nothing is
# written and the function still succeeds — the caller checks for the file.
# Five seconds to connect and a minute for the whole file: a readme is small.
quiet_fetch() {
    qf_dir=$(dirname "$2")
    mkdir -p "$qf_dir" || return 1
    qf_tmp="$qf_dir/.$(basename "$2").$$.part"
    if [ -n "${4:-}" ]; then
        if ! curl -fsL --connect-timeout 5 --max-time 60 --max-filesize "$3" -z "$4" -o "$qf_tmp" "$(github_url "$1")" 2>/dev/null; then
            rm -f "$qf_tmp"
            return 1
        fi
        [ -s "$qf_tmp" ] || { rm -f "$qf_tmp"; return 0; }
    elif ! curl -fsL --connect-timeout 5 --max-time 60 --max-filesize "$3" -o "$qf_tmp" "$(github_url "$1")" 2>/dev/null; then
        rm -f "$qf_tmp"
        return 1
    fi
    # The cap above only holds when the server says the size up front.
    if [ "$3" != 0 ] && [ "$(wc -c < "$qf_tmp" | tr -d ' ')" -gt "$3" ]; then
        rm -f "$qf_tmp"
        return 1
    fi
    mv "$qf_tmp" "$2"
}

# readme_ref <version> — the revision an item's README is read at: the commit
# in a +<hash> suffix (dawn's 0.1.3+0e958747.2 is read at 0e958747), else
# v<version> for an x.y.z version, else HEAD.
readme_ref() {
    case "$1" in
        *+*)
            rr_hash="${1#*+}"
            rr_hash=$(printf '%s' "$rr_hash" | sed 's/[^0-9a-fA-F].*//')
            case "$rr_hash" in
                ???????*) printf '%s' "$rr_hash"; return 0 ;;
            esac
            ;;
    esac
    case "$1" in
        [0-9]*.[0-9]*.[0-9]*) printf 'v%s' "$1" ;;
        *) printf 'HEAD' ;;
    esac
}

# readme_resolve — after load_item: sets RD_PATH to the item's cached README
# and RD_REF to the revision it was read at, fetching only when there is no
# copy for this version yet. A tag that is not there falls back to HEAD. The
# copy is keyed by the item's version, so a new one is fetched when the
# catalog moves the item on; `prefetch` revalidates it once a day
# (readme_revalidate). Returns 1 when there is no copy at all, 2 when the item
# has no upstream to read (a setup, or a part).
readme_resolve() {
    RD_PATH=""
    RD_REF=""
    [ -n "$it_upstream" ] && [ "$it_upstream" != "-" ] || return 2
    rd_dir="$CACHE_DIR/readme"
    rd_md="$rd_dir/$it_name-$it_version.md"
    rd_reffile="$rd_dir/$it_name-$it_version.ref"
    rd_want=$(readme_ref "$it_version")
    if [ ! -f "$rd_md" ]; then
        rd_new="$rd_dir/.$it_name-$it_version.$$.new"
        for rd_try in "$rd_want" HEAD; do
            if quiet_fetch "$GITHUB_RAW/$it_upstream/$rd_try/README.md" "$rd_new" 0; then
                mv "$rd_new" "$rd_md" || return 1
                printf '%s\n' "$rd_try" > "$rd_reffile"
                cache_stamp
                break
            fi
            [ "$rd_try" != HEAD ] || break
        done
    fi
    [ -f "$rd_md" ] || return 1
    RD_PATH="$rd_md"
    RD_REF=$(cat "$rd_reffile" 2>/dev/null || true)
    [ -n "$RD_REF" ] || RD_REF="$rd_want"
    return 0
}

# readme_revalidate — after readme_resolve found a copy: once a day, asks
# GitHub whether the README at that revision has moved (curl -z) and takes the
# newer one when it has. Either way the copy's clock is reset, so the question
# is asked at most daily, and a copy that cannot be checked stays as it is.
readme_revalidate() {
    [ -n "$RD_PATH" ] || return 0
    stale_day "$RD_PATH" || return 0
    rv_new="$CACHE_DIR/readme/.$it_name-$it_version.$$.new"
    if quiet_fetch "$GITHUB_RAW/$it_upstream/$RD_REF/README.md" "$rv_new" 0 "$RD_PATH" && [ -s "$rv_new" ]; then
        mv "$rv_new" "$RD_PATH" && cache_stamp
    fi
    rm -f "$rv_new"
    touch "$RD_PATH" 2>/dev/null || true
    return 0
}

# readme_resolve_pinned — after load_item, when it_readme is not "-": a local,
# digest-verified copy of the pinned readme (see load_item / readme,
# readme-digest), cached under CACHE_DIR/readme/pinned keyed by the digest so
# a second call never touches the network — the same scheme `tlstore picture`
# already uses for a cover picture. Sets RD_PATH and returns 0 on success;
# returns 1, printing nothing, when the download fails or the digest does not
# match (download() prints the one clear line either way). A digest mismatch
# is never a silent fall back to the upstream readme, the same as a picture
# whose digest does not match is never silently served from somewhere else.
readme_resolve_pinned() {
    RD_PATH=""
    rp_url=$(source_url "$it_readme")
    rp_dir="$CACHE_DIR/readme/pinned"
    rp_dest="$rp_dir/$it_readme_digest.md"
    if [ -f "$rp_dest" ]; then
        RD_PATH="$rp_dest"
        return 0
    fi
    mkdir -p "$rp_dir" || return 1
    download "$rp_url" "$rp_dest" "$it_readme_digest" || return 1
    cache_stamp
    RD_PATH="$rp_dest"
    return 0
}

# tlstore readme <name> — for tlstore-ui: the path of the item's README. When
# the catalog pins one (readme, readme-digest — see load_item), that digest-
# verified copy is fetched, cached and served, and a mismatch is a hard
# failure with no fallback to upstream. Otherwise the upstream README is read
# at the revision the item is built from (readme_ref) and kept under
# CACHE_DIR/readme for as long as the item stays at that version; a copy that
# is here is served at once, whatever its age (`prefetch` keeps it current).
# Prints the path alone on stdout; exits 1 with one line on stderr when
# nothing could be fetched and nothing is kept, 2 when the item has no
# upstream and no pinned readme (a setup).
cmd_readme() {
    [ $# -eq 1 ] || { err "readme needs one name"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    if [ "$it_readme" != "-" ]; then
        readme_resolve_pinned && { printf '%s\n' "$RD_PATH"; return 0; }
        return 1
    fi
    readme_resolve
    rd_rc=$?
    case "$rd_rc" in
        0) printf '%s\n' "$RD_PATH"; return 0 ;;
        2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
        *) err "could not fetch the readme for $it_name, and no copy is kept here"; return 1 ;;
    esac
}

# readme_asset_fetch <src> <revalidate 0|1> — after load_item: the cached copy
# of a picture the item's README refers to, fetched when missing. <src> is
# the address as written in the README: relative (resolved against the
# README's own revision on raw.githubusercontent.com) or an https address on
# one of GitHub's hosts; anything else returns 1. At most 5 MB. The copy lives
# under CACHE_DIR/readme/<name>/<ref>/, keyed by the address, so it moves on
# with the README's revision; with <revalidate> 1 (the prefetch) a copy a day
# old is checked against GitHub first. Prints the path alone on stdout.
readme_asset_fetch() {
    ra_src="$1"
    ra_reval="${2:-0}"
    case "$ra_src" in
        https://*)
            github_host_ok "$ra_src" || { err "$ra_src is not on GitHub — left alone"; return 1; }
            ;;
        *:*|//*)
            err "$ra_src is not on GitHub — left alone"
            return 1
            ;;
    esac
    # The README the address belongs to, and the revision its copy is kept
    # under: the README's own, or the commit a pinned copy names on its first
    # line (<!-- tlstore: pinned from owner/repo@sha -->), so the pictures go
    # when the README moves on.
    ra_pin=""
    ra_rc=0
    if [ "$it_readme" != "-" ]; then
        readme_resolve_pinned || { err "could not fetch the readme for $it_name, so $ra_src has nothing to be relative to"; return 1; }
        ra_pin=$(sed -n '1s/^<!-- tlstore: pinned from \([A-Za-z0-9._-]*\/[A-Za-z0-9._-]*\)@\([0-9a-f]*\) -->$/\1@\2/p' "$RD_PATH")
        ra_ref="${ra_pin##*@}"
        [ -n "$ra_ref" ] || ra_ref=pinned
    else
        readme_resolve
        ra_rc=$?
        ra_ref="${RD_REF:-HEAD}"
    fi
    case "$ra_src" in
        https://*) ra_url="$ra_src" ;;
        *)
            ra_rel="${ra_src#./}"
            ra_rel="${ra_rel#/}"
            if [ "$it_readme" != "-" ]; then
                case "$ra_pin" in
                    */*@?*) ra_url="$GITHUB_RAW/${ra_pin%@*}/${ra_pin##*@}/$ra_rel" ;;
                    *) err "the pinned readme for $it_name does not say where it was taken from"; return 1 ;;
                esac
            else
                case "$ra_rc" in
                    0) ;;
                    2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
                    *) err "could not fetch the readme for $it_name, so $ra_src has nothing to be relative to"; return 1 ;;
                esac
                ra_url="$GITHUB_RAW/$it_upstream/$RD_REF/$ra_rel"
            fi
            ;;
    esac
    ra_file="${ra_url%%\?*}"
    ra_file="${ra_file%%#*}"
    ra_file="${ra_file##*/}"
    ra_ext=""
    case "$ra_file" in
        *.*)
            ra_ext="${ra_file##*.}"
            case "$ra_ext" in
                ''|*[!a-zA-Z0-9]*) ra_ext="" ;;
                *) ra_ext=".$ra_ext" ;;
            esac
            ;;
    esac
    ra_dir="$CACHE_DIR/readme/$it_name/$ra_ref"
    ra_dest="$ra_dir/$(string_digest "$ra_url")$ra_ext"
    ra_new="$ra_dir/.$(basename "$ra_dest").$$.new"
    if [ ! -f "$ra_dest" ]; then
        if quiet_fetch "$ra_url" "$ra_new" 5242880; then
            mv "$ra_new" "$ra_dest" || return 1
            cache_stamp
        fi
    elif [ "$ra_reval" = 1 ] && stale_day "$ra_dest"; then
        # A stale copy is only replaced by a fetch that brought something
        # newer, and its clock is reset either way.
        if quiet_fetch "$ra_url" "$ra_new" 5242880 "$ra_dest" && [ -s "$ra_new" ]; then
            mv "$ra_new" "$ra_dest" && cache_stamp
        fi
        rm -f "$ra_new"
        touch "$ra_dest" 2>/dev/null || true
    fi
    [ -f "$ra_dest" ] || { err "could not fetch $ra_src for $it_name"; return 1; }
    printf '%s\n' "$ra_dest"
    return 0
}

# tlstore readme-asset <name> <src> — for tlstore-ui: a picture the README
# refers to (readme_asset_fetch), served from the cache whenever a copy is
# here. Prints the path alone on stdout.
cmd_readme_asset() {
    [ $# -eq 2 ] || { err "readme-asset needs a name and a picture address"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    readme_asset_fetch "$2" 0
}

# readme_first_image <readme file> — the picture tlstore-ui puts in the
# header: the first image before the first H2 (markdown or <img>), leaving
# out SVGs, shields and badges the way the UI's parser does. Prints nothing
# when there is none.
readme_first_image() {
    awk '
        function usable(src) {
            s = tolower(src)
            sub(/[?#].*/, "", s)
            if (s ~ /\.svg$/) return 0
            if (index(tolower(src), "shields.io") > 0) return 0
            if (index(tolower(src), "badge") > 0) return 0
            if (index(tolower(src), "/badges/") > 0) return 0
            return 1
        }
        /^##[ \t]/ || /^##$/ || /<[Hh]2[ >]/ { exit }
        {
            line = $0
            while (match(line, /!\[[^]]*\]\([^)]*\)/)) {
                src = substr(line, RSTART, RLENGTH)
                sub(/^!\[[^]]*\]\(/, "", src)
                sub(/\)$/, "", src)
                sub(/[ \t].*/, "", src)
                if (src != "" && usable(src)) { print src; exit }
                line = substr(line, RSTART + RLENGTH)
            }
            line = $0
            while (match(line, /<[Ii][Mm][Gg][ \t][^>]*>/)) {
                tag = substr(line, RSTART, RLENGTH)
                if (match(tag, /[Ss][Rr][Cc][ \t]*=[ \t]*"[^"]*"/)) {
                    src = substr(tag, RSTART, RLENGTH)
                    sub(/^[Ss][Rr][Cc][ \t]*=[ \t]*"/, "", src)
                    sub(/"$/, "", src)
                } else if (match(tag, /[Ss][Rr][Cc][ \t]*=[ \t]*'"'"'[^'"'"']*'"'"'/)) {
                    src = substr(tag, RSTART, RLENGTH)
                    sub(/^[Ss][Rr][Cc][ \t]*=[ \t]*'"'"'/, "", src)
                    sub(/'"'"'$/, "", src)
                } else {
                    src = ""
                }
                if (src != "" && usable(src)) { print src; exit }
                line = substr(line, RSTART + RLENGTH)
            }
        }' "$1"
}

# ---------------------------------------------------------------------------
# One snapshot and one prefetch, for tlstore-ui
# ---------------------------------------------------------------------------

# snapshot_key — what `snapshot` reads: the catalog and the installed list
# (by name, mtime and size), the cache's stamp, and everything rows() filters
# on. When none of it changed, neither did the answer.
snapshot_key() {
    printf 'v=%s;serial=%s;catalog=%s:%s;state=%s;cache=%s;host=%s;arch=%s;pkg=%s;lver=%s;home=%s;prefix=%s' \
        "$TLSTORE_VERSION" "$CATALOG_SERIAL" "$CATALOG" "$(file_stamp "$CATALOG")" \
        "$(file_stamp "$STATE")" "$(file_stamp "$CACHE_DIR/.changed")" \
        "$HOST" "$ARCH_OK" "$APP_PACKAGE" "$LAUNCHER_VERSION" "$HOME" "$PREFIX"
}

# snapshot_rows — one awk pass over every row that applies here and the
# installed list: the `item` line of every visible item (the list --tsv
# columns), its `field` lines (the info --tsv rows, same keys, same order),
# an `update` line per installed item with a newer version here (the update
# --check --tsv --offline columns), and, for snapshot_cached to turn into
# `cached` lines, a `check` (path known) or `probe` (path keyed by the URL's
# digest) line per picture, demo and readme.
snapshot_rows() {
    rows | awk -F "$TAB" -v OFS="$TAB" -v state="$STATE" -v home="$HOME" \
        -v bindir="$BIN_DIR" -v libdir="$LIB_DIR" -v privdir="$PRIV_DIR" \
        -v cachedir="$CACHE_DIR" -v launcher_raw="$LAUNCHER_RAW" -v binaries_raw="$BINARIES_RAW" \
        -v binaries_rel="$BINARIES_RELEASES" '
        function optval(list, key,   n, i, parts) {
            n = split(list, parts, ";")
            for (i = 1; i <= n; i++)
                if (index(parts[i], key "=") == 1)
                    return substr(parts[i], length(key) + 2)
            return ""
        }
        function dash(v) { return (v == "") ? "-" : v }
        function expand(p) {
            if (p == "~") return home
            if (substr(p, 1, 2) == "~/") return home substr(p, 2)
            return p
        }
        # item_targets, as the shell does it.
        function targets(name, kind, target, source, opts,   exe, n, parts) {
            if (kind == "binary" || kind == "file" || kind == "file-once") {
                if (kind == "binary" && optval(opts, "priv") == "shizuku") {
                    if (target == "-" || target == "") return privdir "/" name " " bindir "/" name
                    return expand(target) " " bindir "/" name
                }
                if (target == "-" || target == "") return (kind == "binary") ? bindir "/" name : ""
                return expand(target)
            }
            if (kind == "npm-musl") {
                n = split(source, parts, "#")
                exe = (n > 1) ? parts[n] : name
                sub(/.*\//, "", exe)
                if (target == "-" || target == "") return libdir "/" name " " bindir "/" exe
                return expand(target) " " bindir "/" exe
            }
            return ""
        }
        # source_url, as the shell does it.
        function url_of(src,   rest, path, tag) {
            if (index(src, "launcher:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                return launcher_raw "/" tag "/" path
            }
            if (index(src, "binaries:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                if (index(path, "/") > 0) return binaries_raw "/" tag "/" path
                return binaries_rel "/" tag "/" path "-aarch64"
            }
            return src
        }
        function ext_of(url,   e) {
            e = url
            sub(/.*\./, "", e)
            if (e == "" || e ~ /[^a-zA-Z0-9]/) e = "jpg"
            return e
        }
        function put(name, key, value) { print "field", name, key, value }
        function put_known(name, key, value) { if (value != "-") put(name, key, value) }
        function asset(name, what, src, digest,   url) {
            url = url_of(src)
            if (digest != "-" && digest != "") print "check", name, what, cachedir "/pictures/" digest "." ext_of(url)
            else print "probe", name, what, url, ext_of(url)
        }
        BEGIN {
            while ((getline line < state) > 0) {
                if (line ~ /^#/) continue
                n = split(line, f, "\t")
                if (n > 0 && f[1] != "") { inst[f[1]] = 1; iver[f[1]] = f[3] }
            }
            close(state)
        }
        {
            name = $1; kind = $2; ver = $3; src = $5; dig = $6; target = $7
            req = $8; opts = $9; summary = $10
            hidden = (opts ~ /(^|;)hidden=1(;|$)/)
            have = (name in inst) ? iver[name] : ""
            if (!hidden) {
                print "item", name, (name in inst) ? "installed" : "available", ver, have, kind, summary, dash($11), $26
                where = targets(name, kind, target, src, opts)
                if (kind == "pkg") where = src
                else if (kind == "bundle") where = "-"
                if (where == "") where = "-"
                build = optval(opts, "build")
                put(name, "Kind", kind)
                put(name, "Version", ver)
                put(name, "From", src)
                put(name, "Checksum", dig)
                put(name, "Needs", req)
                if (build != "") put(name, "Builds with", build)
                put(name, "Files", where)
                if (name in inst) put(name, "Installed", have)
                put(name, "Summary", summary)
                put_known(name, "Category", dash($11))
                put_known(name, "Upstream", dash($12))
                put(name, "Setup", $13)
                put_known(name, "Standfirst", dash($14))
                put_known(name, "Does1", dash($15))
                put_known(name, "Does2", dash($16))
                put_known(name, "Does3", dash($17))
                put_known(name, "Try", dash($18))
                put_known(name, "Notes", dash($19))
                put_known(name, "Author", dash($20))
                put_known(name, "Licence", dash($21))
                put_known(name, "Size", dash($22))
                if (dash($23) != "-") {
                    put(name, "Picture", $23)
                    put(name, "Picture-digest", $24)
                }
                if (dash($25) != "-") {
                    put(name, "Demo", $25)
                    put_known(name, "Demo-digest", dash($30))
                }
                put(name, "Featured", $26)
                put_known(name, "Readme-skip", dash($27))
                if (dash($28) != "-") {
                    put(name, "Readme", $28)
                    put_known(name, "Readme-digest", dash($29))
                }
            }
            if (name in inst) {
                upd = 0
                if (kind == "pkg" || kind == "bundle" || kind == "fisher") upd = 0
                else if (kind == "npm-musl") upd = (ver != "latest" && ver != have)
                else upd = (ver != have)
                if (upd) print "update", name, have, ver, (kind == "file") ? "config-asks" : ""
            }
            if (!hidden) {
                if (dash($23) != "-") asset(name, "picture", $23, dash($24))
                if (dash($25) != "-") asset(name, "demo", $25, dash($30))
                if (dash($28) != "-") print "check", name, "readme", cachedir "/readme/pinned/" dash($29) ".md"
                else if (dash($12) != "-") print "check", name, "readme", cachedir "/readme/" name "-" ver ".md"
            }
        }'
}

# snapshot_cached — passes snapshot_rows through, turning each `check` and
# `probe` line into a `cached` line when the file is really here (nothing is
# forked for a check; a probe hashes the URL, as cache_fetch does).
snapshot_cached() {
    while IFS= read -r sc_line; do
        case "$sc_line" in
            "check$TAB"*|"probe$TAB"*)
                sc_kind="${sc_line%%"$TAB"*}"
                sc_rest="${sc_line#*"$TAB"}"
                sc_name="${sc_rest%%"$TAB"*}"
                sc_rest="${sc_rest#*"$TAB"}"
                sc_what="${sc_rest%%"$TAB"*}"
                sc_rest="${sc_rest#*"$TAB"}"
                if [ "$sc_kind" = probe ]; then
                    sc_url="${sc_rest%%"$TAB"*}"
                    sc_ext="${sc_rest#*"$TAB"}"
                    sc_path="$CACHE_DIR/pictures/$(string_digest "$sc_url").$sc_ext"
                else
                    sc_path="$sc_rest"
                fi
                if [ -f "$sc_path" ]; then
                    printf 'cached\t%s\t%s\t%s\n' "$sc_name" "$sc_what" "$sc_path"
                fi
                ;;
            *) printf '%s\n' "$sc_line" ;;
        esac
    done
    return 0
}

# tlstore snapshot --tsv — for tlstore-ui: everything its screens need, in one
# run. Line-typed, tab-separated, comment lines starting with #:
#   item    name state version installed kind summary category featured
#   field   name key value             (the info --tsv rows, one per line)
#   update  name installed available note
#   cached  name picture|demo|readme path   (a verified copy already here)
# The answer is kept under CACHE_DIR/snapshot.tsv with its key (snapshot_key)
# on the first line, and served from there while nothing it reads has moved.
cmd_snapshot() {
    sn_tsv=0
    for sn_a in "$@"; do
        case "$sn_a" in
            --tsv) sn_tsv=1 ;;
            *) err "unknown option: $sn_a"; return 2 ;;
        esac
    done
    [ "$sn_tsv" = 1 ] || { err "snapshot is for programs: use --tsv"; return 2; }
    need_catalog
    sn_key=$(snapshot_key)
    sn_file="$CACHE_DIR/snapshot.tsv"
    sn_head="# tlstore snapshot${TAB}key=$sn_key"
    if [ -f "$sn_file" ] && [ "$(head -1 "$sn_file" 2>/dev/null)" = "$sn_head" ]; then
        cat "$sn_file"
        return 0
    fi
    mkdir -p "$CACHE_DIR"
    sn_tmp="$sn_file.$$.new"
    {
        printf '%s\n' "$sn_head"
        snapshot_rows | snapshot_cached
    } > "$sn_tmp" || { rm -f "$sn_tmp"; return 1; }
    mv "$sn_tmp" "$sn_file" || { rm -f "$sn_tmp"; return 1; }
    cat "$sn_file"
    return 0
}

# prefetch_say <ready|failed> <name> <kind> <path or reason> [src] — one line
# of the prefetch stream, written whole (one short printf is one write).
prefetch_say() {
    if [ $# -ge 5 ]; then
        printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5"
    else
        printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"
    fi
}

# prefetch_item <name> — after need_catalog: the item's picture, demo, readme
# and the readme's first image, one line each as it lands. What is cached
# and verified is answered without a fetch.
prefetch_item() {
    load_item "$1" || return 0
    if [ "$it_picture" != "-" ] && [ -n "$it_picture" ]; then
        if pi_p=$(picture_fetch "$it_picture" "$it_picture_digest" 2>/dev/null); then
            prefetch_say ready "$it_name" picture "$pi_p"
        else
            prefetch_say failed "$it_name" picture "not fetched or not verified"
        fi
    fi
    if [ "$it_demo" != "-" ] && [ -n "$it_demo" ]; then
        if pi_p=$(picture_fetch "$it_demo" "$it_demo_digest" 2>/dev/null); then
            prefetch_say ready "$it_name" demo "$pi_p"
        else
            prefetch_say failed "$it_name" demo "not fetched or not verified"
        fi
    fi
    RD_PATH=""
    RD_REF=""
    if [ "$it_readme" != "-" ]; then
        if readme_resolve_pinned 2>/dev/null; then
            prefetch_say ready "$it_name" readme "$RD_PATH"
        else
            prefetch_say failed "$it_name" readme "not fetched or not verified"
        fi
    elif [ -n "$it_upstream" ] && [ "$it_upstream" != "-" ]; then
        readme_resolve 2>/dev/null
        pi_rc=$?
        if [ "$pi_rc" = 0 ]; then
            readme_revalidate
            prefetch_say ready "$it_name" readme "$RD_PATH"
        elif [ "$pi_rc" = 1 ]; then
            prefetch_say failed "$it_name" readme "not fetched, and no copy is kept"
        fi
    fi
    [ -n "$RD_PATH" ] || return 0
    pi_src=$(readme_first_image "$RD_PATH")
    [ -n "$pi_src" ] || return 0
    if pi_a=$(readme_asset_fetch "$pi_src" 1 2>/dev/null); then
        prefetch_say ready "$it_name" asset "$pi_a" "$pi_src"
    else
        prefetch_say failed "$it_name" asset "not fetched" "$pi_src"
    fi
    return 0
}

# prefetch_gc — throws away what the active catalog no longer names: a
# picture whose digest is gone, a pinned readme likewise, an upstream readme
# for a version an item has moved past, and a readme's pictures for an item
# or a revision that is gone. Files a fetch is still writing (dot files) are
# never touched.
prefetch_gc() {
    [ -d "$CACHE_DIR" ] || return 0
    gc_pics=" "
    gc_pins=" "
    gc_mds=" "
    gc_names=" "
    gc_subs=" "
    gc_changed=0
    gc_list=$(rows | awk -F "$TAB" -v OFS="$TAB" -v cachedir="$CACHE_DIR" \
        -v launcher_raw="$LAUNCHER_RAW" -v binaries_raw="$BINARIES_RAW" \
        -v binaries_rel="$BINARIES_RELEASES" '
        function dash(v) { return (v == "") ? "-" : v }
        function url_of(src,   rest, path, tag) {
            if (index(src, "launcher:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                return launcher_raw "/" tag "/" path
            }
            if (index(src, "binaries:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                if (index(path, "/") > 0) return binaries_raw "/" tag "/" path
                return binaries_rel "/" tag "/" path "-aarch64"
            }
            return src
        }
        function ext_of(url,   e) {
            e = url
            sub(/.*\./, "", e)
            if (e == "" || e ~ /[^a-zA-Z0-9]/) e = "jpg"
            return e
        }
        function asset(src, digest,   url) {
            url = url_of(src)
            if (digest != "-") print "pic", digest "." ext_of(url)
            else print "picurl", url, ext_of(url)
        }
        {
            name = $1; ver = $3
            if (dash($23) != "-") asset($23, dash($24))
            if (dash($25) != "-") asset($25, dash($30))
            print "name", name
            if (dash($28) != "-") {
                print "pin", dash($29) ".md"
                # Its pictures live under the commit the pinned copy names.
                pinfile = cachedir "/readme/pinned/" dash($29) ".md"
                keep = "*"
                if ((getline first < pinfile) > 0 && match(first, /@[0-9a-f][0-9a-f]* -->$/))
                    keep = substr(first, RSTART + 1, RLENGTH - 5)
                close(pinfile)
                print "sub", name, keep
            } else if (dash($12) != "-") {
                print "md", name "-" ver
                print "sub", name, "HEAD"
                print "sub", name, "v" ver
                hash = ver
                if (sub(/^[^+]*\+/, "", hash)) { sub(/[^0-9a-fA-F].*/, "", hash); if (length(hash) >= 7) print "sub", name, hash }
                reffile = cachedir "/readme/" name "-" ver ".ref"
                if ((getline r < reffile) > 0 && r != "") print "sub", name, r
                close(reffile)
            }
        }')
    while IFS= read -r gc_line; do
        gc_t="${gc_line%%"$TAB"*}"
        gc_rest="${gc_line#*"$TAB"}"
        case "$gc_t" in
            pic) gc_pics="$gc_pics$gc_rest " ;;
            picurl)
                gc_url="${gc_rest%%"$TAB"*}"
                gc_ext="${gc_rest#*"$TAB"}"
                gc_pics="$gc_pics$(string_digest "$gc_url").$gc_ext "
                ;;
            pin) gc_pins="$gc_pins$gc_rest " ;;
            md) gc_mds="$gc_mds$gc_rest " ;;
            name) gc_names="$gc_names$gc_rest " ;;
            sub) gc_subs="$gc_subs${gc_rest%%"$TAB"*}/${gc_rest#*"$TAB"} " ;;
        esac
    done <<EOF
$gc_list
EOF
    for gc_f in "$CACHE_DIR/pictures"/*; do
        [ -e "$gc_f" ] || continue
        case "$gc_pics" in
            *" ${gc_f##*/} "*) ;;
            *) rm -f "$gc_f" && gc_changed=1 ;;
        esac
    done
    for gc_f in "$CACHE_DIR/readme/pinned"/*; do
        [ -e "$gc_f" ] || continue
        case "$gc_pins" in
            *" ${gc_f##*/} "*) ;;
            *) rm -f "$gc_f" && gc_changed=1 ;;
        esac
    done
    for gc_f in "$CACHE_DIR/readme"/*; do
        [ -e "$gc_f" ] || continue
        gc_b="${gc_f##*/}"
        if [ -d "$gc_f" ]; then
            [ "$gc_b" != pinned ] || continue
            case "$gc_names" in
                *" $gc_b "*) ;;
                *) rm -rf "$gc_f" && gc_changed=1; continue ;;
            esac
            case "$gc_subs" in
                *" $gc_b/* "*) continue ;;
            esac
            for gc_s in "$gc_f"/*; do
                [ -e "$gc_s" ] || continue
                gc_r="${gc_s##*/}"
                if [ -d "$gc_s" ]; then
                    case "$gc_subs" in
                        *" $gc_b/$gc_r "*) ;;
                        *) rm -rf "$gc_s" && gc_changed=1 ;;
                    esac
                else
                    # A picture from before revisions had directories of their own.
                    rm -f "$gc_s" && gc_changed=1
                fi
            done
        else
            gc_stem="${gc_b%.md}"
            gc_stem="${gc_stem%.ref}"
            case "$gc_mds" in
                *" $gc_stem "*) ;;
                *) rm -f "$gc_f" && gc_changed=1 ;;
            esac
        fi
    done
    [ "$gc_changed" = 0 ] || cache_stamp
    return 0
}

# tlstore prefetch — for tlstore-ui: after throwing away what the catalog no
# longer names (prefetch_gc), fetches every picture, demo, readme and readme
# header picture that is missing, the featured items first and then in list
# order, three items at a time, and prints one line per asset as it lands:
#   ready   name  picture|demo|readme  path
#   ready   name  asset                path  src
#   failed  name  kind                 reason  [src]
# What is cached and verified costs no network at all. Exits 0 once every
# item has been seen.
cmd_prefetch() {
    [ $# -eq 0 ] || { err "prefetch takes no arguments"; return 2; }
    need_catalog
    prefetch_gc
    pf_names=$(visible_rows | awk -F "$TAB" '
        $26 == "1" { print $1; next }
        { later = later "\n" $1 }
        END { printf "%s", substr(later, 2) }')
    pf_lanes=3
    pf_k=0
    while [ "$pf_k" -lt "$pf_lanes" ]; do
        (
            pf_i=0
            for pf_n in $pf_names; do
                if [ $((pf_i % pf_lanes)) -eq "$pf_k" ]; then
                    prefetch_item "$pf_n"
                fi
                pf_i=$((pf_i + 1))
            done
        ) &
        pf_k=$((pf_k + 1))
    done
    wait
    return 0
}

cmd_install() {
    ci_names=""
    for ci_a in "$@"; do
        case "$ci_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -*) err "unknown option: $ci_a"; return 2 ;;
            *) ci_names="$ci_names $ci_a" ;;
        esac
    done
    need_catalog

    if [ -z "$ci_names" ]; then
        mkdir -p "$CACHE_DIR"
        ci_cand="$CACHE_DIR/choices"
        ci_chosen="$CACHE_DIR/chosen"
        # Only what is not installed yet: the picker is for adding.
        : > "$ci_cand"
        visible_rows | awk -F "$TAB" '{ printf "%s\t%s\n", $1, $10 }' |
        while IFS="$TAB" read -r ci_pn ci_ps; do
            is_installed "$ci_pn" || printf '%s\t%s\n' "$ci_pn" "$ci_ps" >> "$ci_cand"
        done
        if [ ! -s "$ci_cand" ]; then
            rm -f "$ci_cand"
            say "You already have everything in the list."
            return 0
        fi
        say "Pick what you want."
        pick_items "$ci_cand" "$ci_chosen"
        ci_names=$(tr '\n' ' ' < "$ci_chosen")
        rm -f "$ci_cand" "$ci_chosen"
        if [ -z "$(printf '%s' "$ci_names" | tr -d ' ')" ]; then
            say "Nothing to install."
            return 0
        fi
    fi

    for ci_n in $ci_names; do
        [ -n "$(row "$ci_n")" ] || { err "$ci_n is not in the list"; return 1; }
        ! hidden_item "$ci_n" || { err "$ci_n is part of another item"; return 1; }
    done

    # shellcheck disable=SC2086  # a list of names, split on purpose
    ci_plan=$(plan_for $ci_names)
    say "Installing: $(words_list "$ci_plan")"
    ask_yn "Go ahead?" || { say "Nothing was installed."; return 0; }
    add_build_tools "$ci_plan" 0 || return 1
    for ci_n in $ci_plan; do
        if [ "$PROGRESS" = 1 ]; then
            CANCEL_ITEM="$ci_n"
            PROGRESS_AT=0
            progress_stage 10 fetched
            PROGRESS_NOTE=""
            if install_item "$ci_n"; then
                progress_stage 60 "signature checked"
                progress_stage 90 "putting files in place"
                progress_stage 100 ready
                progress_done "$ci_n" ok "${PROGRESS_NOTE:-installed}"
            else
                FAILED=1
                progress_done "$ci_n" failed "could not install $ci_n"
            fi
            CANCEL_ITEM=""
        else
            install_item "$ci_n" || FAILED=1
        fi
    done
    drop_build_tools
    [ "$FAILED" = 0 ] || return 1
    return 0
}

cmd_remove() {
    cr_names=""
    for cr_a in "$@"; do
        case "$cr_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -*) err "unknown option: $cr_a"; return 2 ;;
            *) cr_names="$cr_names $cr_a" ;;
        esac
    done
    [ -n "$cr_names" ] || { err "remove needs a name"; return 2; }
    pick_catalog || true

    # A bundle takes the members it brought in with it.
    cr_all=""
    for cr_n in $cr_names; do
        cr_all="$cr_all $cr_n"
        cr_row=$(state_row "$cr_n" 2>/dev/null || true)
        [ -n "$cr_row" ] || continue
        [ "$(field "$cr_row" 2)" = bundle ] || continue
        [ -n "$CATALOG" ] || continue
        cr_item=$(row "$cr_n")
        [ -n "$cr_item" ] || continue
        for cr_m in $(commas "$(field "$cr_item" 8)"); do
            [ "$cr_m" = "-" ] && continue
            is_installed "$cr_m" || continue
            in_list "$cr_all" "$cr_m" || cr_all="$cr_all $cr_m"
        done
    done

    say "Removing: $(words_list "$cr_all")"
    ask_yn "Go ahead?" || { say "Nothing was removed."; return 0; }
    for cr_n in $cr_all; do
        if [ "$PROGRESS" = 1 ]; then
            CANCEL_ITEM="$cr_n"
            progress_line step "$cr_n" 30 fetched
            if remove_item "$cr_n"; then
                progress_line step "$cr_n" 75 "putting files in place"
                progress_line step "$cr_n" 100 ready
                progress_done "$cr_n" ok removed
            else
                FAILED=1
                progress_done "$cr_n" failed "could not remove $cr_n"
            fi
            CANCEL_ITEM=""
        else
            remove_item "$cr_n" || FAILED=1
        fi
    done
    [ "$FAILED" = 0 ] || return 1
    return 0
}

# The item half of update; cmd_update adds the self-update on top of it.
update_items() {
    cu_check=0
    cu_offline=0
    cu_tsv=0
    cu_names=""
    for cu_a in "$@"; do
        case "$cu_a" in
            --check) cu_check=1 ;;
            --offline) cu_offline=1 ;;
            --tsv) cu_tsv=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -y|--yes) ASSUME_YES=1 ;;
            -*) err "unknown option: $cu_a"; return 2 ;;
            *) cu_names="$cu_names $cu_a" ;;
        esac
    done
    need_catalog
    [ "$cu_offline" = 1 ] || refresh_catalog 1 || true
    need_catalog

    [ -n "$cu_names" ] || cu_names=$(installed_names | tr '\n' ' ')
    if [ -z "$(printf '%s' "$cu_names" | tr -d ' ')" ]; then
        [ "$cu_tsv" = 1 ] || say "Nothing is installed yet."
        return 0
    fi

    cu_out=""
    cu_pkgs=""
    cu_latest=""
    cu_resolved=""
    for cu_n in $cu_names; do
        if ! is_installed "$cu_n"; then
            [ "$cu_tsv" = 1 ] || say "$cu_n is not installed"
            continue
        fi
        cu_row=$(row "$cu_n")
        if [ -z "$cu_row" ]; then
            [ "$cu_tsv" = 1 ] || say "$cu_n is no longer in the list"
            continue
        fi
        cu_kind=$(field "$cu_row" 2)
        cu_new=$(field "$cu_row" 3)
        cu_have=$(installed_version "$cu_n")
        case "$cu_kind" in
            pkg) cu_pkgs="$cu_pkgs $(field "$cu_row" 5)" ;;
            bundle|fisher) ;;
            npm-musl)
                # An item pinned to latest is whatever its source says today.
                # --check asks the registry which version that is and names the
                # item only when it differs from what is here; offline, or when
                # the registry cannot be reached, it says nothing about it.
                if [ "$cu_new" = latest ]; then
                    cu_latest="$cu_latest $cu_n"
                    if [ "$cu_check" = 1 ] && [ "$cu_offline" = 0 ]; then
                        cu_now=$(npm_latest_version "$(field "$cu_row" 5)")
                        if [ -n "$cu_now" ] && [ "$cu_now" != "$cu_have" ]; then
                            cu_resolved="$cu_resolved $cu_n=$cu_now"
                        fi
                    fi
                elif [ "$cu_new" != "$cu_have" ]; then
                    cu_out="$cu_out $cu_n"
                fi
                ;;
            *)
                [ "$cu_new" = "$cu_have" ] || cu_out="$cu_out $cu_n"
                ;;
        esac
    done

    if [ "$cu_check" = 1 ] && [ "$cu_tsv" = 1 ]; then
        for cu_n in $cu_out; do
            cu_row=$(row "$cu_n")
            cu_note=""
            [ "$(field "$cu_row" 2)" = file ] && cu_note=config-asks
            printf '%s\t%s\t%s\t%s\n' "$cu_n" \
                "$(installed_version "$cu_n")" "$(field "$cu_row" 3)" "$cu_note"
        done
        for cu_nv in $cu_resolved; do
            printf '%s\t%s\t%s\t%s\n' "${cu_nv%%=*}" "$(installed_version "${cu_nv%%=*}")" "${cu_nv#*=}" latest
        done
        return 0
    fi

    if [ "$cu_check" = 1 ]; then
        for cu_nv in $cu_resolved; do
            say "${cu_nv%%=*} ${cu_nv#*=} is available; you have $(installed_version "${cu_nv%%=*}")"
        done
        if [ -z "$(printf '%s%s' "$cu_out" "$cu_resolved" | tr -d ' ')" ]; then
            say "Everything is up to date."
        else
            for cu_n in $cu_out; do
                cu_row=$(row "$cu_n")
                if [ "$(field "$cu_row" 2)" = file ]; then
                    say "$cu_n has a new version; update shows the change and asks"
                else
                    say "$cu_n $(field "$cu_row" 3) is available; you have $(installed_version "$cu_n")"
                fi
            done
        fi
        [ -z "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ] || say "Packages are checked by the package manager when you update."
        if [ "$cu_offline" = 1 ]; then
            for cu_n in $cu_latest; do
                say "$cu_n is checked against its source when you update."
            done
        fi
        return 0
    fi

    if [ -n "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ]; then
        say "Updating packages"
        # shellcheck disable=SC2086
        upgrade_pkg $cu_pkgs || FAILED=1
    fi
    cu_out="$cu_out $cu_latest"
    if [ -z "$(printf '%s' "$cu_out" | tr -d ' ')" ]; then
        [ -n "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ] || say "Everything is up to date."
    else
        add_build_tools "$cu_out" 1 || return 1
        for cu_n in $cu_out; do
            if [ "$PROGRESS" = 1 ]; then
                CANCEL_ITEM="$cu_n"
                PROGRESS_AT=0
                progress_stage 10 fetched
                PROGRESS_NOTE=""
                if install_item "$cu_n" 1; then
                    progress_stage 60 "signature checked"
                    progress_stage 90 "putting files in place"
                    progress_stage 100 ready
                    progress_done "$cu_n" ok "${PROGRESS_NOTE:-updated}"
                else
                    FAILED=1
                    progress_done "$cu_n" failed "could not update $cu_n"
                fi
                CANCEL_ITEM=""
            else
                install_item "$cu_n" 1 || FAILED=1
            fi
        done
        drop_build_tools
    fi
    [ "$FAILED" = 0 ] || return 1
    return 0
}

cmd_update() {
    update_items "$@"
    cu_status=$?
    # tlstore keeps itself, and the store program that pairs with it, current
    # on a plain `update` — never offline, never on `--check` (the refresh
    # tlstore-ui runs in the background; swapping the files under a running
    # UI is what `self-update --progress` exists to do in plain view), and
    # not inside a --progress stream, which carries the item lines alone.
    if [ "$cu_status" != 2 ] && [ "${cu_offline:-0}" = 0 ] && [ "${cu_check:-0}" = 0 ] && [ "$PROGRESS" != 1 ]; then
        self_update
    fi
    return "$cu_status"
}

cmd_refresh() {
    for cf_a in "$@"; do
        case "$cf_a" in
            -y|--yes) ASSUME_YES=1 ;;
            *) err "unknown option: $cf_a"; return 2 ;;
        esac
    done
    pick_catalog || true
    refresh_catalog 0
    cf_status=$?
    [ "$cf_status" = 2 ] && return 1
    return 0
}

# ---------------------------------------------------------------------------
# Keeping tlstore itself current
# ---------------------------------------------------------------------------

# version_newer <a> <b> — true when a is ahead of b.
version_newer() {
    awk -v a="$1" -v b="$2" '
        function vercmp(x, y,   nx, ny, px, py, i, n, p, q) {
            nx = split(x, px, /[._-]/)
            ny = split(y, py, /[._-]/)
            n = (nx > ny) ? nx : ny
            for (i = 1; i <= n; i++) {
                p = (i <= nx) ? px[i] + 0 : 0
                q = (i <= ny) ? py[i] + 0 : 0
                if (p > q) return 1
                if (p < q) return -1
            }
            return 0
        }
        BEGIN { exit (vercmp(a, b) > 0) ? 0 : 1 }'
}

# The name the launcher's build gives the store program for this processor:
# uname -m says aarch64 or x86_64, the APK's assets say arm64-v8a or x86_64.
ui_abi() {
    case "$ARCH" in
        aarch64|arm64) printf 'arm64-v8a' ;;
        x86_64) printf 'x86_64' ;;
        *) printf '' ;;
    esac
}

# What self_update has to say. Its lines are narration, never part of the
# machine output `update --check --tsv` prints for tlstore-ui, so in that
# mode they go to stderr the way --progress narration does.
su_say() {
    if [ "${cu_tsv:-0}" = 1 ]; then
        printf '%s\n' "$*" >&2
    else
        say "$*"
    fi
}

# tlstore keeps itself current from the newest store release, whoever put it
# here — the launcher app or the standalone installer. The release's script
# is fetched with its signature and taken only when it checks out against the
# trusted key and its TLSTORE_VERSION is ahead of this one's. The store
# program moves with it: the script names the digest of the tlstore-ui built
# beside it (TLSTORE_UI_SHA256_<abi>, filled in before signing), and where a
# tlstore-ui is in place the matching one is downloaded, checked against that
# signed digest and put down together with the script. An engine and a UI
# from different releases is what breaks the store, so if the UI cannot be
# had, the old script stays too. Both land by a rename beside their target,
# the script first (an older UI reads a newer script's output — new columns
# only ever land at the end — the other way round does not hold), and the
# launcher's own record of the UI (.tlstore-ui-sha256) is updated so the app
# still counts the file as its own. Nothing is re-executed here: the copy
# that is running finishes its work on the old inode (tlstore-ui re-executes
# itself after `self-update --progress`, see cmd_self_update).
#
# The work is split so three callers share it: `update` (self_update: quiet,
# one line when something moved), `self-update --check --tsv` (the script
# alone, left verified in the cache) and `self-update --progress` (the whole
# thing as a --progress stream for tlstore-ui, which takes the cached script
# rather than fetching it twice). Each step returns 0 done, 1 nothing to do
# (offline, nothing newer), 2 refused — with the reason in SU_NOTE.
SU_NOTE=""

su_paths() {
    su_target="$PREFIX/bin/tlstore"
    su_new="$CACHE_DIR/tlstore.new"
    su_sig="$CACHE_DIR/tlstore.new.minisig"
    su_ui_new="$CACHE_DIR/tlstore-ui.new"
}

# su_ready — something to replace, and the tools to check what is offered.
su_ready() {
    su_paths
    [ -f "$su_target" ] || return 1
    have curl || return 1
    have minisign || return 1
    [ -f "$PUBKEY" ] || return 1
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
    return 0
}

# su_verified — the script in the cache checks out against the trusted key
# and is ahead of this one; su_version is its version (set whenever one
# could be read, so a caller can name the version that was refused).
su_verified() {
    su_version=""
    [ -f "$su_new" ] && [ -f "$su_sig" ] || return 1
    minisign -Q -V -p "$PUBKEY" -x "$su_sig" -m "$su_new" >/dev/null 2>&1 || return 2
    su_version=$(sed -n 's/^TLSTORE_VERSION=\([0-9][0-9.]*\)$/\1/p' "$su_new" | head -1)
    [ -n "$su_version" ] || return 1
    version_newer "$su_version" "$TLSTORE_VERSION"
}

# su_fetch_script <use cache 0|1> — the newest release's script and its
# signature into the cache, verified. With 1, a copy `self-update --check`
# left there is taken as it is when it still verifies and is still newer.
# The cache is emptied whenever this returns 1 or 2.
su_fetch_script() {
    SU_NOTE=""
    if [ "$1" = 1 ] && su_verified; then
        return 0
    fi
    rm -f "$su_new" "$su_sig"
    # Inside a --progress stream the script's own download is the first,
    # small share of the bar; it may well jump straight to the end of it.
    PROGRESS_FETCH_END=8
    if ! curl_to "$RELEASE_BASE/tlstore" "$su_new" 2>/dev/null ||
       ! curl -fsL --connect-timeout 5 --max-time 60 -o "$su_sig" "$RELEASE_BASE/tlstore.minisig" 2>/dev/null; then
        rm -f "$su_new" "$su_sig"
        return 1
    fi
    su_verified
    case $? in
        0) return 0 ;;
        2)
            rm -f "$su_new" "$su_sig"
            SU_NOTE="the tlstore that was offered is not signed by the launcher — ignoring it"
            return 2
            ;;
        *)
            rm -f "$su_new" "$su_sig"
            return 1
            ;;
    esac
}

# su_ui_digest_named — where a store program is in place, the digest the
# new script names for this processor (su_ui_digest; empty with no UI to
# pair). 2 when a UI is here and the script names none for it.
su_ui_digest_named() {
    su_ui_digest=""
    [ -f "$TLSTORE_UI_BIN" ] || return 0
    su_abi=$(ui_abi)
    su_key=$(printf '%s' "$su_abi" | tr '-' '_')
    [ -z "$su_abi" ] || su_ui_digest=$(sed -n "s/^TLSTORE_UI_SHA256_$su_key=\([0-9a-f]\{64\}\)\$/\1/p" "$su_new" | head -1)
    if [ -z "$su_ui_digest" ]; then
        SU_NOTE="tlstore $su_version names no store program for this processor — keeping what you have"
        return 2
    fi
    return 0
}

# su_fetch_ui — the store program the new script names, checked against the
# signed digest. Inside a --progress stream its download is most of the bar
# (8 to 80), and "signature checked" is the moment the digest matches: the
# script's own signature was checked before this download began, and a
# refused script ends the job there.
su_fetch_ui() {
    su_ui_digest_named || return 2
    [ -n "$su_ui_digest" ] || return 0
    progress_stage 8 fetched
    PROGRESS_FETCH_END=80
    CANCEL_TMP="$su_ui_new"
    if ! curl_to "$RELEASE_BASE/tlstore-ui-$su_abi" "$su_ui_new" 2>/dev/null; then
        rm -f "$su_ui_new"
        CANCEL_TMP=""
        SU_NOTE="could not download the store program that goes with tlstore $su_version — keeping what you have"
        return 2
    fi
    CANCEL_TMP=""
    progress_stage 85 "signature checked"
    if [ "$(file_digest "$su_ui_new")" != "$su_ui_digest" ]; then
        rm -f "$su_ui_new"
        SU_NOTE="the store program that was offered does not match what tlstore $su_version expects — keeping what you have"
        return 2
    fi
    return 0
}

# su_place — stage both beside their targets, then rename, the script first:
# a copy that fails leaves everything as it was.
su_place() {
    progress_stage 92 "putting files in place"
    su_stage="$su_target.new"
    su_ui_stage="$TLSTORE_UI_BIN.new"
    CANCEL_EXTRA="$CANCEL_EXTRA $su_stage $su_ui_stage"
    if ! cp "$su_new" "$su_stage" || ! chmod 755 "$su_stage"; then
        rm -f "$su_stage"
        SU_NOTE="could not put the newer tlstore in place"
        return 2
    fi
    if [ -n "$su_ui_digest" ]; then
        if ! cp "$su_ui_new" "$su_ui_stage" || ! chmod 755 "$su_ui_stage"; then
            rm -f "$su_stage" "$su_ui_stage"
            SU_NOTE="could not put the newer store program in place — keeping what you have"
            return 2
        fi
    fi
    if ! mv "$su_stage" "$su_target"; then
        rm -f "$su_stage" "$su_ui_stage"
        SU_NOTE="could not put the newer tlstore in place"
        return 2
    fi
    if [ -n "$su_ui_digest" ]; then
        if mv "$su_ui_stage" "$TLSTORE_UI_BIN"; then
            printf '%s\n' "$su_ui_digest" > "$(dirname "$TLSTORE_UI_BIN")/.tlstore-ui-sha256" 2>/dev/null || true
        else
            rm -f "$su_ui_stage"
            err "could not put the newer store program in place"
        fi
    fi
    return 0
}

# self_update_try <use cache 0|1> — the whole thing, quietly. 0 updated
# (su_version says to what), 1 nothing to do, 2 refused (SU_NOTE says why);
# after 1 or 2 both old files are where they were.
self_update_try() {
    SU_NOTE=""
    su_ready || return 1
    # What a cancel has to drop, beyond the download in flight: the cached
    # script pair, the program, and (from su_place on) the staged copies.
    CANCEL_EXTRA="$su_new $su_sig $su_ui_new"
    su_fetch_script "$1"
    su_rc=$?
    if [ "$su_rc" = 0 ]; then
        if su_fetch_ui && su_place; then
            su_rc=0
        else
            su_rc=2
        fi
    fi
    rm -f "$su_new" "$su_sig" "$su_ui_new"
    CANCEL_EXTRA=""
    PROGRESS_FETCH_END=55
    return "$su_rc"
}

# The self-update `update` runs: one line when something moved, the reason
# when something was refused, nothing otherwise.
self_update() {
    self_update_try 0
    case $? in
        0) su_say "tlstore is now version $su_version." ;;
        2) err "$SU_NOTE" ;;
    esac
    return 0
}

# tlstore self-update --check --tsv — for tlstore-ui, when it starts: one
# line, `self <installed> <latest> <available 0|1>`. Only the signed script
# is fetched and verified; when it is newer (and, where a store program is
# in place, names one for this processor) it stays in the cache for the
# --progress run that follows, so it is not fetched twice. Offline, refused
# or nothing newer: available 0, latest `-` when no version could be read,
# and nothing is left behind.
self_update_check() {
    su_avail=0
    su_latest="-"
    if su_ready; then
        su_fetch_script 0
        case $? in
            0)
                su_latest=$su_version
                if su_ui_digest_named; then
                    su_avail=1
                else
                    rm -f "$su_new" "$su_sig"
                    err "$SU_NOTE"
                fi
                ;;
            2) err "$SU_NOTE" ;;
            *) [ -z "${su_version:-}" ] || su_latest=$su_version ;;
        esac
    fi
    if [ "${cs_tsv:-0}" = 1 ]; then
        printf 'self\t%s\t%s\t%s\n' "$TLSTORE_VERSION" "$su_latest" "$su_avail"
    elif [ "$su_avail" = 1 ]; then
        say "tlstore $su_latest is available; you have $TLSTORE_VERSION."
    else
        say "tlstore is up to date."
    fi
    return 0
}

# tlstore self-update --progress — the same as `update`'s self-update, as a
# --progress stream for the one item `tlstore`: fetched (the script to 8,
# then the store program to 80, as curl reports it), signature checked (85),
# putting files in place (92), ready (100), then `done tlstore ok updated to
# <v>`, or `done tlstore failed <reason>` with both old files untouched. A
# cancel (SIGTERM to the process group) drops the part file, the staged
# copies and the cached script, and closes the stream the usual way.
self_update_progress() {
    PROGRESS=1
    ASSUME_YES=1
    CANCEL_ITEM=tlstore
    PROGRESS_AT=0
    progress_stage 2 fetched
    self_update_try 1
    su_rc=$?
    case "$su_rc" in
        0)
            progress_stage 100 ready
            progress_done tlstore ok "updated to $su_version"
            ;;
        2)
            progress_done tlstore failed "$SU_NOTE"
            ;;
        *)
            progress_done tlstore failed "no newer tlstore was offered"
            ;;
    esac
    CANCEL_ITEM=""
    [ "$su_rc" = 0 ] || return 1
    return 0
}

cmd_self_update() {
    cs_check=0
    cs_tsv=0
    cs_progress=0
    for cs_a in "$@"; do
        case "$cs_a" in
            --check) cs_check=1 ;;
            --tsv) cs_tsv=1 ;;
            --progress) cs_progress=1 ;;
            *) err "unknown option: $cs_a"; return 2 ;;
        esac
    done
    if [ "$cs_check" = 1 ]; then
        self_update_check
    elif [ "$cs_progress" = 1 ]; then
        self_update_progress
    else
        self_update
    fi
}

cd_line() { printf '%-13s %s\n' "$1" "$2"; }

cmd_doctor() {
    pick_catalog || true
    cd_bad=0
    cd_line Prefix "$PREFIX"
    if [ -n "$APP_PACKAGE" ]; then
        cd_line Edition "$APP_PACKAGE"
    else
        cd_line Edition "unknown"
    fi
    cd_pkg="${APP_PACKAGE:-unknown}"
    if [ "$HOST" = launcher ]; then
        if [ -n "$LAUNCHER_VERSION" ]; then
            cd_line App "Termux Launcher $LAUNCHER_VERSION ($cd_pkg)"
        else
            cd_line App "Termux Launcher ($cd_pkg)"
        fi
    else
        cd_line App "Termux ($cd_pkg)"
    fi
    case ":$PATH:" in
        *":$BIN_DIR:"*)
            cd_first=$(printf '%s' "$PATH" | tr ':' '\n' | grep -n -x -e "$BIN_DIR" -e "$PREFIX/bin" | head -1)
            case "$cd_first" in
                *"$BIN_DIR") cd_line PATH "$BIN_DIR comes first" ;;
                *) cd_line PATH "put $BIN_DIR before $PREFIX/bin so the tools here win" ;;
            esac
            ;;
        *) cd_line PATH "add $BIN_DIR to it, or the tools here will not run" ;;
    esac

    for cd_t in curl tar sha256sum; do
        if have "$cd_t"; then
            cd_line "$cd_t" ready
        else
            cd_line "$cd_t" missing
            cd_bad=1
        fi
    done
    if have minisign; then
        cd_line minisign ready
    else
        cd_line minisign "not installed (needed to refresh the item list)"
    fi

    if [ -n "$CATALOG" ]; then
        cd_line "Item list" "$CATALOG_SERIAL, $CATALOG_FROM"
    else
        cd_line "Item list" "missing — reopen the app to put it back"
        cd_bad=1
    fi

    cd_missing=""
    for cd_n in $(installed_names); do
        cd_row=$(state_row "$cd_n")
        for cd_f in $(field "$cd_row" 5); do
            [ -e "$cd_f" ] || in_list "$cd_missing" "$cd_n" || cd_missing="$cd_missing $cd_n"
        done
    done
    if [ -n "$(printf '%s' "$cd_missing" | tr -d ' ')" ]; then
        cd_line "Missing" "$(printf '%s' "$cd_missing" | sed 's/^ *//') — install them again"
        cd_bad=1
    fi

    if [ "$ARCH_OK" = 1 ] && [ -n "$CATALOG" ]; then
        cd_row=$(row musl-loader)
        if [ -n "$cd_row" ]; then
            cd_loader=$(item_targets musl-loader binary "$(field "$cd_row" 7)")
            if [ -f "$cd_loader" ]; then
                cd_line Loader ready
            else
                cd_line Loader "not installed (Claude Code needs it)"
            fi
        fi
    fi

    [ "$cd_bad" = 0 ] || return 1
    return 0
}

cmd_display() {
    cy_setup="$PREFIX/bin/termux-x11-gpu-setup"
    if [ ! -x "$cy_setup" ]; then
        err "graphics setup is not here yet — update the app and try again"
        return 1
    fi
    "$cy_setup" "$@"
}

cmd_version() {
    pick_catalog || true
    say "tlstore $TLSTORE_VERSION"
    [ -z "$CATALOG_SERIAL" ] || say "Item list $CATALOG_SERIAL"
    return 0
}

# ---------------------------------------------------------------------------

main() {
    if [ $# -eq 0 ]; then
        # Inside the launcher, with a real terminal at both ends and the store
        # program in place, hand the screen to it; it calls back into this
        # script for every install, update and remove. Everywhere else — plain
        # Termux, ssh, tmux, or before the app has put tlstore-ui down — there
        # is nothing to draw with, so this just prints the list.
        if [ "$HOST" = launcher ] && on_terminal && [ -x "$TLSTORE_UI_BIN" ]; then
            exec "$TLSTORE_UI_BIN"
        fi
        cmd_list
        say ""
        say "Run 'tlstore install' to add what you want."
        return 0
    fi
    tl_cmd="$1"
    shift
    case "$tl_cmd" in
        list) cmd_list "$@" ;;
        search) cmd_search "$@" ;;
        info) cmd_info "$@" ;;
        picture) cmd_picture "$@" ;;
        readme) cmd_readme "$@" ;;
        readme-asset) cmd_readme_asset "$@" ;;
        snapshot) cmd_snapshot "$@" ;;
        prefetch) cmd_prefetch "$@" ;;
        install|add) cmd_install "$@" ;;
        remove|uninstall) cmd_remove "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        refresh) cmd_refresh "$@" ;;
        self-update) cmd_self_update "$@" ;;
        shell) cmd_install fish-shell "$@" ;;
        display) cmd_display "$@" ;;
        doctor) cmd_doctor "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) usage ;;
        *) err "unknown command: $tl_cmd"; usage >&2; return 2 ;;
    esac
}

main "$@"

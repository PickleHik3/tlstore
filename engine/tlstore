usage() {
    cat <<'EOF'
tlstore installs, updates and removes the tools and configs the launcher
shows off but does not ship.

Usage: tlstore [-y] <command> [options] [name...]

With no command it opens the store in the launcher, or lists what there is.

Commands:
  list [-i|-a]          show every item; -i only yours, -a only what you lack
  search <term>         find an item by name or description
  info <name>           what an item is and where it goes
  install [name...]     install items (alias: add); with no names, pick from a list
  remove <name...>      remove items tlstore installed (alias: uninstall)
  update [name...]      bring what you have up to date (alias: upgrade)
  rollback <name>       go back one version, and hold the item there
  hold <name...>        keep items at their version when you update
  unhold <name...>      let held items update again
  refresh               update the list of items
  self-update           bring tlstore itself up to date
  doctor                check that everything is in place
  display               set up graphics for Linux apps
  version               show the tlstore and item-list versions
  help [command]        this page, or one command's own page

Options:
  -y, --yes       say yes to every question except replacing a config file of yours
  -h, --help      show this page; after a command, that command's page
  -v, --version   show the version

  Run 'tlstore help <command>' for the options a command takes of its own,
  such as --dry-run on install, update and remove.

Exit status:
  0  done
  1  something failed
  2  you used it wrongly: an unknown command or option, a missing name

Environment:
  TLSTORE_ASSUME_YES=1      the same as -y
  TLSTORE_HOST              launcher or termux, when the store should not guess
  TLSTORE_CATALOG_URL       where 'refresh' reads the item list (file:// works)
  TLSTORE_NPM_REGISTRY      the npm registry the npm items read from
  TLSTORE_MOTION=0          no transitions in the store app
EOF
}

# bad_opt <command> <option> — an option the command does not take.
bad_opt() {
    err "unknown option: $2"
    err "run 'tlstore help $1' to see what it takes"
}

# bad_arg <command> <argument> — a word where the command wants nothing.
bad_arg() {
    err "$1: unexpected argument: $2"
    err "run 'tlstore help $1' to see what it takes"
}

# help_for <command> — one command's page: its usage line, what it does and
# every option it takes. The ones for the store app come last, in their own
# group. Aliases get the page of the command they stand for.
help_for() {
    case "$1" in
        list)
            cat <<'EOF'
Usage: tlstore list [-i|-a]

Shows every item in the store. A * marks the ones you have.

Options:
  -i          only what you have installed
  -a          only what you do not have yet
  -h, --help  show this page

For the store app:
  --tsv       the same answer as tab-separated columns
EOF
            ;;
        search)
            cat <<'EOF'
Usage: tlstore search <term>

Finds items whose name or description contains the term.

Options:
  -h, --help  show this page

For the store app:
  --tsv       the same answer as tab-separated columns
EOF
            ;;
        info)
            cat <<'EOF'
Usage: tlstore info <name>

Says what an item is, its version, and where it goes.

Options:
  -h, --help  show this page

For the store app:
  --tsv       the same answer as tab-separated columns
EOF
            ;;
        install|add)
            cat <<'EOF'
Usage: tlstore [-y] install [options] [name...]
       tlstore add ...

Installs items, and the parts they need, in the order they need them.
With no names it shows a list to pick from. When the packages they need
from Termux come to more than 50 MB, it says how much before it asks.

Options:
  -n, --dry-run  say what would be installed, and change nothing
  -y, --yes      say yes to every question except replacing a config file of yours
  --configs      also replace a config file of yours with the new one
  -h, --help     show this page

For the store app:
  --progress     a line per step on stdout, for a program to read (implies -y)
EOF
            ;;
        remove|uninstall)
            cat <<'EOF'
Usage: tlstore [-y] remove [options] <name...>
       tlstore uninstall ...

Removes items tlstore installed, and puts back any file of yours it kept.
What needs a removed item goes with it, and so do the parts it brought in
that nothing else needs. --dry-run lists them first.
A package item is only forgotten: the package stays with your package manager.

Options:
  -n, --dry-run  say what would be removed, and change nothing
  -y, --yes      do not ask first
  -h, --help     show this page

For the store app:
  --progress     a line per step on stdout, for a program to read (implies -y)
EOF
            ;;
        update|upgrade)
            cat <<'EOF'
Usage: tlstore [-y] update [options] [name...]
       tlstore upgrade ...

Fetches the newest item list and brings what you have up to date, then offers
a newer tlstore when there is one: answer yes, no, or never. With no names it
does everything you have installed, except items you have held; naming a held
item updates it and lets go of the hold. When the packages it needs from
Termux come to more than 50 MB, it says how much and asks first.

Options:
  --check        say what would change, and change nothing
  -n, --dry-run  the same as --check
  --offline      do not fetch the item list or ask the registry; use what you have
  -y, --yes      say yes to every question except replacing a config file of yours
  --configs      also replace a config file of yours with the new one
  -h, --help     show this page

For the store app:
  --tsv          with --check, the changes as tab-separated columns
  --progress     a line per step on stdout, for a program to read (implies -y)
EOF
            ;;
        rollback)
            cat <<'EOF'
Usage: tlstore [-y] rollback [options] <name>

Puts an item back at the version it had before its last update, then holds it
there so the next update does not undo that. It goes one step only; to move
forward again, run 'tlstore unhold <name>' and 'tlstore update <name>'.

Works for items from npm, binaries, app archives, agent skills and config files. A package,
a bundle or a fish plugin cannot go back: Termux keeps only the newest package,
and the others have no version of their own to return to. An item installed
before tlstore recorded versions has nothing to go back to until it updates once.

Options:
  -n, --dry-run  say what would be installed, and change nothing
  -y, --yes      do not ask first
  -h, --help     show this page
EOF
            ;;
        hold)
            cat <<'EOF'
Usage: tlstore hold <name...>

Keeps installed items at the version they have. A plain 'tlstore update'
skips them and the store app does not offer them; 'tlstore update <name>'
updates one anyway and lets go of its hold. Removing an item drops its hold.

Options:
  -h, --help  show this page
EOF
            ;;
        unhold)
            cat <<'EOF'
Usage: tlstore unhold <name...>

Lets held items update again.

Options:
  -h, --help  show this page
EOF
            ;;
        refresh)
            cat <<'EOF'
Usage: tlstore [-y] refresh

Fetches the newest item list and checks its signature. Nothing you have
installed is touched.

Options:
  -y, --yes   do not ask first
  -h, --help  show this page
EOF
            ;;
        self-update)
            cat <<'EOF'
Usage: tlstore self-update [--check]

Brings tlstore itself, and the store app that goes with it, up to date. This
also turns the offer on update back on after you said never.
Exits 1 when a newer tlstore was offered and could not be taken.

Options:
  --check     say whether a newer tlstore is out, and change nothing
  -h, --help  show this page

For the store app:
  --tsv       with --check, one line of tab-separated columns
  --progress  a line per step on stdout, for a program to read
EOF
            ;;
        doctor)
            cat <<'EOF'
Usage: tlstore doctor

Checks where things are installed, whether your shell finds them, which tools
are present and whether anything tlstore put down has gone missing.
Exits 1 when something needs fixing.

Options:
  -h, --help  show this page
EOF
            ;;
        display)
            cat <<'EOF'
Usage: tlstore display [options]

Sets up graphics for Linux apps. Everything after 'display' is handed to the
setup script as it is.
EOF
            ;;
        version)
            cat <<'EOF'
Usage: tlstore version

Shows the tlstore version and the serial of the item list it is using.
Also: tlstore --version, tlstore -v.

Options:
  -h, --help  show this page
EOF
            ;;
        help)
            cat <<'EOF'
Usage: tlstore help [command]

Shows the list of commands, or one command's own page.
EOF
            ;;
        *)
            err "no help for '$1': it is not a command"
            err "run 'tlstore help' to see the commands"
            return 2
            ;;
    esac
}

cmd_help() {
    case $# in
        0) usage ;;
        1) help_for "$1" ;;
        *) bad_arg help "$2"; return 2 ;;
    esac
}

# emit_items <style list|search> <all|installed|available> <tsv 0|1> [term]
# The one place the item list is printed, for people and for programs. The
# machine-readable columns are name, state, version, installed, kind, summary,
# category, featured — the two tlstore-ui needs for the Apps screen's chips
# and cover picture without an `info` call per item.
emit_items() {
    ei_style="$1"
    ei_mode="$2"
    ei_tsv="$3"
    ei_term="${4:-}"
    visible_rows | awk -F "$TAB" -v term="$ei_term" '
        BEGIN { t = tolower(term) }
        t == "" || index(tolower($1), t) > 0 || index(tolower($10), t) > 0 {
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $9, $10, $11, $26
        }' |
    while IFS="$TAB" read -r ei_name ei_kind ei_version ei_options ei_summary ei_category ei_featured; do
        if is_installed "$ei_name"; then
            [ "$ei_mode" = available ] && continue
            ei_state=installed
            ei_have=$(installed_version "$ei_name")
            ei_mark="*"
        else
            [ "$ei_mode" = installed ] && continue
            ei_state=available
            ei_have=""
            ei_mark=" "
        fi
        if [ "$ei_tsv" = 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$ei_name" "$ei_state" "$ei_version" "$ei_have" "$ei_kind" "$ei_summary" \
                "$ei_category" "$ei_featured"
            continue
        fi
        if [ "$ei_style" = list ]; then
            ei_held=""
            ! is_held "$ei_name" || ei_held=" (held)"
            printf '%s %-14s %s%s\n' "$ei_mark" "$ei_name" "$ei_summary" "$ei_held"
            ei_build=$(opt "$ei_options" build)
            [ -z "$ei_build" ] || printf '    needs while installing: %s\n' "$ei_build"
        else
            printf '  %-14s %s\n' "$ei_name" "$ei_summary"
        fi
    done
    return 0
}

cmd_list() {
    cl_mode=all
    cl_tsv=0
    for cl_a in "$@"; do
        case "$cl_a" in
            -i) cl_mode=installed ;;
            -a) cl_mode=available ;;
            --tsv) cl_tsv=1 ;;
            -*) bad_opt list "$cl_a"; return 2 ;;
            *) bad_arg list "$cl_a"; return 2 ;;
        esac
    done
    need_catalog
    emit_items list "$cl_mode" "$cl_tsv"
}

cmd_search() {
    cs_tsv=0
    cs_term=""
    for cs_a in "$@"; do
        case "$cs_a" in
            --tsv) cs_tsv=1 ;;
            -*) bad_opt search "$cs_a"; return 2 ;;
            *)
                if [ -n "$cs_term" ]; then
                    err "search takes one thing to look for"
                    return 2
                fi
                cs_term="$cs_a"
                ;;
        esac
    done
    [ -n "$cs_term" ] || { err "search needs something to look for"; return 2; }
    need_catalog
    emit_items search all "$cs_tsv" "$cs_term"
}

cmd_info() {
    ci_tsv=0
    ci_want=""
    for ci_a in "$@"; do
        case "$ci_a" in
            --tsv) ci_tsv=1 ;;
            -*) bad_opt info "$ci_a"; return 2 ;;
            *)
                if [ -n "$ci_want" ]; then
                    err "info needs one name"
                    return 2
                fi
                ci_want="$ci_a"
                ;;
        esac
    done
    [ -n "$ci_want" ] || { err "info needs one name"; return 2; }
    need_catalog
    load_item "$ci_want" || { err "$ci_want is not in the list"; return 1; }
    ci_files=$(item_targets "$it_name" "$it_kind" "$it_target" "$it_source" "$it_options")
    ci_where="$ci_files"
    case "$it_kind" in
        pkg) ci_where="$it_source" ;;
        bundle) ci_where="-" ;;
    esac
    [ -n "$ci_where" ] || ci_where="-"
    ci_build=$(opt "$it_options" build)
    if [ "$ci_tsv" = 1 ]; then
        printf '%s\t%s\n' Kind "$it_kind"
        printf '%s\t%s\n' Version "$it_version"
        printf '%s\t%s\n' From "$it_source"
        printf '%s\t%s\n' Checksum "$it_digest"
        printf '%s\t%s\n' Needs "$it_requires"
        [ -z "$ci_build" ] || printf '%s\t%s\n' "Builds with" "$ci_build"
        printf '%s\t%s\n' Files "$ci_where"
        if is_installed "$it_name"; then
            printf '%s\t%s\n' Installed "$(installed_version "$it_name")"
        fi
        printf '%s\t%s\n' Summary "$it_summary"
        # The item spread, for tlstore-ui: everything item-spread-rules.md
        # needs to draw the item's own page, one key per line, an unknown
        # value ("-") dropping its row the same way "Builds with" does above.
        [ "$it_category" = - ] || printf '%s\t%s\n' Category "$it_category"
        [ "$it_upstream" = - ] || printf '%s\t%s\n' Upstream "$it_upstream"
        printf '%s\t%s\n' Setup "$it_setup"
        [ "$it_standfirst" = - ] || printf '%s\t%s\n' Standfirst "$it_standfirst"
        [ "$it_does1" = - ] || printf '%s\t%s\n' Does1 "$it_does1"
        [ "$it_does2" = - ] || printf '%s\t%s\n' Does2 "$it_does2"
        [ "$it_does3" = - ] || printf '%s\t%s\n' Does3 "$it_does3"
        [ "$it_try" = - ] || printf '%s\t%s\n' Try "$it_try"
        [ "$it_notes" = - ] || printf '%s\t%s\n' Notes "$it_notes"
        [ "$it_author" = - ] || printf '%s\t%s\n' Author "$it_author"
        [ "$it_licence" = - ] || printf '%s\t%s\n' Licence "$it_licence"
        [ "$it_size" = - ] || printf '%s\t%s\n' Size "$it_size"
        # Revision 15: the line its page shows before install, and the two figures, when its
        # Termux packages are large. An older tlstore-ui skips keys it does not know.
        if item_weight "$it_options" && heavy "$iw_dl" "$iw_disk"; then
            printf '%s\t%s\n' Packages "$(weight_sentence "$iw_what" "$iw_dl" "$iw_disk")"
            printf '%s\t%s,%s\n' Packages-size "$iw_dl" "$iw_disk"
        fi
        if [ "$it_picture" != - ]; then
            printf '%s\t%s\n' Picture "$it_picture"
            printf '%s\t%s\n' Picture-digest "$it_picture_digest"
        fi
        if [ "$it_demo" != - ]; then
            printf '%s\t%s\n' Demo "$it_demo"
            [ "$it_demo_digest" = - ] || printf '%s\t%s\n' Demo-digest "$it_demo_digest"
        fi
        printf '%s\t%s\n' Featured "$it_featured"
        [ "$it_readme_skip" = - ] || printf '%s\t%s\n' Readme-skip "$it_readme_skip"
        if [ "$it_readme" != - ]; then
            printf '%s\t%s\n' Readme "$it_readme"
            [ "$it_readme_digest" = - ] || printf '%s\t%s\n' Readme-digest "$it_readme_digest"
        fi
        return 0
    fi
    say "$it_name"
    say "  $it_summary"
    printf '  %-11s %s\n' Kind "$it_kind"
    printf '  %-11s %s\n' Version "$it_version"
    printf '  %-11s %s\n' From "$it_source"
    printf '  %-11s %s\n' Checksum "$it_digest"
    printf '  %-11s %s\n' Needs "$it_requires"
    [ -z "$ci_build" ] || printf '  %-11s %s\n' "Builds with" "$ci_build"
    printf '  %-11s %s\n' Files "$ci_where"
    if is_installed "$it_name"; then
        printf '  %-11s %s\n' Installed "$(installed_version "$it_name")"
        ! is_held "$it_name" || printf '  %-11s %s\n' Held "yes; 'tlstore unhold $it_name' lets it update"
    fi
    [ "$it_category" = - ] || printf '  %-11s %s\n' Category "$it_category"
    [ "$it_upstream" = - ] || printf '  %-11s %s\n' Upstream "$it_upstream"
    [ "$it_author" = - ] || printf '  %-11s %s\n' Author "$it_author"
    [ "$it_licence" = - ] || printf '  %-11s %s\n' Licence "$it_licence"
    [ "$it_size" = - ] || printf '  %-11s %s\n' Size "$it_size"
    if item_weight "$it_options" && heavy "$iw_dl" "$iw_disk"; then
        printf '  %-11s %s\n' Packages "$(weight_sentence "$iw_what" "$iw_dl" "$iw_disk")"
    fi
    return 0
}

# sha256 of a short string, for caching a fetch that carries no digest of its
# own (an old catalog's demo has none — a fresh one carries demo-digest).
string_digest() {
    sd_tmp="$CACHE_DIR/.picture-url.$$"
    mkdir -p "$CACHE_DIR"
    printf '%s' "$1" > "$sd_tmp"
    sd_out=$(file_digest "$sd_tmp")
    rm -f "$sd_tmp"
    printf '%s' "$sd_out"
}

# ---------------------------------------------------------------------------
# The asset cache — pictures, demos and readmes for tlstore-ui
# ---------------------------------------------------------------------------
#
# Everything tlstore-ui shows lives under CACHE_DIR ($HOME/.cache/tlstore —
# the Termux home, under the app's files directory, which Android leaves
# alone; it is not the app's cache directory the system may clear):
#
#   pictures/<digest>.<ext>            a picture or demo, keyed by the catalog's
#                                      digest (by the sha256 of its URL when an
#                                      old catalog carries none)
#   readme/pinned/<digest>.md          a pinned readme, keyed by its digest
#   readme/<name>-<version>.md, .ref   an upstream readme and the revision it
#                                      was read at, keyed by the item's version
#   readme/<name>/<ref>/<urldigest>.<ext>
#                                      a picture that readme refers to
#   snapshot.tsv                       the last `snapshot --tsv`, with its key
#   .changed                           touched whenever any of the above moves
#
# A digest-keyed file is final: it is fetched once and served for as long as
# the catalog names that digest. A version-keyed one is fetched once per
# version; `prefetch` revalidates it at most once a day (curl -z, in the
# background), and `readme` / `readme-asset` — the open path — always serve
# whatever copy is here, offline or not. `prefetch` also throws away what the
# active catalog no longer names.

# cache_stamp — something under CACHE_DIR changed (a fetch landed, an orphan
# went), so the next `snapshot` knows its cached copy is stale.
cache_stamp() {
    mkdir -p "$CACHE_DIR"
    touch "$CACHE_DIR/.changed"
}

# file_stamp <file> — its mtime and size, "-" when it is not there.
file_stamp() {
    [ -e "$1" ] || { printf '%s' -; return 0; }
    stat -c '%Y.%s' "$1" 2>/dev/null || stat -f '%m.%z' "$1" 2>/dev/null || printf '?'
}

# stale_day <file> — is the copy a day old or more?
stale_day() {
    [ -f "$1" ] || return 1
    [ -n "$(find "$1" -mtime +0 2>/dev/null)" ]
}

# A local, verified copy of <url> (checked against <digest> unless it is "-"),
# cached under CACHE_DIR/pictures keyed by the digest so a second call for the
# same picture never touches the network. Prints the path on success only.
# cache_fetch <url> <digest> <extension>
cache_fetch() {
    cf_url="$1"
    cf_digest="$2"
    cf_ext="$3"
    mkdir -p "$CACHE_DIR/pictures"
    if [ -n "$cf_digest" ] && [ "$cf_digest" != "-" ]; then
        cf_key="$cf_digest"
    else
        cf_key=$(string_digest "$cf_url")
    fi
    cf_dest="$CACHE_DIR/pictures/$cf_key.$cf_ext"
    if [ -f "$cf_dest" ]; then
        printf '%s\n' "$cf_dest"
        return 0
    fi
    download "$cf_url" "$cf_dest" "$cf_digest" || return 1
    cache_stamp
    printf '%s\n' "$cf_dest"
    return 0
}

# picture_fetch <source> <digest> — the cached, verified copy of a picture or
# demo source field (the path `tlstore picture` prints), fetched when missing.
picture_fetch() {
    pf_url=$(source_url "$1")
    pf_ext="${pf_url##*.}"
    case "$pf_ext" in
        ''|*[!a-zA-Z0-9]*) pf_ext=jpg ;;
    esac
    cache_fetch "$pf_url" "$2" "$pf_ext"
}

# tlstore picture <name> [demo] — for tlstore-ui: the local path of the item's
# cover picture, or its demo when "demo" is given, fetched and digest-checked
# the same way any other launcher: source is (see load_item / picture,
# picture-digest, demo, demo-digest). A catalog from before demo-digest
# carries "-" there, so it is only cached by its URL, not verified against
# one. Prints nothing and exits non-zero when the item has no such picture,
# the download fails, or the digest does not match.
cmd_picture() {
    cp_name=""
    cp_demo=0
    for cp_a in "$@"; do
        case "$cp_a" in
            demo) cp_demo=1 ;;
            -*) err "unknown option: $cp_a"; return 2 ;;
            *)
                if [ -n "$cp_name" ]; then
                    err "picture needs one name"
                    return 2
                fi
                cp_name="$cp_a"
                ;;
        esac
    done
    [ -n "$cp_name" ] || { err "picture needs a name"; return 2; }
    need_catalog
    load_item "$cp_name" || return 1
    if [ "$cp_demo" = 1 ]; then
        cp_source="$it_demo"
        cp_digest="$it_demo_digest"
    else
        cp_source="$it_picture"
        cp_digest="$it_picture_digest"
    fi
    [ "$cp_source" != "-" ] && [ -n "$cp_source" ] || return 1
    picture_fetch "$cp_source" "$cp_digest"
}

# ---------------------------------------------------------------------------
# The upstream README, for tlstore-ui's item page
# ---------------------------------------------------------------------------

# github_url <https address> — the address actually fetched: the real one, or
# the same host and path under the TLSTORE_GITHUB tree when it is set.
github_url() {
    if [ -n "$GITHUB_MIRROR" ]; then
        printf '%s/%s' "$GITHUB_MIRROR" "${1#https://}"
    else
        printf '%s' "$1"
    fi
}

# github_host_ok <address> — only https on GitHub's own hosts is fetched for a
# README's pictures; anything else is left where it is.
github_host_ok() {
    case "$1" in
        https://*) ;;
        *) return 1 ;;
    esac
    gh_host="${1#https://}"
    gh_host="${gh_host%%/*}"
    gh_host="${gh_host##*@}"
    gh_host="${gh_host%%:*}"
    case "$gh_host" in
        github.com|raw.githubusercontent.com|user-images.githubusercontent.com) return 0 ;;
        *.githubusercontent.com|github.io|*.github.io) return 0 ;;
    esac
    return 1
}

# quiet_fetch <https address> <destination> <cap in bytes, 0 for none>
# [<copy to revalidate>] — a silent download, written beside its destination
# first (under this process's pid, so a prefetch lane and an item opened early
# never share a part file) so a failure leaves nothing behind. A missing file,
# a network error and a file over the cap all fail the same way; the caller
# says what that means. With a fourth argument the request is conditional on
# that copy's age (curl -z): when the server has nothing newer, nothing is
# written and the function still succeeds — the caller checks for the file.
# Five seconds to connect and a minute for the whole file: a readme is small.
quiet_fetch() {
    qf_dir=$(dirname "$2")
    mkdir -p "$qf_dir" || return 1
    qf_tmp="$qf_dir/.$(basename "$2").$$.part"
    if [ -n "${4:-}" ]; then
        if ! curl -fsL --connect-timeout 5 --max-time 60 --max-filesize "$3" -z "$4" -o "$qf_tmp" "$(github_url "$1")" 2>/dev/null; then
            rm -f "$qf_tmp"
            return 1
        fi
        [ -s "$qf_tmp" ] || { rm -f "$qf_tmp"; return 0; }
    elif ! curl -fsL --connect-timeout 5 --max-time 60 --max-filesize "$3" -o "$qf_tmp" "$(github_url "$1")" 2>/dev/null; then
        rm -f "$qf_tmp"
        return 1
    fi
    # The cap above only holds when the server says the size up front.
    if [ "$3" != 0 ] && [ "$(wc -c < "$qf_tmp" | tr -d ' ')" -gt "$3" ]; then
        rm -f "$qf_tmp"
        return 1
    fi
    mv "$qf_tmp" "$2"
}

# readme_ref <version> — the revision an item's README is read at: the commit
# in a +<hash> suffix (dawn's 0.1.3+0e958747.2 is read at 0e958747), else
# v<version> for an x.y.z version, else HEAD.
readme_ref() {
    case "$1" in
        *+*)
            rr_hash="${1#*+}"
            rr_hash=$(printf '%s' "$rr_hash" | sed 's/[^0-9a-fA-F].*//')
            case "$rr_hash" in
                ???????*) printf '%s' "$rr_hash"; return 0 ;;
            esac
            ;;
    esac
    case "$1" in
        [0-9]*.[0-9]*.[0-9]*) printf 'v%s' "$1" ;;
        *) printf 'HEAD' ;;
    esac
}

# readme_resolve — after load_item: sets RD_PATH to the item's cached README
# and RD_REF to the revision it was read at, fetching only when there is no
# copy for this version yet. A tag that is not there falls back to HEAD. The
# copy is keyed by the item's version, so a new one is fetched when the
# catalog moves the item on; `prefetch` revalidates it once a day
# (readme_revalidate). Returns 1 when there is no copy at all, 2 when the item
# has no upstream to read (a setup, or a part).
readme_resolve() {
    RD_PATH=""
    RD_REF=""
    [ -n "$it_upstream" ] && [ "$it_upstream" != "-" ] || return 2
    rd_dir="$CACHE_DIR/readme"
    rd_md="$rd_dir/$it_name-$it_version.md"
    rd_reffile="$rd_dir/$it_name-$it_version.ref"
    rd_want=$(readme_ref "$it_version")
    if [ ! -f "$rd_md" ]; then
        rd_new="$rd_dir/.$it_name-$it_version.$$.new"
        for rd_try in "$rd_want" HEAD; do
            if quiet_fetch "$GITHUB_RAW/$it_upstream/$rd_try/README.md" "$rd_new" 0; then
                mv "$rd_new" "$rd_md" || return 1
                printf '%s\n' "$rd_try" > "$rd_reffile"
                cache_stamp
                break
            fi
            [ "$rd_try" != HEAD ] || break
        done
    fi
    [ -f "$rd_md" ] || return 1
    RD_PATH="$rd_md"
    RD_REF=$(cat "$rd_reffile" 2>/dev/null || true)
    [ -n "$RD_REF" ] || RD_REF="$rd_want"
    return 0
}

# readme_revalidate — after readme_resolve found a copy: once a day, asks
# GitHub whether the README at that revision has moved (curl -z) and takes the
# newer one when it has. Either way the copy's clock is reset, so the question
# is asked at most daily, and a copy that cannot be checked stays as it is.
readme_revalidate() {
    [ -n "$RD_PATH" ] || return 0
    stale_day "$RD_PATH" || return 0
    rv_new="$CACHE_DIR/readme/.$it_name-$it_version.$$.new"
    if quiet_fetch "$GITHUB_RAW/$it_upstream/$RD_REF/README.md" "$rv_new" 0 "$RD_PATH" && [ -s "$rv_new" ]; then
        mv "$rv_new" "$RD_PATH" && cache_stamp
    fi
    rm -f "$rv_new"
    touch "$RD_PATH" 2>/dev/null || true
    return 0
}

# readme_resolve_pinned — after load_item, when it_readme is not "-": a local,
# digest-verified copy of the pinned readme (see load_item / readme,
# readme-digest), cached under CACHE_DIR/readme/pinned keyed by the digest so
# a second call never touches the network — the same scheme `tlstore picture`
# already uses for a cover picture. Sets RD_PATH and returns 0 on success;
# returns 1, printing nothing, when the download fails or the digest does not
# match (download() prints the one clear line either way). A digest mismatch
# is never a silent fall back to the upstream readme, the same as a picture
# whose digest does not match is never silently served from somewhere else.
readme_resolve_pinned() {
    RD_PATH=""
    rp_url=$(source_url "$it_readme")
    rp_dir="$CACHE_DIR/readme/pinned"
    rp_dest="$rp_dir/$it_readme_digest.md"
    if [ -f "$rp_dest" ]; then
        RD_PATH="$rp_dest"
        return 0
    fi
    mkdir -p "$rp_dir" || return 1
    download "$rp_url" "$rp_dest" "$it_readme_digest" || return 1
    cache_stamp
    RD_PATH="$rp_dest"
    return 0
}

# tlstore readme <name> — for tlstore-ui: the path of the item's README. When
# the catalog pins one (readme, readme-digest — see load_item), that digest-
# verified copy is fetched, cached and served, and a mismatch is a hard
# failure with no fallback to upstream. Otherwise the upstream README is read
# at the revision the item is built from (readme_ref) and kept under
# CACHE_DIR/readme for as long as the item stays at that version; a copy that
# is here is served at once, whatever its age (`prefetch` keeps it current).
# Prints the path alone on stdout; exits 1 with one line on stderr when
# nothing could be fetched and nothing is kept, 2 when the item has no
# upstream and no pinned readme (a setup).
cmd_readme() {
    [ $# -eq 1 ] || { err "readme needs one name"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    if [ "$it_readme" != "-" ]; then
        readme_resolve_pinned && { printf '%s\n' "$RD_PATH"; return 0; }
        return 1
    fi
    readme_resolve
    rd_rc=$?
    case "$rd_rc" in
        0) printf '%s\n' "$RD_PATH"; return 0 ;;
        2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
        *) err "could not fetch the readme for $it_name, and no copy is kept here"; return 1 ;;
    esac
}

# readme_asset_fetch <src> <revalidate 0|1> — after load_item: the cached copy
# of a picture the item's README refers to, fetched when missing. <src> is
# the address as written in the README: relative (resolved against the
# README's own revision on raw.githubusercontent.com) or an https address on
# one of GitHub's hosts; anything else returns 1. At most 5 MB. The copy lives
# under CACHE_DIR/readme/<name>/<ref>/, keyed by the address, so it moves on
# with the README's revision; with <revalidate> 1 (the prefetch) a copy a day
# old is checked against GitHub first. Prints the path alone on stdout.
readme_asset_fetch() {
    ra_src="$1"
    ra_reval="${2:-0}"
    case "$ra_src" in
        https://*)
            github_host_ok "$ra_src" || { err "$ra_src is not on GitHub — left alone"; return 1; }
            ;;
        *:*|//*)
            err "$ra_src is not on GitHub — left alone"
            return 1
            ;;
    esac
    # The README the address belongs to, and the revision its copy is kept
    # under: the README's own, or the commit a pinned copy names on its first
    # line (<!-- tlstore: pinned from owner/repo@sha -->), so the pictures go
    # when the README moves on.
    ra_pin=""
    ra_rc=0
    if [ "$it_readme" != "-" ]; then
        readme_resolve_pinned || { err "could not fetch the readme for $it_name, so $ra_src has nothing to be relative to"; return 1; }
        ra_pin=$(sed -n '1s/^<!-- tlstore: pinned from \([A-Za-z0-9._-]*\/[A-Za-z0-9._-]*\)@\([0-9a-f]*\) -->$/\1@\2/p' "$RD_PATH")
        ra_ref="${ra_pin##*@}"
        [ -n "$ra_ref" ] || ra_ref=pinned
    else
        readme_resolve
        ra_rc=$?
        ra_ref="${RD_REF:-HEAD}"
    fi
    case "$ra_src" in
        https://*) ra_url="$ra_src" ;;
        *)
            ra_rel="${ra_src#./}"
            ra_rel="${ra_rel#/}"
            if [ "$it_readme" != "-" ]; then
                case "$ra_pin" in
                    */*@?*) ra_url="$GITHUB_RAW/${ra_pin%@*}/${ra_pin##*@}/$ra_rel" ;;
                    *) err "the pinned readme for $it_name does not say where it was taken from"; return 1 ;;
                esac
            else
                case "$ra_rc" in
                    0) ;;
                    2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
                    *) err "could not fetch the readme for $it_name, so $ra_src has nothing to be relative to"; return 1 ;;
                esac
                ra_url="$GITHUB_RAW/$it_upstream/$RD_REF/$ra_rel"
            fi
            ;;
    esac
    ra_file="${ra_url%%\?*}"
    ra_file="${ra_file%%#*}"
    ra_file="${ra_file##*/}"
    ra_ext=""
    case "$ra_file" in
        *.*)
            ra_ext="${ra_file##*.}"
            case "$ra_ext" in
                ''|*[!a-zA-Z0-9]*) ra_ext="" ;;
                *) ra_ext=".$ra_ext" ;;
            esac
            ;;
    esac
    ra_dir="$CACHE_DIR/readme/$it_name/$ra_ref"
    ra_dest="$ra_dir/$(string_digest "$ra_url")$ra_ext"
    ra_new="$ra_dir/.$(basename "$ra_dest").$$.new"
    if [ ! -f "$ra_dest" ]; then
        if quiet_fetch "$ra_url" "$ra_new" 5242880; then
            mv "$ra_new" "$ra_dest" || return 1
            cache_stamp
        fi
    elif [ "$ra_reval" = 1 ] && stale_day "$ra_dest"; then
        # A stale copy is only replaced by a fetch that brought something
        # newer, and its clock is reset either way.
        if quiet_fetch "$ra_url" "$ra_new" 5242880 "$ra_dest" && [ -s "$ra_new" ]; then
            mv "$ra_new" "$ra_dest" && cache_stamp
        fi
        rm -f "$ra_new"
        touch "$ra_dest" 2>/dev/null || true
    fi
    [ -f "$ra_dest" ] || { err "could not fetch $ra_src for $it_name"; return 1; }
    printf '%s\n' "$ra_dest"
    return 0
}

# tlstore readme-asset <name> <src> — for tlstore-ui: a picture the README
# refers to (readme_asset_fetch), served from the cache whenever a copy is
# here. Prints the path alone on stdout.
cmd_readme_asset() {
    [ $# -eq 2 ] || { err "readme-asset needs a name and a picture address"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    readme_asset_fetch "$2" 0
}

# readme_first_image <readme file> — the picture tlstore-ui puts in the
# header: the first image before the first H2 (markdown or <img>), leaving
# out SVGs, shields and badges the way the UI's parser does. Prints nothing
# when there is none.
readme_first_image() {
    awk '
        function usable(src) {
            s = tolower(src)
            sub(/[?#].*/, "", s)
            if (s ~ /\.svg$/) return 0
            if (index(tolower(src), "shields.io") > 0) return 0
            if (index(tolower(src), "badge") > 0) return 0
            if (index(tolower(src), "/badges/") > 0) return 0
            return 1
        }
        /^##[ \t]/ || /^##$/ || /<[Hh]2[ >]/ { exit }
        {
            line = $0
            while (match(line, /!\[[^]]*\]\([^)]*\)/)) {
                src = substr(line, RSTART, RLENGTH)
                sub(/^!\[[^]]*\]\(/, "", src)
                sub(/\)$/, "", src)
                sub(/[ \t].*/, "", src)
                if (src != "" && usable(src)) { print src; exit }
                line = substr(line, RSTART + RLENGTH)
            }
            line = $0
            while (match(line, /<[Ii][Mm][Gg][ \t][^>]*>/)) {
                tag = substr(line, RSTART, RLENGTH)
                if (match(tag, /[Ss][Rr][Cc][ \t]*=[ \t]*"[^"]*"/)) {
                    src = substr(tag, RSTART, RLENGTH)
                    sub(/^[Ss][Rr][Cc][ \t]*=[ \t]*"/, "", src)
                    sub(/"$/, "", src)
                } else if (match(tag, /[Ss][Rr][Cc][ \t]*=[ \t]*'"'"'[^'"'"']*'"'"'/)) {
                    src = substr(tag, RSTART, RLENGTH)
                    sub(/^[Ss][Rr][Cc][ \t]*=[ \t]*'"'"'/, "", src)
                    sub(/'"'"'$/, "", src)
                } else {
                    src = ""
                }
                if (src != "" && usable(src)) { print src; exit }
                line = substr(line, RSTART + RLENGTH)
            }
        }' "$1"
}

# ---------------------------------------------------------------------------
# One snapshot and one prefetch, for tlstore-ui
# ---------------------------------------------------------------------------

# snapshot_key — what `snapshot` reads: the catalog and the installed list
# (by name, mtime and size), the cache's stamp, the channel answers, and
# everything rows() filters on. When none of it changed, neither did the
# answer.
snapshot_key() {
    printf 'v=%s;serial=%s;catalog=%s:%s;state=%s;held=%s;cache=%s;channel=%s;host=%s;arch=%s;pkg=%s;lver=%s;home=%s;prefix=%s' \
        "$TLSTORE_VERSION" "$CATALOG_SERIAL" "$CATALOG" "$(file_stamp "$CATALOG")" \
        "$(file_stamp "$STATE")" "$(file_stamp "$HELD")" "$(file_stamp "$CACHE_DIR/.changed")" \
        "$(channel_stamp)" \
        "$HOST" "$ARCH" "$APP_PACKAGE" "$LAUNCHER_VERSION" "$HOME" "$PREFIX"
}

# channel_stamp — the channel answers without their times: every check
# rewrites channel.tsv, and only a changed outcome or reason changes the
# snapshot.
channel_stamp() {
    [ -f "$CHANNEL_FILE" ] || return 0
    awk -F "$TAB" '{ printf "%s:%s:%s,", $1, $2, $4 }' "$CHANNEL_FILE"
}

# snapshot_channels — a `channel` line per channel CHANNEL_FILE has an
# answer for: catalog|self, the outcome, and the reason (- for none).
snapshot_channels() {
    [ -f "$CHANNEL_FILE" ] || return 0
    awk -F "$TAB" -v OFS="$TAB" '
        ($1 == "catalog" || $1 == "self") && $2 != "" {
            print "channel", $1, $2, ($4 == "" ? "-" : $4)
        }' "$CHANNEL_FILE"
}

# snapshot_rows — one awk pass over every row that applies here and the
# installed list: the `item` line of every visible item (the list --tsv
# columns), its `field` lines (the info --tsv rows, same keys, same order),
# an `update` line per installed item with a newer version here (the update
# --check --tsv --offline columns), and, for snapshot_cached to turn into
# `cached` lines, a `check` (path known) or `probe` (path keyed by the URL's
# digest) line per picture, demo and readme.
snapshot_rows() {
    sn_codex=0
    [ ! -d "$HOME/.codex" ] || sn_codex=1
    rows | awk -F "$TAB" -v OFS="$TAB" -v state="$STATE" -v heldfile="$HELD" -v home="$HOME" \
        -v bindir="$BIN_DIR" -v libdir="$LIB_DIR" -v privdir="$PRIV_DIR" \
        -v skillsdir="$SKILLS_DIR" -v codex="$sn_codex" \
        -v cachedir="$CACHE_DIR" -v launcher_raw="$LAUNCHER_RAW" -v binaries_raw="$BINARIES_RAW" \
        -v binaries_rel="$BINARIES_RELEASES" -v arch="$ARCH" -v ask="$WEIGH_ASK_MB" '
        function optval(list, key,   n, i, parts) {
            n = split(list, parts, ";")
            for (i = 1; i <= n; i++)
                if (index(parts[i], key "=") == 1)
                    return substr(parts[i], length(key) + 2)
            return ""
        }
        function dash(v) { return (v == "") ? "-" : v }
        function expand(p) {
            if (p == "~") return home
            if (substr(p, 1, 2) == "~/") return home substr(p, 2)
            return p
        }
        # item_targets, as the shell does it.
        function targets(name, kind, target, source, opts,   exe, n, parts) {
            if (kind == "binary" || kind == "file" || kind == "file-once") {
                if (kind == "binary" && optval(opts, "priv") == "shizuku") {
                    if (target == "-" || target == "") return privdir "/" name " " bindir "/" name
                    return expand(target) " " bindir "/" name
                }
                if (target == "-" || target == "") return (kind == "binary") ? bindir "/" name : ""
                return expand(target)
            }
            if (kind == "npm-musl" || kind == "npm-android") {
                n = split(source, parts, "#")
                exe = (n > 1) ? parts[n] : name
                sub(/.*\//, "", exe)
                if (optval(opts, "command") != "") exe = optval(opts, "command")
                if (target == "-" || target == "") return libdir "/" name " " bindir "/" exe
                return expand(target) " " bindir "/" exe
            }
            if (kind == "archive") {
                exe = optval(opts, "command")
                if (exe == "") exe = name
                if (target == "-" || target == "") return libdir "/" name " " bindir "/" exe
                return expand(target) " " bindir "/" exe
            }
            if (kind == "skill") {
                exe = (target == "-" || target == "") ? skillsdir "/" name : expand(target)
                exe = exe " " home "/.claude/skills/" name
                if (codex == 1) exe = exe " " home "/.codex/skills/" name
                return exe
            }
            return ""
        }
        # source_url, as the shell does it.
        function url_of(src,   rest, path, tag) {
            if (index(src, "launcher:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                return launcher_raw "/" tag "/" path
            }
            if (index(src, "binaries:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                if (index(path, "/") > 0) return binaries_raw "/" tag "/" path
                return binaries_rel "/" tag "/" path "-" arch
            }
            return src
        }
        function ext_of(url,   e) {
            e = url
            sub(/.*\./, "", e)
            if (e == "" || e ~ /[^a-zA-Z0-9]/) e = "jpg"
            return e
        }
        # item_weight, heavy and weight_sentence, as the shell does them (Revision 15).
        function weight(name, opts,   v, what, dl, disk) {
            v = optval(opts, "pkg-size")
            if (v !~ /^(0|[1-9][0-9]*),(0|[1-9][0-9]*)$/) return
            dl = v; sub(/,.*/, "", dl)
            disk = v; sub(/.*,/, "", disk)
            if (dl + 0 <= ask + 0 && disk + 0 <= ask + 0) return
            what = optval(opts, "pkg-what")
            if (what == "") what = "packages from Termux"
            put(name, "Packages", "Also installs " what ": about " dl " MB to download, " disk " MB on disk (less if you already have some of them).")
            put(name, "Packages-size", dl "," disk)
        }
        function put(name, key, value) { print "field", name, key, value }
        function put_known(name, key, value) { if (value != "-") put(name, key, value) }
        function asset(name, what, src, digest,   url) {
            url = url_of(src)
            if (digest != "-" && digest != "") print "check", name, what, cachedir "/pictures/" digest "." ext_of(url)
            else print "probe", name, what, url, ext_of(url)
        }
        BEGIN {
            while ((getline line < state) > 0) {
                if (line ~ /^#/) continue
                n = split(line, f, "\t")
                if (n > 0 && f[1] != "") { inst[f[1]] = 1; iver[f[1]] = f[3] }
            }
            close(state)
            # A held item is not offered an update; a missing file just ends the loop.
            while ((getline line < heldfile) > 0)
                if (line != "") held[line] = 1
            close(heldfile)
        }
        {
            name = $1; kind = $2; ver = $3; src = $5; dig = $6; target = $7
            req = $8; opts = $9; summary = $10
            hidden = (opts ~ /(^|;)hidden=1(;|$)/)
            have = (name in inst) ? iver[name] : ""
            if (!hidden) {
                print "item", name, (name in inst) ? "installed" : "available", ver, have, kind, summary, dash($11), $26
                where = targets(name, kind, target, src, opts)
                if (kind == "pkg") where = src
                else if (kind == "bundle") where = "-"
                if (where == "") where = "-"
                build = optval(opts, "build")
                put(name, "Kind", kind)
                put(name, "Version", ver)
                put(name, "From", src)
                put(name, "Checksum", dig)
                put(name, "Needs", req)
                if (build != "") put(name, "Builds with", build)
                put(name, "Files", where)
                if (name in inst) put(name, "Installed", have)
                put(name, "Summary", summary)
                put_known(name, "Category", dash($11))
                put_known(name, "Upstream", dash($12))
                put(name, "Setup", $13)
                put_known(name, "Standfirst", dash($14))
                put_known(name, "Does1", dash($15))
                put_known(name, "Does2", dash($16))
                put_known(name, "Does3", dash($17))
                put_known(name, "Try", dash($18))
                put_known(name, "Notes", dash($19))
                put_known(name, "Author", dash($20))
                put_known(name, "Licence", dash($21))
                put_known(name, "Size", dash($22))
                weight(name, opts)
                if (dash($23) != "-") {
                    put(name, "Picture", $23)
                    put(name, "Picture-digest", $24)
                }
                if (dash($25) != "-") {
                    put(name, "Demo", $25)
                    put_known(name, "Demo-digest", dash($30))
                }
                put(name, "Featured", $26)
                put_known(name, "Readme-skip", dash($27))
                if (dash($28) != "-") {
                    put(name, "Readme", $28)
                    put_known(name, "Readme-digest", dash($29))
                }
            }
            if (name in inst) {
                retired = (opts ~ /(^|;)retired=1(;|$)/)
                # A retired row is hidden: the UI could count it but never
                # show or run it. snapshot has already retired it anyway.
                if (retired || (name in held)) {
                    upd = 0
                } else {
                    upd = 0
                    note = (kind == "file") ? "config-asks" : ""
                    if (kind == "pkg" || kind == "bundle" || kind == "fisher") upd = 0
                    else if (kind == "npm-musl" || kind == "npm-android") upd = (ver != "latest" && ver != have)
                    else upd = (ver != have)
                }
                if (upd) print "update", name, have, ver, note
            }
            if (!hidden) {
                if (dash($23) != "-") asset(name, "picture", $23, dash($24))
                if (dash($25) != "-") asset(name, "demo", $25, dash($30))
                if (dash($28) != "-") print "check", name, "readme", cachedir "/readme/pinned/" dash($29) ".md"
                else if (dash($12) != "-") print "check", name, "readme", cachedir "/readme/" name "-" ver ".md"
            }
        }'
}

# snapshot_cached — passes snapshot_rows through, turning each `check` and
# `probe` line into a `cached` line when the file is really here (nothing is
# forked for a check; a probe hashes the URL, as cache_fetch does).
snapshot_cached() {
    while IFS= read -r sc_line; do
        case "$sc_line" in
            "check$TAB"*|"probe$TAB"*)
                sc_kind="${sc_line%%"$TAB"*}"
                sc_rest="${sc_line#*"$TAB"}"
                sc_name="${sc_rest%%"$TAB"*}"
                sc_rest="${sc_rest#*"$TAB"}"
                sc_what="${sc_rest%%"$TAB"*}"
                sc_rest="${sc_rest#*"$TAB"}"
                if [ "$sc_kind" = probe ]; then
                    sc_url="${sc_rest%%"$TAB"*}"
                    sc_ext="${sc_rest#*"$TAB"}"
                    sc_path="$CACHE_DIR/pictures/$(string_digest "$sc_url").$sc_ext"
                else
                    sc_path="$sc_rest"
                fi
                if [ -f "$sc_path" ]; then
                    printf 'cached\t%s\t%s\t%s\n' "$sc_name" "$sc_what" "$sc_path"
                fi
                ;;
            *) printf '%s\n' "$sc_line" ;;
        esac
    done
    return 0
}

# tlstore snapshot --tsv — for tlstore-ui: everything its screens need, in one
# run. Line-typed, tab-separated, comment lines starting with #:
#   item    name state version installed kind summary category featured
#   field   name key value             (the info --tsv rows, one per line)
#   update  name installed available note
#   cached  name picture|demo|readme path   (a verified copy already here)
#   channel catalog|self outcome reason     (the last check of each, see
#                                            channel_fetch; reason - for none)
# The answer is kept under CACHE_DIR/snapshot.tsv with its key (snapshot_key)
# on the first line, and served from there while nothing it reads has moved.
cmd_snapshot() {
    sn_tsv=0
    for sn_a in "$@"; do
        case "$sn_a" in
            --tsv) sn_tsv=1 ;;
            *) err "unknown option: $sn_a"; return 2 ;;
        esac
    done
    [ "$sn_tsv" = 1 ] || { err "snapshot is for programs: use --tsv"; return 2; }
    need_catalog
    retire_pending
    sn_key=$(snapshot_key)
    sn_file="$CACHE_DIR/snapshot.tsv"
    sn_head="# tlstore snapshot${TAB}key=$sn_key"
    if [ -f "$sn_file" ] && [ "$(head -1 "$sn_file" 2>/dev/null)" = "$sn_head" ]; then
        cat "$sn_file"
        return 0
    fi
    mkdir -p "$CACHE_DIR"
    sn_tmp="$sn_file.$$.new"
    {
        printf '%s\n' "$sn_head"
        snapshot_rows | snapshot_cached
        snapshot_channels
    } > "$sn_tmp" || { rm -f "$sn_tmp"; return 1; }
    mv "$sn_tmp" "$sn_file" || { rm -f "$sn_tmp"; return 1; }
    cat "$sn_file"
    return 0
}

# prefetch_say <ready|failed> <name> <kind> <path or reason> [src] — one line
# of the prefetch stream, written whole (one short printf is one write).
prefetch_say() {
    if [ $# -ge 5 ]; then
        printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5"
    else
        printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"
    fi
}

# prefetch_item <name> — after need_catalog: the item's picture, demo, readme
# and the readme's first image, one line each as it lands. What is cached
# and verified is answered without a fetch.
prefetch_item() {
    load_item "$1" || return 0
    if [ "$it_picture" != "-" ] && [ -n "$it_picture" ]; then
        if pi_p=$(picture_fetch "$it_picture" "$it_picture_digest" 2>/dev/null); then
            prefetch_say ready "$it_name" picture "$pi_p"
        else
            prefetch_say failed "$it_name" picture "not fetched or not verified"
        fi
    fi
    if [ "$it_demo" != "-" ] && [ -n "$it_demo" ]; then
        if pi_p=$(picture_fetch "$it_demo" "$it_demo_digest" 2>/dev/null); then
            prefetch_say ready "$it_name" demo "$pi_p"
        else
            prefetch_say failed "$it_name" demo "not fetched or not verified"
        fi
    fi
    RD_PATH=""
    RD_REF=""
    if [ "$it_readme" != "-" ]; then
        if readme_resolve_pinned 2>/dev/null; then
            prefetch_say ready "$it_name" readme "$RD_PATH"
        else
            prefetch_say failed "$it_name" readme "not fetched or not verified"
        fi
    elif [ -n "$it_upstream" ] && [ "$it_upstream" != "-" ]; then
        readme_resolve 2>/dev/null
        pi_rc=$?
        if [ "$pi_rc" = 0 ]; then
            readme_revalidate
            prefetch_say ready "$it_name" readme "$RD_PATH"
        elif [ "$pi_rc" = 1 ]; then
            prefetch_say failed "$it_name" readme "not fetched, and no copy is kept"
        fi
    fi
    [ -n "$RD_PATH" ] || return 0
    pi_src=$(readme_first_image "$RD_PATH")
    [ -n "$pi_src" ] || return 0
    if pi_a=$(readme_asset_fetch "$pi_src" 1 2>/dev/null); then
        prefetch_say ready "$it_name" asset "$pi_a" "$pi_src"
    else
        prefetch_say failed "$it_name" asset "not fetched" "$pi_src"
    fi
    return 0
}

# prefetch_gc — throws away what the active catalog no longer names: a
# picture whose digest is gone, a pinned readme likewise, an upstream readme
# for a version an item has moved past, and a readme's pictures for an item
# or a revision that is gone. Files a fetch is still writing (dot files) are
# never touched.
prefetch_gc() {
    [ -d "$CACHE_DIR" ] || return 0
    gc_pics=" "
    gc_pins=" "
    gc_mds=" "
    gc_names=" "
    gc_subs=" "
    gc_changed=0
    gc_list=$(rows | awk -F "$TAB" -v OFS="$TAB" -v cachedir="$CACHE_DIR" \
        -v launcher_raw="$LAUNCHER_RAW" -v binaries_raw="$BINARIES_RAW" \
        -v binaries_rel="$BINARIES_RELEASES" -v arch="$ARCH" '
        function dash(v) { return (v == "") ? "-" : v }
        function url_of(src,   rest, path, tag) {
            if (index(src, "launcher:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                return launcher_raw "/" tag "/" path
            }
            if (index(src, "binaries:") == 1) {
                rest = substr(src, 10)
                tag = rest; sub(/.*@/, "", tag)
                path = rest; sub(/@[^@]*$/, "", path)
                if (index(path, "/") > 0) return binaries_raw "/" tag "/" path
                return binaries_rel "/" tag "/" path "-" arch
            }
            return src
        }
        function ext_of(url,   e) {
            e = url
            sub(/.*\./, "", e)
            if (e == "" || e ~ /[^a-zA-Z0-9]/) e = "jpg"
            return e
        }
        function asset(src, digest,   url) {
            url = url_of(src)
            if (digest != "-") print "pic", digest "." ext_of(url)
            else print "picurl", url, ext_of(url)
        }
        {
            name = $1; ver = $3
            if (dash($23) != "-") asset($23, dash($24))
            if (dash($25) != "-") asset($25, dash($30))
            print "name", name
            if (dash($28) != "-") {
                print "pin", dash($29) ".md"
                # Its pictures live under the commit the pinned copy names.
                pinfile = cachedir "/readme/pinned/" dash($29) ".md"
                keep = "*"
                if ((getline first < pinfile) > 0 && match(first, /@[0-9a-f][0-9a-f]* -->$/))
                    keep = substr(first, RSTART + 1, RLENGTH - 5)
                close(pinfile)
                print "sub", name, keep
            } else if (dash($12) != "-") {
                print "md", name "-" ver
                print "sub", name, "HEAD"
                print "sub", name, "v" ver
                hash = ver
                if (sub(/^[^+]*\+/, "", hash)) { sub(/[^0-9a-fA-F].*/, "", hash); if (length(hash) >= 7) print "sub", name, hash }
                reffile = cachedir "/readme/" name "-" ver ".ref"
                if ((getline r < reffile) > 0 && r != "") print "sub", name, r
                close(reffile)
            }
        }')
    while IFS= read -r gc_line; do
        gc_t="${gc_line%%"$TAB"*}"
        gc_rest="${gc_line#*"$TAB"}"
        case "$gc_t" in
            pic) gc_pics="$gc_pics$gc_rest " ;;
            picurl)
                gc_url="${gc_rest%%"$TAB"*}"
                gc_ext="${gc_rest#*"$TAB"}"
                gc_pics="$gc_pics$(string_digest "$gc_url").$gc_ext "
                ;;
            pin) gc_pins="$gc_pins$gc_rest " ;;
            md) gc_mds="$gc_mds$gc_rest " ;;
            name) gc_names="$gc_names$gc_rest " ;;
            sub) gc_subs="$gc_subs${gc_rest%%"$TAB"*}/${gc_rest#*"$TAB"} " ;;
        esac
    done <<EOF
$gc_list
EOF
    for gc_f in "$CACHE_DIR/pictures"/*; do
        [ -e "$gc_f" ] || continue
        case "$gc_pics" in
            *" ${gc_f##*/} "*) ;;
            *) rm -f "$gc_f" && gc_changed=1 ;;
        esac
    done
    for gc_f in "$CACHE_DIR/readme/pinned"/*; do
        [ -e "$gc_f" ] || continue
        case "$gc_pins" in
            *" ${gc_f##*/} "*) ;;
            *) rm -f "$gc_f" && gc_changed=1 ;;
        esac
    done
    for gc_f in "$CACHE_DIR/readme"/*; do
        [ -e "$gc_f" ] || continue
        gc_b="${gc_f##*/}"
        if [ -d "$gc_f" ]; then
            [ "$gc_b" != pinned ] || continue
            case "$gc_names" in
                *" $gc_b "*) ;;
                *) rm -rf "$gc_f" && gc_changed=1; continue ;;
            esac
            case "$gc_subs" in
                *" $gc_b/* "*) continue ;;
            esac
            for gc_s in "$gc_f"/*; do
                [ -e "$gc_s" ] || continue
                gc_r="${gc_s##*/}"
                if [ -d "$gc_s" ]; then
                    case "$gc_subs" in
                        *" $gc_b/$gc_r "*) ;;
                        *) rm -rf "$gc_s" && gc_changed=1 ;;
                    esac
                else
                    # A picture from before revisions had directories of their own.
                    rm -f "$gc_s" && gc_changed=1
                fi
            done
        else
            gc_stem="${gc_b%.md}"
            gc_stem="${gc_stem%.ref}"
            case "$gc_mds" in
                *" $gc_stem "*) ;;
                *) rm -f "$gc_f" && gc_changed=1 ;;
            esac
        fi
    done
    [ "$gc_changed" = 0 ] || cache_stamp
    return 0
}

# tlstore prefetch — for tlstore-ui: after throwing away what the catalog no
# longer names (prefetch_gc), fetches every picture, demo, readme and readme
# header picture that is missing, the featured items first and then in list
# order, three items at a time, and prints one line per asset as it lands:
#   ready   name  picture|demo|readme  path
#   ready   name  asset                path  src
#   failed  name  kind                 reason  [src]
# What is cached and verified costs no network at all. Exits 0 once every
# item has been seen.
cmd_prefetch() {
    [ $# -eq 0 ] || { err "prefetch takes no arguments"; return 2; }
    need_catalog
    prefetch_gc
    pf_names=$(visible_rows | awk -F "$TAB" '
        $26 == "1" { print $1; next }
        { later = later "\n" $1 }
        END { printf "%s", substr(later, 2) }')
    pf_lanes=3
    pf_k=0
    while [ "$pf_k" -lt "$pf_lanes" ]; do
        (
            pf_i=0
            for pf_n in $pf_names; do
                if [ $((pf_i % pf_lanes)) -eq "$pf_k" ]; then
                    prefetch_item "$pf_n"
                fi
                pf_i=$((pf_i + 1))
            done
        ) &
        pf_k=$((pf_k + 1))
    done
    wait
    return 0
}

# ---------------------------------------------------------------------------
# The plan (Revision 13)
# ---------------------------------------------------------------------------

# An install, update or remove is built once as a plan, then shown (--dry-run)
# or applied, so a dry run cannot drift from the real run. PLAN holds one row
# per item, in apply order, one row a line:
#   name <TAB> action <TAB> kind <TAB> version <TAB> by <TAB> why
# action  install skip unavailable remove forget retire absent
# by      requested (named on the command line) or auto (pulled in)
# why     why the row is there: "part of fishkit", "needed by claude-code",
#         "needs fishfn", "only claude-code needed it", ...
# An empty field is written "-", so every row splits into six.
PLAN=""
PLAN_VERB=""
# update's knobs, which update_items sets before plan_build update.
PLAN_CHECK=0
PLAN_OFFLINE=0
PLAN_TSV=0
# What the plan found no way to install here; do_bundle does not wait for it.
PLAN_UNAVAILABLE=""
# The why of an npm item pinned to latest, which update asks its source about.
PLAN_LATEST="follows latest"

plan_add() {
    PLAN="$PLAN${PLAN:+$NL}$1$TAB$2$TAB${3:--}$TAB${4:--}$TAB${5:--}$TAB${6:--}"
}

# plan_split <row> — sets ps_name ps_action ps_kind ps_version ps_by ps_why.
plan_split() {
    ps_rest="$1$TAB"
    ps_name="${ps_rest%%"$TAB"*}"; ps_rest="${ps_rest#*"$TAB"}"
    ps_action="${ps_rest%%"$TAB"*}"; ps_rest="${ps_rest#*"$TAB"}"
    ps_kind="${ps_rest%%"$TAB"*}"; ps_rest="${ps_rest#*"$TAB"}"
    ps_version="${ps_rest%%"$TAB"*}"; ps_rest="${ps_rest#*"$TAB"}"
    ps_by="${ps_rest%%"$TAB"*}"; ps_rest="${ps_rest#*"$TAB"}"
    ps_why="${ps_rest%%"$TAB"*}"
}

# plan_names [action] — the names in PLAN, or only those with that action.
plan_names() {
    pn_out=""
    pn_ifs="$IFS"
    IFS="$NL"
    for pn_line in $PLAN; do
        IFS="$pn_ifs"
        plan_split "$pn_line"
        [ -z "${1:-}" ] || [ "$ps_action" = "$1" ] || continue
        pn_out="$pn_out $ps_name"
    done
    IFS="$pn_ifs"
    printf '%s' "${pn_out# }"
}

# deps_has <requires, commas> <name>
deps_has() {
    case ",$1," in
        *",$2,"*) return 0 ;;
    esac
    return 1
}

# plan_why_from <item> — sets pw_why: "part of <item>" when it is a bundle,
# "needed by <item>" otherwise. (It reads the row, so prw_* change.)
plan_why_from() {
    pb_row "$1"
    if [ "$prw_kind" = bundle ]; then
        pw_why="part of $1"
    else
        pw_why="needed by $1"
    fi
}

# plan_build install|update|remove <names> — builds PLAN. Every check that
# refuses the whole command happens here, before anything is asked or
# fetched; then PLAN is empty, the reason has been said, and it returns 1.
plan_build() {
    pb_verb="$1"
    shift
    PLAN=""
    PLAN_VERB="$pb_verb"
    PLAN_UNAVAILABLE=""
    case "$pb_verb" in
        install) plan_build_install "$@" ;;
        update) plan_build_update "$@" ;;
        remove) plan_build_remove "$@" ;;
        *) err "plan_build: no such verb: $pb_verb"; false ;;
    esac
    pb_rc=$?
    [ "$pb_rc" = 0 ] || PLAN=""
    return "$pb_rc"
}

plan_build_install() {
    bi_names=""
    for bi_n in "$@"; do
        in_list "$bi_names" "$bi_n" || bi_names="$bi_names $bi_n"
    done
    for bi_n in $bi_names; do
        pb_row "$bi_n"
        [ "$prw_kind" != "-" ] || { err "$bi_n is not in the list"; return 1; }
        case "$prw_flags" in *r*) err "$bi_n was retired"; return 1 ;; esac
        case "$prw_flags" in *h*) err "$bi_n is part of another item"; return 1 ;; esac
    done

    # Everything they need, breadth first, remembering which item pulled each
    # part in. A retired part refuses the install, as a retired name does.
    bi_closure=""
    bi_parent=" "
    bi_todo="$bi_names"
    while [ -n "$bi_todo" ]; do
        bi_next=""
        for bi_n in $bi_todo; do
            in_list "$bi_closure" "$bi_n" && continue
            pb_row "$bi_n"
            case "$prw_flags" in *r*) err "$bi_n was retired"; return 1 ;; esac
            bi_closure="$bi_closure $bi_n"
            for bi_d in $(commas "$prw_deps"); do
                in_list "$bi_names" "$bi_d" || map_get "$bi_parent" "$bi_d" || bi_parent="$bi_parent$bi_d=$bi_n "
                bi_next="$bi_next $bi_d"
            done
        done
        bi_todo="$bi_next"
    done
    plan_order "$bi_closure"
    bi_order="$po_out"

    # A package that owns the same commands is reported before anything is asked or fetched.
    for bi_n in $bi_order; do
        is_installed "$bi_n" || conflict_check "$bi_n" || return 1
    done

    # A part with no row here. A bundle installs without it (it is another
    # edition's build); anything else that needs it cannot be installed
    # either, and when that was named, nothing is. bi_un maps each such name
    # to what it is missing (- for a name with no row itself).
    bi_un=" "
    for bi_n in $bi_order; do
        pb_row "$bi_n"
        if [ "$prw_kind" = "-" ]; then
            bi_un="$bi_un$bi_n=- "
            continue
        fi
        [ "$prw_kind" != bundle ] || continue
        for bi_d in $(commas "$prw_deps"); do
            if map_get "$bi_un" "$bi_d"; then
                bi_un="$bi_un$bi_n=$bi_d "
                break
            fi
        done
    done
    for bi_n in $bi_names; do
        map_get "$bi_un" "$bi_n" || continue
        err "$bi_n needs $mg_v, which is not available on this device"
        return 1
    done

    for bi_n in $bi_order; do
        bi_by=auto
        in_list "$bi_names" "$bi_n" && bi_by=requested
        bi_why="-"
        if map_get "$bi_parent" "$bi_n"; then
            plan_why_from "$mg_v"
            bi_why="$pw_why"
        fi
        pb_row "$bi_n"
        if map_get "$bi_un" "$bi_n"; then
            if [ "$mg_v" = "-" ]; then
                bi_why="not available on this device"
            else
                bi_why="needs $mg_v, which is not available on this device"
            fi
            PLAN_UNAVAILABLE="$PLAN_UNAVAILABLE $bi_n"
            plan_add "$bi_n" unavailable "$prw_kind" - "$bi_by" "$bi_why"
        elif already_here "$bi_n"; then
            plan_add "$bi_n" skip "$prw_kind" "$prw_ver" "$bi_by" "$bi_why"
        else
            plan_add "$bi_n" install "$prw_kind" "$prw_ver" "$bi_by" "$bi_why"
        fi
    done
    return 0
}

# The update decisions: holds, retired items, versions, npm's latest. With no
# names, everything installed; a held item only when it is named. Then an
# install row for anything the list now says one of them needs that is not
# here yet. PLAN_CHECK asks npm's registry about latest (unless PLAN_OFFLINE)
# instead of planning to fetch it; PLAN_TSV keeps the remarks off stdout.
plan_build_update() {
    bu_explicit=1
    bu_names=""
    for bu_n in "$@"; do
        in_list "$bu_names" "$bu_n" || bu_names="$bu_names $bu_n"
    done
    if [ -z "$bu_names" ]; then
        bu_explicit=0
        bu_names=$(installed_names | tr '\n' ' ')
    fi
    bu_set=""
    # Each planned name's action|version|why-code.
    bu_rows=" "
    bu_retire=""
    for bu_n in $bu_names; do
        if ! is_installed "$bu_n"; then
            [ "$PLAN_TSV" = 1 ] || say "$bu_n is not installed"
            continue
        fi
        pb_row "$bu_n"
        if [ "$prw_kind" = "-" ]; then
            [ "$PLAN_TSV" = 1 ] || say "$bu_n is no longer in the list"
            continue
        fi
        case "$prw_flags" in
            *r*) bu_retire="$bu_retire $bu_n"; continue ;;
        esac
        if [ "$bu_explicit" = 0 ] && is_held "$bu_n"; then
            [ "$PLAN_TSV" = 1 ] || say "$bu_n is held at $(installed_version "$bu_n"); 'tlstore unhold $bu_n' lets it update"
            continue
        fi
        bu_have=$(installed_version "$bu_n")
        bu_act=skip
        bu_ver="$prw_ver"
        bu_code=-
        case "$prw_kind" in
            pkg) bu_act=install; bu_code=pkg ;;
            bundle|fisher) ;;
            npm-musl|npm-android)
                # An item pinned to latest is whatever its source says today.
                # A check asks the registry which version that is and plans it
                # only when it differs from what is here; offline, or when the
                # registry cannot be reached, it is left for the update itself.
                if [ "$prw_ver" = latest ]; then
                    bu_code=latest
                    if [ "$PLAN_CHECK" = 0 ]; then
                        bu_act=install
                    elif [ "$PLAN_OFFLINE" = 0 ]; then
                        bu_now=$(npm_latest_version "$(field "$(row "$bu_n")" 5)")
                        if [ -n "$bu_now" ] && [ "$bu_now" != "$bu_have" ]; then
                            bu_act=install
                            bu_ver="$bu_now"
                        fi
                    fi
                elif [ "$prw_ver" != "$bu_have" ]; then
                    bu_act=install
                fi
                ;;
            *) [ "$prw_ver" = "$bu_have" ] || bu_act=install ;;
        esac
        bu_set="$bu_set $bu_n"
        bu_rows="$bu_rows$bu_n=$bu_act|$bu_ver|$bu_code "
    done

    # What the list now says these need that is not here yet.
    bu_new=""
    bu_parent=" "
    bu_todo="$bu_set"
    while [ -n "$bu_todo" ]; do
        bu_next=""
        for bu_n in $bu_todo; do
            pb_row "$bu_n"
            for bu_d in $(commas "$prw_deps"); do
                in_list "$bu_set" "$bu_d" && continue
                in_list "$bu_new" "$bu_d" && continue
                is_installed "$bu_d" && continue
                bu_new="$bu_new $bu_d"
                bu_parent="$bu_parent$bu_d=$bu_n "
                bu_next="$bu_next $bu_d"
            done
        done
        bu_todo="$bu_next"
    done
    plan_order "$bu_set$bu_new"
    bu_order="$po_out"

    # A new part with no row here (or a retired one) is not installed, nor is
    # a new part that needs one, unless it is a bundle. What is already here
    # is updated as before either way.
    bu_un=" "
    for bu_n in $bu_order; do
        in_list "$bu_new" "$bu_n" || continue
        pb_row "$bu_n"
        case "$prw_kind:$prw_flags" in
            -:*|*:*r*) bu_un="$bu_un$bu_n=- "; continue ;;
        esac
        [ "$prw_kind" != bundle ] || continue
        for bu_d in $(commas "$prw_deps"); do
            if map_get "$bu_un" "$bu_d"; then
                bu_un="$bu_un$bu_n=$bu_d "
                break
            fi
        done
    done

    for bu_n in $bu_order; do
        if in_list "$bu_new" "$bu_n"; then
            map_get "$bu_parent" "$bu_n"
            plan_why_from "$mg_v"
            bu_why="$pw_why"
            pb_row "$bu_n"
            if map_get "$bu_un" "$bu_n"; then
                if [ "$mg_v" = "-" ]; then
                    bu_why="not available on this device"
                else
                    bu_why="needs $mg_v, which is not available on this device"
                fi
                PLAN_UNAVAILABLE="$PLAN_UNAVAILABLE $bu_n"
                plan_add "$bu_n" unavailable "$prw_kind" - auto "$bu_why"
            else
                plan_add "$bu_n" install "$prw_kind" "$prw_ver" auto "$bu_why"
            fi
            continue
        fi
        map_get "$bu_rows" "$bu_n"
        bu_act="${mg_v%%"|"*}"
        bu_rest="${mg_v#*"|"}"
        bu_ver="${bu_rest%%"|"*}"
        bu_code="${bu_rest#*"|"}"
        case "$bu_code" in
            latest) bu_why="$PLAN_LATEST" ;;
            pkg) bu_why="the package manager checks it" ;;
            *) bu_why="-" ;;
        esac
        bu_by=$(state_by "$bu_n")
        pb_row "$bu_n"
        plan_add "$bu_n" "$bu_act" "$prw_kind" "$bu_ver" "${bu_by:--}" "$bu_why"
    done
    for bu_n in $bu_retire; do
        bu_by=$(state_by "$bu_n")
        pb_row "$bu_n"
        plan_add "$bu_n" retire "$prw_kind" "$(installed_version "$bu_n")" "${bu_by:--}" retired
    done
    return 0
}

# What remove takes, in the reverse of the install order: the names, and
#  - a bundle's members, except members recorded as requested on their own
#    (a row from before the by column counts as part of the bundle);
#  - what needs something that is going (a package item only stops being
#    tracked, so needing one is no reason to go);
#  - what was pulled in (auto) by something that is going;
# but never a part that something staying still needs.
plan_build_remove() {
    br_named=""
    for br_n in "$@"; do
        in_list "$br_named" "$br_n" || br_named="$br_named $br_n"
    done
    br_all="$br_named"
    # Why each one the command line did not name is here: p:<bundle> (part
    # of it), n:<item> (needs it), o:<item> (only it needed this one).
    br_codes=" "
    br_kinds=" "
    br_bys=" "
    if [ -f "$STATE" ]; then
        br_kinds=$(awk -F "$TAB" '/^#/ { next } NF { printf " %s=%s", $1, $2 } END { printf " " }' "$STATE")
        br_bys=$(awk -F "$TAB" '/^#/ { next } NF { printf " %s=%s", $1, ($11 == "" ? "-" : $11) } END { printf " " }' "$STATE")
    fi
    if [ -n "$CATALOG" ]; then
        br_installed=$(installed_names | tr '\n' ' ')
        br_changed=1
        while [ "$br_changed" = 1 ]; do
            br_changed=0
            for br_i in $br_installed; do
                in_list "$br_all" "$br_i" && continue
                pb_row "$br_i"
                br_ideps="$prw_deps"
                br_code=""
                for br_r in $(commas "$br_ideps"); do
                    in_list "$br_all" "$br_r" || continue
                    map_get "$br_kinds" "$br_r" || continue
                    [ "$mg_v" != pkg ] || continue
                    br_code="n:$br_r"
                    break
                done
                if [ -z "$br_code" ]; then
                    map_get "$br_bys" "$br_i"
                    br_by="$mg_v"
                    [ "$br_by" != requested ] || continue
                    br_part=""
                    br_only=""
                    for br_r in $br_all; do
                        map_get "$br_kinds" "$br_r" || continue
                        br_rkind="$mg_v"
                        pb_row "$br_r"
                        deps_has "$prw_deps" "$br_i" || continue
                        if [ "$br_rkind" = bundle ]; then
                            [ -n "$br_part" ] || br_part="$br_r"
                        else
                            [ -n "$br_only" ] || br_only="$br_r"
                        fi
                    done
                    if [ -n "$br_part" ]; then
                        br_code="p:$br_part"
                    elif [ -n "$br_only" ] && [ "$br_by" = auto ]; then
                        br_code="o:$br_only"
                    else
                        continue
                    fi
                    br_kept=0
                    for br_j in $br_installed; do
                        [ "$br_j" != "$br_i" ] || continue
                        in_list "$br_all" "$br_j" && continue
                        pb_row "$br_j"
                        if deps_has "$prw_deps" "$br_i"; then
                            br_kept=1
                            break
                        fi
                    done
                    [ "$br_kept" = 0 ] || continue
                fi
                br_all="$br_all $br_i"
                br_codes="$br_codes$br_i=$br_code "
                br_changed=1
            done
        done
        # The reverse of the install order: what needs another item goes
        # first, so fish plugins are taken away while the fisher they need
        # is still there.
        plan_order "$br_all"
        br_order=""
        for br_n in $po_out; do
            br_order="$br_n $br_order"
        done
    else
        # Without a list there is nothing to read the order from.
        br_order="$br_all"
    fi

    for br_n in $br_order; do
        br_by=auto
        in_list "$br_named" "$br_n" && br_by=requested
        br_why="-"
        if map_get "$br_codes" "$br_n"; then
            case "$mg_v" in
                p:*) br_why="part of ${mg_v#p:}" ;;
                n:*) br_why="needs ${mg_v#n:}" ;;
                o:*) br_why="only ${mg_v#o:} needed it" ;;
            esac
        fi
        if ! map_get "$br_kinds" "$br_n"; then
            pb_row "$br_n"
            plan_add "$br_n" absent "$prw_kind" - "$br_by" "$br_why"
            continue
        fi
        br_act=remove
        [ "$mg_v" != pkg ] || br_act=forget
        plan_add "$br_n" "$br_act" "$mg_v" "$(installed_version "$br_n")" "$br_by" "$br_why"
    done
    return 0
}

# plan_show — the dry run, from PLAN: the only dry-run code there is. (For
# update it is also what --check says; DRY_RUN adds "Nothing was changed.")
plan_show() {
    case "$PLAN_VERB" in
        install) plan_show_install ;;
        remove) plan_show_remove ;;
        update) plan_show_update ;;
    esac
}

# Nothing is fetched, written or asked of the package manager, so the build
# tools are named, not checked for, and large packages are said from the
# catalog's figures (plan_weight_say catalog).
plan_show_install() {
    si_names=""
    say "Would install, in this order:"
    si_ifs="$IFS"
    IFS="$NL"
    for si_line in $PLAN; do
        IFS="$si_ifs"
        plan_split "$si_line"
        si_note=""
        [ "$ps_why" = "-" ] || si_note="  ($ps_why)"
        case "$ps_action" in
            unavailable) say "  $ps_name  ($ps_why, skipped)" ;;
            skip) say "  $ps_name  (already installed, skipped)" ;;
            *)
                si_names="$si_names $ps_name"
                case "$ps_kind" in
                    pkg) say "  $ps_name  (packages: $(words_list "$(field "$(row "$ps_name")" 5)"))$si_note" ;;
                    bundle|fisher) say "  $ps_name$si_note" ;;
                    *) say "  $ps_name  $ps_version$si_note" ;;
                esac
                ;;
        esac
    done
    IFS="$si_ifs"
    si_tools=$(build_tools_for "$si_names" 1)
    if [ -n "$si_tools" ]; then
        say "Needed only while installing: $(words_list "$si_tools")"
        say "  (any that are missing are added first, and you are asked about taking them back)"
    fi
    plan_weight_say catalog || :
    say "Nothing was changed."
}

# Each item and the files the state records for it.
plan_show_remove() {
    say "Would remove:"
    sw_ifs="$IFS"
    IFS="$NL"
    for sw_line in $PLAN; do
        IFS="$sw_ifs"
        plan_split "$sw_line"
        sw_note=""
        [ "$ps_why" = "-" ] || sw_note="  ($ps_why)"
        case "$ps_action" in
            absent) say "  $ps_name  (not installed, nothing to do)"; continue ;;
            forget)
                if [ "$ps_why" = "-" ]; then
                    say "  $ps_name  (only forgotten; the package stays installed)"
                else
                    say "  $ps_name  ($ps_why; only forgotten, the package stays installed)"
                fi
                continue
                ;;
        esac
        say "  $ps_name$sw_note"
        sw_row=$(state_row "$ps_name" 2>/dev/null || true)
        sw_digest=$(field "$sw_row" 7)
        for sw_f in $(field "$sw_row" 5); do
            case "$ps_kind" in
                file|file-once)
                    if [ -f "$sw_f" ] && [ -n "$sw_digest" ] && [ "$sw_digest" != "-" ] &&
                        [ "$(file_digest "$sw_f")" != "$sw_digest" ]; then
                        say "    $sw_f  (changed since it was installed; kept beside it as a .bak)"
                        continue
                    fi
                    ;;
            esac
            say "    $sw_f"
        done
    done
    IFS="$sw_ifs"
    say "Nothing was changed."
}

# What update --check says, read off the plan.
plan_show_update() {
    sp_any=0
    sp_up=""
    sp_pkgs=0
    sp_wait=""
    sp_ifs="$IFS"
    IFS="$NL"
    for sp_line in $PLAN; do
        IFS="$sp_ifs"
        plan_split "$sp_line"
        case "$ps_action:$ps_kind" in
            install:pkg) ! is_installed "$ps_name" || sp_pkgs=1 ;;
            install:*)
                if [ "$ps_why" = "$PLAN_LATEST" ]; then
                    sp_any=1
                    say "$ps_name $ps_version is available; you have $(installed_version "$ps_name")"
                elif is_installed "$ps_name"; then
                    sp_up="$sp_up $ps_name"
                fi
                ;;
            skip:*) [ "$ps_why" != "$PLAN_LATEST" ] || sp_wait="$sp_wait $ps_name" ;;
        esac
    done
    IFS="$NL"
    for sp_line in $PLAN; do
        IFS="$sp_ifs"
        plan_split "$sp_line"
        [ "$ps_action" = retire ] || continue
        sp_any=1
        say "$ps_name was retired; update will remove it"
    done
    IFS="$NL"
    for sp_line in $PLAN; do
        IFS="$sp_ifs"
        plan_split "$sp_line"
        case "$ps_action" in
            install)
                [ "$ps_by" = auto ] || continue
                ! is_installed "$ps_name" || continue
                ;;
            unavailable) ;;
            *) continue ;;
        esac
        sp_any=1
        case "$ps_action:$ps_why" in
            install:*) say "$ps_name is $ps_why; update will install it" ;;
            *:needs\ *) say "$ps_name $ps_why; update leaves it out" ;;
            *) say "$ps_name is $ps_why; update leaves it out" ;;
        esac
    done
    IFS="$sp_ifs"
    if [ "$sp_any" = 0 ] && [ -z "$sp_up" ]; then
        say "Everything is up to date."
    else
        for sp_n in $sp_up; do
            sp_row=$(row "$sp_n")
            if [ "$(field "$sp_row" 2)" = file ]; then
                say "$sp_n has a new version; update asks first if you changed it"
            else
                say "$sp_n $(field "$sp_row" 3) is available; you have $(installed_version "$sp_n")"
            fi
        done
    fi
    [ "$sp_pkgs" = 0 ] || say "Packages are checked by the package manager when you update."
    [ "$DRY_RUN" = 0 ] || say "Nothing was changed."
    if [ "$PLAN_OFFLINE" = 1 ]; then
        for sp_n in $sp_wait; do
            say "$sp_n is checked against its source when you update."
        done
    fi
}

# update --check --tsv, read off the plan: name, have, new, note. No line for
# a retired item (it is hidden, so the store UI could count it but never show
# or run it; snapshot retires it instead), nor for a part not installed yet.
plan_tsv() {
    pt_ifs="$IFS"
    IFS="$NL"
    for pt_line in $PLAN; do
        IFS="$pt_ifs"
        plan_split "$pt_line"
        [ "$ps_action" = install ] || continue
        [ "$ps_kind" != pkg ] || continue
        [ "$ps_why" != "$PLAN_LATEST" ] || continue
        is_installed "$ps_name" || continue
        pt_note=""
        [ "$ps_kind" = file ] && pt_note=config-asks
        printf '%s\t%s\t%s\t%s\n' "$ps_name" "$(installed_version "$ps_name")" "$ps_version" "$pt_note"
    done
    IFS="$NL"
    for pt_line in $PLAN; do
        IFS="$pt_ifs"
        plan_split "$pt_line"
        [ "$ps_action" = install ] || continue
        [ "$ps_why" = "$PLAN_LATEST" ] || continue
        printf '%s\t%s\t%s\t%s\n' "$ps_name" "$(installed_version "$ps_name")" "$ps_version" latest
    done
    IFS="$pt_ifs"
}

# plan_pkg_list [rows] — the Termux packages the plan's install rows need: pl_pkgs (every pkg
# row's packages), pl_repo (the packages of repo=1 rows that are not here yet, which add a
# package source; Revision 15) and pl_repo_rows (those rows), pl_tools (the build= tools that
# are missing), pl_names (every install row) and pl_first (the first pkg row). [rows] leaves out
# the packages of those rows and of the rows that require one of them.
plan_pkg_list() {
    pl_pkgs=""
    pl_repo=""
    pl_repo_rows=""
    pl_names=""
    pl_first=""
    pl_ifs="$IFS"
    IFS="$NL"
    for pl_line in $PLAN; do
        IFS="$pl_ifs"
        plan_split "$pl_line"
        [ "$ps_action" = install ] || continue
        pl_names="$pl_names $ps_name"
        [ "$ps_kind" = pkg ] || continue
        [ -n "$pl_first" ] || pl_first="$ps_name"
        pl_n="$ps_name"
        if [ -n "${1:-}" ]; then
            in_list "$1" "$pl_n" && continue
            pb_row "$pl_n"
            pl_skip=0
            for pl_d in $(commas "$prw_deps"); do
                in_list "$1" "$pl_d" && pl_skip=1
            done
            [ "$pl_skip" = 0 ] || continue
        fi
        pl_row=$(row "$pl_n")
        pl_src=$(field "$pl_row" 5)
        pl_pkgs="$pl_pkgs $pl_src"
        [ "$(opt "$(field "$pl_row" 9)" repo)" = 1 ] || continue
        for pl_p in $pl_src; do
            pkg_present "$pl_p" && continue
            pl_repo="$pl_repo $pl_p"
            in_list "$pl_repo_rows" "$pl_n" || pl_repo_rows="$pl_repo_rows $pl_n"
        done
    done
    IFS="$pl_ifs"
    pl_tools=""
    for pl_t in $(build_tools_for "$pl_names" 1); do
        pkg_present "$pl_t" || pl_tools="$pl_tools $pl_t"
    done
}

# plan_packages — the plan's call to the package manager, for every package
# its pkg rows need and every build= tool that is missing. On pacman that is
# one -Sy, so the lists are synced once; on apt an update upgrades with
# --only-upgrade, so build tools there are a second call. A repo=1 package
# that is not here yet (it adds a package source; Revision 15) goes first, in
# a call of its own, and the lists are read again (pkg_refresh) before the
# rest, which may come from that source; when that fails, what needs it is
# left out of the rest. Sets pa_first_pkg (the first pkg row, which the
# calls' --progress steps belong to), pa_pkg_at (how far those steps got),
# pa_pkg_bad (pkg rows whose packages are not all present afterwards) and
# pa_tools_bad (build tools that did not arrive); the tools it added go in
# BUILD_ADDED.
plan_packages() {
    plan_pkg_list
    pa_first_pkg="$pl_first"
    pp_pkgs="$pl_pkgs"
    pp_missing="$pl_tools"
    pp_ifs="$IFS"
    [ -n "$pp_pkgs$pp_missing" ] || return 0

    if [ "$PROGRESS" = 1 ] && [ -n "$pa_first_pkg" ]; then
        CANCEL_ITEM="$pa_first_pkg"
        PROGRESS_AT=0
        progress_stage 10 fetched
    fi
    pp_rc=0
    if [ -n "$pl_repo" ]; then
        say "Installing $(words_list "$pl_repo") first, for the packages that come from it"
        # shellcheck disable=SC2086  # a list of package names, split on purpose
        if ! install_pkg $pl_repo || ! pkg_refresh; then
            pp_rc=1
            plan_pkg_list "$pl_repo_rows"
            pp_pkgs="$pl_pkgs"
        fi
    fi
    [ -n "$(printf '%s' "$pp_pkgs" | tr -d ' ')" ] || pp_pkgs=""
    [ -z "$pp_missing" ] || say "Installing what is needed to build:$pp_missing"
    if [ -n "$pp_pkgs" ]; then
        if [ "$PLAN_VERB" = update ]; then
            say "Updating packages"
        else
            say "Installing packages: $(words_list "$pp_pkgs")"
        fi
    fi
    # shellcheck disable=SC2086  # lists of package names, split on purpose
    if [ -z "$pp_pkgs$pp_missing" ]; then
        :
    elif have pacman; then
        pm_run pacman -Sy --needed --noconfirm $pp_missing $pp_pkgs || pp_rc=1
    elif [ "$PLAN_VERB" = update ] && have apt; then
        [ -z "$pp_pkgs" ] || upgrade_pkg $pp_pkgs || pp_rc=1
        [ -z "$pp_missing" ] || install_pkg $pp_missing || pp_rc=1
    else
        install_pkg $pp_missing $pp_pkgs || pp_rc=1
    fi
    pa_pkg_at="$PROGRESS_AT"
    CANCEL_ITEM=""

    for pp_t in $pp_missing; do
        if [ "$pp_rc" = 0 ] || pkg_present "$pp_t"; then
            BUILD_ADDED="$BUILD_ADDED $pp_t"
        else
            pa_tools_bad="$pa_tools_bad $pp_t"
        fi
    done
    [ -z "$pa_tools_bad" ] || err "could not install what is needed to build:$pa_tools_bad"

    IFS="$NL"
    for pp_line in $PLAN; do
        IFS="$pp_ifs"
        plan_split "$pp_line"
        [ "$ps_action" = install ] || continue
        [ "$ps_kind" = pkg ] || continue
        for pp_p in $(field "$(row "$ps_name")" 5); do
            if ! pkg_present "$pp_p"; then
                pa_pkg_bad="$pa_pkg_bad $ps_name"
                break
            fi
        done
    done
    IFS="$pp_ifs"
}

# plan_weigh — what the plan's Termux packages take, before anything is installed (Revision 15):
# pw_dl and pw_disk in MB, and pw_how, which says where the figures came from. `apt` is what apt
# says this phone still needs for the same packages plan_packages will ask for (0 and 0 when
# they are all here). When apt cannot say (not here, or one of the packages comes from a source
# a repo=1 row adds first, which apt does not read yet) it is `catalog`: the sum of the
# pkg-size= figures of the plan's install rows, a stock Termux's figures, with pw_what naming the
# packages of the first. `none` when there are no packages, or neither knows. With `catalog`
# (a dry run) the package manager is not asked anything and the catalog's figures are used.
plan_weigh() {
    pw_dl=0
    pw_disk=0
    pw_how=none
    pw_what=""
    if [ "${1:-}" != catalog ]; then
        plan_pkg_list
        [ -n "$(printf '%s' "$pl_pkgs$pl_tools" | tr -d ' ')" ] || return 0
    fi
    # shellcheck disable=SC2086  # lists of package names, split on purpose
    if [ "${1:-}" != catalog ] && weigh_apt $pl_tools $pl_pkgs; then
        pw_dl="$wa_dl"
        pw_disk="$wa_disk"
        pw_how=apt
        return 0
    fi
    pw_ifs="$IFS"
    IFS="$NL"
    for pw_line in $PLAN; do
        IFS="$pw_ifs"
        plan_split "$pw_line"
        [ "$ps_action" = install ] || continue
        item_weight "$(field "$(row "$ps_name")" 9)" || continue
        pw_dl=$((pw_dl + iw_dl))
        pw_disk=$((pw_disk + iw_disk))
        [ "$pw_how" = catalog ] || pw_what="$iw_what"
        pw_how=catalog
    done
    IFS="$pw_ifs"
}

# plan_weight_say — says what the plan's Termux packages take when that is more than
# WEIGH_ASK_MB to download or to keep, the way apt itself would before installing. Returns 0
# when it said so, so a caller that does not always ask asks now; 1 when there was nothing to
# say, and then nothing changes. [catalog] passes on to plan_weigh.
plan_weight_say() {
    plan_weigh "${1:-}"
    [ "$pw_how" != none ] || return 1
    heavy "$pw_dl" "$pw_disk" || return 1
    if [ "$pw_how" = apt ]; then
        say "The packages this needs from Termux take $pw_dl MB to download and $pw_disk MB more on disk."
    else
        say "$(weight_sentence "$pw_what" "$pw_dl" "$pw_disk")"
    fi
    return 0
}

# plan_apply — runs PLAN, row by row, in order. Each row ends ok, failed or
# skipped (a row that needs one that failed or was skipped), with a reason
# that the --progress done line carries; the rows around a failure carry on.
# Returns 1 when any row failed or was skipped. Its helpers below share the
# pa_ variables.
plan_apply() {
    pa_rc=0
    pa_bad=""
    pa_first_pkg=""
    pa_pkg_at=0
    pa_pkg_bad=""
    pa_tools_bad=""
    pa_fetch_bad=""
    pa_fetch_at=" "
    journal_open
    # Under --progress the plan goes first: one row line per item, in apply
    # order, so tlstore-ui can draw one bar over the whole job and a line per
    # part. The step and done lines that follow belong to these rows.
    if [ "$PROGRESS" = 1 ]; then
        pa_ifs="$IFS"
        IFS="$NL"
        for pa_line in $PLAN; do
            IFS="$pa_ifs"
            printf 'row\t%s\n' "$pa_line"
        done
        IFS="$pa_ifs"
    fi
    ROWS_OK=0 ROWS_BAD=0 ROWS_SAME=0
    ! styled || STATUS_SCOPE=1
    case "$PLAN_VERB" in
        install|update)
            plan_packages
            plan_fetch
            ;;
    esac
    pa_ifs="$IFS"
    IFS="$NL"
    for pa_line in $PLAN; do
        IFS="$pa_ifs"
        plan_split "$pa_line"
        pa_n="$ps_name"
        pa_action="$ps_action"
        pa_kind="$ps_kind"
        pa_by="$ps_by"
        pa_why="$ps_why"
        LAST_ERR=""
        PROGRESS_NOTE=""
        ROW_NAME="$pa_n"
        pa_outcome=ok
        case "$pa_action" in
            install) plan_apply_install ;;
            skip)
                if [ "$PLAN_VERB" = update ]; then
                    plan_let_go "$pa_n"
                    row_mark same "$pa_n"
                else
                    plan_apply_skip
                fi
                ;;
            unavailable)
                # A bundle's part from another edition, or what needs one:
                # passed by on purpose, which is not a failure.
                case "$pa_why" in
                    needs\ *) pa_said="$pa_n $pa_why" ;;
                    *) pa_said="$pa_n is $pa_why" ;;
                esac
                say "$pa_said"
                row_mark note "$pa_n" "${pa_said#"$pa_n" }"
                [ "$PROGRESS" != 1 ] || progress_done "$pa_n" ok "$pa_said"
                ;;
            remove|forget|absent) plan_apply_remove ;;
            retire) plan_apply_retire ;;
        esac
        journal_done "$pa_n" "$pa_outcome"
    done
    IFS="$pa_ifs"
    ROW_NAME=""
    STATUS_SCOPE=0
    [ "$PA_STAGING" != 1 ] || rm -rf "$STAGE_DIR"
    PA_STAGING=0
    PA_STAGED=""
    drop_build_tools
    rm -f "$JOURNAL"
    case "$PLAN_VERB" in
        update) row_summary updated "already current" ;;
        install) row_summary installed "already installed" ;;
        *) row_summary removed "not installed" ;;
    esac
    return "$pa_rc"
}

# plan_fetch — step 3 of plan_apply: the payload of every binary, archive, file
# and file-once row the plan installs, downloaded and checked into STAGE_DIR before
# any row is applied. One that does not arrive, or does not match its digest,
# fails its row there and then, with the download's own reason, and goes in
# pa_bad so what needs it is skipped; nothing on disk has changed by then. A
# file-once whose file is already there needs nothing (do_file keeps yours), a
# file with nowhere to go is left to do_file to refuse, and a row that will be
# skipped for what it needs is not fetched at all. The npm kinds fetch while
# they apply. Under --progress each row's own step lines run while its download
# does, up to the checksum; pa_fetch_at keeps where each got to, so its apply
# carries on from there.
plan_fetch() {
    pf_doomed="$pa_bad $pa_pkg_bad"
    PA_STAGING=1
    PA_STAGED=""
    rm -rf "$STAGE_DIR"
    pf_ifs="$IFS"
    IFS="$NL"
    for pf_line in $PLAN; do
        IFS="$pf_ifs"
        plan_split "$pf_line"
        [ "$ps_action" = install ] || continue
        pf_n="$ps_name"
        pf_kind="$ps_kind"
        pb_row "$pf_n"
        pf_skip=0
        for pf_d in $(commas "$prw_deps"); do
            if in_list "$pf_doomed" "$pf_d"; then
                pf_skip=1
                break
            fi
        done
        if [ "$pf_skip" = 1 ]; then
            pf_doomed="$pf_doomed $pf_n"
            continue
        fi
        case "$pf_kind" in
            binary|archive|skill|file|file-once) ;;
            *) continue ;;
        esac
        load_item "$pf_n" || continue
        case "$pf_kind" in
            file|file-once)
                pf_dest=$(item_targets "$pf_n" file "$it_target")
                [ -n "$pf_dest" ] || continue
                [ "$pf_kind" = file ] || [ ! -e "$pf_dest" ] || continue
                ;;
        esac
        say "fetching $pf_n"
        LAST_ERR=""
        CANCEL_ITEM="$pf_n"
        ROW_NAME="$pf_n"
        DL_WHAT="$pf_n $it_version"
        PROGRESS_AT=0
        progress_stage 10 fetched
        DL_STAGE=1
        if download "$(source_url "$it_source")" "$STAGE_DIR/$pf_n" "$it_digest"; then
            PA_STAGED="$PA_STAGED $pf_n"
            pa_fetch_at="$pa_fetch_at$pf_n=$PROGRESS_AT "
        else
            pa_bad="$pa_bad $pf_n"
            pa_fetch_bad="$pa_fetch_bad $pf_n"
            pf_doomed="$pf_doomed $pf_n"
            pa_rc=1
            row_mark failed "$pf_n" "${LAST_ERR:-could not download $pf_n}"
            [ "$PROGRESS" != 1 ] || progress_done "$pf_n" failed "${LAST_ERR:-could not download $pf_n}"
        fi
        DL_STAGE=0
        DL_WHAT=""
        ROW_NAME=""
        CANCEL_ITEM=""
    done
    IFS="$pf_ifs"
}

# journal_read — what JOURNAL says: jn_verb, and jn_names, the rows of its plan
# with no done line, in plan order, as a comma list.
journal_read() {
    jn_verb=$(awk -F "$TAB" '$1 == "verb" { print $2; exit }' "$JOURNAL" 2>/dev/null)
    [ -n "$jn_verb" ] || jn_verb=run
    jn_names=$(awk -F "$TAB" '
        $1 == "row" { n[++c] = $2 }
        $1 == "done" { d[$2] = 1 }
        END { for (i = 1; i <= c; i++) if (!(n[i] in d)) s = s " " n[i]; print s }' "$JOURNAL" 2>/dev/null)
    jn_names=$(words_list "$jn_names")
}

# journal_open — step 1 of plan_apply, which only runs once the dry run and the
# question are behind it: says what an earlier run that was cut short did not
# finish, then starts this run's journal.
journal_open() {
    if [ -f "$JOURNAL" ]; then
        journal_read
        if [ -n "$jn_names" ]; then
            say "The last $jn_verb was interrupted; $jn_names did not finish."
        else
            say "The last $jn_verb was interrupted."
        fi
        rm -f "$JOURNAL"
    fi
    mkdir -p "$DATA_DIR" 2>/dev/null || return 0
    {
        printf 'verb\t%s\n' "$PLAN_VERB"
        printf '%s\n' "$PLAN" | awk -v t="$TAB" 'NF { print "row" t $0 }'
    } > "$JOURNAL" 2>/dev/null || rm -f "$JOURNAL"
}

# journal_done <name> <outcome> — a row finished: ok, failed or skipped.
journal_done() {
    [ ! -f "$JOURNAL" ] || printf 'done\t%s\t%s\n' "$1" "$2" >> "$JOURNAL" 2>/dev/null || true
}

# A held item named on update's command line: updating it lets go of the hold.
plan_let_go() {
    is_held "$1" || return 0
    hold_drop "$1"
    say "$1 was held; updating it lets go of the hold"
}

plan_apply_skip() {
    # Named on the command line, something another item pulled in is yours now.
    if [ "$pa_by" = requested ] && [ "$(state_by "$pa_n")" != requested ]; then
        state_set_by "$pa_n" requested
    fi
    say "$pa_n is already installed"
    row_mark same "$pa_n"
    [ "$PROGRESS" = 1 ] || return 0
    CANCEL_ITEM="$pa_n"
    PROGRESS_AT=0
    progress_stage 10 fetched
    progress_stage 60 "signature checked"
    progress_stage 90 "putting files in place"
    progress_stage 100 ready
    progress_done "$pa_n" ok "already installed"
    CANCEL_ITEM=""
}

plan_apply_install() {
    pa_word=installed
    pa_doing=Installing
    pa_fail="could not install $pa_n"
    pa_was=$(installed_version "$pa_n")
    if [ "$PLAN_VERB" = update ] && is_installed "$pa_n"; then
        pa_word=updated
        pa_doing=Updating
        pa_fail="could not update $pa_n"
    fi
    # Its payload did not arrive in the fetch phase, which already failed it
    # and said why.
    if in_list "$pa_fetch_bad" "$pa_n"; then
        pa_outcome=failed
        return 0
    fi
    pb_row "$pa_n"
    pa_reason=""
    for pa_d in $(commas "$prw_deps"); do
        if in_list "$pa_bad" "$pa_d"; then
            pa_reason="needs $pa_d, which did not install"
            break
        fi
    done
    if [ -n "$pa_reason" ]; then
        pa_bad="$pa_bad $pa_n"
        pa_rc=1
        pa_outcome=skipped
        err "skipped $pa_n: $pa_reason"
        row_mark failed "$pa_n" "$pa_reason"
        [ "$PROGRESS" != 1 ] || progress_done "$pa_n" failed "$pa_reason"
        return 0
    fi
    CANCEL_ITEM="$pa_n"
    # The steps its package-manager call or its fetch already reported are not
    # reported again: the bar carries on from there.
    if [ "$pa_n" = "$pa_first_pkg" ]; then
        PROGRESS_AT="$pa_pkg_at"
    elif map_get "$pa_fetch_at" "$pa_n"; then
        PROGRESS_AT="$mg_v"
    else
        PROGRESS_AT=0
    fi
    progress_stage 10 fetched
    [ "$PLAN_VERB" != update ] || plan_let_go "$pa_n"
    pa_ok=1
    pa_short=""
    if [ "$pa_kind" = pkg ] && in_list "$pa_pkg_bad" "$pa_n"; then
        for pa_p in $(field "$(row "$pa_n")" 5); do
            pkg_present "$pa_p" || pa_short="$pa_short $pa_p"
        done
    else
        for pa_t in $(build_tools_for "$pa_n" 1); do
            in_list "$pa_tools_bad" "$pa_t" && pa_short="$pa_short $pa_t"
        done
    fi
    if [ -n "$pa_short" ]; then
        err "the package manager could not install $(words_list "$pa_short")"
        pa_ok=0
    else
        pa_force=0
        [ "$PLAN_VERB" != update ] || pa_force=1
        SR_BY="$pa_by"
        status "$pa_doing $pa_n"
        install_item "$pa_n" "$pa_force" || pa_ok=0
        SR_BY=""
    fi
    if [ "$pa_ok" = 1 ]; then
        progress_stage 60 "signature checked"
        progress_stage 90 "putting files in place"
        progress_stage 100 ready
        plan_mark_ok
        [ "$PROGRESS" != 1 ] || progress_done "$pa_n" ok "${PROGRESS_NOTE:-$pa_word}"
    else
        pa_bad="$pa_bad $pa_n"
        pa_rc=1
        pa_outcome=failed
        row_mark failed "$pa_n" "${LAST_ERR:-$pa_fail}"
        [ "$PROGRESS" != 1 ] || progress_done "$pa_n" failed "${LAST_ERR:-$pa_fail}"
    fi
    CANCEL_ITEM=""
}

# plan_mark_ok — an installed row's closing line on a styled terminal: its new
# version (or what happened, for a kind without one) and any note. An update
# that left the version where it was (a package, an npm item already at its
# latest) is counted as current instead.
plan_mark_ok() {
    styled || return 0
    pa_now=$(installed_version "$pa_n")
    if [ "$pa_word" = updated ] && [ "$pa_now" = "$pa_was" ] && [ -z "$PROGRESS_NOTE$LAST_ERR" ]; then
        row_mark same "$pa_n"
        return 0
    fi
    case "$pa_now" in
        ''|-|latest) pa_said="$pa_word" ;;
        *) pa_said="$C_ACC$pa_now$C_OFF" ;;
    esac
    if [ -n "$PROGRESS_NOTE" ]; then
        pa_said="$pa_said $C_DIM· $PROGRESS_NOTE$C_OFF"
    elif [ -n "$LAST_ERR" ]; then
        # An err from a row that still succeeded (err only records it here).
        pa_said="$pa_said $C_DIM·$C_OFF $C_ASK$LAST_ERR$C_OFF"
    fi
    row_mark ok "$pa_n" "$pa_said"
}

plan_apply_remove() {
    pa_word=removed
    [ "$pa_action" != absent ] || pa_word="not installed"
    if [ "$PROGRESS" = 1 ]; then
        CANCEL_ITEM="$pa_n"
        progress_line step "$pa_n" 30 fetched
    fi
    if remove_item "$pa_n"; then
        if [ "$pa_action" = absent ]; then
            row_mark same "$pa_n"
        else
            row_mark ok "$pa_n" "$pa_word"
        fi
        if [ "$PROGRESS" = 1 ]; then
            progress_line step "$pa_n" 75 "putting files in place"
            progress_line step "$pa_n" 100 ready
            progress_done "$pa_n" ok "$pa_word"
        fi
    else
        pa_bad="$pa_bad $pa_n"
        pa_rc=1
        pa_outcome=failed
        row_mark failed "$pa_n" "${LAST_ERR:-could not remove $pa_n}"
        [ "$PROGRESS" != 1 ] || progress_done "$pa_n" failed "${LAST_ERR:-could not remove $pa_n}"
    fi
    CANCEL_ITEM=""
}

plan_apply_retire() {
    if [ "$PROGRESS" = 1 ]; then
        CANCEL_ITEM="$pa_n"
        progress_line step "$pa_n" 30 fetched
    fi
    if retire_item "$pa_n"; then
        row_mark ok "$pa_n" retired
        if [ "$PROGRESS" = 1 ]; then
            progress_line step "$pa_n" 75 "putting files in place"
            progress_line step "$pa_n" 100 ready
            progress_done "$pa_n" ok retired
        fi
    else
        pa_bad="$pa_bad $pa_n"
        pa_rc=1
        pa_outcome=failed
        row_mark failed "$pa_n" "${LAST_ERR:-could not retire $pa_n}"
        [ "$PROGRESS" != 1 ] || progress_done "$pa_n" failed "${LAST_ERR:-could not retire $pa_n}"
    fi
    CANCEL_ITEM=""
}

cmd_install() {
    ci_names=""
    for ci_a in "$@"; do
        case "$ci_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            -*) bad_opt install "$ci_a"; return 2 ;;
            *) ci_names="$ci_names $ci_a" ;;
        esac
    done
    need_catalog

    if [ -z "$ci_names" ] && [ "$DRY_RUN" = 1 ]; then
        err "install --dry-run needs a name; there is nothing to pick from without asking"
        return 2
    fi
    if [ -z "$ci_names" ]; then
        mkdir -p "$CACHE_DIR"
        ci_cand="$CACHE_DIR/choices"
        ci_chosen="$CACHE_DIR/chosen"
        # Only what is not installed yet: the picker is for adding.
        : > "$ci_cand"
        visible_rows | awk -F "$TAB" '{ printf "%s\t%s\n", $1, $10 }' |
        while IFS="$TAB" read -r ci_pn ci_ps; do
            is_installed "$ci_pn" || printf '%s\t%s\n' "$ci_pn" "$ci_ps" >> "$ci_cand"
        done
        if [ ! -s "$ci_cand" ]; then
            rm -f "$ci_cand"
            say "You already have everything in the list."
            return 0
        fi
        say "Pick what you want."
        pick_items "$ci_cand" "$ci_chosen"
        ci_names=$(tr '\n' ' ' < "$ci_chosen")
        rm -f "$ci_cand" "$ci_chosen"
        if [ -z "$(printf '%s' "$ci_names" | tr -d ' ')" ]; then
            say "Nothing to install."
            return 0
        fi
    fi

    # shellcheck disable=SC2086  # a list of names, split on purpose
    plan_build install $ci_names || return 1
    if [ "$DRY_RUN" = 1 ]; then
        plan_show
        return 0
    fi
    say "Installing: $(words_list "$(plan_names)")"
    # Large Termux packages are named, with what they take, before the usual question.
    plan_weight_say || :
    ask_yn "Go ahead?" || { say "Nothing was installed."; return 0; }
    plan_apply
}

cmd_remove() {
    cr_names=""
    for cr_a in "$@"; do
        case "$cr_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            -*) bad_opt remove "$cr_a"; return 2 ;;
            *) cr_names="$cr_names $cr_a" ;;
        esac
    done
    [ -n "$cr_names" ] || { err "remove needs a name"; return 2; }
    pick_catalog || true

    # shellcheck disable=SC2086  # a list of names, split on purpose
    plan_build remove $cr_names || return 1
    if [ "$DRY_RUN" = 1 ]; then
        plan_show
        return 0
    fi
    say "Removing: $(words_list "$(plan_names)")"
    ask_yn "Go ahead?" || { say "Nothing was removed."; return 0; }
    plan_apply
}

# The item half of update; cmd_update adds the self-update on top of it.
update_items() {
    cu_check=0
    cu_offline=0
    cu_tsv=0
    cu_names=""
    for cu_a in "$@"; do
        case "$cu_a" in
            --check) cu_check=1 ;;
            --offline) cu_offline=1 ;;
            --tsv) cu_tsv=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -y|--yes) ASSUME_YES=1 ;;
            -n|--dry-run) cu_check=1; DRY_RUN=1 ;;
            -*) bad_opt update "$cu_a"; return 2 ;;
            *) cu_names="$cu_names $cu_a" ;;
        esac
    done
    need_catalog
    if [ "$cu_offline" = 0 ]; then
        [ "$cu_tsv" = 1 ] || status "Checking the item list"
        update_refresh
    fi
    need_catalog

    if [ -z "$cu_names" ] && [ -z "$(installed_names)" ]; then
        [ "$cu_tsv" = 1 ] || say "Nothing is installed yet."
        return 0
    fi
    PLAN_CHECK="$cu_check"
    PLAN_OFFLINE="$cu_offline"
    PLAN_TSV="$cu_tsv"
    # shellcheck disable=SC2086  # a list of names, split on purpose
    plan_build update $cu_names || return 1
    if [ "$cu_check" = 1 ]; then
        if [ "$cu_tsv" = 1 ]; then
            plan_tsv
        else
            plan_show
        fi
        return 0
    fi
    if [ -z "$(plan_names install)$(plan_names retire)" ]; then
        say "Everything is up to date."
        return 0
    fi
    # An update asks nothing, unless the Termux packages it needs are large (Revision 15).
    if plan_weight_say; then
        ask_yn "Go ahead?" || { say "Nothing was updated."; return 0; }
    fi
    plan_apply
}

# An update offers the newer tlstore, and the store program that pairs with
# it, when there is one — never offline, never on `--check` (the refresh
# tlstore-ui runs in the background; swapping the files under a running UI is
# what `self-update --progress` exists to do in plain view), and not inside a
# --progress stream, which carries the item lines alone. A plain update
# (Revision 16) asks first, before any item is planned: taken, the newer
# tlstore is run in this one's place with the same arguments, so the newer
# engine plans the items, and TLSTORE_UPDATED_FROM keeps it from offering or
# restarting again. Declined, never, offline or nothing newer, this one carries
# on. `update --tsv` without --check still asks at the end, as it always has.
cmd_update() {
    cu_plain=1
    cu_su=0
    su_moved=0
    for cu_a in "$@"; do
        case "$cu_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --configs) ;;
            -*) cu_plain=0 ;;
        esac
    done
    if [ "$cu_plain" = 1 ] && [ -z "$SU_FROM" ]; then
        status "Checking for a newer tlstore"
        self_update_offer || cu_su=1
        if [ "$su_moved" = 1 ]; then
            status_clear
            export TLSTORE_UPDATED_FROM="$TLSTORE_VERSION"
            export TLSTORE_ASSUME_YES="$ASSUME_YES"
            exec "$su_target" update "$@"
        fi
    fi
    update_items "$@"
    cu_status=$?
    if [ "$cu_plain" = 0 ] && [ -z "$SU_FROM" ] && [ "$cu_status" != 2 ] && [ "${cu_offline:-0}" = 0 ] &&
        [ "${cu_check:-0}" = 0 ] && [ "$PROGRESS" != 1 ]; then
        self_update_offer || cu_su=1
    fi
    # A refused or failed self-update fails the command, as a failed item does.
    [ "$cu_su" = 0 ] || [ "$cu_status" != 0 ] || cu_status=1
    status_clear
    return "$cu_status"
}

# tlstore rollback <name> — one step back to the version recorded before the
# current one, then hold the item there so the next update does not undo it.
cmd_rollback() {
    rb_name=""
    for rb_a in "$@"; do
        case "$rb_a" in
            -y|--yes) ASSUME_YES=1 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            -*) bad_opt rollback "$rb_a"; return 2 ;;
            *)
                if [ -n "$rb_name" ]; then
                    err "rollback takes one name"
                    return 2
                fi
                rb_name="$rb_a"
                ;;
        esac
    done
    [ -n "$rb_name" ] || { err "rollback needs a name"; return 2; }
    need_catalog
    rb_row=$(state_row "$rb_name" 2>/dev/null || true)
    if [ -z "$rb_row" ]; then
        err "$rb_name is not installed"
        return 1
    fi
    rb_kind=$(field "$rb_row" 2)
    rb_have=$(field "$rb_row" 3)
    case "$rb_kind" in
        pkg)
            err "$rb_name is a package: Termux's repositories keep only the newest, so there is nothing to go back to"
            return 1
            ;;
        bundle)
            err "$rb_name is a bundle and has no version of its own; roll back the items in it"
            return 1
            ;;
        fisher)
            err "$rb_name is a fish plugin: fisher keeps it current, so tlstore cannot go back a version"
            return 1
            ;;
    esac
    rb_ver=$(field "$rb_row" 8)
    rb_src=$(field "$rb_row" 9)
    rb_dig=$(field "$rb_row" 10)
    case "$rb_kind" in
        binary|archive|skill|file|file-once)
            # Without the old file's address and digest there is nothing to fetch.
            if [ -z "$rb_src" ] || [ -z "$rb_dig" ]; then rb_ver=""; fi
            ;;
    esac
    if [ -z "$rb_ver" ]; then
        err "no earlier version of $rb_name is recorded"
        return 1
    fi
    if ! load_item "$rb_name"; then
        err "$rb_name is not available on this device"
        return 1
    fi
    if [ "$DRY_RUN" = 1 ]; then
        say "Would put $rb_name back from $rb_have to $rb_ver, and hold it there."
        case "$rb_kind" in
            binary|archive|skill|file|file-once) say "  from $rb_src" ;;
        esac
        say "Nothing was changed."
        return 0
    fi
    say "Putting $rb_name back from $rb_have to $rb_ver."
    ask_yn "Go ahead?" || { say "Nothing was changed."; return 0; }
    RB_VERSION="$rb_ver"
    case "$rb_kind" in
        binary|archive|skill|file|file-once) RB_SOURCE="$rb_src"; RB_DIGEST="$rb_dig" ;;
        *) RB_SOURCE=""; RB_DIGEST="" ;;
    esac
    SR_CLEAR_PREV=1
    rb_rc=0
    install_item "$rb_name" 1 || rb_rc=1
    RB_VERSION=""
    RB_SOURCE=""
    RB_DIGEST=""
    SR_CLEAR_PREV=0
    if [ "$rb_rc" != 0 ]; then
        err "could not put $rb_name back"
        return 1
    fi
    hold_add "$rb_name"
    say "$rb_name is back at $rb_ver and held; 'tlstore unhold $rb_name' lets it update again"
    return 0
}

cmd_hold() {
    ch_names=""
    for ch_a in "$@"; do
        case "$ch_a" in
            -*) bad_opt hold "$ch_a"; return 2 ;;
            *) ch_names="$ch_names $ch_a" ;;
        esac
    done
    [ -n "$ch_names" ] || { err "hold needs a name"; return 2; }
    ch_rc=0
    for ch_n in $ch_names; do
        if ! is_installed "$ch_n"; then
            err "$ch_n is not installed, so there is nothing to hold"
            ch_rc=1
            continue
        fi
        hold_add "$ch_n"
        say "$ch_n is held at $(installed_version "$ch_n"); 'tlstore unhold $ch_n' lets it update"
    done
    return "$ch_rc"
}

cmd_unhold() {
    cx_names=""
    for cx_a in "$@"; do
        case "$cx_a" in
            -*) bad_opt unhold "$cx_a"; return 2 ;;
            *) cx_names="$cx_names $cx_a" ;;
        esac
    done
    [ -n "$cx_names" ] || { err "unhold needs a name"; return 2; }
    for cx_n in $cx_names; do
        if is_held "$cx_n"; then
            hold_drop "$cx_n"
            say "$cx_n can update again"
        else
            say "$cx_n was not held"
        fi
    done
    return 0
}

cmd_refresh() {
    for cf_a in "$@"; do
        case "$cf_a" in
            -y|--yes) ASSUME_YES=1 ;;
            -*) bad_opt refresh "$cf_a"; return 2 ;;
            *) bad_arg refresh "$cf_a"; return 2 ;;
        esac
    done
    pick_catalog || true
    refresh_catalog 0
    cf_status=$?
    [ "$cf_status" = 2 ] && return 1
    return 0
}

# ---------------------------------------------------------------------------
# Keeping tlstore itself current
# ---------------------------------------------------------------------------

# version_newer <a> <b> — true when a is ahead of b.
version_newer() {
    awk -v a="$1" -v b="$2" '
        function vercmp(x, y,   nx, ny, px, py, i, n, p, q) {
            nx = split(x, px, /[._-]/)
            ny = split(y, py, /[._-]/)
            n = (nx > ny) ? nx : ny
            for (i = 1; i <= n; i++) {
                p = (i <= nx) ? px[i] + 0 : 0
                q = (i <= ny) ? py[i] + 0 : 0
                if (p > q) return 1
                if (p < q) return -1
            }
            return 0
        }
        BEGIN { exit (vercmp(a, b) > 0) ? 0 : 1 }'
}

# The name the launcher's build gives the store program for this processor:
# uname -m says aarch64 or x86_64, the APK's assets say arm64-v8a or x86_64.
ui_abi() {
    case "$ARCH" in
        aarch64|arm64) printf 'arm64-v8a' ;;
        x86_64) printf 'x86_64' ;;
        *) printf '' ;;
    esac
}

# What self_update has to say. Its lines are narration, never part of the
# machine output `update --check --tsv` prints for tlstore-ui, so in that
# mode they go to stderr the way --progress narration does.
su_say() {
    if [ "${cu_tsv:-0}" = 1 ]; then
        printf '%s\n' "$*" >&2
    else
        say "$*"
    fi
}

# tlstore keeps itself current from the newest store release, whoever put it
# here — the launcher app or the standalone installer. The release's script
# is fetched with its signature and taken only when it checks out against the
# trusted key and its TLSTORE_VERSION is ahead of this one's. The store
# program moves with it: the script names the digest of the tlstore-ui built
# beside it (TLSTORE_UI_SHA256_<abi>, filled in before signing), and where a
# tlstore-ui is in place the matching one is downloaded, checked against that
# signed digest and put down together with the script. An engine and a UI
# from different releases is what breaks the store, so if the UI cannot be
# had, the old script stays too. Both land by a rename beside their target,
# the script first (an older UI reads a newer script's output — new columns
# only ever land at the end — the other way round does not hold), and the
# launcher's own record of the UI (.tlstore-ui-sha256) is updated so the app
# still counts the file as its own. Nothing is re-executed here: the copy
# that is running finishes its work on the old inode (tlstore-ui re-executes
# itself after `self-update --progress`, see cmd_self_update).
#
# The work is split so three callers share it: `update` (self_update: quiet,
# one line when something moved), `self-update --check --tsv` (the script
# alone, left verified in the cache) and `self-update --progress` (the whole
# thing as a --progress stream for tlstore-ui, which takes the cached script
# rather than fetching it twice). Each step returns 0 done, 1 nothing to do
# (offline, nothing newer), 2 refused — with the reason in SU_NOTE.
SU_NOTE=""

su_paths() {
    su_target="$PREFIX/bin/tlstore"
    su_new="$CACHE_DIR/tlstore.new"
    su_sig="$CACHE_DIR/tlstore.new.minisig"
    su_ui_new="$CACHE_DIR/tlstore-ui.new"
}

# su_ready — something here to replace. The tools that check what is offered
# are channel_fetch's to look for, so it can say which one is missing.
su_ready() {
    su_paths
    [ -f "$su_target" ] || return 1
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
    return 0
}

# su_verified — the script `self-update --check` left in the cache still
# checks out against the trusted key and is ahead of this one: 0 yes, 2
# refused (channel_check says why), 1 anything else. su_version is its
# version (set whenever one could be read, so a caller can name it).
su_verified() {
    su_version=""
    [ -f "$su_new" ] && [ -f "$su_sig" ] || return 1
    have minisign && [ -f "$PUBKEY" ] || return 1
    channel_check self
    su_version=$CH_VERSION
    case "$CH_OUTCOME" in
        newer) return 0 ;;
        refused) return 2 ;;
    esac
    return 1
}

# su_fetch_script <use cache 0|1> — the newest release's script and its
# signature into the cache, verified (channel_fetch self). With 1, a copy
# `self-update --check` left there is taken as it is when it still verifies
# and is still newer. 0 newer; 1 nothing to take (current, offline, cannot
# verify: CH_OUTCOME says which, SU_NOTE why); 2 refused (SU_NOTE says why).
# The cache is emptied whenever this returns 1 or 2.
su_fetch_script() {
    SU_NOTE=""
    if [ "$1" = 1 ] && su_verified; then
        return 0
    fi
    # Inside a --progress stream the script's own download is the first,
    # small share of the bar; it may well jump straight to the end of it.
    PROGRESS_FETCH_END=8
    channel_fetch self
    su_version=$CH_VERSION
    case "$CH_OUTCOME" in
        newer) return 0 ;;
        refused)
            SU_NOTE="$CH_REASON — ignoring it"
            return 2
            ;;
    esac
    SU_NOTE="$CH_REASON"
    return 1
}

# su_ui_digest_named — where a store program is in place, the digest the
# new script names for this processor (su_ui_digest; empty with no UI to
# pair). 2 when a UI is here and the script names none for it.
su_ui_digest_named() {
    su_ui_digest=""
    [ -f "$TLSTORE_UI_BIN" ] || return 0
    su_abi=$(ui_abi)
    su_key=$(printf '%s' "$su_abi" | tr '-' '_')
    [ -z "$su_abi" ] || su_ui_digest=$(sed -n "s/^TLSTORE_UI_SHA256_$su_key=\([0-9a-f]\{64\}\)\$/\1/p" "$su_new" | head -1)
    if [ -z "$su_ui_digest" ]; then
        SU_NOTE="tlstore $su_version names no store program for this processor — keeping what you have"
        return 2
    fi
    return 0
}

# su_fetch_ui — the store program the new script names, checked against the
# signed digest. Inside a --progress stream its download is most of the bar
# (8 to 80), and "signature checked" is the moment the digest matches: the
# script's own signature was checked before this download began, and a
# refused script ends the job there.
su_fetch_ui() {
    su_ui_digest_named || return 2
    [ -n "$su_ui_digest" ] || return 0
    progress_stage 8 fetched
    PROGRESS_FETCH_END=80
    CANCEL_TMP="$su_ui_new"
    if ! curl_to "$RELEASE_BASE/tlstore-ui-$su_abi" "$su_ui_new" 2>/dev/null; then
        rm -f "$su_ui_new"
        CANCEL_TMP=""
        SU_NOTE="could not download the store program that goes with tlstore $su_version — keeping what you have"
        return 2
    fi
    CANCEL_TMP=""
    progress_stage 85 "signature checked"
    if [ "$(file_digest "$su_ui_new")" != "$su_ui_digest" ]; then
        rm -f "$su_ui_new"
        SU_NOTE="the store program that was offered does not match what tlstore $su_version expects — keeping what you have"
        return 2
    fi
    return 0
}

# su_place — stage both beside their targets, then rename, the script first:
# a copy that fails leaves everything as it was.
su_place() {
    progress_stage 92 "putting files in place"
    su_stage="$su_target.new"
    su_ui_stage="$TLSTORE_UI_BIN.new"
    CANCEL_EXTRA="$CANCEL_EXTRA $su_stage $su_ui_stage"
    if ! cp "$su_new" "$su_stage" || ! chmod 755 "$su_stage"; then
        rm -f "$su_stage"
        SU_NOTE="could not put the newer tlstore in place"
        return 2
    fi
    if [ -n "$su_ui_digest" ]; then
        if ! cp "$su_ui_new" "$su_ui_stage" || ! chmod 755 "$su_ui_stage"; then
            rm -f "$su_stage" "$su_ui_stage"
            SU_NOTE="could not put the newer store program in place — keeping what you have"
            return 2
        fi
    fi
    if ! mv "$su_stage" "$su_target"; then
        rm -f "$su_stage" "$su_ui_stage"
        SU_NOTE="could not put the newer tlstore in place"
        return 2
    fi
    if [ -n "$su_ui_digest" ]; then
        if mv "$su_ui_stage" "$TLSTORE_UI_BIN"; then
            printf '%s\n' "$su_ui_digest" > "$(dirname "$TLSTORE_UI_BIN")/.tlstore-ui-sha256" 2>/dev/null || true
        else
            rm -f "$su_ui_stage"
            err "could not put the newer store program in place"
        fi
    fi
    return 0
}

# self_update_try <use cache 0|1> — the whole thing, quietly. 0 updated
# (su_version says to what), 1 nothing to do (CH_OUTCOME current, or SU_NOTE
# says why it could not check), 2 refused (SU_NOTE says why); after 1 or 2
# both old files are where they were.
self_update_try() {
    SU_NOTE=""
    CH_OUTCOME=""
    CH_REASON=""
    if ! su_ready; then
        SU_NOTE="there is no tlstore at $su_target to replace"
        return 1
    fi
    # What a cancel has to drop, beyond the download in flight: the cached
    # script pair, the program, and (from su_place on) the staged copies.
    CANCEL_EXTRA="$su_new $su_sig $su_ui_new"
    su_fetch_script "$1"
    su_rc=$?
    if [ "$su_rc" = 0 ]; then
        if su_fetch_ui && su_place; then
            su_rc=0
        else
            su_rc=2
        fi
    fi
    rm -f "$su_new" "$su_sig" "$su_ui_new"
    CANCEL_EXTRA=""
    PROGRESS_FETCH_END=55
    return "$su_rc"
}

# The self-update `self-update` runs: one line when something moved, the
# reason when something was refused, nothing otherwise (cmd_self_update says
# the rest). su_moved says it did. With 1 a script the offer already fetched
# and verified is taken from the cache.
self_update() {
    su_moved=0
    self_update_try "${1:-0}"
    case $? in
        0) su_moved=1; su_say "tlstore is now version $su_version." ;;
        2) err "$SU_NOTE"; return 1 ;;
    esac
    return 0
}

# su_reply — the answer to the offer, read from stdin like ask_yn: y (also
# empty), n, or never; anything else counts as n. Sets su_answer.
su_reply() {
    read -r su_answer || su_answer=""
    case "$su_answer" in
        ''|y|Y|yes|YES|Yes) su_answer=y ;;
        never|NEVER|Never) su_answer=never ;;
        *) su_answer=n ;;
    esac
}

# The self-update `update` runs: ask before taking a newer tlstore. Nothing
# newer, offline, cannot verify (the item list's own line, just before, has
# already said why: both channels need the same minisign and key), or the
# user said never: silence. -y takes it unasked; with
# nobody to ask it says so on one line and leaves it. The script is fetched
# and verified first, so a bad signature is refused the same way as ever.
self_update_offer() {
    SU_NOTE=""
    su_ready || return 0
    CANCEL_EXTRA="$su_new $su_sig $su_ui_new"
    su_fetch_script 0
    su_rc=$?
    CANCEL_EXTRA=""
    case "$su_rc" in
        0) ;;
        2) err "$SU_NOTE"; return 1 ;;
        *) return 0 ;;
    esac
    if [ -f "$SU_QUIET" ]; then
        rm -f "$su_new" "$su_sig"
        return 0
    fi
    if [ "$ASSUME_YES" = 1 ]; then
        self_update 1
        return $?
    fi
    if ! interactive; then
        rm -f "$su_new" "$su_sig"
        su_say "tlstore $su_version is available. Run tlstore self-update to get it."
        return 0
    fi
    status_clear
    if [ "${cu_tsv:-0}" = 1 ]; then
        printf 'tlstore %s is available; you have %s. Update now? [Y/n/never] ' "$su_version" "$TLSTORE_VERSION" >&2
    else
        printf 'tlstore %s is available; you have %s. Update now? [Y/n/never] ' "$su_version" "$TLSTORE_VERSION"
    fi
    su_reply
    case "$su_answer" in
        y)
            self_update 1
            return $?
            ;;
        never)
            su_quiet_on
            su_say "Okay. tlstore self-update still gets it whenever you want."
            ;;
    esac
    rm -f "$su_new" "$su_sig"
    return 0
}

# tlstore self-update --check --tsv — for tlstore-ui, when it starts: one
# line, `self <installed> <latest> <available 0|1> <outcome> <reason>` (an
# older UI reads the first four; the reason is `-` when there is none). Only
# the signed script is fetched and verified; when it is newer (and, where a
# store program is in place, names one for this processor) it stays in the
# cache for the --progress run that follows, so it is not fetched twice.
# Offline, refused or nothing newer: available 0, latest `-` when no version
# could be read, and nothing is left behind. Without --tsv it says the same
# to a person, and never "up to date" unless the release said so.
self_update_check() {
    su_avail=0
    su_latest="-"
    su_paths
    su_fetch_script 0
    su_rc=$?
    [ -z "${su_version:-}" ] || su_latest=$su_version
    su_outcome=$CH_OUTCOME
    su_why=$CH_REASON
    case "$su_rc" in
        0)
            if [ ! -f "$su_target" ]; then
                rm -f "$su_new" "$su_sig"
                su_why="there is no tlstore at $su_target to replace"
            elif su_ui_digest_named; then
                su_avail=1
            else
                rm -f "$su_new" "$su_sig"
                su_why=$SU_NOTE
            fi
            ;;
    esac
    if [ "${cs_tsv:-0}" = 1 ]; then
        # The reasons are for a person; tlstore-ui reads them from the
        # line, and stderr still carries a refusal as it always has.
        [ "$su_rc" = 0 ] || [ "$su_outcome" != refused ] || err "$SU_NOTE"
        [ "$su_rc" != 0 ] || [ "$su_avail" = 1 ] || err "$su_why"
        printf 'self\t%s\t%s\t%s\t%s\t%s\n' "$TLSTORE_VERSION" "$su_latest" "$su_avail" \
            "$su_outcome" "${su_why:--}"
    elif [ "$su_avail" = 1 ]; then
        say "tlstore $su_latest is available; you have $TLSTORE_VERSION."
    elif [ "$su_outcome" = newer ]; then
        say "tlstore $su_latest cannot be taken here: $su_why."
    elif [ "$su_outcome" = current ]; then
        say "tlstore is up to date."
    else
        say "Could not check for a newer tlstore: $su_why."
    fi
    return 0
}

# tlstore self-update --progress — the same as `update`'s self-update, as a
# --progress stream for the one item `tlstore`: fetched (the script to 8,
# then the store program to 80, as curl reports it), signature checked (85),
# putting files in place (92), ready (100), then `done tlstore ok updated to
# <v>`, or `done tlstore failed <reason>` with both old files untouched. A
# cancel (SIGTERM to the process group) drops the part file, the staged
# copies and the cached script, and closes the stream the usual way.
self_update_progress() {
    PROGRESS=1
    ASSUME_YES=1
    CANCEL_ITEM=tlstore
    PROGRESS_AT=0
    progress_stage 2 fetched
    self_update_try 1
    su_rc=$?
    case "$su_rc" in
        0)
            progress_stage 100 ready
            progress_done tlstore ok "updated to $su_version"
            ;;
        *)
            # The real reason: refused, offline, cannot verify; only a
            # release that is simply not ahead has none of its own.
            if [ "$su_rc" = 1 ] && [ "$CH_OUTCOME" = current ]; then
                SU_NOTE="no newer tlstore was offered"
            fi
            progress_done tlstore failed "${SU_NOTE:-no newer tlstore was offered}"
            ;;
    esac
    CANCEL_ITEM=""
    [ "$su_rc" = 0 ] || return 1
    return 0
}

cmd_self_update() {
    cs_check=0
    cs_tsv=0
    cs_progress=0
    for cs_a in "$@"; do
        case "$cs_a" in
            --check) cs_check=1 ;;
            --tsv) cs_tsv=1 ;;
            --progress) cs_progress=1 ;;
            -*) bad_opt self-update "$cs_a"; return 2 ;;
            *) bad_arg self-update "$cs_a"; return 2 ;;
        esac
    done
    if [ "$cs_check" = 1 ]; then
        self_update_check
    elif [ "$cs_progress" = 1 ]; then
        self_update_progress
    else
        self_update || return 1
        if [ "$su_moved" = 1 ]; then
            # Asking for it by hand is the way back from "never".
            su_quiet_off
            return 0
        fi
        if [ "$CH_OUTCOME" = current ]; then
            say "tlstore is up to date."
            return 0
        fi
        say "Could not check for a newer tlstore: $SU_NOTE."
        return 1
    fi
}

cd_line() { printf '%-13s %s\n' "$1" "$2"; }

# doctor_channel catalog|self <what> — a Channel line: what the last check of
# that channel found, when, and why when it found nothing it could take.
doctor_channel() {
    dc_row=""
    [ ! -f "$CHANNEL_FILE" ] || dc_row=$(awk -F "$TAB" -v c="$1" '$1 == c { r = $0 } END { print r }' "$CHANNEL_FILE")
    if [ -z "$dc_row" ]; then
        cd_line Channel "$2: not checked yet"
        return 0
    fi
    dc_out=$(field "$dc_row" 2)
    dc_when=$(field "$dc_row" 3)
    dc_why=$(field "$dc_row" 4)
    case "$dc_out" in
        newer) dc_said="a newer one was found" ;;
        current) dc_said="up to date" ;;
        offline) dc_said="could not check" ;;
        cannot-verify) dc_said="could not check" ;;
        refused) dc_said="refused what was offered" ;;
        *) dc_said="$dc_out" ;;
    esac
    if [ -n "$dc_why" ] && [ "$dc_why" != - ]; then
        dc_said="$dc_said: $dc_why"
    fi
    cd_line Channel "$2 $dc_said ($dc_out, $dc_when)"
}

cmd_doctor() {
    [ $# -eq 0 ] || { bad_arg doctor "$1"; return 2; }
    pick_catalog || true
    cd_bad=0
    cd_line Prefix "$PREFIX"
    if [ -n "$APP_PACKAGE" ]; then
        cd_line Edition "$APP_PACKAGE"
    else
        cd_line Edition "unknown"
    fi
    cd_pkg="${APP_PACKAGE:-unknown}"
    if [ "$HOST" = launcher ]; then
        if [ -n "$LAUNCHER_VERSION" ]; then
            cd_line App "Termux Launcher $LAUNCHER_VERSION ($cd_pkg)"
        else
            cd_line App "Termux Launcher ($cd_pkg)"
        fi
    else
        cd_line App "Termux ($cd_pkg)"
    fi
    case ":$PATH:" in
        *":$BIN_DIR:"*)
            cd_first=$(printf '%s' "$PATH" | tr ':' '\n' | grep -n -x -e "$BIN_DIR" -e "$PREFIX/bin" | head -1)
            case "$cd_first" in
                *"$BIN_DIR") cd_line PATH "$BIN_DIR comes first" ;;
                *) cd_line PATH "put $BIN_DIR before $PREFIX/bin so the tools here win" ;;
            esac
            ;;
        *) cd_line PATH "add $BIN_DIR to it, or the tools here will not run" ;;
    esac

    for cd_t in curl tar sha256sum; do
        if have "$cd_t"; then
            cd_line "$cd_t" ready
        else
            cd_line "$cd_t" missing
            cd_bad=1
        fi
    done
    # Nothing can be updated without minisign: neither the item list nor
    # tlstore itself is taken unchecked.
    if have minisign; then
        cd_line minisign ready
    else
        cd_line minisign "not installed — nothing can be updated without it (pkg install minisign)"
        cd_bad=1
    fi
    doctor_channel catalog "item list"
    doctor_channel self tlstore

    if [ -n "$CATALOG" ]; then
        cd_line "Item list" "$CATALOG_SERIAL, $CATALOG_FROM"
    else
        cd_line "Item list" "missing — reopen the app to put it back"
        cd_bad=1
    fi

    cd_missing=""
    for cd_n in $(installed_names); do
        cd_row=$(state_row "$cd_n")
        for cd_f in $(field "$cd_row" 5); do
            [ -e "$cd_f" ] || in_list "$cd_missing" "$cd_n" || cd_missing="$cd_missing $cd_n"
        done
    done
    if [ -n "$(printf '%s' "$cd_missing" | tr -d ' ')" ]; then
        cd_line "Missing" "$(printf '%s' "$cd_missing" | sed 's/^ *//') — install them again"
        cd_bad=1
    fi

    # An install, update or remove that was cut short (a killed process, a
    # phone that died) left its journal behind.
    if [ -f "$JOURNAL" ]; then
        journal_read
        if [ -n "$jn_names" ]; then
            cd_line Interrupted "$jn_verb: $jn_names did not finish"
        else
            cd_line Interrupted "$jn_verb"
        fi
        cd_bad=1
    fi

    if [ "$ARCH_OK" = 1 ] && [ -n "$CATALOG" ]; then
        cd_row=$(row musl-loader)
        if [ -n "$cd_row" ]; then
            cd_loader=$(item_targets musl-loader binary "$(field "$cd_row" 7)")
            if [ -f "$cd_loader" ]; then
                cd_line Loader ready
            else
                cd_line Loader "not installed (Claude Code needs it)"
            fi
        fi
    fi

    [ "$cd_bad" = 0 ] || return 1
    return 0
}

cmd_display() {
    cy_setup="$PREFIX/bin/termux-x11-gpu-setup"
    if [ ! -x "$cy_setup" ]; then
        err "graphics setup is not here yet — update the app and try again"
        return 1
    fi
    "$cy_setup" "$@"
}

cmd_version() {
    [ $# -eq 0 ] || { bad_arg version "$1"; return 2; }
    pick_catalog || true
    say "tlstore $TLSTORE_VERSION"
    [ -z "$CATALOG_SERIAL" ] || say "Item list $CATALOG_SERIAL"
    return 0
}

# ---------------------------------------------------------------------------

main() {
    if [ $# -eq 0 ]; then
        # Inside the launcher, with a real terminal at both ends and the store
        # program in place, hand the screen to it; it calls back into this
        # script for every install, update and remove. Everywhere else — plain
        # Termux, ssh, tmux, or before the app has put tlstore-ui down — there
        # is nothing to draw with, so this just prints the list.
        if [ "$HOST" = launcher ] && on_terminal && [ -x "$TLSTORE_UI_BIN" ]; then
            exec "$TLSTORE_UI_BIN"
        fi
        cmd_list
        say ""
        say "Run 'tlstore install' to add what you want."
        return 0
    fi
    # Options that come before the command.
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes) ASSUME_YES=1; shift ;;
            -h|--help) usage; return 0 ;;
            -v|--version) cmd_version; return $? ;;
            -*) err "unknown option: $1"; err "run 'tlstore help' to see what there is"; return 2 ;;
            *) break ;;
        esac
    done
    if [ $# -eq 0 ]; then
        err "-y needs a command after it"
        err "run 'tlstore help' to see the commands"
        return 2
    fi
    tl_cmd="$1"
    shift
    # `<command> -h` is that command's page, for every command but display,
    # which hands its arguments on to the setup script untouched.
    case "$tl_cmd" in
        list|search|info|install|add|remove|uninstall|update|upgrade|rollback|hold|unhold|refresh|self-update|doctor|version)
            for tl_a in "$@"; do
                case "$tl_a" in
                    -h|--help) help_for "$tl_cmd"; return $? ;;
                esac
            done
            ;;
    esac
    case "$tl_cmd" in
        list) cmd_list "$@" ;;
        search) cmd_search "$@" ;;
        info) cmd_info "$@" ;;
        picture) cmd_picture "$@" ;;
        readme) cmd_readme "$@" ;;
        readme-asset) cmd_readme_asset "$@" ;;
        snapshot) cmd_snapshot "$@" ;;
        prefetch) cmd_prefetch "$@" ;;
        install|add) cmd_install "$@" ;;
        remove|uninstall) cmd_remove "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        rollback) cmd_rollback "$@" ;;
        hold) cmd_hold "$@" ;;
        unhold) cmd_unhold "$@" ;;
        refresh) cmd_refresh "$@" ;;
        self-update) cmd_self_update "$@" ;;
        shell)
            # Gone as a command; the launcher's own docs still say it.
            err "tlstore shell is now: tlstore install fish-shell"
            return 2
            ;;
        display) cmd_display "$@" ;;
        doctor) cmd_doctor "$@" ;;
        version) cmd_version "$@" ;;
        help) cmd_help "$@" ;;
        *) err "unknown command: $tl_cmd"; err "run 'tlstore help' to see the commands"; return 2 ;;
    esac
}

# TLSTORE_SOURCE_ONLY=1 defines everything and runs nothing, so a test can
# source this file and call a function directly (scripts/test.sh, tl_fn).
[ "${TLSTORE_SOURCE_ONLY:-0}" = 1 ] || main "$@"

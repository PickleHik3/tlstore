#!/system/bin/sh
# written by termux-launcher
# tlstore — the launcher's tool store. Installs, lists, updates and removes the
# tools and configs the launcher shows off but does not ship.
#
# The shebang is /system/bin/sh on purpose: the prefix differs per edition and
# this file is written into it by the app, so it cannot name $PREFIX/bin/sh.
# POSIX sh only (Termux's sh is dash): no locals, no arrays, no [[ ]].
# Functions therefore share one variable namespace — every helper prefixes its
# variables (dl_, bk_, it_, …) so callers and callees cannot clobber each other.
#
# Item definitions come from the catalog: the one shipped in the APK, or a newer
# one refreshed from the repository and verified with minisign.
#
# Env:
#   TLSTORE_PREFIX      install prefix (default $PREFIX) — tests point it at a fake tree
#   TLSTORE_CATALOG_URL where refresh reads the catalog (file:// works)
#   TLSTORE_ASSUME_YES  1 = same as -y
#   TLSTORE_NPM_REGISTRY npm registry base (default https://registry.npmjs.org)
#   TLSTORE_ARCH        override uname -m (tests exercise aarch64 and x86_64
#                       items on a host)
#   TLSTORE_PATCHELF    the patchelf command (tests pass a no-op)
#   TLSTORE_ASSUME_TTY  1 = answer questions from stdin even when it is not a
#                       terminal (the test suite pipes them in)
#   TLSTORE_HOST        launcher|termux — which app the store is running in,
#                       when the detection below should not have the last word
#   TLSTORE_UI          the tlstore-ui binary bare `tlstore` execs inside the
#                       launcher (default $PREFIX/libexec/termux-launcher/
#                       tlstore/tlstore-ui; tests point it at a fake one, or
#                       one that is not there, to take the other path)
#   TLSTORE_GITHUB      where GitHub is, for an item's README and the pictures
#                       in it: a prefix put in front of the host and path of
#                       every https://…github… address (default none, the real
#                       hosts; tests point it at a file:// tree laid out
#                       <host>/<path>)
#   TLSTORE_RELEASE_BASE  where the newest store release is: tlstore,
#                       tlstore.minisig, catalog.tsv, catalog.tsv.minisig and
#                       tlstore-ui-<abi> sit right under it (default this
#                       repository's releases/latest/download; tests point it
#                       at a file:// directory)
#   TLSTORE_BINARIES_RELEASES  where a bare `binaries:<asset>@<tag>` source
#                       is: <base>/<tag>/<asset>-<arch> (default this
#                       repository's releases/download; tests use file://)
#   TLSTORE_BINARIES_RAW  where a `binaries:<path/with/slash>@<tag>` source
#                       is: <base>/<tag>/<path>, a file in this repository at
#                       that tag (default the raw GitHub URL; tests use file://)
#   TLSTORE_SOURCE_ONLY 1 = define the functions and run nothing (tests source
#                       the file and call them directly)
#   TLSTORE_STYLE       1|0 = colour, icons and a status line on, or plain
#                       text, whatever stdout is (default: on for a terminal)
#   TLSTORE_ICONS       nerd|plain — which icons styled output draws (default:
#                       nerd in the launcher's terminal, plain elsewhere)
#   TLSTORE_UPDATED_FROM  set by an update that just took a newer tlstore and
#                       hands the rest of the run to it; that run never offers
#                       a newer tlstore again

set -u

TLSTORE_VERSION=0.19

# The store program that pairs with this script, one digest per processor.
# Empty in the source tree: scripts/release.sh --prepare fills them in from
# dist/tlstore-ui-<abi> before the file is signed, so a self-update can check
# the program it downloads against a digest the signature covers (see
# self_update, which reads them out of the downloaded copy, not this one).
# Keep these two lines exactly in this shape.
# shellcheck disable=SC2034
TLSTORE_UI_SHA256_arm64_v8a=
# shellcheck disable=SC2034
TLSTORE_UI_SHA256_x86_64=

PREFIX="${TLSTORE_PREFIX:-${PREFIX:-${HOME%/files/home}/files/usr}}"
HOME="${HOME:?tlstore needs HOME}"

# /data/data/<app package>/files/usr — the edition this prefix belongs to.
APP_PACKAGE=""
case "$PREFIX" in
    */files/usr)
        APP_PACKAGE="${PREFIX%/files/usr}"
        APP_PACKAGE="${APP_PACKAGE##*/}"
        ;;
esac

BIN_DIR="$HOME/.local/bin"
LIB_DIR="$HOME/.local/lib"
# Where a priv=shizuku binary itself lives: off PATH, since what the user runs
# is the wrapper in BIN_DIR that hands it to the launcher's privileged lane.
PRIV_DIR="$LIB_DIR/tlstore/priv"
# Where a skill item unpacks (Revision 18): the directory agents share, which
# each agent's own skills directory links into.
SKILLS_DIR="$HOME/.agents/skills"
DATA_DIR="$HOME/.local/share/tlstore"
CACHE_DIR="$HOME/.cache/tlstore"
STORE_DIR="$PREFIX/libexec/termux-launcher/tlstore"
BASE_CATALOG="$STORE_DIR/catalog.tsv"
USER_CATALOG="$DATA_DIR/catalog.tsv"
PUBKEY="$STORE_DIR/trusted.pub"
STATE="$DATA_DIR/installed.tsv"
HELD="$DATA_DIR/held"
# Present when the user answered "never" to update's offer of a newer tlstore.
SU_QUIET="$DATA_DIR/self-update-quiet"
# What an install, update or remove that was cut short leaves behind: its verb,
# its plan, and a line for each row that finished. plan_apply writes it and
# removes it when it returns; the next plan_apply, and doctor, report one that
# is still here. Nothing else reads it, and nothing is resumed from it.
JOURNAL="$DATA_DIR/journal"
# Where plan_apply's fetch phase keeps each payload it downloaded and checked,
# until its row is applied. One per process: the store app and a terminal can
# each be installing at once, and each wipes its own when it is done.
STAGE_DIR="$CACHE_DIR/stage.$$"

# The app writes this when it puts tlstore down (a hand install writes
# .standalone instead, with the address it came from inside it; nothing here
# reads that one — tlstore keeps itself current the same way in both cases).
INSTALLED_MARK="$STORE_DIR/.installed"

# Which app the store is running in. The launcher names itself in the
# environment; over ssh nothing does, and then the app's own marker answers.
HOST="${TLSTORE_HOST:-}"
case "$HOST" in
    launcher|termux) ;;
    *)
        if [ "${TERM_PROGRAM:-}" = termux-launcher ]; then
            HOST=launcher
        elif [ -n "${TERM_PROGRAM:-}" ]; then
            HOST=termux
        elif [ -f "$INSTALLED_MARK" ]; then
            HOST=launcher
        else
            HOST=termux
        fi
        ;;
esac

# The launcher's own version, for items that need a recent one. Only the
# launcher sets it, and an item asking for it passes anywhere else.
LAUNCHER_VERSION="${TERM_PROGRAM_VERSION:-}"
[ "$HOST" = launcher ] || LAUNCHER_VERSION=""

# The newest store release: the signed script, the signed catalog and the
# store program, as GitHub Release assets. The catalog and tlstore itself are
# refreshed from here, whoever installed tlstore (see refresh_catalog and
# self_update).
RELEASE_BASE="${TLSTORE_RELEASE_BASE:-https://github.com/PickleHik3/tlstore/releases/latest/download}"
CATALOG_URL="${TLSTORE_CATALOG_URL:-$RELEASE_BASE/catalog.tsv}"
NPM_REGISTRY="${TLSTORE_NPM_REGISTRY:-https://registry.npmjs.org}"
PATCHELF="${TLSTORE_PATCHELF:-patchelf}"
TLSTORE_UI_BIN="${TLSTORE_UI:-$STORE_DIR/tlstore-ui}"

LAUNCHER_RAW="https://raw.githubusercontent.com/PickleHik3/termux-launcher"
# A bare `binaries:<asset>@<tag>` is a GitHub Release asset of this repository
# (a bins-… prerelease built by .github/workflows/build.yml); a path with a
# slash is a small file kept in git, read raw at that tag.
BINARIES_RELEASES="${TLSTORE_BINARIES_RELEASES:-https://github.com/PickleHik3/tlstore/releases/download}"
BINARIES_RAW="${TLSTORE_BINARIES_RAW:-https://raw.githubusercontent.com/PickleHik3/tlstore}"

# Where an item's own README and its pictures are read from (see cmd_readme).
GITHUB_RAW="https://raw.githubusercontent.com"
GITHUB_MIRROR="${TLSTORE_GITHUB:-}"

ASSUME_YES="${TLSTORE_ASSUME_YES:-0}"
[ "$ASSUME_YES" = 1 ] || ASSUME_YES=0

ASSUME_TTY="${TLSTORE_ASSUME_TTY:-0}"
[ "$ASSUME_TTY" = 1 ] || ASSUME_TTY=0

# The version an update just moved on from, when this run is the newer tlstore
# it handed itself to (cmd_update). Read once and dropped from the environment,
# so nothing this run starts inherits it.
SU_FROM="${TLSTORE_UPDATED_FROM:-}"
unset TLSTORE_UPDATED_FROM

# -y never answers "replace my config file?"; --configs does, and only that.
REPLACE_CONFIGS=0

# --progress: a machine stream on stdout for install/update/remove, for
# tlstore-ui. It implies -y, and a config file question is always answered by
# keeping the user's file (never replacing it) rather than asking.
PROGRESS=0
PROGRESS_NOTE=""

# --dry-run: say what install, update or remove would do, and change nothing.
DRY_RUN=0

# Packages this run installed only so something else could be built.
BUILD_ADDED=""

# The processor, as the catalog names it: aarch64 or x86_64. A row's own
# columns are the aarch64 build; on x86_64 its x86_64:source, x86_64:digest and
# x86_64:target options stand in for them (rows). Any other processor has no
# prebuilt tools at all.
ARCH="${TLSTORE_ARCH:-$(uname -m 2>/dev/null || echo unknown)}"
case "$ARCH" in
    aarch64|arm64) ARCH=aarch64; ARCH_OK=1 ;;
    x86_64|amd64) ARCH=x86_64; ARCH_OK=1 ;;
    *) ARCH_OK=0 ;;
esac

CATALOG=""
CATALOG_SERIAL=""
CATALOG_FROM=""

TAB=$(printf '\t')
NL='
'

# The last thing err said, so a --progress done line can carry the real
# reason an item failed (plan_apply clears it before each row).
LAST_ERR=""

# What a cancel (SIGTERM to the whole process group — tlstore-ui sends it when
# the person backs out of a running --progress job) has to clean up: the temp
# file the current download is writing (download() keeps this current),
# anywhere else an install leaves a half-built scratch copy before it moves it
# into place (the npm kinds' unpack directory), and which item was in flight, so
# the UI still gets a done line for it instead of waiting forever.
CANCEL_TMP=""
CANCEL_EXTRA=""
CANCEL_ITEM=""
# 1 while plan_apply keeps payloads in STAGE_DIR (a cancel drops the lot), and
# the names this run staged there: only those are ever taken from it, so a copy
# some other run left behind is never put in place unchecked.
PA_STAGING=0
PA_STAGED=""
# 1 while download is staging a payload: it stops short of the "putting files
# in place" step, which belongs to the row's apply.
DL_STAGE=0

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

say() {
    if [ "$PROGRESS" = 1 ]; then
        printf '%s\n' "$*" >&2
    elif [ "$STATUS_SCOPE" = 1 ]; then
        # An item's narration: its status and closing lines say what matters.
        :
    else
        status_clear
        printf '%s\n' "$*"
    fi
}
# Inside a styled row, the row's own closing line carries the reason instead.
err() {
    LAST_ERR="$*"
    [ "$STATUS_SCOPE" = 1 ] && [ -n "$ROW_NAME" ] && return 0
    status_clear
    printf 'tlstore: %s\n' "$*" >&2
}
die() { ROW_NAME=""; err "$*"; exit 1; }

# progress_line <step> <name> <pct> <words> — one line of the --progress
# stream. Always stdout, whether or not PROGRESS is set, since these lines are
# the machine output itself, not incidental narration.
progress_line() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }
progress_done() { printf 'done\t%s\t%s\t%s\n' "$1" "$2" "$3"; }

# progress_stage <pct> <words> — the job's item reached a step. Only moves
# forward, so a step the work already reported (the download's own count, or
# its checksum) is not reported again, and one it never reached (a pkg item
# has no download of ours) still shows before "ready".
PROGRESS_AT=0
progress_stage() {
    [ "$PROGRESS" = 1 ] && [ -n "$CANCEL_ITEM" ] || return 0
    [ "$1" -gt "$PROGRESS_AT" ] || return 0
    PROGRESS_AT=$1
    progress_line step "$CANCEL_ITEM" "$1" "$2"
}

# The share of the bar a download fills: from the "fetched" step up to where
# the checksum step starts.
PROGRESS_FETCH_END=55

# curl_to <url> <file> — download to a file. Inside a --progress job, for the
# job's own item, curl's progress bar is turned into step lines as the bytes
# arrive (one per whole percent of the bar, flushed), so the count and the line
# move with the download instead of jumping from the first step to the last.
# On a styled terminal, a download its caller named (DL_WHAT) draws the same
# frames as a bar on the status line instead.
curl_to() {
    if styled && [ -n "$DL_WHAT" ]; then
        ct_rc="$2.rc"
        status "Downloading $DL_WHAT" "$I_DL"
        ct_head=$(status_text "$I_DL" "Downloading $DL_WHAT" $((BAR_CELLS + 5)))
        { curl -fL -# --connect-timeout 5 --speed-limit 1 --speed-time 30 -o "$2" "$1" 2>&1
          echo "$?" > "$ct_rc"; } |
            tr '\r' '\n' |
            awk -v head="$ct_head" -v esc="$ESC" -v cells="$BAR_CELLS" -v on="$C_ACC" -v dim="$C_DIM" -v off="$C_OFF" '
                match($0, /[0-9]+(\.[0-9]+)?%/) {
                    p = int(substr($0, RSTART, RLENGTH - 1))
                    if (p == last) next
                    last = p
                    f = int(cells * p / 100)
                    bar = ""; rest = ""
                    for (i = 0; i < f; i++) bar = bar "━"
                    if (f < cells) { rest = "╺"; for (i = f + 1; i < cells; i++) rest = rest "━" }
                    printf "\r%s[K%s %s%s%s%s%s %d%%", esc, head, on, bar, dim, rest, off, p
                    fflush()
                }'
        ct_status=$(cat "$ct_rc" 2>/dev/null || echo 1)
        rm -f "$ct_rc"
        [ "$ct_status" = 0 ]
        return
    fi
    if [ "$PROGRESS" != 1 ] || [ -z "$CANCEL_ITEM" ]; then
        curl -fsSL --connect-timeout 5 --speed-limit 1 --speed-time 30 -o "$2" "$1"
        return
    fi
    ct_rc="$2.rc"
    # curl's own exit status cannot come back through the pipe, so it goes
    # through a file; -# draws "####   42.0%" frames separated by carriage
    # returns on stderr, whatever stderr is.
    { curl -fL -# --connect-timeout 5 --speed-limit 1 --speed-time 30 -o "$2" "$1" 2>&1
      echo "$?" > "$ct_rc"; } |
        tr '\r' '\n' |
        awk -v name="$CANCEL_ITEM" -v from="$PROGRESS_AT" -v to="$PROGRESS_FETCH_END" '
            match($0, /[0-9]+(\.[0-9]+)?%/) {
                p = substr($0, RSTART, RLENGTH - 1) + 0
                v = int(from + (to - from) * p / 100)
                if (v > last) { last = v; printf "step\t%s\t%d\tfetched\n", name, v; fflush() }
            }'
    ct_status=$(cat "$ct_rc" 2>/dev/null || echo 1)
    rm -f "$ct_rc"
    [ "$ct_status" = 0 ] || return 1
    PROGRESS_AT=$PROGRESS_FETCH_END
    return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# Styled output (Revision 16)
# ---------------------------------------------------------------------------

# On a terminal, install, update and remove draw one status line rewritten in
# place, one closing line per item and a summary; everywhere else (a pipe,
# --progress, NO_COLOR, a dumb TERM) output stays plain text. Colours are the
# sixteen ANSI ones only: the launcher builds those from the person's scheme,
# so the store wears it too. Icons follow fish/prompt.fish: Nerd Font glyphs
# where the launcher's bundled Symbols Nerd Font draws them, plain ones
# elsewhere. Nothing animates on a timer; the line moves when the work does.
STYLE="${TLSTORE_STYLE:-}"
case "$STYLE" in
    0|1) ;;
    *)
        STYLE=0
        if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -n "${TERM:-}" ] && [ "$TERM" != dumb ]; then
            STYLE=1
        fi
        ;;
esac
ESC=$(printf '\033')
C_OK="" C_BAD="" C_ASK="" C_DIM="" C_ACC="" C_OFF=""
if [ "$STYLE" = 1 ]; then
    C_OK="${ESC}[32m" C_BAD="${ESC}[31m" C_ASK="${ESC}[33m" C_DIM="${ESC}[2m" C_ACC="${ESC}[34m" C_OFF="${ESC}[0m"
fi
ICONS="${TLSTORE_ICONS:-}"
case "$ICONS" in
    nerd|plain) ;;
    *)
        ICONS=plain
        if [ -z "${SSH_CONNECTION:-}" ] && { [ "${TERM_PROGRAM:-}" = termux-launcher ] || have launcherctl; }; then
            ICONS=nerd
        fi
        ;;
esac
# Nerd Fonts 3.5: fa-check, fa-xmark, fa-warning, fa-download, oct-package. The
# launcher draws a glyph two cells wide over the space after it, hence the gap.
I_OK="✓" I_BAD="✗" I_ASK="!" I_DOT="·" I_DL="·" I_PKG="·" GAP=" "
if [ "$ICONS" = nerd ]; then
    I_OK=$(printf '\357\200\214') I_BAD=$(printf '\357\200\215') I_ASK=$(printf '\357\201\261')
    I_DL=$(printf '\357\200\231') I_PKG=$(printf '\357\222\207') GAP="  "
fi
# How many cells a download's bar takes on the status line.
BAR_CELLS=20
STATUS_ON=0
STATUS_COLS=""
# 1 while plan_apply runs styled: its narration (say) is left out, and
# ROW_NAME is the item whose closing line will carry any error.
STATUS_SCOPE=0
ROW_NAME=""
# What curl_to is downloading, for the status line ("claude-code 2.1.300").
DL_WHAT=""
ROWS_OK=0 ROWS_BAD=0 ROWS_SAME=0

styled() { [ "$STYLE" = 1 ] && [ "$PROGRESS" != 1 ]; }

# status_text <icon> <words> <cells kept after them> — the status line, cut to
# the terminal's width. Item names and versions are ASCII, so bytes are cells.
status_text() {
    st_room=$((STATUS_COLS - $3 - 5))
    [ "$st_room" -gt 8 ] || st_room=8
    # shellcheck disable=SC2059  # the width is ours, the words are an argument
    printf "%s%s%s%s%.${st_room}s" "$C_ACC" "$1" "$C_OFF" "$GAP" "$2"
}

# status <words> [icon] — says what is happening now, in place of the last.
status() {
    styled || return 0
    [ -n "$STATUS_COLS" ] || STATUS_COLS=$(term_cols)
    printf '\r%s[K%s…' "$ESC" "$(status_text "${2:-$I_DOT}" "$1" 1)"
    STATUS_ON=1
}

status_clear() {
    [ "$STATUS_ON" = 1 ] || return 0
    printf '\r%s[K' "$ESC"
    STATUS_ON=0
}

# row_mark ok|failed|same|note <name> <words> — an item's one closing line on
# a styled terminal (an item already current gets none, only a count).
row_mark() {
    styled || return 0
    case "$1" in
        ok) ROWS_OK=$((ROWS_OK + 1)); rm_c="$C_OK" rm_i="$I_OK" rm_sep=" " ;;
        failed) ROWS_BAD=$((ROWS_BAD + 1)); rm_c="$C_BAD" rm_i="$I_BAD" rm_sep=": " ;;
        same) ROWS_SAME=$((ROWS_SAME + 1)); return 0 ;;
        *) rm_c="$C_DIM" rm_i="$I_DOT" rm_sep=" " ;;
    esac
    status_clear
    printf '%s%s%s%s%s%s%s%s\n' "$rm_c" "$rm_i" "$C_OFF" "$GAP" "$C_ACC" "$2" "$C_OFF$rm_sep" "$3"
}

# row_summary <done word> <current words> — "2 updated · 1 failed · 6 already current".
row_summary() {
    styled || return 0
    rs_out=""
    [ "$ROWS_OK" = 0 ] || rs_out="$C_OK$ROWS_OK $1$C_OFF"
    [ "$ROWS_BAD" = 0 ] || rs_out="$rs_out${rs_out:+ $C_DIM·$C_OFF }$C_BAD$ROWS_BAD failed$C_OFF"
    [ "$ROWS_SAME" = 0 ] || rs_out="$rs_out${rs_out:+ $C_DIM·$C_OFF }$C_DIM$ROWS_SAME $2$C_OFF"
    status_clear
    [ -z "$rs_out" ] || printf '%s\n' "$rs_out"
}

# Runs on SIGTERM (a plain kill or the whole process group tlstore-ui signals
# to cancel a running --progress job): drop whatever the current download had
# not finished writing, drop any other scratch copy an install had not yet
# moved into place, tell the UI the item in flight failed rather than leaving
# it to wait for a line that is never coming, and stop. Nothing already
# recorded in STATE is touched, so an item that finished earlier in this same
# run stays installed.
on_cancel() {
    [ -z "$CANCEL_TMP" ] || rm -f "$CANCEL_TMP"
    for oc_p in $CANCEL_EXTRA; do
        rm -rf "$oc_p"
    done
    [ "$PA_STAGING" != 1 ] || rm -rf "$STAGE_DIR"
    if [ "$PROGRESS" = 1 ] && [ -n "$CANCEL_ITEM" ]; then
        progress_done "$CANCEL_ITEM" failed "Cancelled."
    fi
    exit 143
}
trap on_cancel TERM

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

serial_of() {
    [ -f "$1" ] || return 1
    sed -n 's/^#.*serial=\([0-9][0-9]*\).*$/\1/p' "$1" | head -1
}

# Picks the newer of the refreshed catalog and the one shipped in the app.
pick_catalog() {
    pc_base=$(serial_of "$BASE_CATALOG" 2>/dev/null || true)
    pc_user=$(serial_of "$USER_CATALOG" 2>/dev/null || true)
    CATALOG=""
    if [ -f "$USER_CATALOG" ] && [ -n "$pc_user" ]; then
        if [ -z "$pc_base" ] || [ "$pc_user" -gt "$pc_base" ] 2>/dev/null; then
            CATALOG="$USER_CATALOG"
            CATALOG_SERIAL="$pc_user"
            CATALOG_FROM=refreshed
        fi
    fi
    if [ -z "$CATALOG" ] && [ -f "$BASE_CATALOG" ]; then
        CATALOG="$BASE_CATALOG"
        CATALOG_SERIAL="$pc_base"
        CATALOG_FROM=app
    fi
    [ -n "$CATALOG" ]
}

need_catalog() {
    pick_catalog || die "the list of items is missing — reopen the app to put it back"
}

# Every row that applies here: this edition's prefix, this processor, this app,
# a new enough launcher; first row per name wins. Off aarch64 a row comes out
# with its <arch>:source, <arch>:digest and <arch>:target options already in
# place of columns 5, 6 and 7, so nothing downstream needs to know the
# processor. A binary, an archive or a skill is here only with its own <arch>:digest
# (build-catalog.sh writes it once that build is published); an npm-musl or
# npm-android item only with its own <arch>:source (the npm package built for
# it), and an npm-musl item only while its musl loader and libraries are here
# as well.
rows() {
    awk -F "$TAB" -v OFS="$TAB" -v pkgname="$APP_PACKAGE" -v archok="$ARCH_OK" \
        -v arch="$ARCH" -v host="$HOST" -v lver="$LAUNCHER_VERSION" '
        function prefix_ok(list,   n, i, parts) {
            if (list == "*" || list == "") return 1
            n = split(list, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == pkgname) return 1
            return 0
        }
        function arch_ok(kind, opts) {
            if (kind != "binary" && kind != "archive" && kind != "skill" && kind != "npm-musl" && kind != "npm-android") return 1
            if (archok != "1") return 0
            if (arch == "aarch64") return 1
            if (kind == "binary" || kind == "archive" || kind == "skill") return optval(opts, arch ":digest") != ""
            return optval(opts, arch ":source") != ""
        }
        function for_arch(   v) {
            if (archok != "1" || arch == "aarch64") return
            v = optval($9, arch ":source"); if (v != "") $5 = v
            v = optval($9, arch ":digest"); if (v != "") $6 = v
            v = optval($9, arch ":target"); if (v != "") $7 = v
        }
        function optval(list, key,   n, i, parts) {
            n = split(list, parts, ";")
            for (i = 1; i <= n; i++)
                if (index(parts[i], key "=") == 1)
                    return substr(parts[i], length(key) + 2)
            return ""
        }
        function host_ok(list,   want, n, i, parts) {
            want = optval(list, "host")
            if (want == "") return 1
            n = split(want, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == host) return 1
            return 0
        }
        function vercmp(a, b,   na, nb, pa, pb, i, n, x, y) {
            na = split(a, pa, /[._-]/)
            nb = split(b, pb, /[._-]/)
            n = (na > nb) ? na : nb
            for (i = 1; i <= n; i++) {
                x = (i <= na) ? pa[i] + 0 : 0
                y = (i <= nb) ? pb[i] + 0 : 0
                if (x > y) return 1
                if (x < y) return -1
            }
            return 0
        }
        function launcher_ok(list,   want) {
            want = optval(list, "min-launcher")
            if (want == "") return 1
            if (lver == "") return 1
            return vercmp(lver, want) >= 0
        }
        function applies() {
            if ($0 ~ /^[ \t]*#/ || $0 ~ /^[ \t]*$/ || NF < 10) return 0
            return prefix_ok($4) && arch_ok($2, $9) && host_ok($9) && launcher_ok($9)
        }
        # An npm-musl item cannot start without the musl loader and the
        # libraries its musl-libs names, so it is here only when they are:
        # on x86_64 the npm package exists before our own builds do.
        function musl_ready(opts,   n, i, parts) {
            if (!("musl-loader" in here)) return 0
            n = split(optval(opts, "musl-libs"), parts, ",")
            for (i = 1; i <= n; i++) if (!(parts[i] in here)) return 0
            return 1
        }
        # The catalog is read twice: once for the names that apply here, then
        # for the rows themselves.
        NR == FNR { if (applies()) here[$1] = 1; next }
        !applies() { next }
        $2 == "npm-musl" && !musl_ready($9) { next }
        seen[$1]++ { next }
        { for_arch(); print }
    ' "$CATALOG" "$CATALOG"
}

# The rows a user picks from. The rest are plumbing: parts other items pull in,
# never listed and never installed by name.
visible_rows() {
    rows | awk -F "$TAB" '$9 !~ /(^|;)hidden=1(;|$)/'
}

# A retired item's row stays in the catalog (hidden, so old engines never
# offer it) purely so update can find it on a phone that already installed
# it and take it away. A new engine never installs one, directly or through
# another item's requires.
retired_item() {
    rti_row=$(row "$1")
    [ -n "$rti_row" ] || return 1
    [ "$(opt "$(field "$rti_row" 9)" retired)" = 1 ]
}

# row <name> — the row for one item, empty when it has none here.
row() {
    rows | awk -F "$TAB" -v want="$1" '$1 == want { print; exit }'
}

# Loads a row into it_* for the rest of the run. The row is split with
# parameter expansion alone (no cut per field): a field beyond the row's end
# reads as "", the way `cut -f` reports it, and an empty field stays empty.
load_item() {
    it_row=$(row "$1")
    [ -n "$it_row" ] || return 1
    it_name=""; it_kind=""; it_version=""; it_prefixes=""; it_source=""
    it_digest=""; it_target=""; it_requires=""; it_options=""; it_summary=""
    it_category=""; it_upstream=""; it_setup=""; it_standfirst=""
    it_does1=""; it_does2=""; it_does3=""; it_try=""; it_notes=""
    it_author=""; it_licence=""; it_size=""; it_picture=""
    it_picture_digest=""; it_demo=""; it_featured=""; it_readme_skip=""
    it_readme=""; it_readme_digest=""; it_demo_digest=""
    # A trailing tab so the last field ends the way every other one does.
    li_rest="$it_row$TAB"
    li_i=1
    while [ -n "$li_rest" ] && [ "$li_i" -le 30 ]; do
        li_f="${li_rest%%"$TAB"*}"
        li_rest="${li_rest#*"$TAB"}"
        # shellcheck disable=SC2034  # it_prefixes is loaded for completeness; rows() did the matching
        case "$li_i" in
            1) it_name="$li_f" ;;
            2) it_kind="$li_f" ;;
            3) it_version="$li_f" ;;
            4) it_prefixes="$li_f" ;;
            5) it_source="$li_f" ;;
            6) it_digest="$li_f" ;;
            7) it_target="$li_f" ;;
            8) it_requires="$li_f" ;;
            9) it_options="$li_f" ;;
            10) it_summary="$li_f" ;;
            # The Revision 5 fields, read out by cmd_info and cmd_snapshot.
            11) it_category="$li_f" ;;
            12) it_upstream="$li_f" ;;
            13) it_setup="$li_f" ;;
            14) it_standfirst="$li_f" ;;
            15) it_does1="$li_f" ;;
            16) it_does2="$li_f" ;;
            17) it_does3="$li_f" ;;
            18) it_try="$li_f" ;;
            19) it_notes="$li_f" ;;
            20) it_author="$li_f" ;;
            21) it_licence="$li_f" ;;
            22) it_size="$li_f" ;;
            23) it_picture="$li_f" ;;
            24) it_picture_digest="$li_f" ;;
            25) it_demo="$li_f" ;;
            26) it_featured="$li_f" ;;
            27) it_readme_skip="$li_f" ;;
            28) it_readme="$li_f" ;;
            29) it_readme_digest="$li_f" ;;
            30) it_demo_digest="$li_f" ;;
        esac
        li_i=$((li_i + 1))
    done
    # Revision 6: the README sections tlstore-ui leaves out, |-separated. A
    # catalog from before the column has no field 27 at all, which reads as
    # "none" the same way "-" does.
    [ -n "$it_readme_skip" ] || it_readme_skip="-"
    # Pinned content (Revision 6 addendum): a launcher:/binaries: source for a
    # pinned README (instead of fetching upstream) and its digest, plus the
    # demo picture's own digest. A catalog from before these columns has none
    # of the three, which reads as "-" the same way an explicit "-" does.
    [ -n "$it_readme" ] || it_readme="-"
    [ -n "$it_readme_digest" ] || it_readme_digest="-"
    [ -n "$it_demo_digest" ] || it_demo_digest="-"
    return 0
}

field() {
    printf '%s\n' "$1" | cut -d "$TAB" -f "$2"
}

# The value of one ;-separated option, empty when unset.
opt() {
    printf '%s' "$1" | tr ';' '\n' | sed -n "s/^$2=//p" | head -1
}

commas() { printf '%s' "$1" | tr ',' ' '; }

# " a  b " → "a, b", for reading out a list of names.
words_list() { printf '%s' "$1" | sed 's/^ *//; s/ *$//; s/  */, /g'; }

# A leading ~ in a target is this user's home, not a shell expansion.
# shellcheck disable=SC2088
expand_path() {
    case "$1" in
        '~'|'~/'*) printf '%s' "$HOME${1#\~}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The URL a source field points at.
source_url() {
    case "$1" in
        launcher:*)
            su_rest="${1#launcher:}"
            su_path="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            printf '%s/%s/%s' "$LAUNCHER_RAW" "$su_tag" "$su_path"
            ;;
        binaries:*)
            su_rest="${1#binaries:}"
            su_asset="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            case "$su_asset" in
                # A path (a readme or a hero picture kept in the repository)
                # resolves straight to that file at the tag; a bare asset name
                # is the per-processor binary, published as a release asset
                # under the tag as <asset>-aarch64 or <asset>-x86_64.
                */*) printf '%s/%s/%s' "$BINARIES_RAW" "$su_tag" "$su_asset" ;;
                *) printf '%s/%s/%s-%s' "$BINARIES_RELEASES" "$su_tag" "$su_asset" "$ARCH" ;;
            esac
            ;;
        *) printf '%s' "$1" ;;
    esac
}

# item_targets <name> <kind> <target> [source] [options] — where an item's
# payload lands, space separated; empty for pkg and bundles. An npm-musl or
# npm-android item lands twice: the directory, then the wrapper, which is named
# after the executable inside the package (claude-code installs the command
# `claude`) unless command=<name> says otherwise. A package that keeps its
# executable in a subdirectory (npm:x#bin/y) still gets the bare name. A binary with priv=shizuku lands twice as well: the program
# under PRIV_DIR, off PATH, then the wrapper on PATH that runs it through
# tl-priv. An archive lands twice too: the directory it unpacks into
# (~/.local/lib/<name>, like the npm kinds), then the wrapper, named after the
# item unless command=<name> says otherwise. A skill lands as its directory
# (~/.agents/skills/<name>), then the links agents read it through:
# ~/.claude/skills/<name>, and ~/.codex/skills/<name> while ~/.codex is there.
item_targets() {
    case "$2" in
        binary|file|file-once)
            if [ "$2" = binary ] && [ "$(opt "${5:-}" priv)" = shizuku ]; then
                if [ "$3" = "-" ] || [ -z "$3" ]; then
                    printf '%s %s' "$PRIV_DIR/$1" "$BIN_DIR/$1"
                else
                    printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$1"
                fi
            elif [ "$3" = "-" ] || [ -z "$3" ]; then
                [ "$2" = binary ] || return 0
                printf '%s' "$BIN_DIR/$1"
            else
                expand_path "$3"
            fi
            ;;
        npm-musl|npm-android)
            it_exe="${4:-}"
            case "$it_exe" in
                *"#"*) it_exe="${it_exe##*#}" ;;
                *) it_exe="$1" ;;
            esac
            it_exe="${it_exe##*/}"
            it_cmd=$(opt "${5:-}" command)
            [ -z "$it_cmd" ] || it_exe="$it_cmd"
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                printf '%s %s' "$LIB_DIR/$1" "$BIN_DIR/$it_exe"
            else
                printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$it_exe"
            fi
            ;;
        archive)
            it_cmd=$(opt "${5:-}" command)
            [ -n "$it_cmd" ] || it_cmd="$1"
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                printf '%s %s' "$LIB_DIR/$1" "$BIN_DIR/$it_cmd"
            else
                printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$it_cmd"
            fi
            ;;
        skill)
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                printf '%s' "$SKILLS_DIR/$1"
            else
                expand_path "$3"
            fi
            printf ' %s' "$HOME/.claude/skills/$1"
            [ ! -d "$HOME/.codex" ] || printf ' %s' "$HOME/.codex/skills/$1"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

state_row() {
    [ -f "$STATE" ] || return 1
    awk -F "$TAB" -v want="$1" '/^#/ { next } $1 == want { print; exit }' "$STATE"
}

is_installed() {
    [ -n "$(state_row "$1" 2>/dev/null)" ]
}

installed_version() {
    st_row=$(state_row "$1" 2>/dev/null) || return 1
    [ -n "$st_row" ] || return 1
    field "$st_row" 3
}

installed_names() {
    [ -f "$STATE" ] || return 0
    awk -F "$TAB" '/^#/ { next } NF > 0 { print $1 }' "$STATE"
}

# state_record <name> <kind> <version> <files…>
# A row is name kind version when files, then source digest and the one
# version before this (prev_version prev_source prev_digest), which is what
# rollback reinstalls. Rows from before those columns have none of them; the
# readers all ask for a column by number, so a short row reads as empty ones.
# The source and digest are the install's own (ii_source, ii_digest). A new
# version pushes the old row's into the prev columns; the same version again
# (a reinstall, npm's "already here") keeps what was there. A row with no
# source recorded cannot say what it was, so nothing is kept for it.
# SR_CLEAR_PREV=1 drops them, which a rollback does: it goes back one step only.
# Column 11 is `by` (Revision 13): requested (named on the command line) or
# auto (pulled in by another item). SR_BY says which this install is: a
# reinstall keeps what was recorded unless SR_BY is requested, and a new row
# takes SR_BY (empty, as a rollback leaves it, records nothing). A row from
# before the column reads as unknown.
SR_BY=""
state_record() {
    sr_name="$1"
    sr_kind="$2"
    sr_version="$3"
    shift 3
    sr_files="$*"
    sr_src="${ii_source:-}"
    sr_dig="${ii_digest:-}"
    case "$sr_kind" in
        npm-musl|npm-android) sr_dig="-" ;;
    esac
    sr_pv=""
    sr_ps=""
    sr_pd=""
    sr_old=$(state_row "$sr_name" 2>/dev/null || true)
    if [ -n "$sr_old" ] && [ "${SR_CLEAR_PREV:-0}" != 1 ]; then
        if [ "$(field "$sr_old" 3)" != "$sr_version" ]; then
            if [ -n "$(field "$sr_old" 6)" ]; then
                sr_pv=$(field "$sr_old" 3)
                sr_ps=$(field "$sr_old" 6)
                sr_pd=$(field "$sr_old" 7)
            fi
        else
            sr_pv=$(field "$sr_old" 8)
            sr_ps=$(field "$sr_old" 9)
            sr_pd=$(field "$sr_old" 10)
        fi
    fi
    if [ "${SR_BY:-}" = requested ]; then
        sr_by=requested
    elif [ -n "$sr_old" ]; then
        sr_by=$(field "$sr_old" 11)
    elif [ "${SR_BY:-}" = auto ]; then
        sr_by=auto
    else
        sr_by=""
    fi
    mkdir -p "$DATA_DIR"
    [ -f "$STATE" ] || printf '# tlstore installed\tname\tkind\tversion\twhen\tfiles\tsource\tdigest\tprev_version\tprev_source\tprev_digest\tby\n' > "$STATE"
    sr_tmp="$STATE.new"
    awk -F "$TAB" -v want="$sr_name" '$1 != want' "$STATE" > "$sr_tmp" || return 1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sr_name" "$sr_kind" "$sr_version" "$(timestamp)" "$sr_files" \
        "$sr_src" "$sr_dig" "$sr_pv" "$sr_ps" "$sr_pd" "$sr_by" >> "$sr_tmp"
    mv "$sr_tmp" "$STATE"
}

# state_set_by <name> <by> — column 11 alone, for an item that is already
# here: an explicit install of something another item pulled in makes it
# requested, so remove no longer takes it away with that item.
state_set_by() {
    [ -f "$STATE" ] || return 0
    ssb_tmp="$STATE.new"
    awk -F "$TAB" -v OFS="$TAB" -v want="$1" -v by="$2" \
        '/^#/ { print; next } $1 == want { $11 = by } { print }' "$STATE" > "$ssb_tmp" || return 1
    mv "$ssb_tmp" "$STATE"
}

# state_by <name> — column 11: requested, auto, or empty for unknown.
state_by() {
    sb_row=$(state_row "$1" 2>/dev/null) || return 0
    [ -n "$sb_row" ] || return 0
    field "$sb_row" 11
}

# Holds: names, one a line, kept apart from installed.tsv so a reinstall
# (which rewrites the row) does not drop one.
is_held() {
    [ -f "$HELD" ] && grep -qx -- "$1" "$HELD" 2>/dev/null
}

hold_add() {
    is_held "$1" && return 0
    mkdir -p "$DATA_DIR"
    printf '%s\n' "$1" >> "$HELD"
}

hold_drop() {
    [ -f "$HELD" ] || return 0
    hd_tmp="$HELD.new"
    grep -vx -- "$1" "$HELD" > "$hd_tmp" || true
    mv "$hd_tmp" "$HELD"
}

# The "never" answer to update's offer of a newer tlstore: an empty file that
# only a successful `tlstore self-update` takes away.
su_quiet_on() {
    mkdir -p "$DATA_DIR"
    : > "$SU_QUIET"
}

su_quiet_off() {
    rm -f "$SU_QUIET"
}

state_forget() {
    # A hold goes with the item, however it leaves (remove, retirement).
    hold_drop "$1"
    [ -f "$STATE" ] || return 0
    sf_tmp="$STATE.new"
    awk -F "$TAB" -v want="$1" '$1 != want' "$STATE" > "$sf_tmp" || return 1
    mv "$sf_tmp" "$STATE"
}

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

file_digest() {
    if have sha256sum; then
        sha256sum "$1" | cut -d' ' -f1
    elif have openssl; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        printf ''
    fi
}

backup_existing() {
    bk_target="$1"
    # What this item itself put here last time — its program, or the wrapper
    # tlstore wrote — is simply replaced. Keeping a copy would add one on every
    # update, and remove would then put the stale one back. A config file is
    # different: it may hold your edits, so it is always kept.
    case "${ii_kind:-}" in
        file|file-once) ;;
        *)
            bk_row=$(state_row "${ii_name:-}" 2>/dev/null || true)
            case " $(field "$bk_row" 5) " in
                *" $bk_target "*) prune_backups "$bk_target"; return 0 ;;
            esac
            ;;
    esac
    if [ -e "$bk_target" ]; then
        bk_copy="$bk_target.bak-$(timestamp)"
        cp -a "$bk_target" "$bk_copy" || return 1
        say "  kept a copy of $(basename "$bk_target") beside it"
    fi
    prune_backups "$bk_target"
    return 0
}

# How many .bak copies beside one file are kept; older ones go.
BACKUPS_KEPT=3

# prune_backups <file> — tidies the .bak copies beside a file. A copy of a
# wrapper tlstore wrote itself was never yours (an older tlstore kept one on
# every update), so it goes; of the rest, the newest BACKUPS_KEPT stay. The
# names carry the time, so the glob lists them oldest first.
prune_backups() {
    pb_target="$1"
    pb_count=0
    for pb_f in "$pb_target".bak-*; do
        [ -f "$pb_f" ] || continue
        if [ "$(head -c 200 "$pb_f" | sed -n 2p)" = "# written by termux-launcher" ]; then
            rm -f "$pb_f"
        else
            pb_count=$((pb_count + 1))
        fi
    done
    for pb_f in "$pb_target".bak-*; do
        [ "$pb_count" -gt "$BACKUPS_KEPT" ] || break
        [ -f "$pb_f" ] || continue
        rm -f "$pb_f"
        pb_count=$((pb_count - 1))
    done
}

# The newest .bak beside a file, put back in its place.
restore_backup() {
    rb_target="$1"
    prune_backups "$rb_target"
    rb_newest=""
    for rb_f in "$rb_target".bak-*; do
        [ -e "$rb_f" ] || continue
        rb_newest="$rb_f"
    done
    [ -n "$rb_newest" ] || return 1
    mv "$rb_newest" "$rb_target" || return 1
    return 0
}

# download <url> <destination> <sha256 or -> — CANCEL_TMP tracks the part
# file while it is being written, so on_cancel can drop it if a SIGTERM lands
# mid-download; nothing here is left behind once the function returns, either
# way, since every exit path clears it again. The part file carries this
# process's pid, so two tlstores fetching the same file at once (a prefetch
# lane and an item opened early) never write over each other: each verifies
# its own copy and the last mv wins, whole. A payload can be hundreds of
# megabytes on a slow link, so the timeout is on a stall (nothing for 30 s)
# rather than on the whole transfer.
download() {
    dl_url="$1"
    dl_dest="$2"
    dl_expect="$3"
    dl_dir=$(dirname "$dl_dest")
    mkdir -p "$dl_dir" || return 1
    dl_tmp="$dl_dir/.$(basename "$dl_dest").$$.part"
    CANCEL_TMP="$dl_tmp"
    if ! curl_to "$dl_url" "$dl_tmp"; then
        rm -f "$dl_tmp"
        CANCEL_TMP=""
        err "could not download $(basename "$dl_dest")"
        return 1
    fi
    if [ "$dl_expect" != "-" ] && [ -n "$dl_expect" ]; then
        progress_stage 60 "signature checked"
        dl_actual=$(file_digest "$dl_tmp")
        if [ -z "$dl_actual" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "cannot check what was downloaded — install coreutils and try again"
            return 1
        fi
        if [ "$dl_actual" != "$dl_expect" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "$(basename "$dl_dest") does not match what the list expects — nothing was installed"
            return 1
        fi
    fi
    [ "$DL_STAGE" = 1 ] || progress_stage 90 "putting files in place"
    mv "$dl_tmp" "$dl_dest" || { CANCEL_TMP=""; return 1; }
    CANCEL_TMP=""
    return 0
}

# payload_to <url> <destination> <sha256 or -> — an item's payload, put at the
# destination: the copy plan_apply's fetch phase already downloaded and checked
# for ii_name when this run staged one, otherwise a download as before (a
# rollback, which installs straight through install_item, always downloads).
# The staged copy goes the way a download does: beside the destination as a
# part file first, then one mv, so the destination is never seen half written.
payload_to() {
    pt_staged="$STAGE_DIR/${ii_name:-}"
    if [ "$PA_STAGING" != 1 ] || ! in_list "$PA_STAGED" "${ii_name:-}" || [ ! -f "$pt_staged" ]; then
        download "$1" "$2" "$3"
        return
    fi
    pt_dir=$(dirname "$2")
    mkdir -p "$pt_dir" || return 1
    pt_tmp="$pt_dir/.$(basename "$2").$$.part"
    CANCEL_TMP="$pt_tmp"
    if ! mv "$pt_staged" "$pt_tmp"; then
        rm -f "$pt_tmp"
        CANCEL_TMP=""
        err "could not put $(basename "$2") in place"
        return 1
    fi
    progress_stage 90 "putting files in place"
    mv "$pt_tmp" "$2" || { rm -f "$pt_tmp"; CANCEL_TMP=""; return 1; }
    CANCEL_TMP=""
    return 0
}

# Is someone there to answer a question?
interactive() {
    [ "$ASSUME_TTY" = 1 ] && return 0
    [ -t 0 ]
}

# A full-screen view needs a real terminal at both ends, whatever the knob says.
on_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

# How wide the terminal is; 80 when nothing here will say.
term_cols() {
    tc_n="${COLUMNS:-}"
    case "$tc_n" in
        ''|*[!0-9]*) tc_n="" ;;
    esac
    if [ -z "$tc_n" ] && have tput; then
        tc_n=$(tput cols 2>/dev/null || printf '')
        case "$tc_n" in
            ''|*[!0-9]*) tc_n="" ;;
        esac
    fi
    { [ -n "$tc_n" ] && [ "$tc_n" -gt 0 ]; } || tc_n=80
    printf '%s' "$tc_n"
}

yes_reply() {
    case "$1" in
        y|Y|yes|YES) return 0 ;;
    esac
    return 1
}

# A question that goes ahead unless you say no. -y answers it.
ask_yn() {
    [ "$ASSUME_YES" = 1 ] && return 0
    status_clear
    printf '%s [Y/n] ' "$1"
    read -r ay_answer || ay_answer=""
    [ -n "$ay_answer" ] || ay_answer=y
    yes_reply "$ay_answer"
}

# A question that does nothing unless you say yes. -y answers it; with nobody
# there to ask, the answer is no.
ask_ny() {
    [ "$ASSUME_YES" = 1 ] && return 0
    interactive || return 1
    status_clear
    printf '%s [y/N] ' "$1"
    read -r an_answer || an_answer=""
    yes_reply "$an_answer"
}

# Two files with the same contents.
same_file() {
    if have cmp; then
        cmp -s "$1" "$2"
        return $?
    fi
    sf_a=$(file_digest "$1")
    sf_b=$(file_digest "$2")
    [ -n "$sf_a" ] && [ "$sf_a" = "$sf_b" ]
}

# pm_run <command...> — run the package manager. Inside a --progress job, for
# the job's own item, what it prints is turned into step lines, since pkg, apt
# and pacman draw no progress bar a pipe can carry: each download line moves
# the bar a third of the way on towards the checksum step, the integrity check
# and the unpacking move it past that, and everything it says goes to stderr so
# stdout stays the machine stream.
pm_run() {
    if styled; then
        pm_styled "$@"
        return
    fi
    if [ "$PROGRESS" != 1 ]; then
        "$@"
        return
    fi
    # No item to give the steps to (only build tools to fetch): what it says
    # still stays off stdout, which is the machine stream.
    if [ -z "$CANCEL_ITEM" ]; then
        "$@" >&2
        return
    fi
    mkdir -p "$CACHE_DIR"
    pr_rc="$CACHE_DIR/pm.rc"
    # As in curl_to, the exit status comes back through a file; so does the
    # last percentage reported, so progress_stage never steps back behind it.
    { "$@" 2>&1; echo "$?" > "$pr_rc"; } |
        tr '\r' '\n' |
        awk -v name="$CANCEL_ITEM" -v from="$PROGRESS_AT" -v to="$PROGRESS_FETCH_END" -v atf="$pr_rc.at" '
            function step(v, w) {
                if (v > last) { last = v; printf "step\t%s\t%d\t%s\n", name, v, w; fflush() }
            }
            BEGIN { last = from; at = from }
            { print | "cat 1>&2" }
            /^(Get|Hit):[0-9]/ || /downloading/ || /^:: (Synchronizing|Retrieving)/ {
                at += (to - at) / 3; step(int(at), "fetched"); next
            }
            /^Fetched / || /checking (package integrity|keys)/ { step(60, "signature checked"); next }
            /^(Preparing to unpack|Unpacking) / || /^\([0-9]+\/[0-9]+\) (installing|upgrading) / {
                step(75, "putting files in place"); next
            }
            /^Setting up / || /^:: Running post-transaction/ { step(85, "putting files in place") }
            END { print last > atf }'
    pr_status=$(cat "$pr_rc" 2>/dev/null || echo 1)
    PROGRESS_AT=$(cat "$pr_rc.at" 2>/dev/null || echo "$PROGRESS_AT")
    rm -f "$pr_rc" "$pr_rc.at"
    [ "$pr_status" = 0 ]
}

# pm_styled <command...> — pm_run on a styled terminal: what the package
# manager says goes to PM_LOG (emptied by the run's first call, added to by the
# rest), and the status line counts its packages as it goes. Its input is
# empty, since a question it asked would be hidden in the log; on a failure the
# last lines are shown, and where the rest is. The one question dpkg asks on
# its own, about a package's config file the person changed, is answered
# ahead through DPKG_FORCE: keep theirs, or take the default where there is
# one; with empty input it would fail the install instead. pacman never asks.
PM_LOG="$CACHE_DIR/last-update.log"
PM_LOGGED=0
pm_styled() {
    mkdir -p "$CACHE_DIR"
    [ "$PM_LOGGED" = 1 ] || : > "$PM_LOG"
    PM_LOGGED=1
    pms_rc="$CACHE_DIR/pm.rc"
    status "Installing Termux packages" "$I_PKG"
    pms_head=$(status_text "$I_PKG" "Installing Termux packages" 30)
    { DPKG_FORCE=confdef,confold "$@" < /dev/null 2>&1; echo "$?" > "$pms_rc"; } |
        tr '\r' '\n' |
        awk -v lf="$PM_LOG" -v head="$pms_head" -v esc="$ESC" '
            function show(w) {
                if (w == shown) return
                shown = w
                printf "\r%s[K%s · %s", esc, head, substr(w, 1, 24); fflush()
            }
            { print >> lf }
            match($0, /^\([0-9]+\/[0-9]+\)/) { split(substr($0, 2, RLENGTH - 2), n, "/"); show(n[1] " of " n[2]); next }
            /^(Unpacking|Setting up) / { show($2) }'
    pms_status=$(cat "$pms_rc" 2>/dev/null || echo 1)
    rm -f "$pms_rc"
    STATUS_ON=1
    [ "$pms_status" = 0 ] && return 0
    status_clear
    tail -n 10 "$PM_LOG" | sed "s/^/  $C_DIM/; s/\$/$C_OFF/"
    printf '  %s\n' "The package manager stopped. Everything it said is in ~/${PM_LOG#"$HOME"/}"
    return 1
}

# -Sy as Termux's own pkg does on pacman: a fresh bootstrap has never synced its
# package lists, and a plain -S finds nothing in them ("target not found").
install_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pm_run pacman -Sy --needed --noconfirm $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pm_run pkg install -y $@
    else
        err "no package manager here — cannot install $*"
        return 1
    fi
}

upgrade_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pm_run pacman -Sy --needed --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        pm_run apt-get install -y -qq --only-upgrade $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pm_run pkg install -y $@
    else
        err "no package manager here — cannot update $*"
        return 1
    fi
}

remove_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pacman -R --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        apt remove -y $@
    else
        return 1
    fi
}

pkg_present() {
    if have pacman; then
        pacman -Q "$1" >/dev/null 2>&1
    elif have dpkg; then
        dpkg -s "$1" >/dev/null 2>&1
    else
        have "$1"
    fi
}

# Is this package really installed? Like pkg_present, but on a dpkg host a package that was
# removed and left only its config files behind ("rc") does not count — apt's own view of it.
conflict_present() {
    if have pacman || ! have dpkg-query; then
        pkg_present "$1"
    else
        # shellcheck disable=SC2016  # dpkg-query's format, not a shell expansion
        [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ]
    fi
}

# conflict_check <name> — an item with conflicts=<packages> owns commands a package also owns,
# so it is refused (return 1, saying which package to remove) while one of them is installed,
# rather than shadowing or overwriting what that package put there.
conflict_check() {
    cc_list=$(opt "$(field "$(row "$1")" 9)" conflicts)
    [ -n "$cc_list" ] || return 0
    for cc_p in $(commas "$cc_list"); do
        if conflict_present "$cc_p"; then
            err "$1 cannot be installed while the $cc_p package is: both provide the same commands. Remove it first (pkg uninstall $cc_p), then install $1 again."
            PROGRESS_NOTE="remove the $cc_p package first"
            return 1
        fi
    done
    return 0
}

# pkg_refresh — the package lists, read again: after a package that adds a package source
# (repo=1, Revision 15), so the next call knows what that source offers. Termux's own pkg
# refreshes only when its main list is old, which a source added a moment ago never is. On
# pacman the plan's next call is a -Sy, which is the refresh.
pkg_refresh() {
    if have pacman; then
        return 0
    elif have apt-get; then
        pm_run apt-get update
    else
        return 1
    fi
}

# ---------------------------------------------------------------------------
# What Termux packages take (Revision 15)
# ---------------------------------------------------------------------------

# Above this many MB, to download or to keep, a plan says what its Termux packages take before
# it asks to go ahead, and an item page shows its pkg-size= sentence. Below it nothing changes.
WEIGH_ASK_MB=50

# weigh_parse — apt-get's install output on stdin, in the C locale; prints "<download MB>
# <disk MB>" when it said what it would fetch, nothing when it did not. apt 2 says "Need to get
# 1234 kB/75.3 MB of archives." (the first figure is what is not in its cache yet) and "After
# this operation, 414 MB of additional disk space will be used." (or "freed", which is 0 here);
# apt 3 says "Download size: …" and "Space needed: …" instead. Sizes are decimal, as apt's are.
weigh_parse() {
    awk '
        function bytes(n, u) {
            gsub(",", "", n)
            sub("/.*", "", u)
            n += 0
            if (u == "kB") return n * 1000
            if (u == "MB") return n * 1000000
            if (u == "GB") return n * 1000000000
            if (u == "TB") return n * 1000000000000
            return n
        }
        function mb(b) { return int(b / 1000000 + 0.5) }
        /^Need to get / { dl = bytes($4, $5); seen = 1; next }
        /^ *Download size: / { sub(/^ *Download size: /, ""); dl = bytes($1, $2); seen = 1; next }
        /^After this operation, .* be used/ { disk = bytes($4, $5); seen = 1; next }
        /^ *Space needed: / { sub(/^ *Space needed: /, ""); disk = bytes($1, $2); seen = 1; next }
        END { if (seen) printf "%d %d\n", mb(dl), mb(disk) }'
}

# weigh_apt <packages> — what apt says this phone still needs for them: wa_dl and wa_disk, in
# MB, both 0 when nothing is missing. --print-uris keeps it from ever installing: apt asks
# before it installs more than the names it was given, and --assume-no answers that; with
# nothing more to add it would install without asking, and --print-uris stops it there and
# only prints addresses. Returns 1 when apt is not the package manager here or cannot work it
# out (a package no source it reads has yet, such as one from a source the plan adds first).
weigh_apt() {
    wa_dl=0
    wa_disk=0
    ! have pacman || return 1
    have apt-get || return 1
    wa_out=$(LC_ALL=C apt-get install --print-uris --assume-no -q "$@" 2>&1)
    wa_rc=$?
    wa_sizes=$(printf '%s\n' "$wa_out" | weigh_parse)
    if [ -n "$wa_sizes" ]; then
        wa_dl="${wa_sizes% *}"
        wa_disk="${wa_sizes#* }"
        return 0
    fi
    [ "$wa_rc" = 0 ]
}

# item_weight <options> — an item's pkg-size=<download MB>,<disk MB> and pkg-what=<words>:
# what the Termux packages it pulls in (its own and its parts') take on a stock Termux, as
# scripts/pkg-weight.py computes it. Sets iw_dl, iw_disk and iw_what; returns 1 without a
# usable pkg-size.
item_weight() {
    iw_v=$(opt "$1" pkg-size)
    case "$iw_v" in
        *[!0-9,]*|*,*,*|,*|*,|0[0-9]*|*,0[0-9]*) return 1 ;;
        *,*) ;;
        *) return 1 ;;
    esac
    iw_dl="${iw_v%,*}"
    iw_disk="${iw_v#*,}"
    iw_what=$(opt "$1" pkg-what)
    [ -n "$iw_what" ] || iw_what="packages from Termux"
    return 0
}

# weight_sentence <what> <download MB> <disk MB> — the line an item page shows before install,
# and what a plan says when apt cannot tell it more. snapshot_rows writes the same words in awk.
weight_sentence() {
    printf 'Also installs %s: about %s MB to download, %s MB on disk (less if you already have some of them).' \
        "$1" "$2" "$3"
}

# heavy <download MB> <disk MB> — more than WEIGH_ASK_MB of either.
heavy() {
    [ "$1" -gt "$WEIGH_ASK_MB" ] || [ "$2" -gt "$WEIGH_ASK_MB" ]
}

# ---------------------------------------------------------------------------
# Lists of names (space separated; names are [a-z0-9-]+ so words are safe)
# ---------------------------------------------------------------------------

in_list() {
    case " $1 " in
        *" $2 "*) return 0 ;;
    esac
    return 1
}

# The item and everything it needs, in the order they have to be installed.
plan_for() {
    pf_closure=""
    pf_todo="$*"
    while [ -n "$pf_todo" ]; do
        pf_next=""
        for pf_n in $pf_todo; do
            in_list "$pf_closure" "$pf_n" && continue
            if retired_item "$pf_n"; then
                err "$pf_n was retired"
                return 1
            fi
            pf_closure="$pf_closure $pf_n"
            pf_deps=$(item_deps "$pf_n")
            pf_next="$pf_next $pf_deps"
        done
        pf_todo="$pf_next"
    done
    plan_order "$pf_closure"
    printf '%s' "$po_out"
}

# What a name needs installed before it.
item_deps() {
    id_row=$(row "$1")
    [ -n "$id_row" ] || return 0
    id_req=$(commas "$(field "$id_row" 8)")
    [ "$id_req" = "-" ] && id_req=""
    printf '%s' "$id_req"
}

# A map is " key=value key=value " in one variable (names and the values kept
# in one are free of spaces). map_get <map> <key> sets mg_v and says whether
# the key was there.
map_get() {
    case "$1" in
        *" $2="*)
            mg_v="${1#* "$2"=}"
            mg_v="${mg_v%% *}"
            return 0
            ;;
    esac
    mg_v=""
    return 1
}

# What one run has read of the catalog, a row per name at most: its kind (-
# when it has no row here), version, requires (commas) and flags (h hidden,
# r retired).
PB_KIND=" "
PB_VER=" "
PB_DEPS=" "
PB_FLAGS=" "

# pb_row <name> — sets prw_kind, prw_ver, prw_deps (commas) and prw_flags.
pb_row() {
    if map_get "$PB_KIND" "$1"; then
        prw_kind="$mg_v"
        map_get "$PB_VER" "$1"; prw_ver="$mg_v"
        map_get "$PB_DEPS" "$1"; prw_deps="$mg_v"
        map_get "$PB_FLAGS" "$1"; prw_flags="$mg_v"
        return 0
    fi
    prw_kind="-"; prw_ver="-"; prw_deps=""; prw_flags=""
    if [ -n "$CATALOG" ] && load_item "$1"; then
        prw_kind="$it_kind"
        prw_ver="${it_version:--}"
        [ "$it_requires" = "-" ] || prw_deps="$it_requires"
        case ";$it_options;" in *";hidden=1;"*) prw_flags="h" ;; esac
        case ";$it_options;" in *";retired=1;"*) prw_flags="${prw_flags}r" ;; esac
    fi
    PB_KIND="$PB_KIND$1=$prw_kind "
    PB_VER="$PB_VER$1=$prw_ver "
    PB_DEPS="$PB_DEPS$1=$prw_deps "
    PB_FLAGS="$PB_FLAGS$1=$prw_flags "
}

# plan_order <names> — the same names in the order they have to be installed:
# each after whatever of the others it requires. Sets po_out. A loop (which
# the catalog never has) keeps the order it was given.
plan_order() {
    po_out=""
    po_left="$1"
    while :; do
        po_moved=0
        po_rest=""
        for po_n in $po_left; do
            pb_row "$po_n"
            po_ready=1
            for po_d in $(commas "$prw_deps"); do
                in_list "$1" "$po_d" || continue
                in_list "$po_out" "$po_d" || { po_ready=0; break; }
            done
            if [ "$po_ready" = 1 ]; then
                po_out="$po_out $po_n"
                po_moved=1
            else
                po_rest="$po_rest $po_n"
            fi
        done
        [ -n "$po_rest" ] || break
        if [ "$po_moved" = 0 ]; then
            po_out="$po_out$po_rest"
            break
        fi
        po_left="$po_rest"
    done
    po_out="${po_out# }"
}

# ---------------------------------------------------------------------------
# Tools that are only needed while installing
# ---------------------------------------------------------------------------

# Is this item already here in the version the list offers?
already_here() {
    ah_row=$(row "$1")
    [ -n "$ah_row" ] || return 1
    is_installed "$1" || return 1
    case "$(field "$ah_row" 2)" in
        # A package counts only while it is really there: one taken away behind
        # tlstore's back (pkg uninstall) is still in the state, and trusting that
        # would skip it on every install from then on.
        pkg)
            for ah_p in $(field "$ah_row" 5); do
                pkg_present "$ah_p" || return 1
            done
            return 0
            ;;
        # A bundle's own step is never skipped: it is cheap, and login-shell=
        # has to happen again when the shell was changed or not there last time.
        bundle) return 1 ;;
        fisher) return 0 ;;
    esac
    [ "$(installed_version "$1")" = "$(field "$ah_row" 3)" ]
}

# build_tools_for <names> <force> — the build= packages the plan will really
# need, each named once. Nothing is fetched for an item that is already here.
build_tools_for() {
    bt_out=""
    for bt_n in $1; do
        bt_row=$(row "$bt_n")
        [ -n "$bt_row" ] || continue
        if [ "$2" = 0 ] && already_here "$bt_n"; then
            continue
        fi
        for bt_p in $(commas "$(opt "$(field "$bt_row" 9)" build)"); do
            [ "$bt_p" = "-" ] && continue
            in_list "$bt_out" "$bt_p" || bt_out="$bt_out $bt_p"
        done
    done
    printf '%s' "$bt_out" | sed 's/^ *//'
}

# The ones that were not here are installed by plan_packages, in the plan's
# one package-manager call, and remembered in BUILD_ADDED so they can be
# offered back afterwards.
drop_build_tools() {
    db_pkgs=$(printf '%s' "$BUILD_ADDED" | sed 's/^ *//')
    BUILD_ADDED=""
    [ -n "$db_pkgs" ] || return 0
    ask_ny "Remove the tools that were only needed for installing ($(words_list "$db_pkgs"))?" || return 0
    # shellcheck disable=SC2086
    remove_pkg $db_pkgs >/dev/null 2>&1 || true
    # What was downloaded to build: not the pictures and readmes tlstore-ui
    # keeps (see "The asset cache" below), which stay until an item moves on.
    for db_f in "${CACHE_DIR:?}"/*; do
        [ -e "$db_f" ] || continue
        case "${db_f##*/}" in
            pictures|readme|snapshot.tsv|last-update.log) ;;
            *) rm -rf "$db_f" 2>/dev/null || true ;;
        esac
    done
    say "Removed them, and cleared what was downloaded."
    return 0
}

# ---------------------------------------------------------------------------
# Installing
# ---------------------------------------------------------------------------

install_item() {
    ii_name="$1"
    ii_force="${2:-0}"
    # Something with no row here (another edition's build, or a tool not
    # built for this processor) never reaches this point: plan_build marks it
    # unavailable and plan_apply passes it by. Should one arrive anyway, it is
    # not counted as installed.
    load_item "$ii_name" || {
        err "$ii_name is not available on this device"
        return 1
    }
    ii_kind="$it_kind"
    ii_version="$it_version"
    ii_source="$it_source"
    ii_digest="$it_digest"
    ii_target="$it_target"
    ii_options="$it_options"
    # A rollback installs an earlier version in place of the list's: its
    # version, and for a binary, an archive or a file its own source and digest.
    if [ -n "${RB_VERSION:-}" ]; then
        ii_version="$RB_VERSION"
        if [ -n "${RB_SOURCE:-}" ]; then
            ii_source="$RB_SOURCE"
            ii_digest="$RB_DIGEST"
        fi
    fi

    if [ "$ii_force" = 0 ] && already_here "$ii_name"; then
        say "$ii_name is already installed"
        PROGRESS_NOTE="already installed"
        return 0
    fi
    # An installed bundle comes through here every time (already_here never skips one); as in
    # cmd_install, what is already installed is not refused afterwards.
    if [ "$ii_kind" != bundle ] || ! is_installed "$ii_name"; then
        conflict_check "$ii_name" || return 1
    fi

    case "$ii_kind" in
        pkg) do_pkg ;;
        binary) do_binary ;;
        file) do_file 0 ;;
        file-once) do_file 1 ;;
        fisher) do_fisher ;;
        npm-musl) do_npm_musl ;;
        npm-android) do_npm_musl ;;
        archive) do_archive ;;
        skill) do_skill ;;
        bundle) do_bundle ;;
        *) err "$ii_name cannot be installed here"; return 1 ;;
    esac
}

# The package manager already ran, once for the whole plan (plan_packages),
# and plan_apply only comes here when every package of this item is present:
# all that is left is to record it.
do_pkg() {
    state_record "$ii_name" pkg "$ii_version"
}

do_binary() {
    db_targets=$(item_targets "$ii_name" binary "$ii_target" "$ii_source" "$ii_options")
    db_dest="${db_targets%% *}"
    db_mode=$(opt "$ii_options" mode)
    [ -n "$db_mode" ] || db_mode=755
    say "installing $ii_name"
    mkdir -p "$(dirname "$db_dest")"
    backup_existing "$db_dest"
    payload_to "$(source_url "$ii_source")" "$db_dest" "$ii_digest" || return 1
    chmod "$db_mode" "$db_dest"
    if [ "$(opt "$ii_options" priv)" = shizuku ]; then
        # The program stays off PATH. What the user runs is a wrapper that hands
        # it to tl-priv, the client of the launcher's privileged lane, which
        # starts it as the Shizuku shell user. tl-priv is a hidden binary item
        # every such item requires, so it is in BIN_DIR by now.
        db_wrapper="${db_targets#* }"
        mkdir -p "$BIN_DIR"
        backup_existing "$db_wrapper"
        {
            printf '#!%s/bin/sh\n' "$PREFIX"
            printf '# written by termux-launcher\n'
            printf 'exec "%s/tl-priv" run "%s" "$@"\n' "$BIN_DIR" "$db_dest"
        } > "$db_wrapper"
        chmod 755 "$db_wrapper"
        state_record "$ii_name" binary "$ii_version" "$db_dest" "$db_wrapper"
        say "  $db_wrapper"
    else
        state_record "$ii_name" binary "$ii_version" "$db_dest"
        say "  $db_dest"
    fi
    return 0
}

# Asks, on one line, before a config file the person may have changed is
# replaced; d shows the change and asks again. Only --configs answers this for
# you; -y deliberately does not, because a config is the user's own work.
# confirm_replace <current> <new> [edited] — edited is 1 when tlstore knows the
# file is no longer what it wrote, empty when it cannot tell.
confirm_replace() {
    cf_cur="$1"
    cf_new="$2"
    # --progress never opens a prompt tlstore-ui cannot answer: the user's file
    # is always kept, whatever --configs says.
    [ "$PROGRESS" = 1 ] && return 1
    [ "$REPLACE_CONFIGS" = 1 ] && return 0
    interactive || return 1
    cf_show="$cf_cur"
    # shellcheck disable=SC2088  # the ~ is for the person to read
    case "$cf_cur" in "$HOME"/*) cf_show="~/${cf_cur#"$HOME"/}" ;; esac
    cf_ask="Replace your $cf_show with the new one?"
    [ "${3:-}" != 1 ] || cf_ask="You changed $cf_show. Replace it with the new one?"
    cf_mark=""
    ! styled || cf_mark="$C_ASK$I_ASK$C_OFF$GAP"
    while :; do
        status_clear
        printf '%s%s [y/N/d] ' "$cf_mark" "$cf_ask"
        read -r cf_answer || cf_answer=""
        case "$cf_answer" in
            d|D) ;;
            *) yes_reply "$cf_answer"; return ;;
        esac
        if have diff; then
            diff -u "$cf_cur" "$cf_new" || true
        else
            printf '  before:\n'
            head -25 "$cf_cur" | sed 's/^/    /'
            printf '  after:\n'
            head -25 "$cf_new" | sed 's/^/    /'
        fi
    done
}

# do_file <once>
do_file() {
    df_once="$1"
    df_dest=$(item_targets "$ii_name" file "$ii_target")
    if [ -z "$df_dest" ]; then
        err "$ii_name has nowhere to go"
        return 1
    fi
    df_mode=$(opt "$ii_options" mode)
    [ -n "$df_mode" ] || df_mode=644
    if [ "$df_once" = 1 ] && [ -e "$df_dest" ]; then
        say "kept your $(basename "$df_dest") — it is yours to edit"
        PROGRESS_NOTE="kept your $(basename "$df_dest")"
        is_installed "$ii_name" || state_record "$ii_name" file-once "$ii_version"
        return 0
    fi
    # A config file you already have is replaced without a word only while it
    # is still exactly what tlstore last wrote there: the row's digest (column
    # 7) is the sha256 of the payload it put in place, so a match means nobody
    # edited it and there is nothing of yours to keep a copy of. One that
    # differs is yours (edited, or kept when you declined the last one, whose
    # digest the row then holds) and is asked about first; so is one with no
    # digest recorded. It is recorded either way, so declining is not asked
    # again until the shipped file itself moves on.
    if [ "$df_once" = 0 ] && [ -e "$df_dest" ]; then
        mkdir -p "$CACHE_DIR"
        df_new="$CACHE_DIR/$ii_name.new"
        payload_to "$(source_url "$ii_source")" "$df_new" "$ii_digest" || return 1
        if same_file "$df_dest" "$df_new"; then
            rm -f "$df_new"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        df_was=$(field "$(state_row "$ii_name" 2>/dev/null || true)" 7)
        df_have=$(file_digest "$df_dest")
        df_edited=""
        case "$df_was" in
            ''|-) ;;
            "$df_have") df_edited=0 ;;
            *) [ -z "$df_have" ] || df_edited=1 ;;
        esac
        if [ "$df_edited" != 0 ] && ! confirm_replace "$df_dest" "$df_new" "$df_edited"; then
            rm -f "$df_new"
            say "kept your $(basename "$df_dest")"
            PROGRESS_NOTE="kept your $(basename "$df_dest")"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        [ "$df_edited" = 0 ] || backup_existing "$df_dest"
        cp "$df_new" "$df_dest" || return 1
        rm -f "$df_new"
        chmod "$df_mode" "$df_dest"
        state_record "$ii_name" file "$ii_version" "$df_dest"
        say "  $df_dest"
        return 0
    fi
    say "installing $ii_name"
    mkdir -p "$(dirname "$df_dest")"
    backup_existing "$df_dest"
    payload_to "$(source_url "$ii_source")" "$df_dest" "$ii_digest" || return 1
    chmod "$df_mode" "$df_dest"
    if [ "$df_once" = 1 ]; then
        state_record "$ii_name" file-once "$ii_version" "$df_dest"
    else
        state_record "$ii_name" file "$ii_version" "$df_dest"
    fi
    say "  $df_dest"
    return 0
}

# Plugins fish's own plugin manager fetches. Keeping them current is fisher's
# job, not tlstore's, so update never touches them.
do_fisher() {
    if ! have fish; then
        err "$ii_name needs fish — install it first"
        return 1
    fi
    say "installing $ii_name"
    if ! fish -c "fisher install $ii_source" </dev/null; then
        err "could not install $ii_name"
        return 1
    fi
    state_record "$ii_name" fisher "$ii_version"
    return 0
}

do_bundle() {
    # A member that did not install fails the bundle, rather than the bundle
    # standing as installed around it. One with no row here (another edition's,
    # or not built for this processor), or one the plan found unavailable for
    # that reason further down, was skipped on purpose and does not count.
    db_missing=""
    for db_m in $(commas "$(field "$(row "$ii_name")" 8)"); do
        [ "$db_m" = "-" ] && continue
        [ -n "$(row "$db_m")" ] || continue
        in_list "$PLAN_UNAVAILABLE" "$db_m" && continue
        is_installed "$db_m" || db_missing="$db_missing $db_m"
    done
    if [ -n "$db_missing" ]; then
        err "$ii_name is not complete: $(words_list "${db_missing# }") did not install"
        return 1
    fi
    state_record "$ii_name" bundle "$ii_version"
    db_shell=$(opt "$ii_options" login-shell)
    [ -n "$db_shell" ] && set_login_shell "$ii_name" "$db_shell"
    return 0
}

# set_login_shell <item> <shell> — a bundle with login-shell=<shell> makes that shell the one new
# sessions start in, through Termux's own chsh (the ~/.termux/shell symlink the app follows). A
# shell that is not there, or a chsh that is not, is said and leaves the install standing: the
# bundle's files are in place either way, and the hint is the one command the person would run.
set_login_shell() {
    sls_item="$1"
    sls_shell="$2"
    # The note is what tlstore-ui shows on the item's closing line; err alone
    # goes to a stderr the store does not show.
    if ! have "$sls_shell"; then
        err "$sls_item could not make $sls_shell your login shell: $sls_shell is not installed"
        PROGRESS_NOTE="$sls_shell is not installed, so it is not your login shell"
        return 0
    fi
    if ! have chsh; then
        err "$sls_item could not make $sls_shell your login shell: chsh is missing. Run: chsh -s $sls_shell"
        PROGRESS_NOTE="installed; run chsh -s $sls_shell to start sessions in it"
        return 0
    fi
    if chsh -s "$sls_shell" </dev/null >/dev/null 2>&1; then
        say "$sls_shell is now your login shell: new sessions start in it"
        PROGRESS_NOTE="new sessions start in $sls_shell"
    else
        err "$sls_item could not make $sls_shell your login shell. Run: chsh -s $sls_shell"
        PROGRESS_NOTE="installed; run chsh -s $sls_shell to start sessions in it"
    fi
    return 0
}

# unset_login_shell <shell> — the way back out: when ~/.termux/shell still points at <shell>, the
# symlink goes and sessions start in the default shell again. A link to anything else is the
# person's own choice and is left alone.
unset_login_shell() {
    uls_link="$HOME/.termux/shell"
    [ -L "$uls_link" ] || return 0
    uls_to=$(readlink "$uls_link" 2>/dev/null || true)
    [ "$(basename "$uls_to")" = "$1" ] || return 0
    rm -f "$uls_link"
    say "  new sessions start in the default shell again"
    return 0
}

# Reads one string field out of a single-line npm registry document.
json_field() {
    tr -d '\n' | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1
}

# npm_latest_version <npm:package#exe> — the version the registry's latest
# dist-tag points at now, or nothing when it cannot be reached.
npm_latest_version() {
    nl_package="${1#npm:}"
    nl_package="${nl_package%#*}"
    curl -fsSL --connect-timeout 5 --max-time 60 "$NPM_REGISTRY/$nl_package/latest" 2>/dev/null | json_field version
}

# np_runtime_refresh <installed> <copy> <mode> — replaces an npm-musl
# program's copy of a musl part when the installed part differs. The copy is
# renamed into place, never written over: a running program has it mapped.
np_runtime_refresh() {
    [ -f "$1" ] || return 0
    [ "$(file_digest "$1")" != "$(file_digest "$2" 2>/dev/null)" ] || return 0
    if cp -f "$1" "$2.new" && chmod "$3" "$2.new" && mv -f "$2.new" "$2"; then
        say "  updated its copy of ${2##*/}"
        return 0
    fi
    rm -f "$2.new"
    err "could not update ${2##*/} beside $ii_name"
    return 1
}

# do_npm_musl installs both npm kinds. npm-musl is a musl binary that needs
# our loader and a patchelf pass; npm-android is a Bionic executable that runs
# as it is, so it skips the loader, the musl libraries and patchelf.
do_npm_musl() {
    np_package="${ii_source#npm:}"
    np_exe="${np_package##*#}"
    np_package="${np_package%#*}"
    np_dir=$(item_targets "$ii_name" "$ii_kind" "$ii_target" "$ii_source" "$ii_options")
    np_wrapper="${np_dir##* }"
    np_dir="${np_dir%% *}"

    for np_tool in curl tar sha512sum base64 od; do
        have "$np_tool" || { err "$np_tool is missing — install coreutils and tar"; return 1; }
    done
    np_loader_row=""
    if [ "$ii_kind" = npm-musl ]; then
        have "$PATCHELF" || { err "patchelf is missing — install it and try again"; return 1; }
        np_loader_row=$(row musl-loader)
        if [ -z "$np_loader_row" ]; then
            err "$ii_name has no loader for this device"
            return 1
        fi
    fi

    say "installing $ii_name"
    np_want="${ii_version:-latest}"
    if [ "$np_want" = latest ]; then
        status "Asking npm for $ii_name's latest version"
    else
        status "Asking npm for $ii_name $np_want"
    fi
    np_meta=$(curl -fsSL --connect-timeout 5 --max-time 60 "$NPM_REGISTRY/$np_package/$np_want") || {
        err "could not reach the $ii_name download"
        return 1
    }
    np_version=$(printf '%s' "$np_meta" | json_field version)
    np_tarball=$(printf '%s' "$np_meta" | json_field tarball)
    np_integrity=$(printf '%s' "$np_meta" | json_field integrity)
    case "$np_integrity" in
        sha512-*) ;;
        *) err "$ii_name came without a checksum — nothing was installed"; return 1 ;;
    esac
    np_expect=$(printf '%s' "${np_integrity#sha512-}" | base64 -d | od -An -v -tx1 | tr -d ' \n')

    # An npm-musl copy patched before the rpath-first marker may be one that
    # segfaults (see the patchelf calls below), so it is not counted as here.
    if [ -x "$np_dir/$np_exe" ] && [ "$(cat "$np_dir/version" 2>/dev/null)" = "$np_version" ] &&
        { [ "$ii_kind" != npm-musl ] || [ -e "$np_dir/rpath-first" ]; }; then
        say "  $ii_name $np_version is already here"
        # Its loader and libraries are copies taken when it was unpacked; a
        # rebuilt musl-loader (updated first, as a part this needs) reaches
        # the program here rather than with its next version.
        if [ "$ii_kind" = npm-musl ]; then
            np_runtime_refresh "$(item_targets musl-loader binary "$(field "$np_loader_row" 7)")" \
                "$np_dir/ld-musl-$ARCH.so.1" 755 || return 1
            for np_lib in $(commas "$(opt "$ii_options" musl-libs)"); do
                np_lib_row=$(row "$np_lib")
                [ -n "$np_lib_row" ] || continue
                np_lib_have=$(item_targets "$np_lib" binary "$(field "$np_lib_row" 7)")
                np_runtime_refresh "$np_lib_have" "$np_dir/${np_lib_have##*/}" 644 || return 1
            done
        fi
    else
        say "  downloading $ii_name $np_version"
        mkdir -p "$(dirname "$np_dir")"
        np_tmp="$CACHE_DIR/$ii_name.tgz"
        mkdir -p "$CACHE_DIR"
        CANCEL_TMP="$np_tmp"
        DL_WHAT="$ii_name $np_version"
        curl_to "$np_tarball" "$np_tmp" || { rm -f "$np_tmp"; CANCEL_TMP=""; DL_WHAT=""; err "could not download $ii_name"; return 1; }
        DL_WHAT=""
        np_actual=$(sha512sum "$np_tmp" | cut -d' ' -f1)
        if [ "$np_actual" != "$np_expect" ]; then
            rm -f "$np_tmp"
            CANCEL_TMP=""
            err "$ii_name does not match its checksum — nothing was installed"
            return 1
        fi
        CANCEL_TMP=""
        rm -rf "$np_dir.new"
        mkdir -p "$np_dir.new"
        CANCEL_EXTRA="$np_dir.new"
        if ! tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 "package/$np_exe"; then
            rm -f "$np_tmp"
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            err "the $ii_name download is not what was expected"
            return 1
        fi
        # extra=<path,path>: more members of the package, unpacked beside the
        # executable under their package paths. A missing one fails the
        # install just as a missing executable does.
        for np_more in $(commas "$(opt "$ii_options" extra)"); do
            if ! tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 "package/$np_more"; then
                rm -f "$np_tmp"
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                err "the $ii_name download is not what was expected"
                return 1
            fi
            chmod 755 "$np_dir.new/$np_more"
        done
        for np_licence in LICENSE.md LICENSE NOTICE; do
            tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 "package/$np_licence" 2>/dev/null || true
        done
        rm -f "$np_tmp"
        chmod 755 "$np_dir.new/$np_exe"

        if [ "$ii_kind" = npm-musl ]; then
            np_loader="$np_dir.new/ld-musl-$ARCH.so.1"
            np_have_loader=$(item_targets musl-loader binary "$(field "$np_loader_row" 7)")
            if [ -f "$np_have_loader" ]; then
                cp -f "$np_have_loader" "$np_loader"
            elif ! download "$(source_url "$(field "$np_loader_row" 5)")" "$np_loader" "$(field "$np_loader_row" 6)"; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                return 1
            fi
            chmod 755 "$np_loader"

            # Some of these binaries need more of the musl world than its libc —
            # opencode links libstdc++ and libgcc_s, and Termux's own are Bionic
            # ones the musl loader cannot use. They go in beside the loader,
            # because the rpath set below is this directory and nothing else.
            for np_lib in $(commas "$(opt "$ii_options" musl-libs)"); do
                np_lib_row=$(row "$np_lib")
                if [ -z "$np_lib_row" ]; then
                    rm -rf "$np_dir.new"
                    CANCEL_EXTRA=""
                    err "$ii_name has no $np_lib for this device"
                    return 1
                fi
                np_lib_have=$(item_targets "$np_lib" binary "$(field "$np_lib_row" 7)")
                np_lib_dest="$np_dir.new/${np_lib_have##*/}"
                if [ -f "$np_lib_have" ]; then
                    cp -f "$np_lib_have" "$np_lib_dest"
                elif ! download "$(source_url "$(field "$np_lib_row" 5)")" "$np_lib_dest" "$(field "$np_lib_row" 6)"; then
                    rm -rf "$np_dir.new"
                    CANCEL_EXTRA=""
                    return 1
                fi
                chmod 644 "$np_lib_dest"
            done

            # Two calls, the rpath first. Termux's patchelf 0.19.2, given both
            # at once or the interpreter first, grows the headers into a new
            # RW LOAD that overlaps the next, read-only one; .dynamic lands in
            # the read-only mapping and the loader segfaults writing to it.
            if ! "$PATCHELF" --set-rpath "$np_dir" "$np_dir.new/$np_exe" ||
                ! "$PATCHELF" --set-interpreter "$np_dir/ld-musl-$ARCH.so.1" "$np_dir.new/$np_exe"; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                err "could not prepare $ii_name for this device"
                return 1
            fi
            : > "$np_dir.new/rpath-first"
        fi
        printf '%s\n' "$np_version" > "$np_dir.new/version"
        CANCEL_EXTRA=""
        rm -rf "$np_dir.old"
        [ ! -e "$np_dir" ] || mv "$np_dir" "$np_dir.old"
        mv "$np_dir.new" "$np_dir"
        rm -rf "$np_dir.old"
    fi

    wrapper_write "$np_wrapper" "$np_dir/$np_exe" || return 1
    state_record "$ii_name" "$ii_kind" "$np_version" "$np_dir" "$np_wrapper"
    say "  $np_wrapper"
    return 0
}

# wrapper_write <wrapper> <program> — the command on PATH for an item that
# lives in a directory of its own (the npm kinds, an archive): it exports what
# env= names, sets TZ for tz=1, and execs the program with args= in front of
# the person's own arguments. What was at <wrapper> before is kept as a .bak
# unless this item wrote it (backup_existing). Reads ii_options. It is written
# beside <wrapper> and moved over it: what is there may be a program that is
# still running (a binary item that became an archive, its server still up),
# which cannot be opened for writing ("Text file busy") but can be replaced.
wrapper_write() {
    mkdir -p "$BIN_DIR"
    backup_existing "$1"
    ww_envs=$(commas "$(opt "$ii_options" env)")
    ww_tmp="$(dirname "$1")/.$(basename "$1").$$.part"
    {
        printf '#!%s/bin/sh\n' "$PREFIX"
        printf '# written by termux-launcher\n'
        for ww_e in $ww_envs; do
            printf 'export %s\n' "$ww_e"
        done
        if [ "$(opt "$ii_options" tz)" = 1 ]; then
            # shellcheck disable=SC2016  # written into the wrapper, expanded there
            printf '%s\n' '[ -n "${TZ:-}" ] || TZ=$(getprop persist.sys.timezone 2>/dev/null) && export TZ'
        fi
        # args=<words> go in unquoted, before the person's own arguments.
        ww_args=$(opt "$ii_options" args)
        if [ -n "$ww_args" ]; then
            printf 'exec "%s" %s "$@"\n' "$2" "$ww_args"
        else
            printf 'exec "%s" "$@"\n' "$2"
        fi
    } > "$ww_tmp" || { rm -f "$ww_tmp"; err "could not write $1"; return 1; }
    chmod 755 "$ww_tmp"
    mv -f "$ww_tmp" "$1" || { rm -f "$ww_tmp"; err "could not put $1 in place"; return 1; }
}

# do_archive — an app that is a whole directory (an Electron app's tree, say),
# shipped as one pinned .tar.gz whose top level is the app's root (packed with
# `tar czf <asset> -C <app> .`; nothing is stripped). The payload is the one
# plan_apply fetched and checked against the row's digest, or a download for a
# rollback. It unpacks beside the directory as <dir>.new, must hold exe=<path
# inside it> as an executable file, and only then replaces the directory whole:
# the directory is the store's, and anything changed inside it goes with the
# next update. The wrapper on PATH execs that program.
do_archive() {
    da_dir=$(item_targets "$ii_name" archive "$ii_target" "$ii_source" "$ii_options")
    da_wrapper="${da_dir##* }"
    da_dir="${da_dir%% *}"
    da_exe=$(opt "$ii_options" exe)
    case "$da_exe" in
        ''|/*|..|../*|*/..|*/../*)
            err "$ii_name does not say which program in it to run"
            return 1
            ;;
    esac
    case "$ii_digest" in
        ''|-) err "$ii_name came without a checksum — nothing was installed"; return 1 ;;
    esac
    have tar || { err "tar is missing — install it and try again"; return 1; }

    say "installing $ii_name"
    da_tgz="$CACHE_DIR/$ii_name.tgz"
    mkdir -p "$CACHE_DIR" "$(dirname "$da_dir")"
    payload_to "$(source_url "$ii_source")" "$da_tgz" "$ii_digest" || return 1
    unpack_new "$da_tgz" "$da_dir" || return 1
    if [ ! -f "$da_dir.new/$da_exe" ] || [ ! -x "$da_dir.new/$da_exe" ]; then
        rm -rf "$da_dir.new"
        CANCEL_EXTRA=""
        err "the $ii_name download has no $da_exe to run — nothing was installed"
        return 1
    fi
    replace_dir "$da_dir.new" "$da_dir"

    wrapper_write "$da_wrapper" "$da_dir/$da_exe" || return 1
    state_record "$ii_name" archive "$ii_version" "$da_dir" "$da_wrapper"
    say "  $da_wrapper"
    return 0
}

# unpack_new <tgz> <dir> — the archive and skill kinds' unpack: <tgz> goes into
# <dir>.new, made empty first, and the download is dropped. A cancel drops both
# while it runs. On success CANCEL_EXTRA still names <dir>.new for the caller's
# own checks, which either remove it or hand it to replace_dir. On failure
# nothing is left.
unpack_new() {
    un_new="$2.new"
    rm -rf "$un_new"
    mkdir -p "$un_new"
    CANCEL_EXTRA="$1 $un_new"
    if ! tar xzf "$1" -C "$un_new"; then
        rm -f "$1"
        rm -rf "$un_new"
        CANCEL_EXTRA=""
        err "the $ii_name download is not what was expected"
        return 1
    fi
    rm -f "$1"
    return 0
}

# replace_dir <new> <dir> — <dir> replaced whole by <new>: the old one moves
# aside to <dir>.old, the new one into place, and the old one goes.
replace_dir() {
    CANCEL_EXTRA=""
    rm -rf "$2.old"
    if [ -e "$2" ] || [ -L "$2" ]; then mv "$2" "$2.old"; fi
    mv "$1" "$2"
    rm -rf "$2.old"
}

# do_skill — an agent skill (Revision 18): one pinned .tar.gz whose only top
# level entry is the skill's directory, named like the item. It unpacks with
# the archive kind's code into ~/.agents/skills/<name>, replaced whole on every
# update, and each agent's skills directory gets a link to it (skill_link). No
# wrapper. The links recorded are the ones really made; one left alone for
# being the person's own is said on stderr and the install still succeeds.
do_skill() {
    dk_targets=$(item_targets "$ii_name" skill "$ii_target" "$ii_source" "$ii_options")
    dk_dir="${dk_targets%% *}"
    dk_links="${dk_targets#"$dk_dir"}"
    case "$ii_digest" in
        ''|-) err "$ii_name came without a checksum — nothing was installed"; return 1 ;;
    esac
    have tar || { err "tar is missing — install it and try again"; return 1; }

    say "installing $ii_name"
    dk_tgz="$CACHE_DIR/$ii_name.tgz"
    mkdir -p "$CACHE_DIR" "$(dirname "$dk_dir")"
    payload_to "$(source_url "$ii_source")" "$dk_tgz" "$ii_digest" || return 1
    unpack_new "$dk_tgz" "$dk_dir" || return 1
    if [ "$(ls -A "$dk_dir.new")" != "$ii_name" ] || [ -L "$dk_dir.new/$ii_name" ] ||
        [ ! -d "$dk_dir.new/$ii_name" ]; then
        rm -rf "$dk_dir.new"
        CANCEL_EXTRA=""
        err "the $ii_name download does not hold one $ii_name folder — nothing was installed"
        return 1
    fi
    replace_dir "$dk_dir.new/$ii_name" "$dk_dir"
    rm -rf "$dk_dir.new"

    dk_made="$dk_dir"
    for dk_l in $dk_links; do
        skill_link "$dk_dir" "$dk_l" && dk_made="$dk_made $dk_l"
    done
    state_record "$ii_name" skill "$ii_version" "$dk_made"
    say "  $dk_dir"
    return 0
}

# skill_link <dir> <link> — puts <link> down as a symlink to <dir>. A symlink
# already there is replaced, whatever it points at, as terminal-browser's own
# skill links are. A real directory is replaced only when skill_dir_ours finds
# nothing of the person's in it; the retired rows whose files it held are
# forgotten with it, so their retirement has nothing left to do. Anything else
# at <link> is the person's: it stays, stderr says so, and 1 means no link.
skill_link() {
    if [ -L "$2" ]; then
        rm -f "$2"
    elif [ -d "$2" ] && skill_dir_ours "$2"; then
        rm -rf "$2"
        for sl_n in $so_names; do
            state_forget "$sl_n"
        done
        say "  replaced the files an earlier version put in $2"
    elif [ -e "$2" ]; then
        status_clear
        printf 'tlstore: left %s alone: it holds files of your own. %s is in %s\n' "$2" "$ii_name" "$1" >&2
        PROGRESS_NOTE="left your $2 alone"
        return 1
    fi
    mkdir -p "$(dirname "$2")"
    ln -s "$1" "$2"
}

# skill_dir_ours <dir> — 0 when every file under <dir> is one a retired file or
# file-once row of installed.tsv put there and still holds what that row shipped
# (its digest in the list, or the one recorded at install): the agent skill's
# loose files from before Revision 18. A directory with nothing but empty
# folders in it counts too. so_names is those rows' names.
skill_dir_ours() {
    so_names=""
    while IFS= read -r so_f; do
        [ -n "$so_f" ] || continue
        so_st=""
        [ ! -f "$STATE" ] || so_st=$(awk -F "$TAB" -v f="$so_f" '
            /^#/ { next }
            $2 == "file" || $2 == "file-once" {
                n = split($5, a, " ")
                for (i = 1; i <= n; i++) if (a[i] == f) { print $1 "\t" $7; exit }
            }' "$STATE")
        [ -n "$so_st" ] || return 1
        so_n="${so_st%%"$TAB"*}"
        so_sd="${so_st#*"$TAB"}"
        retired_item "$so_n" || return 1
        so_cd=$(field "$(row "$so_n")" 6)
        so_fd=$(file_digest "$so_f")
        [ -n "$so_fd" ] || return 1
        [ "$so_fd" = "$so_cd" ] || [ "$so_fd" = "$so_sd" ] || return 1
        in_list "$so_names" "$so_n" || so_names="$so_names $so_n"
    done <<EOF
$(find "$1" ! -type d 2>/dev/null)
EOF
    return 0
}

# skill_unplace <files> — a skill's files as installed.tsv has them: its
# directory first, then the links made to it. A link goes only while it is
# still a symlink into that directory; whatever the person put in its place
# stays. Then the directory goes.
skill_unplace() {
    sx_dir="${1%% *}"
    for sx_f in $1; do
        [ "$sx_f" != "$sx_dir" ] || continue
        [ -L "$sx_f" ] || continue
        case "$(readlink "$sx_f" 2>/dev/null)" in
            "$sx_dir"|"$sx_dir"/*) rm -f "$sx_f" ;;
        esac
    done
    rm -rf "$sx_dir"
}

# ---------------------------------------------------------------------------
# Removing
# ---------------------------------------------------------------------------

remove_item() {
    ri_name="$1"
    ri_row=$(state_row "$ri_name" 2>/dev/null || true)
    if [ -z "$ri_row" ]; then
        say "$ri_name is not installed"
        return 0
    fi
    ri_kind=$(field "$ri_row" 2)
    ri_files=$(field "$ri_row" 5)
    ri_digest=$(field "$ri_row" 7)
    if [ "$ri_kind" = fisher ]; then
        ri_item=$(row "$ri_name")
        if [ -n "$ri_item" ] && have fish; then
            if ! fish -c "fisher remove $(field "$ri_item" 5)" </dev/null >/dev/null 2>&1; then
                err "fisher could not remove $(field "$ri_item" 5); their files stay in ~/.config/fish"
            fi
        fi
    fi
    # A skill's links go only while they still point into its directory.
    if [ "$ri_kind" = skill ]; then
        skill_unplace "$ri_files"
        ri_files=""
    fi
    for ri_f in $ri_files; do
        # A config file that is no longer what tlstore wrote holds the person's
        # edits (or is their own, kept when they declined ours): it is set
        # aside beside the target rather than deleted. It is moved out of the
        # .bak-* names first, so restore_backup puts back the file that was
        # there before the install, not this one.
        ri_edited=""
        case "$ri_kind" in
            file|file-once)
                if [ -f "$ri_f" ] && [ -n "$ri_digest" ] && [ "$ri_digest" != "-" ] &&
                    [ "$(file_digest "$ri_f")" != "$ri_digest" ]; then
                    ri_edited="$(dirname "$ri_f")/.$(basename "$ri_f").edited.$$"
                    mv "$ri_f" "$ri_edited" || return 1
                fi
                ;;
        esac
        if [ -d "$ri_f" ]; then
            rm -rf "$ri_f"
        else
            rm -f "$ri_f"
        fi
        restore_backup "$ri_f" && say "  put your own $(basename "$ri_f") back"
        if [ -n "$ri_edited" ]; then
            ri_copy="$ri_f.bak-$(timestamp)"
            mv "$ri_edited" "$ri_copy" || return 1
            say "  kept your changed $(basename "$ri_f") as $(basename "$ri_copy")"
        fi
    done
    state_forget "$ri_name"
    case "$ri_kind" in
        pkg) say "$ri_name is no longer tracked; the package itself stays installed" ;;
        bundle)
            say "removed $ri_name"
            ri_item=$(row "$ri_name")
            ri_shell=""
            [ -n "$ri_item" ] && ri_shell=$(opt "$(field "$ri_item" 9)" login-shell)
            [ -n "$ri_shell" ] && unset_login_shell "$ri_shell"
            ;;
        *) say "removed $ri_name" ;;
    esac
    return 0
}

# retire_item <name> — an installed item whose row now carries retired=1,
# found by update. A file/file-once/binary is deleted only when the file on
# disk still matches what tlstore shipped (its sha256 equals the row's
# digest); an edited file is left alone and the state entry is simply
# forgotten, so a retirement never overwrites or deletes the person's own
# changes. Every other kind falls back to remove_item's own behaviour (a pkg
# just stops being tracked; the package itself stays installed). That includes
# an archive: its directory is the store's, replaced whole on every update, so
# there is no edit of yours in it to keep, and it goes the way remove takes it.
# A skill goes the same way.
retire_item() {
    rt_name="$1"
    rt_row=$(row "$rt_name")
    rt_kind=$(field "$rt_row" 2)
    case "$rt_kind" in
        binary|file|file-once)
            rt_digest=$(field "$rt_row" 6)
            rt_state=$(state_row "$rt_name" 2>/dev/null || true)
            rt_files=$(field "$rt_state" 5)
            rt_main="${rt_files%% *}"
            if [ -n "$rt_main" ] && [ -f "$rt_main" ] \
                && [ -n "$rt_digest" ] && [ "$rt_digest" != "-" ] \
                && [ "$(file_digest "$rt_main")" = "$rt_digest" ]; then
                for rt_f in $rt_files; do
                    if [ -d "$rt_f" ]; then
                        rm -rf "$rt_f"
                    else
                        rm -f "$rt_f"
                    fi
                    rt_dir=$(dirname "$rt_f")
                    while [ -n "$rt_dir" ] && [ "$rt_dir" != "$HOME" ] && [ "$rt_dir" != "/" ]; do
                        rmdir "$rt_dir" 2>/dev/null || break
                        rt_dir=$(dirname "$rt_dir")
                    done
                done
                state_forget "$rt_name"
                say "$rt_name was retired and removed"
            elif [ -n "$rt_main" ]; then
                state_forget "$rt_name"
                say "kept your $(basename "$rt_main") — $rt_name was retired"
            else
                # Nothing was ever recorded here (a file-once you already had
                # was kept at install time, with no file of ours to check).
                state_forget "$rt_name"
                say "$rt_name was retired and removed"
            fi
            ;;
        *)
            remove_item "$rt_name"
            ;;
    esac
    return 0
}

# retire_pending — retire every installed item whose row now carries
# retired=1, saying what happened on stderr so a --tsv caller's stdout stays
# clean. snapshot runs it: the launcher writes a new catalog into $PREFIX on
# every start without any refresh, and a retired row is hidden, so the store
# UI can neither show it as an update nor ask for one.
retire_pending() {
    for rp_n in $(installed_names); do
        ! retired_item "$rp_n" || retire_item "$rp_n" >&2
    done
}

# ---------------------------------------------------------------------------
# The signed channel
# ---------------------------------------------------------------------------

# What the newest release offers, for the item list (catalog) or for tlstore
# itself (self), and what came of checking it. channel_fetch is the only place
# that fetches either and checks its signature; refresh_catalog and
# su_fetch_script are its callers. It sets:
#   CH_OUTCOME  newer | current | offline | cannot-verify | refused
#   CH_REASON   one sentence, naming the fix where there is one (empty for
#               newer and current)
#   CH_VERSION  the serial or version that was read, when one was
# and keeps the answer in CHANNEL_FILE, one line per channel:
#   catalog|self <TAB> outcome <TAB> when (UTC) <TAB> reason (- for none)
CH_OUTCOME=""
CH_REASON=""
CH_VERSION=""
CHANNEL_FILE="$DATA_DIR/channel.tsv"

# channel_paths catalog|self — where the offer comes from (cn_url, with
# cn_url.minisig beside it), where it lands in the cache (cn_new, cn_sig),
# and what a person calls it (cn_what).
channel_paths() {
    case "$1" in
        catalog)
            cn_url="$CATALOG_URL"
            cn_new="$CACHE_DIR/catalog.tsv"
            cn_what="item list"
            ;;
        *)
            cn_url="$RELEASE_BASE/tlstore"
            cn_new="$CACHE_DIR/tlstore.new"
            cn_what="tlstore"
            ;;
    esac
    cn_sig="$cn_new.minisig"
}

channel_set() {
    CH_OUTCOME="$1"
    CH_REASON="${2:-}"
}

# channel_check catalog|self — the pair already in the cache, checked against
# the trusted key and compared with what is here. Needs minisign and the key;
# sets CH_OUTCOME, CH_REASON and CH_VERSION, and removes nothing. 0 for newer.
channel_check() {
    channel_paths "$1"
    CH_VERSION=""
    if ! minisign -Q -V -p "$PUBKEY" -x "$cn_sig" -m "$cn_new" >/dev/null 2>&1; then
        channel_set refused "the $cn_what that was offered is not signed by the launcher"
        return 1
    fi
    if [ "$1" = catalog ]; then
        CH_VERSION=$(serial_of "$cn_new" 2>/dev/null || true)
        case "$CH_VERSION" in
            ''|*[!0-9]*)
                CH_VERSION=""
                channel_set refused "the item list that was offered has no readable serial"
                return 1
                ;;
        esac
        if [ -n "$CATALOG_SERIAL" ] && [ "$CH_VERSION" -lt "$CATALOG_SERIAL" ]; then
            channel_set refused "the item list that was offered is older than the one you have"
        elif [ -n "$CATALOG_SERIAL" ] && [ "$CH_VERSION" -eq "$CATALOG_SERIAL" ]; then
            channel_set current
        else
            channel_set newer
        fi
    else
        CH_VERSION=$(sed -n 's/^TLSTORE_VERSION=\([0-9][0-9.]*\)$/\1/p' "$cn_new" | head -1)
        if [ -z "$CH_VERSION" ]; then
            channel_set refused "the tlstore that was offered has no readable version"
        elif version_newer "$CH_VERSION" "$TLSTORE_VERSION"; then
            channel_set newer
        else
            # The same version, or an older one (a copy built ahead of the
            # release): either way there is nothing newer to take.
            channel_set current
        fi
    fi
    [ "$CH_OUTCOME" = newer ]
}

# channel_record catalog|self — this answer replaces the channel's line in
# CHANNEL_FILE. tlstore-ui checks both channels at once, so the rewrite is
# done holding a lock directory; one that will not come free is taken over.
channel_record() {
    mkdir -p "$DATA_DIR" 2>/dev/null || return 0
    cn_lock="$CHANNEL_FILE.lock"
    cn_try=0
    while ! mkdir "$cn_lock" 2>/dev/null; do
        cn_try=$((cn_try + 1))
        [ "$cn_try" -le 3 ] || break
        sleep 1
    done
    cn_when=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf -)
    cn_tmp="$CHANNEL_FILE.$$.new"
    {
        [ ! -f "$CHANNEL_FILE" ] || awk -F "$TAB" -v c="$1" '$1 != c' "$CHANNEL_FILE"
        printf '%s\t%s\t%s\t%s\n' "$1" "$CH_OUTCOME" "$cn_when" "${CH_REASON:--}"
    } > "$cn_tmp" 2>/dev/null && mv "$cn_tmp" "$CHANNEL_FILE" 2>/dev/null
    rm -f "$cn_tmp"
    rmdir "$cn_lock" 2>/dev/null
    return 0
}

# channel_fetch catalog|self — fetch what the newest release offers, with its
# signature, and check it (see the top of this section). On newer the
# verified file and its signature stay in the cache (cn_new, cn_sig) for the
# caller to take; on anything else nothing is left there. 0 for newer.
channel_fetch() {
    channel_paths "$1"
    CH_VERSION=""
    if ! have minisign; then
        channel_set cannot-verify "minisign is not installed (pkg install minisign)"
    elif [ ! -f "$PUBKEY" ]; then
        channel_set cannot-verify "the trusted key is missing — reopen the app to put it back"
    elif ! have curl; then
        channel_set offline "curl is not installed (pkg install curl)"
    elif ! mkdir -p "$CACHE_DIR" 2>/dev/null; then
        channel_set offline "$CACHE_DIR could not be made"
    else
        rm -f "$cn_new" "$cn_sig"
        if [ "$1" = self ]; then
            # Inside a --progress stream this download is the first share of
            # the bar (su_fetch_script says how far it goes).
            curl_to "$cn_url" "$cn_new" 2>/dev/null
        else
            curl -fsL --connect-timeout 5 --max-time 60 -o "$cn_new" "$cn_url" 2>/dev/null
        fi
        cn_got=$?
        if [ "$cn_got" != 0 ] ||
           ! curl -fsL --connect-timeout 5 --max-time 60 -o "$cn_sig" "$cn_url.minisig" 2>/dev/null; then
            channel_set offline "the release could not be reached"
        else
            channel_check "$1"
        fi
    fi
    [ "$CH_OUTCOME" = newer ] || rm -f "$cn_new" "$cn_sig"
    channel_record "$1"
    [ "$CH_OUTCOME" = newer ]
}

# ---------------------------------------------------------------------------
# Refresh
# ---------------------------------------------------------------------------

# refresh_catalog <quiet> [ask] — 0 took a newer list, 1 kept the one we had,
# 2 refused what was offered; CH_OUTCOME and CH_REASON say which and why.
# With minisign missing it first asks to install it: always when not quiet
# (as `refresh` always has), and when quiet only with [ask] 1 (a plain
# `update` with someone there to answer, or -y). Quiet, it only says that the
# list moved; the caller says the rest.
refresh_catalog() {
    rc_quiet="${1:-0}"
    rc_ask="${2:-}"
    if [ -z "$rc_ask" ]; then
        rc_ask=1
        [ "$rc_quiet" = 1 ] && rc_ask=0
    fi
    if [ "$rc_ask" = 1 ] && ! have minisign; then
        if ask_yn "Updating the list of items needs minisign. Install it?"; then
            install_pkg minisign >/dev/null 2>&1 || true
        fi
    fi
    channel_fetch catalog
    case "$CH_OUTCOME" in
        newer)
            if ! mkdir -p "$DATA_DIR" || ! mv "$cn_new" "$USER_CATALOG"; then
                rm -f "$cn_new" "$cn_sig"
                return 1
            fi
            rm -f "$cn_sig"
            pick_catalog
            say "Updated the list of items."
            return 0
            ;;
        current)
            [ "$rc_quiet" = 1 ] || say "The item list is already up to date."
            return 1
            ;;
        refused)
            [ "$rc_quiet" = 1 ] || err "$CH_REASON — ignoring it"
            return 2
            ;;
    esac
    [ "$rc_quiet" = 1 ] || say "Could not check for a newer item list: $CH_REASON. Using the one you have."
    return 1
}

# update_refresh — the refresh `update` starts with (update_items reads its
# cu_* flags). One line when the list could not be checked; --tsv keeps its
# stdout to update rows (a refused list is still said, on stderr), and only a
# plain update, with someone there or -y, asks to install a missing minisign.
update_refresh() {
    ur_ask=0
    if [ "${cu_check:-0}" = 0 ] && [ "${cu_tsv:-0}" = 0 ] && [ "$PROGRESS" != 1 ]; then
        if [ "$ASSUME_YES" = 1 ] || interactive; then
            ur_ask=1
        fi
    fi
    refresh_catalog 1 "$ur_ask" && return 0
    case "$CH_OUTCOME" in
        newer|current) return 0 ;;
    esac
    if [ "${cu_tsv:-0}" = 1 ]; then
        [ "$CH_OUTCOME" != refused ] || err "$CH_REASON — ignoring it"
    else
        say "Could not check for a newer item list: $CH_REASON."
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

# pick_items <candidates file: name TAB summary> <chosen file>
pick_items() {
    pi_list="$1"
    pi_out="$2"
    : > "$pi_out"
    [ -s "$pi_list" ] || return 0
    pi_count=$(awk 'END { print NR }' "$pi_list")
    pi_sel=""
    while :; do
        say ""
        awk -F "$TAB" -v sel=" $pi_sel " '
            { mark = (index(sel, " " NR " ") > 0) ? "x" : " "
              printf "  [%s] %2d  %-18s %s\n", mark, NR, $1, $2 }
        ' "$pi_list"
        say ""
        say "Type numbers to pick, a for all, n for none, Enter when you are done."
        printf '> '
        read -r pi_reply || pi_reply=""
        case "$pi_reply" in
            '') break ;;
            a|A)
                pi_sel=""
                pi_i=1
                while [ "$pi_i" -le "$pi_count" ]; do
                    pi_sel="$pi_sel $pi_i"
                    pi_i=$((pi_i + 1))
                done
                ;;
            n|N) pi_sel="" ;;
            q|Q) pi_sel=""; break ;;
            *)
                for pi_tok in $pi_reply; do
                    case "$pi_tok" in
                        ''|*[!0-9]*) say "  $pi_tok is not one of the numbers"; continue ;;
                    esac
                    if [ "$pi_tok" -lt 1 ] || [ "$pi_tok" -gt "$pi_count" ]; then
                        say "  $pi_tok is not one of the numbers"
                        continue
                    fi
                    if in_list "$pi_sel" "$pi_tok"; then
                        pi_sel=$(printf '%s' " $pi_sel " | sed "s/ $pi_tok / /")
                    else
                        pi_sel="$pi_sel $pi_tok"
                    fi
                done
                ;;
        esac
    done
    [ -n "$pi_sel" ] || return 0
    for pi_n in $pi_sel; do
        awk -F "$TAB" -v want="$pi_n" 'NR == want { print $1 }' "$pi_list" >> "$pi_out"
    done
    return 0
}


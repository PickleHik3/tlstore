#!/bin/sh
# termux-volume — Termux:API-compatible shim over `launcherctl volume`.
# Part of the tlstore item termux-api-shims (docs/maintainer/termux-api-shims.md).
#
# Mirrors termux-api-package scripts/termux-volume.in:
#   https://github.com/termux/termux-api-package/blob/master/scripts/termux-volume.in
# With no arguments: a top-level JSON array, one object per stream (stream, volume, max_volume),
# two-space indented as upstream prints it. launcherctl wraps the array under "streams"; this
# unwraps it. With "stream volume": sets it and prints nothing, as upstream does.
set -eu

SCRIPTNAME=termux-volume
die() { echo "$SCRIPTNAME: $*" >&2; exit 1; }
command -v launcherctl >/dev/null 2>&1 ||
    die "launcherctl not found; this command needs Termux Launcher (open the app once so it installs launcherctl)"
lctl() {
    if LCTL_OUT=$(launcherctl "$@" 2>&1); then return 0; fi
    die "launcherctl $1 failed${LCTL_OUT:+: $LCTL_OUT}"
}

show_usage() {
    echo "Usage: $SCRIPTNAME stream volume"
    echo "Change volume of audio stream"
    echo "Valid audio streams are: alarm, music, notification, ring, system, call"
    echo "Call w/o arguments to show information about each audio stream"
    exit "${1:-0}"
}

if [ $# -gt 0 ]; then
    case "$1" in -h) show_usage ;; esac
    if [ $# -ne 2 ]; then
        echo "Invalid argument count" >&2
        show_usage 1
    fi
    case "$2" in
        ""|*[!0-9]*) echo "ERROR: Volume must be a number" >&2; show_usage 1 ;;
    esac
    lctl volume "$1" "$2" </dev/null
    exit 0
fi

lctl volume </dev/null

# {"ok":true,"streams":[{...},{...}]} → [ {...}, {...} ], one field per line. The objects are
# flat; strings are passed through with their escapes as they came.
printf '%s' "$LCTL_OUT" | LC_ALL=C awk '
function skipws() { while (p <= n && index(" \t\r\n,", substr(s, p, 1)) > 0) p++ }
function rdstr(   st, c) {
    p++; st = p
    while (p <= n) {
        c = substr(s, p, 1)
        if (c == "\\") { p += 2; continue }
        if (c == "\"") break
        p++
    }
    r = substr(s, st, p - st); p++
    return r
}
function rdobj(   k, c, st) {
    nk = 0; p++
    for (;;) {
        skipws()
        if (p > n) return
        c = substr(s, p, 1)
        if (c == "}") { p++; return }
        if (c != "\"") { p++; continue }
        k = rdstr()
        while (p <= n && index(" \t\r\n:", substr(s, p, 1)) > 0) p++
        c = substr(s, p, 1)
        nk++; K[nk] = k
        if (c == "\"") { V[nk] = "\"" rdstr() "\"" }
        else {
            st = p
            while (p <= n && index(",}] \t\r\n", substr(s, p, 1)) == 0) p++
            V[nk] = substr(s, st, p - st)
        }
    }
}
BEGIN { RS = "\001" }
{
    s = $0; n = length(s)
    if (!match(s, /"streams"[ \t\r\n]*:[ \t\r\n]*\[/)) {
        print "termux-volume: unexpected answer from launcherctl: " s > "/dev/stderr"; bad = 1; exit
    }
    p = RSTART + RLENGTH
    rows = 0
    for (;;) {
        skipws()
        if (p > n || substr(s, p, 1) == "]") break
        if (substr(s, p, 1) != "{") { p++; continue }
        rdobj()
        rows++
        lines = ""
        for (i = 1; i <= nk; i++) lines = lines sprintf("    \"%s\": %s%s\n", K[i], V[i], (i < nk ? "," : ""))
        obj[rows] = "  {\n" lines "  }"
    }
    if (rows == 0) { print "[]"; exit }
    print "["
    for (j = 1; j <= rows; j++) print obj[j] (j < rows ? "," : "")
    print "]"
}
END { if (bad) exit 1 }'

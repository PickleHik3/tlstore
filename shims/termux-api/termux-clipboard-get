#!/bin/sh
# termux-clipboard-get — Termux:API-compatible shim over `launcherctl clipboard paste`.
# Part of the tlstore item termux-api-shims (docs/maintainer/termux-api-shims.md).
#
# Mirrors termux-api-package scripts/termux-clipboard-get.in:
#   https://github.com/termux/termux-api-package/blob/master/scripts/termux-clipboard-get.in
# Prints the clipboard as plain text (no JSON, no trailing newline added). Needs Termux Launcher
# on screen and "Let programs read the clipboard" on, as `launcherctl clipboard paste` does.
set -eu

SCRIPTNAME=termux-clipboard-get
die() { echo "$SCRIPTNAME: $*" >&2; exit 1; }
command -v launcherctl >/dev/null 2>&1 ||
    die "launcherctl not found; this command needs Termux Launcher (open the app once so it installs launcherctl)"
lctl() {
    if LCTL_OUT=$(launcherctl "$@" 2>&1); then return 0; fi
    die "launcherctl $1 failed${LCTL_OUT:+: $LCTL_OUT}"
}

show_usage() {
    echo "Usage: $SCRIPTNAME"
    echo "Get the system clipboard text."
    exit 0
}

while getopts :h option; do
    case "$option" in
        h) show_usage ;;
        ?) echo "$SCRIPTNAME: illegal option -$OPTARG" >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ $# != 0 ]; then echo "$SCRIPTNAME: too many arguments" >&2; exit 1; fi

lctl clipboard paste </dev/null

# {"ok":true,"text":"…"} → the text. The awk program undoes the JSON string escapes and writes the
# result in the form printf %b reads back (\0ooo for every non-ASCII byte, \\ for a backslash),
# so no byte is left to the shell's or awk's idea of a character.
decoded=$(printf '%s' "$LCTL_OUT" | LC_ALL=C awk '
function hx(h,   i, n, c) {
    n = 0
    for (i = 1; i <= length(h); i++) {
        c = index("0123456789abcdef", tolower(substr(h, i, 1)))
        if (c == 0) return -1
        n = n * 16 + c - 1
    }
    return n
}
function oct(b) { return sprintf("\\0%03o", b) }
function utf8(cp) {
    if (cp <= 0) return ""
    if (cp < 128) return oct(cp)
    if (cp < 2048) return oct(192 + int(cp / 64)) oct(128 + cp % 64)
    if (cp < 65536) return oct(224 + int(cp / 4096)) oct(128 + int(cp / 64) % 64) oct(128 + cp % 64)
    return oct(240 + int(cp / 262144)) oct(128 + int(cp / 4096) % 64) oct(128 + int(cp / 64) % 64) oct(128 + cp % 64)
}
BEGIN { RS = "\001" }
{
    s = $0
    if (!match(s, /"text"[ \t]*:[ \t]*"/)) exit
    p = RSTART + RLENGTH
    n = length(s)
    out = ""
    while (p <= n) {
        c = substr(s, p, 1)
        if (c == "\"") break
        if (c != "\\") { out = out c; p++; continue }
        d = substr(s, p + 1, 1)
        p += 2
        if (d == "n") out = out "\\n"
        else if (d == "t") out = out "\\t"
        else if (d == "r") out = out "\\r"
        else if (d == "b") out = out "\\b"
        else if (d == "f") out = out "\\f"
        else if (d == "\\") out = out "\\\\"
        else if (d == "u") {
            cp = hx(substr(s, p, 4))
            p += 4
            if (cp >= 55296 && cp < 56320 && substr(s, p, 2) == "\\u") {
                lo = hx(substr(s, p + 2, 4))
                if (lo >= 56320 && lo < 57344) {
                    cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                    p += 6
                }
            }
            out = out utf8(cp)
        }
        else out = out d
    }
    printf "%s", out
}')
printf '%b' "$decoded"

#!/bin/sh
# termux-clipboard-set — Termux:API-compatible shim over `launcherctl clipboard copy`.
# Part of the tlstore item termux-api-shims (docs/maintainer/termux-api-shims.md).
#
# Mirrors termux-api-package scripts/termux-clipboard-set.in:
#   https://github.com/termux/termux-api-package/blob/master/scripts/termux-clipboard-set.in
# The text is the arguments (joined by spaces, as upstream's echo -n "$@" does), or stdin when
# there are none. Prints nothing on success, as upstream does.
set -eu

SCRIPTNAME=termux-clipboard-set
die() { echo "$SCRIPTNAME: $*" >&2; exit 1; }
command -v launcherctl >/dev/null 2>&1 ||
    die "launcherctl not found; this command needs Termux Launcher (open the app once so it installs launcherctl)"
lctl() {
    if LCTL_OUT=$(launcherctl "$@" 2>&1); then return 0; fi
    die "launcherctl $1 failed${LCTL_OUT:+: $LCTL_OUT}"
}

show_usage() {
    echo "Usage: $SCRIPTNAME [text]"
    echo "Set the system clipboard text. The text to set is either supplied as arguments or read from stdin if no arguments are given."
    exit 0
}

while getopts :h option; do
    case "$option" in
        h) show_usage ;;
        ?) echo "$SCRIPTNAME: illegal option -$OPTARG" >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ $# = 0 ]; then
    # launcherctl reads stdin itself when it gets no text.
    lctl clipboard copy
else
    lctl clipboard copy "$*" </dev/null
fi
